}

function renderMetaCvEditor(overview) {
  const state = metaReportsState.customValues;
  const client = (overview.clients || []).find((row) => row.clientId === state.selectedClientId);
  const monthKey = state.selectedMonthKey;
  if (!client || !monthKey) {
    return `
      <div class="meta-cv-editor-empty">
        Select a client month pill to edit won leads, average lead value, and average profit.
      </div>
    `;
  }

  const monthStatus = client.months?.[monthKey] || {};
  if (state.loadingEditor) {
    return renderMetaCvEditorSkeleton(client, monthKey, monthStatus);
  }

  const monthPayload = state.editorPayload?.months?.[monthKey] || null;
  const showProfit = client.metaReportShowBottomline;
  const isGhlListClient = Boolean(client.metaReportGhlDataEnabled);
  const cvSettings = {
    metaReportGhlDataEnabled: client.metaReportGhlDataEnabled,
    metaReportToplineMode: client.metaReportToplineMode,
  };
  const globalMode = resolveClientToplineMode(cvSettings);
  const toplineSource = resolveMetaCvMonthToplineSource(monthPayload, monthStatus, cvSettings);
  const isGhlReadOnly = isGhlListClient && globalMode === 'cenhub' && toplineSource === 'ghl';

  const wonValue = monthStatus.wonLeads != null
    ? monthStatus.wonLeads
    : (monthPayload?.inputs?.wonLeads ?? monthPayload?.topline?.wonLeads ?? '');
  const avgLeadValue = monthStatus.avgLeadValue != null
    ? monthStatus.avgLeadValue
    : (monthPayload?.inputs?.avgLeadValue ?? monthPayload?.topline?.avgLeadValue ?? '');
  const avgProfit = monthStatus.avgProfitPerWon != null
    ? monthStatus.avgProfitPerWon
    : (monthPayload?.inputs?.avgProfitPerWon ?? '');
  const ghlLeads = monthStatus.ghlLeads ?? monthPayload?.ghlTotals?.leads ?? monthPayload?.topline?.leads ?? '';
  const ghlRevenue = monthStatus.ghlTotalRevenue ?? monthPayload?.ghlTotals?.totalRevenue ?? '';
  const ghlProfit = monthStatus.ghlTotalProfit ?? monthPayload?.ghlTotals?.totalProfit ?? '';
  const draft = metaReportsState.customValues.draftInputs;
  const manualMode = isGhlListClient && globalMode === 'cenhub' && toplineSource === 'manual';
  const displayLeads = isGhlReadOnly
    ? ghlLeads
    : (draft?.manualLeads ?? (manualMode
      ? (monthStatus.manualLeads ?? monthPayload?.topline?.leads ?? '')
      : (monthPayload?.topline?.leads ?? monthStatus.manualLeads ?? '')));
  const displayWon = draft?.wonLeads ?? wonValue;
  const displayAvgLead = draft?.avgLeadValue ?? avgLeadValue;
  const displayAvgProfit = draft?.avgProfitPerWon ?? avgProfit;
  const readOnlyAttr = isGhlReadOnly ? ' readonly disabled tabindex="-1" aria-readonly="true"' : '';
  const disabledAttr = isGhlReadOnly ? ' disabled' : '';
  const lockedLabelClass = isGhlReadOnly ? ' is-locked' : '';

  const reportSettingsSaving = state.settingsSaving && state.settingsSavingScope === 'report';
  const toplineControlHtml = isGhlListClient ? renderMetaCvToplineSourceControl(client, overview) : '';
  const manualRowHtml = renderMetaCvMonthManualRow(monthPayload || { dataSource: toplineSource }, client);

  const monthSourcePill = isGhlListClient
    ? renderMetaMonthSourcePill(monthPayload || { dataSource: toplineSource }, cvSettings)
    : '';

  return `
    <div class="meta-report-edit-panel-head">
      <div>
        <h3>${esc(client.accountName)}</h3>
        <p class="meta-cv-editor-sub">
          ${esc(metaMonthLabel(monthKey))}
          · ${esc(monthStatus.status || 'empty')}
          · ${monthStatus.updatedAt ? `Updated ${esc(metaCvFormatUpdatedAt(monthStatus.updatedAt))}` : 'Not updated yet'}
        </p>
      </div>
      ${monthSourcePill}
    </div>
    ${toplineControlHtml}
    <div class="meta-cv-editor-grid">
      <label>Client
        <select id="meta-cv-client-select" class="admin-select">
          ${(overview.clients || []).map((row) => `
            <option value="${esc(row.clientId)}"${row.clientId === client.clientId ? ' selected' : ''}>${esc(row.accountName)}</option>
          `).join('')}
        </select>
      </label>
      <label>Month
        <select id="meta-cv-month-select" class="admin-select">
          ${(overview.monthKeys || []).map((key) => `
            <option value="${esc(key)}"${key === monthKey ? ' selected' : ''}>${esc(metaMonthLabel(key))}</option>
          `).join('')}
        </select>
      </label>
      <label class="meta-cv-value-field${lockedLabelClass}">Number of leads
        <input type="number" step="any" id="meta-cv-leads" value="${esc(displayLeads)}"${readOnlyAttr} />
      </label>
      <label class="meta-cv-value-field${lockedLabelClass}">Won leads
        <input type="number" step="any" id="meta-cv-won-leads" value="${esc(displayWon)}"${readOnlyAttr} />
      </label>
      <label class="meta-cv-value-field${lockedLabelClass}">Avg lead value
        <input type="number" step="any" id="meta-cv-avg-lead-value" value="${esc(displayAvgLead)}"${readOnlyAttr} />
      </label>
      <label class="meta-cv-value-field${lockedLabelClass}">Avg profit per won${showProfit ? '' : ' (optional)'}
        <input type="number" step="any" id="meta-cv-avg-profit" value="${esc(displayAvgProfit)}"${readOnlyAttr} />
      </label>
    </div>
    ${manualRowHtml}
    <div class="meta-report-settings-group meta-report-settings-group--stacked meta-cv-client-settings${reportSettingsSaving ? ' is-saving' : ''}">
      ${renderMetaReportSaveIndicator('meta-cv-settings-status', reportSettingsSaving)}
      ${renderMetaReportBottomlineFeeSettings(client, 'meta-cv', { variant: 'cv' })}
    </div>
    <div class="meta-cv-editor-actions">
      <div class="meta-cv-editor-actions-left">
        <a class="admin-btn admin-btn--ghost" href="/admin/meta-reports/${encodeURIComponent(client.clientId)}">Open full editor</a>
        ${isGhlListClient ? '<a class="admin-btn admin-btn--ghost" href="/admin/meta-reports/ghl-clients">Cenhub clients</a>' : ''}
        ${renderMetaReportSaveIndicator('meta-cv-save-indicator', state.saving)}
      </div>
      <button type="button" class="admin-btn admin-btn--primary" id="meta-cv-save"${state.saving || state.loadingEditor || state.settingsSaving || isGhlReadOnly ? ' disabled' : ''}${disabledAttr}>
        ${state.saving ? 'Saving…' : 'Save values'}
      </button>
    </div>
  `;
}

