(function setInitialLoadingMessage() {
  const el = document.getElementById('initial-loading-msg');
  if (el) el.textContent = LOADING_MSG;
})();

function resolveClientSlug() {
  if (document.body.dataset.clientSlug) return document.body.dataset.clientSlug;
  const parts = window.location.pathname.replace(/^\/+|\/+$/g, '').split('/').filter(Boolean);
  const adminReserved = new Set(['meta-reports', 'google-ads', 'sync-history', 'fb-lead-sync']);
  if (parts[0] === 'admin' && parts[1] === 'google-ads' && parts[2]) {
    return parts[2];
  }
  if (parts[0] === 'admin' && parts[1] === 'meta-reports' && parts[2] && parts[2] !== 'custom-values' && parts[2] !== 'ghl-clients') {
    return parts[2];
  }
  if (parts[0] === 'admin' && parts[1] && !adminReserved.has(parts[1])) return parts[1];
  if (parts[0] && parts[0] !== 'admin' && parts[0] !== 'index.html' && parts[0] !== 'report') return parts[0];
  return new URLSearchParams(window.location.search).get('client') || 'suntech-nordic';
}

const CLIENT_SLUG = resolveClientSlug();
