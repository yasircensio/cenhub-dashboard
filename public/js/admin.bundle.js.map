function setMetaReportYearLoadingBanner(toolbarSelector, year, loading) {
  const toolbar = document.querySelector(toolbarSelector);
  if (!toolbar) return;
  let banner = toolbar.querySelector('.meta-report-year-loading-banner');
  if (loading) {
    if (!banner) {
      banner = document.createElement('span');
      banner.className = 'meta-report-year-loading-banner';
      banner.setAttribute('aria-live', 'polite');
      toolbar.appendChild(banner);
    }
    banner.innerHTML = `<span class="meta-report-save-indicator-spinner"></span> Loading ${esc(year)}…`;
    banner.hidden = false;
  } else if (banner) {
    banner.hidden = true;
  }
}

function setMetaReportClientYearLoading(year, loading) {
  const page = document.querySelector('.meta-report-client-page');
  const yearSelect = document.getElementById('meta-report-year');
  if (loading) {
    if (yearSelect) yearSelect.disabled = true;
    if (page) page.classList.add('is-year-loading');
    setMetaReportYearLoadingBanner('.meta-report-client-page .meta-report-toolbar-left', year, true);
    const tabsEl = document.querySelector('.meta-report-tabs');
    if (tabsEl) {
      tabsEl.innerHTML = renderMetaReportTabsSkeleton();
      tabsEl.setAttribute('aria-busy', 'true');
    }
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) {
      panel.innerHTML = renderMetaReportMonthPanelSkeleton();
      panel.classList.add('is-loading');
    }
  } else {
    if (yearSelect) yearSelect.disabled = false;
    if (page) page.classList.remove('is-year-loading');
    setMetaReportYearLoadingBanner('.meta-report-client-page .meta-report-toolbar-left', year, false);
    const tabsEl = document.querySelector('.meta-report-tabs');
    if (tabsEl) tabsEl.removeAttribute('aria-busy');
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.remove('is-loading');
  }
}

