async function loadMetaReportsHubPage() {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard) return;
  const user = await fetchStaffMe();
  if (!user) {
    dashboard.innerHTML = `
      ${renderBrandTopbar('')}
      ${wrapDashboardShell('<div class="sync-history-empty" style="padding:24px;text-align:center"><a class="admin-btn admin-btn--primary" href="/login?next=' + encodeURIComponent(window.location.pathname) + '">Sign in</a></div>')}
    `;
    return;
  }
  currentStaffUser = user;

  if (!metaReportsState.hubMounted) {
    dashboard.innerHTML = `
      ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
      ${wrapDashboardShell('<div class="loading-state"><div class="spinner"></div><p>Loading Meta reports...</p></div>')}
    `;
  }

  try {
    const data = await adminFetch('/api/meta-reports?filter=all');
    metaReportsState.dashboardData = data;
    const viewData = getMetaReportsHubView(data, metaReportsState.filter, metaReportsState.searchQuery);
    if (!metaReportsState.hubMounted) {
      dashboard.innerHTML = renderMetaReportsHubPage(viewData);
      metaReportsState.hubMounted = true;
      bindMetaReportsHubEvents();
    } else {
      updateMetaReportsHubDom(viewData);
    }
  } catch (error) {
    if (!metaReportsState.hubMounted) {
      dashboard.innerHTML = `
        ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
        ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
      `;
    } else {
      showToast(error.message || 'Load failed', 'error');
    }
  }
}

async function loadMetaReportsClientPage({ silent = false } = {}) {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard) return;
  const user = await fetchStaffMe();
  if (!user) {
    window.location.href = `/login?next=${encodeURIComponent(window.location.pathname)}`;
    return;
  }
  currentStaffUser = user;
  const clientId = CLIENT_SLUG;

  if (!metaReportsState.clientPageMounted) {
    dashboard.innerHTML = `
      ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
      ${wrapDashboardShell('<div class="loading-state"><div class="spinner"></div><p>Loading report editor...</p></div>')}
    `;
  } else if (!silent) {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.add('is-loading');
  }

  try {
    const payload = await adminFetch(`/api/meta-reports/clients/${encodeURIComponent(clientId)}?year=${encodeURIComponent(metaReportsState.selectedYear)}`);
    syncMetaReportSelectedYear(payload, { disableUnavailable: true });
    if (Number(metaReportsState.selectedYear) !== Number(payload.year)) {
      return loadMetaReportsClientPage({ silent: true });
    }
    if (!metaReportsState.activeMonthKey) {
      metaReportsState.activeMonthKey = payload.monthKeys?.[payload.monthKeys.length - 1] || null;
    }
    if (!metaReportsState.clientPageMounted) {
      metaReportsState.clientPayload = payload;
      metaReportsState.clientReportSettingsExpanded = false;
      metaReportsState.clientShareExpanded = false;
      dashboard.innerHTML = renderMetaReportsClientPage(payload);
      metaReportsState.clientPageMounted = true;
      bindMetaReportsClientEvents(payload);
    } else {
      updateMetaReportsClientContent(payload);
    }
  } catch (error) {
    if (!metaReportsState.clientPageMounted) {
      dashboard.innerHTML = `
        ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
        ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
      `;
    } else if (silent) {
      throw error;
    } else {
      showToast(error.message || 'Load failed', 'error');
    }
  } finally {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.remove('is-loading');
  }
}

async function loadPublicMetaReportPage({ silent = false } = {}) {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard || !REPORT_TOKEN) return;

  if (!metaReportsState.publicPageMounted) {
    dashboard.innerHTML = wrapDashboardShell('<div class="loading-state"><div class="spinner"></div><p>Loading report...</p></div>');
  } else if (!silent) {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.add('is-loading');
  }

  try {
    const payload = await fetch(`/api/meta-reports/public/${encodeURIComponent(REPORT_TOKEN)}?year=${encodeURIComponent(metaReportsState.selectedYear)}`)
      .then(async (response) => {
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Report not found');
        return data;
      });
    syncMetaReportSelectedYear(payload, { disableUnavailable: true });
    if (Number(metaReportsState.selectedYear) !== Number(payload.year)) {
      // Previous year has no data — reload the available year instead.
      return loadPublicMetaReportPage({ silent: true });
    }
    if (!metaReportsState.activeMonthKey) {
      metaReportsState.activeMonthKey = payload.monthKeys?.[payload.monthKeys.length - 1] || null;
    }
    if (!metaReportsState.publicPageMounted) {
      metaReportsState.publicPayload = payload;
      dashboard.innerHTML = renderPublicMetaReportPage(payload);
      metaReportsState.publicPageMounted = true;
      bindPublicMetaReportEvents(payload);
    } else {
      updatePublicMetaReportContent(payload);
    }
  } catch (error) {
    if (!metaReportsState.publicPageMounted) {
      dashboard.innerHTML = wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message || 'Report not found')}</div>`);
    } else if (silent) {
      throw error;
    } else {
      showToast(error.message || 'Load failed', 'error');
    }
  } finally {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.remove('is-loading');
  }
}

function metaCvShortMonth(monthKey) {
  const month = Number(String(monthKey || '').slice(5, 7));
  return ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][month - 1] || monthKey;
}

function metaCvFormatUpdatedAt(value) {
  if (!value) return 'Not updated yet';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return 'Not updated yet';
  return date.toLocaleString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

function getMetaCvFilteredClients(overview = metaReportsState.customValues.overview) {
  const clients = overview?.clients || [];
  const query = String(metaReportsState.customValues.searchQuery || '').trim().toLowerCase();
  if (!query) return clients;
  return clients.filter((client) => (
    [client.accountName, client.clientId, client.metaAdAccountId]
      .filter(Boolean)
      .join(' ')
      .toLowerCase()
      .includes(query)
  ));
}

function renderMetaCvMonthPills(client, monthKeys = []) {
  const selectedClientId = metaReportsState.customValues.selectedClientId;
  const selectedMonthKey = metaReportsState.customValues.selectedMonthKey;
  return monthKeys.map((monthKey) => {
    const status = client.months?.[monthKey]?.status || 'empty';
    const isActive = selectedClientId === client.clientId && selectedMonthKey === monthKey;
    return `
      <button
        type="button"
        class="meta-cv-month-pill is-${esc(status)}${isActive ? ' is-active' : ''}"
        data-meta-cv-client="${esc(client.clientId)}"
        data-meta-cv-month="${esc(monthKey)}"
        title="${esc(metaCvShortMonth(monthKey))} · ${esc(status)}"
      >${esc(metaCvShortMonth(monthKey))}</button>
    `;
  }).join('');
}

function renderMetaCvClientRows(overview) {
  const clients = getMetaCvFilteredClients(overview);
  const monthKeys = overview.monthKeys || [];
  if (!clients.length) {
    return '<div class="meta-report-empty" style="padding:32px 12px">No matching clients.</div>';
  }
  return clients.map((client) => {
    const selected = metaReportsState.customValues.selectedClientId === client.clientId;
    return `
      <article class="meta-cv-client${selected ? ' is-selected' : ''}" data-meta-cv-client-card="${esc(client.clientId)}">
        <div class="meta-cv-client-head">
          <div>
            <h3>${esc(client.accountName)}</h3>
            <div class="meta-cv-client-meta">
              ${client.metaReportEnabled ? 'Live report' : 'Report off'}
              · Last update ${esc(metaCvFormatUpdatedAt(client.lastUpdatedAt))}
            </div>
          </div>
          <div class="meta-cv-client-stats">
            ${client.completeCount}/${monthKeys.length} done
            ${client.emptyCount ? `<br>${client.emptyCount} remaining` : ''}
          </div>
        </div>
        <div class="meta-cv-month-pills">${renderMetaCvMonthPills(client, monthKeys)}</div>
      </article>
    `;
  }).join('');
}

function monthStatusIsEmpty(monthContext, settings = {}) {
  if (!monthContext) return true;
  const status = monthContext.status
    ?? classifyMetaCvMonthStatus({
      wonLeads: monthContext.inputs?.wonLeads ?? monthContext.topline?.wonLeads ?? monthContext.wonLeads,
      avgLeadValue: monthContext.inputs?.avgLeadValue ?? monthContext.topline?.avgLeadValue ?? monthContext.avgLeadValue,
      avgProfitPerWon: monthContext.inputs?.avgProfitPerWon ?? monthContext.avgProfitPerWon,
    }, Boolean(settings.metaReportShowBottomline));
  return status === 'empty';
}

function metaReportEffectiveFeeEnabled(clientOrSettings, monthContext = null) {
  if (!monthContext) return Boolean(clientOrSettings?.metaReportFeeEnabled);
  const requireProfit = Boolean(clientOrSettings?.metaReportShowBottomline);
  const status = monthContext.status
    ?? classifyMetaCvMonthStatus({
      wonLeads: monthContext.inputs?.wonLeads ?? monthContext.topline?.wonLeads ?? monthContext.wonLeads,
      avgLeadValue: monthContext.inputs?.avgLeadValue ?? monthContext.topline?.avgLeadValue ?? monthContext.avgLeadValue,
      avgProfitPerWon: monthContext.inputs?.avgProfitPerWon ?? monthContext.avgProfitPerWon,
    }, requireProfit);
  if (status === 'empty') return false;
  return Boolean(clientOrSettings?.metaReportFeeEnabled);
}

function resolveMetaReportFeeMode(settings = {}) {
  if (!settings.metaReportFeeEnabled) return '';
  return resolveMetaReportStoredFeeMode(settings);
}

const META_REPORT_FEE_MODE_META = [
  { value: '', icon: '–', title: 'None', desc: 'No Censio fee' },
  { value: 'performance', icon: '%', title: 'Performance fee', desc: '% of profit (POAS)' },
  { value: 'marketing', icon: 'Dkr', title: 'Marketing fee', desc: 'Fixed Dkr amount' },
];

function metaReportFeeValueBlockHtml(prefix, mode, feePercent, marketingFee, { inline = false } = {}) {
  if (inline && mode === 'performance') {
    return `
      <label class="meta-cv-fee-inline-field">
        <span class="meta-cv-fee-inline-label">Performance fee</span>
        <span class="meta-report-fee-value-input-wrap meta-cv-fee-inline-input">
          <input type="number" step="any" min="0" max="100" id="${prefix}-setting-fee-percent" value="${esc(feePercent)}" />
          <span class="meta-report-fee-value-input-suffix">%</span>
        </span>
      </label>`;
  }
  if (inline && mode === 'marketing') {
    return `
      <label class="meta-cv-fee-inline-field">
        <span class="meta-cv-fee-inline-label">Marketing fee</span>
        <span class="meta-report-fee-value-input-wrap meta-cv-fee-inline-input">
          <input type="number" step="any" min="0" id="${prefix}-setting-marketing-fee" value="${esc(marketingFee)}" />
          <span class="meta-report-fee-value-input-suffix">Dkr</span>
        </span>
      </label>`;
  }
  if (inline) {
    return '<span class="meta-cv-fee-inline-hint">No fee amount — save to apply.</span>';
  }
  if (mode === 'performance') {
    return `
      <label class="meta-report-fee-value-field">
        <span class="meta-report-fee-value-label">Performance fee percentage</span>
        <span class="meta-report-fee-value-input-wrap">
          <input type="number" step="any" min="0" max="100" id="${prefix}-setting-fee-percent" value="${esc(feePercent)}" />
          <span class="meta-report-fee-value-input-suffix">%</span>
        </span>
      </label>`;
  }
  if (mode === 'marketing') {
    return `
      <label class="meta-report-fee-value-field">
        <span class="meta-report-fee-value-label">Marketing fee amount</span>
        <span class="meta-report-fee-value-input-wrap">
          <input type="number" step="any" min="0" id="${prefix}-setting-marketing-fee" value="${esc(marketingFee)}" />
          <span class="meta-report-fee-value-input-suffix">Dkr</span>
        </span>
      </label>`;
  }
  return '<p class="meta-report-fee-value-empty">No amount needed — just save your selection.</p>';
}

function metaReportUsesInlineFeeValue(prefix) {
  return prefix === 'meta-cv';
}

function describeMetaReportFeeModeLabel(mode, feePercent, marketingFee, { feeEnabled = true } = {}) {
  if (!feeEnabled || mode === '' || mode == null) return 'No Censio fee';
  if (mode === 'performance') {
    const pct = Number(feePercent);
    return `Performance fee · ${Number.isFinite(pct) ? pct : 20}%`;
  }
  if (mode === 'marketing') {
    const amount = Number(marketingFee);
    return `Marketing fee · Dkr ${Number.isFinite(amount) ? amount : 0}`;
  }
  return 'No Censio fee';
}

function readMetaReportFeeDraftState(prefix) {
  const nested = document.getElementById(`${prefix}-fee-nested`);
  if (!nested) return null;
  const checkedRadio = nested.querySelector(`input[name="${prefix}-fee-mode"]:checked`);
  const selectedMode = checkedRadio ? (checkedRadio.value || '') : (nested.dataset.feeMode || '');
  let selectedPercent = Number(nested.dataset.feePercent);
  let selectedMarketing = Number(nested.dataset.marketingFee);
  if (selectedMode === 'performance') {
    const input = document.getElementById(`${prefix}-setting-fee-percent`);
    const parsed = Number(input?.value);
    if (Number.isFinite(parsed)) selectedPercent = parsed;
  } else if (selectedMode === 'marketing') {
    const input = document.getElementById(`${prefix}-setting-marketing-fee`);
    const parsed = Number(input?.value);
    if (Number.isFinite(parsed)) selectedMarketing = parsed;
  }
  const appliedMode = nested.dataset.feeEnabled === 'true'
    ? resolveMetaReportStoredFeeMode({
      metaReportFeeEnabled: true,
      metaReportFeeMode: nested.dataset.feeMode || null,
      metaReportMarketingFeeAmount: nested.dataset.marketingFee,
    })
    : '';
  const appliedPercent = Number(nested.dataset.feePercent);
  const appliedMarketing = Number(nested.dataset.marketingFee);
  const modeDirty = selectedMode !== appliedMode;
  const amountDirty = selectedMode === 'performance'
    ? selectedPercent !== appliedPercent
    : selectedMode === 'marketing'
      ? selectedMarketing !== appliedMarketing
      : false;
  return {
    appliedMode,
    appliedPercent,
    appliedMarketing,
    selectedMode,
    selectedPercent,
    selectedMarketing,
    isDirty: modeDirty || amountDirty,
    appliedLabel: describeMetaReportFeeModeLabel(appliedMode, appliedPercent, appliedMarketing),
    selectedLabel: describeMetaReportFeeModeLabel(selectedMode, selectedPercent, selectedMarketing),
  };
}

function metaReportFeeStatusHtml(draft) {
  if (draft.isDirty) {
    return `
        <span class="meta-report-fee-status-value is-active">${esc(draft.appliedLabel)}</span>
        <span class="meta-report-fee-status-arrow" aria-hidden="true">→</span>
        <span class="meta-report-fee-status-pending">${esc(draft.selectedLabel)}</span>`;
  }
  return `<span class="meta-report-fee-status-value is-active">${esc(draft.appliedLabel)}</span>`;
}

function syncMetaReportFeeSelectionState(prefix) {
  const nested = document.getElementById(`${prefix}-fee-nested`);
  const draft = readMetaReportFeeDraftState(prefix);
  if (!nested || !draft) return;

  const statusEl = document.getElementById(`${prefix}-fee-status`);
  if (statusEl) {
    statusEl.innerHTML = metaReportFeeStatusHtml(draft);
  }

  const saveBtn = document.getElementById(`${prefix}-fee-save`);
  if (saveBtn) {
    saveBtn.classList.toggle('is-dirty', draft.isDirty);
    if (prefix === 'meta-cv') {
      saveBtn.disabled = !draft.isDirty;
      saveBtn.textContent = draft.isDirty ? 'Save changes' : 'Saved';
    }
  }
}

function bindMetaReportFeeAmountInputs(prefix) {
  const percentInput = document.getElementById(`${prefix}-setting-fee-percent`);
  const marketingInput = document.getElementById(`${prefix}-setting-marketing-fee`);
  if (percentInput) {
    percentInput.oninput = () => syncMetaReportFeeSelectionState(prefix);
  }
  if (marketingInput) {
    marketingInput.oninput = () => syncMetaReportFeeSelectionState(prefix);
  }
}

function bindMetaReportFeeDraftTracking(prefix) {
  bindMetaReportFeeAmountInputs(prefix);
  syncMetaReportFeeSelectionState(prefix);
}

function renderMetaReportBottomlineFeeSummary(settings = {}, prefix = 'meta-report') {
  const showBottomline = Boolean(settings.metaReportShowBottomline);
  const feeMode = resolveMetaReportFeeMode(settings) || '';
  const feePercent = settings.metaReportFeePercent ?? 20;
  const marketingFee = settings.metaReportMarketingFeeAmount ?? 0;
  const feeLabel = describeMetaReportFeeModeLabel(feeMode, feePercent, marketingFee);
  return `
    <div class="meta-report-bottomline-summary" id="${prefix}-fee-summary">
      <div class="meta-report-bottomline-summary-content">
        <div class="meta-report-bottomline-summary-row">
          <span class="meta-report-bottomline-summary-label">Bottomline</span>
          <span class="meta-report-bottomline-summary-value${showBottomline ? ' is-on' : ' is-off'}">${showBottomline ? 'Enabled' : 'Disabled'}</span>
        </div>
        ${showBottomline ? `
        <div class="meta-report-bottomline-summary-row">
          <span class="meta-report-bottomline-summary-label">Censio fee</span>
          <span class="meta-report-bottomline-summary-value">${esc(feeLabel)}</span>
        </div>` : ''}
      </div>
      <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="${prefix}-fee-edit">Edit</button>
    </div>
  `;
}

function setMetaReportClientSettingsExpanded(prefix, expanded) {
  if (prefix !== 'meta-report') return;
  metaReportsState.clientReportSettingsExpanded = Boolean(expanded);
  const root = document.querySelector('.meta-report-bottomline-fee-settings--client');
  const settingsCard = document.querySelector('.meta-report-client-page .meta-report-settings');
  const editor = document.getElementById(`${prefix}-fee-editor`);
  root?.classList.toggle('is-editing', expanded);
  root?.classList.toggle('is-collapsed', !expanded);
  settingsCard?.classList.toggle('is-collapsed', !expanded);
  editor?.classList.toggle('is-hidden', !expanded);
}

function updateMetaReportBottomlineFeeSummary(settings = {}, prefix = 'meta-report') {
  const summary = document.getElementById(`${prefix}-fee-summary`);
  if (!summary) return;
  const wrapper = document.createElement('div');
  wrapper.innerHTML = renderMetaReportBottomlineFeeSummary(settings, prefix);
  const next = wrapper.firstElementChild;
  if (next) summary.replaceWith(next);
  const editBtn = document.getElementById(`${prefix}-fee-edit`);
  if (editBtn) {
    editBtn.onclick = () => setMetaReportClientSettingsExpanded(prefix, true);
  }
}

function renderMetaReportBottomlineFeeSettings(settings = {}, prefix = 'meta-report', { compact = false, variant = 'default', collapsible = false } = {}) {
  const showBottomline = Boolean(settings.metaReportShowBottomline);
  const feeEnabled = Boolean(settings.metaReportFeeEnabled);
  const storedMode = settings.metaReportFeeMode || '';
  const displayMode = resolveMetaReportFeeMode(settings);
  const feePercent = settings.metaReportFeePercent ?? 20;
  const marketingFee = settings.metaReportMarketingFeeAmount ?? 0;
  const inlineFeeValue = metaReportUsesInlineFeeValue(prefix);
  const feeDataAttrs = `data-fee-mode="${esc(storedMode)}" data-fee-enabled="${feeEnabled ? 'true' : 'false'}" data-fee-percent="${esc(feePercent)}" data-marketing-fee="${esc(marketingFee)}"`;

  if (variant === 'cv') {
    const appliedLabel = describeMetaReportFeeModeLabel(displayMode, feePercent, marketingFee);
    const pills = META_REPORT_FEE_MODE_META.map(({ value, title }) => `
        <label class="meta-report-fee-mode-pill">
          <input type="radio" name="${prefix}-fee-mode" value="${esc(value)}"${displayMode === value ? ' checked' : ''} />
          <span>${esc(title)}</span>
        </label>`).join('');
    return `
    <div class="meta-report-bottomline-fee-settings meta-report-bottomline-fee-settings--cv">
      <div class="meta-cv-bottomline-panel">
        <div class="meta-cv-bottomline-head">
          <div class="meta-cv-bottomline-head-text">
            <span class="meta-cv-bottomline-title">Enable bottomline</span>
            <span class="meta-cv-bottomline-hint">Adds profit breakdown and Censio fee to client report</span>
          </div>
          ${renderMetaReportSwitch(`${prefix}-setting-bottomline`, showBottomline, 'Enable bottomline on report', false, { hideLabel: true })}
        </div>
        <div class="meta-report-fee-nested meta-cv-bottomline-body${showBottomline ? '' : ' is-hidden'}" id="${prefix}-fee-nested" ${feeDataAttrs}>
          <div class="meta-report-fee-status" id="${prefix}-fee-status" aria-live="polite">
            <span class="meta-report-fee-status-value is-active">${esc(appliedLabel)}</span>
          </div>
          <div class="meta-report-fee-mode-pills">${pills}</div>
          <div class="meta-cv-fee-footer">
            <div class="meta-cv-fee-value-inline" id="${prefix}-fee-value">${metaReportFeeValueBlockHtml(prefix, displayMode, feePercent, marketingFee, { inline: true })}</div>
            <button type="button" class="admin-btn admin-btn--primary admin-btn--small" id="${prefix}-fee-save" disabled>Saved</button>
          </div>
        </div>
      </div>
    </div>
  `;
  }

  const appliedLabel = describeMetaReportFeeModeLabel(displayMode, feePercent, marketingFee);
  const cards = META_REPORT_FEE_MODE_META.map(({ value, icon, title, desc }) => `
        <label class="meta-report-fee-mode-card">
          <input type="radio" name="${prefix}-fee-mode" value="${esc(value)}"${displayMode === value ? ' checked' : ''} />
          <span class="meta-report-fee-mode-card-icon" aria-hidden="true">${esc(icon)}</span>
          <span class="meta-report-fee-mode-card-text">
            <span class="meta-report-fee-mode-card-title">${esc(title)}</span>
            <small>${esc(desc)}</small>
          </span>
          <span class="meta-report-fee-mode-card-radio" aria-hidden="true">${ICON_CHECK}</span>
        </label>`).join('');
  const expanded = collapsible ? metaReportsState.clientReportSettingsExpanded : true;
  const editorActions = collapsible ? `
        <div class="meta-report-fee-editor-actions">
          <button type="button" class="admin-btn admin-btn--ghost admin-btn--small" id="${prefix}-fee-done">Done</button>
          <button type="button" class="admin-btn admin-btn--primary admin-btn--small" id="${prefix}-fee-save">Save fee settings</button>
        </div>` : `
        <div class="meta-report-fee-save-row">
          <button type="button" class="admin-btn admin-btn--primary admin-btn--small" id="${prefix}-fee-save">Save fee settings</button>
        </div>`;
  const summaryHtml = collapsible ? renderMetaReportBottomlineFeeSummary(settings, prefix) : '';
  return `
    <div class="meta-report-bottomline-fee-settings${collapsible ? ' meta-report-bottomline-fee-settings--client' : ''}${collapsible ? (expanded ? ' is-editing' : ' is-collapsed') : ''}">
      ${summaryHtml}
      <div class="meta-report-bottomline-editor${collapsible && !expanded ? ' is-hidden' : ''}" id="${prefix}-fee-editor">
        <div class="meta-report-bottomline-row">
          <div class="meta-report-bottomline-row-text">
            <span class="meta-report-bottomline-row-title">Show bottomline</span>
            <span class="meta-report-bottomline-row-desc">Adds profit, ROAS and Censio fee breakdown to this report</span>
          </div>
          ${renderMetaReportSwitch(`${prefix}-setting-bottomline`, showBottomline, 'Show bottomline', false, { hideLabel: true })}
        </div>
        <div class="meta-report-fee-nested${showBottomline ? '' : ' is-hidden'}" id="${prefix}-fee-nested" ${feeDataAttrs}>
          <div class="meta-report-fee-status" id="${prefix}-fee-status" aria-live="polite">
            <span class="meta-report-fee-status-value is-active">${esc(appliedLabel)}</span>
          </div>
          <div class="meta-report-fee-mode-grid${compact ? ' meta-report-fee-mode-grid--rows' : ''}">${cards}
          </div>
          <div class="meta-report-fee-value" id="${prefix}-fee-value">${metaReportFeeValueBlockHtml(prefix, displayMode, feePercent, marketingFee, { inline: inlineFeeValue })}</div>
          ${editorActions}
        </div>
      </div>
    </div>
  `;
}

function syncMetaReportBottomlineFeeDom(settings = {}, prefix = 'meta-report') {
  const showBottomline = Boolean(settings.metaReportShowBottomline);
  const feeEnabled = Boolean(settings.metaReportFeeEnabled);
  const storedMode = settings.metaReportFeeMode || '';
  const displayMode = resolveMetaReportFeeMode(settings);
  const feePercent = settings.metaReportFeePercent ?? 20;
  const marketingFee = settings.metaReportMarketingFeeAmount ?? 0;
  const bottomlineToggle = document.getElementById(`${prefix}-setting-bottomline`);
  if (bottomlineToggle) bottomlineToggle.checked = showBottomline;
  const nested = document.getElementById(`${prefix}-fee-nested`);
  nested?.classList.toggle('is-hidden', !showBottomline);
  if (nested) {
    nested.dataset.feeMode = storedMode;
    nested.dataset.feeEnabled = feeEnabled ? 'true' : 'false';
    nested.dataset.feePercent = String(feePercent);
    nested.dataset.marketingFee = String(marketingFee);
  }
  document.querySelectorAll(`input[name="${prefix}-fee-mode"]`).forEach((radio) => {
    radio.checked = radio.value === displayMode;
  });
  const inlineFeeValue = metaReportUsesInlineFeeValue(prefix);
  const valueBlock = document.getElementById(`${prefix}-fee-value`);
  if (valueBlock) {
    valueBlock.innerHTML = metaReportFeeValueBlockHtml(prefix, displayMode, feePercent, marketingFee, { inline: inlineFeeValue });
    bindMetaReportFeeValueInputEnterKey(prefix);
  }
  syncMetaReportFeeSelectionState(prefix);
  if (prefix === 'meta-report') {
    updateMetaReportBottomlineFeeSummary(settings, prefix);
  }
}

function bindMetaReportFeeValueInputEnterKey(prefix) {
  const input = document.getElementById(`${prefix}-setting-fee-percent`) || document.getElementById(`${prefix}-setting-marketing-fee`);
  if (!input) return;
  input.onkeydown = (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      document.getElementById(`${prefix}-fee-save`)?.click();
    }
  };
}

function bindMetaReportBottomlineFeeEvents(clientId, prefix, saveSettingsFn) {
  const saveSettings = saveSettingsFn || ((patch, revert) => saveMetaReportClientSettings(clientId, patch, revert));
  const editBtn = document.getElementById(`${prefix}-fee-edit`);
  if (editBtn) {
    editBtn.onclick = () => setMetaReportClientSettingsExpanded(prefix, true);
  }
  const doneBtn = document.getElementById(`${prefix}-fee-done`);
  if (doneBtn) {
    doneBtn.onclick = () => {
      const settings = metaReportsState.clientPayload?.settings || {};
      syncMetaReportBottomlineFeeDom(settings, prefix);
      setMetaReportClientSettingsExpanded(prefix, false);
      updateMetaReportBottomlineFeeSummary(settings, prefix);
    };
  }
  const bottomlineToggle = document.getElementById(`${prefix}-setting-bottomline`);
  if (bottomlineToggle) {
    bottomlineToggle.onchange = () => {
      const next = bottomlineToggle.checked;
      saveSettings(
        { metaReportShowBottomline: next },
        () => { bottomlineToggle.checked = !next; },
      );
    };
  }

  document.querySelectorAll(`input[name="${prefix}-fee-mode"]`).forEach((radio) => {
    radio.onchange = () => {
      if (!radio.checked) return;
      const nested = document.getElementById(`${prefix}-fee-nested`);
      const inlineFeeValue = metaReportUsesInlineFeeValue(prefix);
      const valueBlock = document.getElementById(`${prefix}-fee-value`);
      if (valueBlock && nested) {
        valueBlock.innerHTML = metaReportFeeValueBlockHtml(
          prefix,
          radio.value || '',
          nested.dataset.feePercent ?? 20,
          nested.dataset.marketingFee ?? 0,
          { inline: inlineFeeValue },
        );
        bindMetaReportFeeValueInputEnterKey(prefix);
      }
      bindMetaReportFeeAmountInputs(prefix);
      syncMetaReportFeeSelectionState(prefix);
    };
  });

  bindMetaReportFeeValueInputEnterKey(prefix);
  bindMetaReportFeeDraftTracking(prefix);

  const saveBtn = document.getElementById(`${prefix}-fee-save`);
  if (saveBtn) {
    saveBtn.onclick = async () => {
      if (saveBtn.disabled) return;
      const nested = document.getElementById(`${prefix}-fee-nested`);
      const checkedRadio = nested?.querySelector(`input[name="${prefix}-fee-mode"]:checked`);
      const mode = checkedRadio ? (checkedRadio.value || null) : null;
      const patch = { metaReportFeeMode: mode };
      if (mode === 'performance') {
        const input = document.getElementById(`${prefix}-setting-fee-percent`);
        let value = Number(input?.value);
        if (!Number.isFinite(value)) value = 20;
        value = Math.min(100, Math.max(0, value));
        if (input) input.value = String(value);
        patch.metaReportFeePercent = value;
      } else if (mode === 'marketing') {
        const input = document.getElementById(`${prefix}-setting-marketing-fee`);
        let value = Number(input?.value);
        if (!Number.isFinite(value)) value = 0;
        value = Math.max(0, value);
        if (input) input.value = String(value);
        patch.metaReportMarketingFeeAmount = value;
      }
      const originalLabel = saveBtn.textContent;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving…';
      saveBtn.classList.remove('is-dirty');
      try {
        await saveSettings(patch, () => syncMetaReportBottomlineFeeDom({
          metaReportShowBottomline: bottomlineToggle ? bottomlineToggle.checked : true,
          metaReportFeeMode: nested?.dataset.feeMode || null,
          metaReportFeePercent: Number(nested?.dataset.feePercent) || 20,
          metaReportMarketingFeeAmount: Number(nested?.dataset.marketingFee) || 0,
        }, prefix));
        syncMetaReportFeeSelectionState(prefix);
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = originalLabel;
        syncMetaReportFeeSelectionState(prefix);
      }
    };
  }
}

function renderMetaReportSaveIndicator(id, visible = false) {
  return `
    <span class="meta-report-save-indicator${visible ? ' is-visible' : ''}" id="${esc(id)}" aria-live="polite">
      <span class="meta-report-save-indicator-spinner"></span> Saving…
    </span>
  `;
}

function renderMetaReportSwitch(id, checked, labelText, disabled = false, { hideLabel = false } = {}) {
  return `
    <div class="meta-report-switch">
      <label class="meta-report-switch-track" for="${esc(id)}" aria-label="${esc(labelText)}">
        <input type="checkbox" class="meta-report-switch-input" id="${esc(id)}"${checked ? ' checked' : ''}${disabled ? ' disabled' : ''} />
        <span class="meta-report-switch-thumb" aria-hidden="true"></span>
      </label>
      ${hideLabel ? '' : `<span class="meta-report-switch-label">${esc(labelText)}</span>`}
    </div>
  `;
}

function renderMetaCvEditorSkeleton(client, monthKey, monthStatus = {}) {
  return `
    <h3>${esc(client.accountName)}</h3>
    <p class="meta-cv-editor-sub">
      ${esc(metaMonthLabel(monthKey))}
      · ${esc(monthStatus.status || 'empty')}
    </p>
    <div class="meta-cv-editor-skeleton" aria-busy="true" aria-label="Loading month details">
      <div class="meta-cv-skeleton-grid">
        ${Array.from({ length: 5 }).map(() => `
          <div class="meta-cv-skeleton-field">
            <div class="meta-cv-skeleton-line meta-cv-skeleton-line--xs"></div>
            <div class="meta-cv-skeleton-input"></div>
          </div>
        `).join('')}
      </div>
      <div class="meta-cv-skeleton-panel">
        <div class="meta-cv-skeleton-line meta-cv-skeleton-line--md"></div>
        <div class="meta-cv-skeleton-line meta-cv-skeleton-line--full"></div>
      </div>
      <div class="meta-cv-skeleton-actions">
        <div class="meta-cv-skeleton-btn"></div>
        <div class="meta-cv-skeleton-btn meta-cv-skeleton-btn--primary"></div>
      </div>
    </div>
  `;
}

function renderMetaCvEditor(overview) {
  const state = metaReportsState.customValues;
  const client = (overview.clients || []).find((row) => row.clientId === state.selectedClientId);
  const monthKey = state.selectedMonthKey;
  if (!client || !monthKey) {
    return `
      <div class="meta-cv-editor-empty">
        Select a client month pill to edit won leads, average lead value, and average profit.
      </div>
    `;
  }

  const monthStatus = client.months?.[monthKey] || {};
  if (state.loadingEditor) {
    return renderMetaCvEditorSkeleton(client, monthKey, monthStatus);
  }

  const monthPayload = state.editorPayload?.months?.[monthKey] || null;
  const showProfit = client.metaReportShowBottomline;
  const wonValue = monthStatus.wonLeads != null
    ? monthStatus.wonLeads
    : (monthPayload?.inputs?.wonLeads ?? monthPayload?.topline?.wonLeads ?? '');
  const avgLeadValue = monthStatus.avgLeadValue != null
    ? monthStatus.avgLeadValue
    : (monthPayload?.inputs?.avgLeadValue ?? monthPayload?.topline?.avgLeadValue ?? '');
  const avgProfit = monthStatus.avgProfitPerWon != null
    ? monthStatus.avgProfitPerWon
    : (monthPayload?.inputs?.avgProfitPerWon ?? '');
  const draft = metaReportsState.customValues.draftInputs;
  const displayWon = draft?.wonLeads ?? wonValue;
  const displayAvgLead = draft?.avgLeadValue ?? avgLeadValue;
  const displayAvgProfit = draft?.avgProfitPerWon ?? avgProfit;

  const reportSettingsSaving = state.settingsSaving && state.settingsSavingScope === 'report';

  return `
    <h3>${esc(client.accountName)}</h3>
    <p class="meta-cv-editor-sub">
      ${esc(metaMonthLabel(monthKey))}
      · ${esc(monthStatus.status || 'empty')}
      · ${monthStatus.updatedAt ? `Updated ${esc(metaCvFormatUpdatedAt(monthStatus.updatedAt))}` : 'Not updated yet'}
    </p>
    <div class="meta-cv-editor-grid">
      <label>Client
        <select id="meta-cv-client-select" class="admin-select">
          ${(overview.clients || []).map((row) => `
            <option value="${esc(row.clientId)}"${row.clientId === client.clientId ? ' selected' : ''}>${esc(row.accountName)}</option>
          `).join('')}
        </select>
      </label>
      <label>Month
        <select id="meta-cv-month-select" class="admin-select">
          ${(overview.monthKeys || []).map((key) => `
            <option value="${esc(key)}"${key === monthKey ? ' selected' : ''}>${esc(metaMonthLabel(key))}</option>
          `).join('')}
        </select>
      </label>
      <label>Won leads
        <input type="number" step="any" id="meta-cv-won-leads" value="${esc(displayWon)}" />
      </label>
      <label>Avg lead value
        <input type="number" step="any" id="meta-cv-avg-lead-value" value="${esc(displayAvgLead)}" />
      </label>
      <label>Avg profit per won${showProfit ? '' : ' (optional)'}
        <input type="number" step="any" id="meta-cv-avg-profit" value="${esc(displayAvgProfit)}" />
      </label>
    </div>
    <div class="meta-report-settings-group meta-report-settings-group--stacked meta-cv-client-settings${reportSettingsSaving ? ' is-saving' : ''}">
      ${renderMetaReportSaveIndicator('meta-cv-settings-status', reportSettingsSaving)}
      ${renderMetaReportBottomlineFeeSettings(client, 'meta-cv', { variant: 'cv' })}
    </div>
    <div class="meta-cv-editor-actions">
      <div class="meta-cv-editor-actions-left">
        <a class="admin-btn admin-btn--ghost" href="/admin/meta-reports/${encodeURIComponent(client.clientId)}">Open full editor</a>
        ${renderMetaReportSaveIndicator('meta-cv-save-indicator', state.saving)}
      </div>
      <button type="button" class="admin-btn admin-btn--primary" id="meta-cv-save"${state.saving || state.loadingEditor || state.settingsSaving ? ' disabled' : ''}>
        ${state.saving ? 'Saving…' : 'Save values'}
      </button>
    </div>
  `;
}

function renderMetaReportsCustomValuesPage(overview) {
  const summary = overview.summary || {};
  const yearOptions = (overview.years || []).map((entry) => `
    <option value="${esc(entry.year)}"${Number(overview.year) === Number(entry.year) ? ' selected' : ''}>${esc(entry.year)}</option>
  `).join('');

  return `
    ${renderBrandTopbar(renderStaffAdminChrome('meta-reports-custom'))}
    ${wrapDashboardShell(`
    <div class="page-hero admin-hub-hero meta-premium-page-hero">
      <div class="meta-premium-page-hero-inner">
        <div class="admin-breadcrumb">
          <a href="/admin">Clients</a>
          <span aria-hidden="true"> / </span>
          <a href="/admin/meta-reports">Meta reports</a>
          <span aria-hidden="true"> / </span>
          <span>Custom values</span>
        </div>
        <h1>Custom values</h1>
      </div>
    </div>
    <div class="sync-history-page meta-reports-page">
      <div class="meta-cv-toolbar">
        <div class="meta-cv-toolbar-left">
          <label class="meta-report-year-field">Year
            <select id="meta-cv-year" class="admin-select">${yearOptions}</select>
          </label>
          <span class="meta-report-year-loading-banner" id="meta-cv-year-loading-banner" hidden aria-live="polite"></span>
        </div>
        <div class="meta-cv-search">
          <input id="meta-cv-search" type="search" placeholder="Search clients..." value="${esc(metaReportsState.customValues.searchQuery)}" autocomplete="off" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:10px;font:inherit" />
        </div>
      </div>
      <div class="meta-cv-summary">
        <span class="meta-cv-summary-pill is-complete">${summary.completeMonths || 0} complete</span>
        <span class="meta-cv-summary-pill is-partial">${summary.partialMonths || 0} partial</span>
        <span class="meta-cv-summary-pill is-empty">${summary.emptyMonths || 0} remaining</span>
        <span class="meta-cv-summary-pill">${summary.clientCount || 0} clients · ${summary.monthCount || 0} months</span>
      </div>
      <div class="meta-cv-legend">
        <span><i class="is-complete"></i> Complete</span>
        <span><i class="is-partial"></i> Partial</span>
        <span><i class="is-empty"></i> Remaining</span>
      </div>
      <div class="meta-cv-layout" style="margin-top:16px">
        <div class="meta-cv-list" id="meta-cv-client-list">
          ${renderMetaCvClientRows(overview)}
        </div>
        <aside class="meta-cv-editor" id="meta-cv-editor">
          ${renderMetaCvEditor(overview)}
        </aside>
      </div>
    </div>
    `)}
  `;
}

function refreshMetaCvListAndEditor() {
  const overview = metaReportsState.customValues.overview;
  if (!overview) return;
  const list = document.getElementById('meta-cv-client-list');
  if (list) list.innerHTML = renderMetaCvClientRows(overview);
  const editor = document.getElementById('meta-cv-editor');
  if (editor) editor.innerHTML = renderMetaCvEditor(overview);
  metaReportsState.customValues.draftInputs = null;
  bindMetaCvEditorEvents();
  bindMetaCvListEvents();
}

function setMetaCvSavePending(isPending) {
  metaReportsState.customValues.saving = isPending;
  const saveBtn = document.getElementById('meta-cv-save');
  const indicator = document.getElementById('meta-cv-save-indicator');
  if (indicator) indicator.classList.toggle('is-visible', isPending);
  if (saveBtn) {
    saveBtn.disabled = isPending || metaReportsState.customValues.loadingEditor || metaReportsState.customValues.settingsSaving;
    saveBtn.textContent = isPending ? 'Saving…' : 'Save values';
  }
}

function setMetaCvSettingsSaving(isPending, scope = 'report') {
  metaReportsState.customValues.settingsSaving = isPending;
  metaReportsState.customValues.settingsSavingScope = isPending ? scope : null;
  const showReport = isPending && scope === 'report';
  document.getElementById('meta-cv-settings-status')?.classList.toggle('is-visible', showReport);
  document.querySelector('.meta-cv-client-settings')?.classList.toggle('is-saving', showReport);
  const reportToggleIds = ['meta-cv-setting-bottomline'];
  reportToggleIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) el.disabled = showReport;
  });
  document.querySelectorAll('input[name="meta-cv-fee-mode"]').forEach((el) => {
    el.disabled = showReport;
  });
  ['meta-cv-setting-fee-percent', 'meta-cv-setting-marketing-fee'].forEach((id) => {
    const el = document.getElementById(id);
    if (el) el.disabled = showReport || el.disabled;
  });
  const saveBtn = document.getElementById('meta-cv-save');
  if (saveBtn) {
    saveBtn.disabled = isPending || metaReportsState.customValues.saving || metaReportsState.customValues.loadingEditor;
  }
}

function classifyMetaCvMonthStatus(month, requireProfit = false) {
  if (!month) return 'empty';
  const hasWon = month.wonLeads != null;
  const hasAvgLead = month.avgLeadValue != null;
  const hasProfit = month.avgProfitPerWon != null;
  if (hasWon && hasAvgLead && (!requireProfit || hasProfit)) return 'complete';
  if (hasWon || hasAvgLead || hasProfit) return 'partial';
  return 'empty';
}

function applyMetaCvSaveResult(clientId, monthKey, body, result) {
  const overview = metaReportsState.customValues.overview;
  const client = overview?.clients?.find((row) => row.clientId === clientId);
  const month = client?.months?.[monthKey];
  const savedMonth = result?.month || {};
  if (month) {
    month.wonLeads = savedMonth.wonLeads ?? body.wonLeads;
    month.avgLeadValue = savedMonth.avgLeadValue ?? body.avgLeadValue;
    month.avgProfitPerWon = savedMonth.avgProfitPerWon ?? body.avgProfitPerWon;
    month.status = classifyMetaCvMonthStatus(month, Boolean(client.metaReportShowBottomline));
    month.updatedAt = month.status === 'empty'
      ? null
      : (savedMonth.updatedAt || new Date().toISOString());
  }
  if (result?.monthPayload) {
    metaReportsState.customValues.editorPayload = {
      ...(metaReportsState.customValues.editorPayload || {}),
      months: {
        ...(metaReportsState.customValues.editorPayload?.months || {}),
        [monthKey]: result.monthPayload,
      },
    };
  }
}

async function refreshMetaCvOverviewSilently() {
  const overview = await adminFetch(
    `/api/meta-reports/custom-values?year=${encodeURIComponent(metaReportsState.selectedYear)}`,
  );
  metaReportsState.selectedYear = Number(overview.year) || metaReportsState.selectedYear;
  metaReportsState.customValues.overview = overview;
  const list = document.getElementById('meta-cv-client-list');
  if (list) {
    list.innerHTML = renderMetaCvClientRows(overview);
    bindMetaCvListEvents();
  }
  const summaryHost = document.querySelector('.meta-cv-summary');
  if (summaryHost && overview.summary) {
    const summary = overview.summary;
    summaryHost.innerHTML = `
      <span class="meta-cv-summary-pill is-complete">${summary.completeMonths || 0} complete</span>
      <span class="meta-cv-summary-pill is-partial">${summary.partialMonths || 0} partial</span>
      <span class="meta-cv-summary-pill is-empty">${summary.emptyMonths || 0} remaining</span>
      <span class="meta-cv-summary-pill">${summary.clientCount || 0} clients · ${summary.monthCount || 0} months</span>
    `;
  }
}

function collectMetaCvSaveBody() {
  return {
    wonLeads: document.getElementById('meta-cv-won-leads')?.value === ''
      ? null
      : Number(document.getElementById('meta-cv-won-leads')?.value),
    avgLeadValue: document.getElementById('meta-cv-avg-lead-value')?.value === ''
      ? null
      : Number(document.getElementById('meta-cv-avg-lead-value')?.value),
    avgProfitPerWon: document.getElementById('meta-cv-avg-profit')?.value === ''
      ? null
      : Number(document.getElementById('meta-cv-avg-profit')?.value),
  };
}

function syncMetaCvClientSettingsDom(settings = {}) {
  syncMetaReportBottomlineFeeDom(settings, 'meta-cv');
}

async function saveMetaCvClientSettings(clientId, patch, revert) {
  setMetaCvSettingsSaving(true, 'report');
  try {
    const monthKey = metaReportsState.customValues.selectedMonthKey;
    const result = await patchMetaReportSettings(clientId, {
      ...patch,
      monthKey: monthKey || undefined,
    });
    const overview = metaReportsState.customValues.overview;
    const client = overview?.clients?.find((row) => row.clientId === clientId);
    if (client && result.settings) {
      client.metaReportShowBottomline = Boolean(result.settings.metaReportShowBottomline);
      client.metaReportFeeEnabled = Boolean(result.settings.metaReportFeeEnabled);
      client.metaReportFeeMode = result.settings.metaReportFeeMode || null;
      client.metaReportFeePercent = result.settings.metaReportFeePercent ?? 20;
      client.metaReportMarketingFeeAmount = result.settings.metaReportMarketingFeeAmount ?? 0;
    }
    if (result.monthPayload && monthKey) {
      metaReportsState.customValues.editorPayload = {
        ...(metaReportsState.customValues.editorPayload || {}),
        months: {
          ...(metaReportsState.customValues.editorPayload?.months || {}),
          [monthKey]: result.monthPayload,
        },
      };
    }
    setMetaCvSettingsSaving(false);
    syncMetaCvClientSettingsDom(result.settings || {});
    showToast(describeMetaReportSettingsChange(patch, result.settings || {}), 'success');
  } catch (error) {
    showToast(error.message || 'Update failed', 'error');
    if (revert) revert();
    setMetaCvSettingsSaving(false);
  }
}

function bindMetaCvSettingsEvents(clientId) {
  bindMetaReportBottomlineFeeEvents(
    clientId,
    'meta-cv',
    (patch, revert) => saveMetaCvClientSettings(clientId, patch, revert),
  );
}

async function selectMetaCvMonth(clientId, monthKey, { reloadEditor = true } = {}) {
  metaReportsState.customValues.selectedClientId = clientId;
  metaReportsState.customValues.selectedMonthKey = monthKey;
  refreshMetaCvListAndEditor();
  if (!reloadEditor) return;
  metaReportsState.customValues.loadingEditor = true;
  refreshMetaCvListAndEditor();
  try {
    const result = await adminFetch(
      `/api/meta-reports/clients/${encodeURIComponent(clientId)}/months/${encodeURIComponent(monthKey)}`,
    );
    if (
      metaReportsState.customValues.selectedClientId === clientId
      && metaReportsState.customValues.selectedMonthKey === monthKey
    ) {
      metaReportsState.customValues.editorPayload = {
        ...(metaReportsState.customValues.editorPayload || {}),
        months: {
          ...(metaReportsState.customValues.editorPayload?.months || {}),
          [monthKey]: result.monthPayload,
        },
      };
    }
  } catch (error) {
    showToast(error.message || 'Failed to load month', 'error');
  } finally {
    metaReportsState.customValues.loadingEditor = false;
    refreshMetaCvListAndEditor();
  }
}

function bindMetaCvListEvents() {
  document.querySelectorAll('[data-meta-cv-month]').forEach((button) => {
    button.onclick = () => {
      selectMetaCvMonth(
        button.getAttribute('data-meta-cv-client'),
        button.getAttribute('data-meta-cv-month'),
      );
    };
  });
}

function bindMetaCvEditorEvents() {
  const clientId = metaReportsState.customValues.selectedClientId;
  if (clientId) bindMetaCvSettingsEvents(clientId);

  const clientSelect = document.getElementById('meta-cv-client-select');
  const monthSelect = document.getElementById('meta-cv-month-select');
  if (clientSelect) {
    clientSelect.onchange = () => {
      const monthKey = metaReportsState.customValues.selectedMonthKey
        || metaReportsState.customValues.overview?.monthKeys?.slice(-1)[0];
      if (monthKey) selectMetaCvMonth(clientSelect.value, monthKey);
    };
  }
  if (monthSelect) {
    monthSelect.onchange = () => {
      const clientId = metaReportsState.customValues.selectedClientId;
      if (clientId) selectMetaCvMonth(clientId, monthSelect.value);
    };
  }

  const saveBtn = document.getElementById('meta-cv-save');
  if (saveBtn) {
    saveBtn.onclick = async () => {
      const clientId = metaReportsState.customValues.selectedClientId;
      const monthKey = metaReportsState.customValues.selectedMonthKey;
      if (!clientId || !monthKey) return;
      const body = collectMetaCvSaveBody();
      setMetaCvSavePending(true);
      try {
        const result = await adminFetch(
          `/api/meta-reports/clients/${encodeURIComponent(clientId)}/months/${encodeURIComponent(monthKey)}`,
          { method: 'PUT', body: JSON.stringify(body) },
        );
        applyMetaCvSaveResult(clientId, monthKey, body, result);
        metaReportsState.customValues.draftInputs = body;
        setMetaCvSavePending(false);
        refreshMetaCvListAndEditor();
        showToast('Custom values saved', 'success');
        await refreshMetaCvOverviewSilently();
      } catch (error) {
        showToast(error.message || 'Save failed', 'error');
        setMetaCvSavePending(false);
      }
    };
  }
}

function bindMetaReportsCustomValuesEvents(overview) {
  const yearSelect = document.getElementById('meta-cv-year');
  if (yearSelect) {
    yearSelect.onchange = async () => {
      const previousYear = metaReportsState.selectedYear;
      const newYear = Number(yearSelect.value);
      if (newYear === previousYear) return;
      metaReportsState.selectedYear = newYear;
      metaReportsState.customValues.selectedClientId = null;
      metaReportsState.customValues.selectedMonthKey = null;
      metaReportsState.customValues.editorPayload = null;
      setMetaCvYearLoading(newYear, true);
      try {
        await loadMetaReportsCustomValuesPage({ silent: true });
      } catch (error) {
        metaReportsState.selectedYear = previousYear;
        if (yearSelect) yearSelect.value = String(previousYear);
        await loadMetaReportsCustomValuesPage({ silent: true, keepSelection: true });
        showToast(error.message || 'Load failed', 'error');
      } finally {
        setMetaCvYearLoading(newYear, false);
      }
    };
  }
  const search = document.getElementById('meta-cv-search');
  if (search) {
    search.oninput = () => {
      metaReportsState.customValues.searchQuery = search.value;
      const list = document.getElementById('meta-cv-client-list');
      if (list) list.innerHTML = renderMetaCvClientRows(overview);
      bindMetaCvListEvents();
    };
  }
  bindMetaCvListEvents();
  bindMetaCvEditorEvents();
}

async function loadMetaReportsCustomValuesPage({ silent = false, keepSelection = false } = {}) {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard) return;
  const user = await fetchStaffMe();
  if (!user) {
    window.location.href = `/login?next=${encodeURIComponent(window.location.pathname)}`;
    return;
  }
  currentStaffUser = user;

  if (!metaReportsState.customValues.mounted && !silent) {
    dashboard.innerHTML = `
      ${renderBrandTopbar(renderStaffAdminChrome('meta-reports-custom'))}
      ${wrapDashboardShell('<div class="loading-state"><div class="spinner"></div><p>Loading custom values...</p></div>')}
    `;
  }

  try {
    const overview = await adminFetch(`/api/meta-reports/custom-values?year=${encodeURIComponent(metaReportsState.selectedYear)}`);
    metaReportsState.selectedYear = Number(overview.year) || metaReportsState.selectedYear;
    metaReportsState.customValues.overview = overview;
    if (!keepSelection) {
      // keep existing selection if still valid
      const stillValid = (overview.clients || []).some((row) => row.clientId === metaReportsState.customValues.selectedClientId);
      if (!stillValid) {
        metaReportsState.customValues.selectedClientId = null;
        metaReportsState.customValues.selectedMonthKey = null;
        metaReportsState.customValues.editorPayload = null;
      }
    }
    dashboard.innerHTML = renderMetaReportsCustomValuesPage(overview);
    metaReportsState.customValues.mounted = true;
    metaReportsState.customValues.saving = false;
    bindMetaReportsCustomValuesEvents(overview);
  } catch (error) {
    if (!metaReportsState.customValues.mounted) {
      dashboard.innerHTML = `
        ${renderBrandTopbar(renderStaffAdminChrome('meta-reports-custom'))}
        ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
      `;
    } else if (silent) {
      throw error;
    } else {
      showToast(error.message || 'Load failed', 'error');
    }
  }
}

function renderAdminHubPage(clients) {
  const count = clients.length;
  const syncLogActions = currentStaffUser ? `
          <a class="admin-btn admin-btn--secondary" href="/admin/sync-history/meta">Meta sync log</a>
  ` : '';
  const adminActions = isStaffAdmin() ? `
          ${syncLogActions}
          <button class="admin-btn" type="button" onclick="syncAllClients(this)">${ICON_SYNC} Sync all</button>
          <button class="admin-btn admin-btn--primary" type="button" onclick="focusAddClient()">${ICON_PLUS} Add client</button>
  ` : syncLogActions;
  return `
    ${renderBrandTopbar(renderStaffAdminChrome('clients'))}
    ${wrapDashboardShell(`
    <div class="page-hero admin-hub-hero">
      <h1>Client administration</h1>
      <p>Manage dashboard accounts, sync GHL data, and preview client views.</p>
    </div>
    <div class="admin-hub">
      <div class="hub-toolbar-row">
        <div class="hub-search">
          ${ICON_SEARCH}
          <input id="hub-search" type="search" placeholder="Search clients..." oninput="filterHubCards()" />
        </div>
        <span class="hub-count" id="hub-count">${count} client${count === 1 ? '' : 's'}</span>
        <div class="hub-toolbar-actions">
          ${adminActions}
        </div>
      </div>
      <div class="client-grid" id="client-grid">
        ${count ? clients.map((client) => renderClientCard(client)).join('') : `<div class="hub-empty">${isStaffAdmin() ? 'No clients yet. Create your first client below.' : 'No clients yet.'}</div>`}
        <div class="hub-empty" id="hub-no-results" style="display:none">No clients match your search.</div>
      </div>
      ${isStaffAdmin() ? renderAddClientPanel() : ''}
    </div>
    <div class="brand-footer">
      Dashboard by Cenhub · Holstebro
    </div>
    `)}
  `;
}

function focusAddClient() {
  const panel = document.getElementById('add-client-panel');
  if (panel) panel.open = true;
  const input = document.getElementById('new-account-name');
  if (!input) return;
  input.scrollIntoView({ behavior: 'smooth', block: 'center' });
  setTimeout(() => input.focus({ preventScroll: true }), 350);
}

function copyAdminUrl(clientId) {
  const url = `${window.location.origin}/admin/${clientId}`;
  navigator.clipboard.writeText(url).then(
    () => showToast('Admin URL copied', 'success'),
    () => showToast('Could not copy URL', 'error'),
  );
}

function closeCardMenus() {
  document.querySelectorAll('.card-menu.open').forEach((menu) => menu.classList.remove('open'));
}

function toggleCardMenu(clientId, event) {
  event.stopPropagation();
  const menu = document.getElementById(`card-menu-${clientId}`);
  if (!menu) return;
  const willOpen = !menu.classList.contains('open');
  closeCardMenus();
  if (willOpen) menu.classList.add('open');
}

function renderCardMenu(clientId, accountName) {
  const label = accountName || clientId;
  const deleteAction = isStaffAdmin()
    ? `<button type="button" role="menuitem" class="card-menu-item--danger" onclick="closeCardMenus(); deleteClient('${clientId}');">Delete client</button>`
    : '';
  return `
    <div class="card-menu" id="card-menu-${clientId}" data-client-id="${clientId}">
      <button
        type="button"
        class="icon-btn card-menu-trigger"
        aria-label="More actions for ${esc(label)}"
        title="More actions"
        aria-haspopup="menu"
        onclick="toggleCardMenu('${clientId}', event)"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <circle cx="12" cy="5" r="1.75"></circle>
          <circle cx="12" cy="12" r="1.75"></circle>
          <circle cx="12" cy="19" r="1.75"></circle>
        </svg>
      </button>
      <div class="card-menu-dropdown" role="menu">
        <button type="button" role="menuitem" onclick="copyAdminUrl('${clientId}'); closeCardMenus();">Copy admin URL</button>
        ${deleteAction}
      </div>
    </div>
  `;
}

function renderClientCard(client) {
  const kpis = client.previewKpis || {};
  const pipelineLabel = client.pipelineMode === '3-pipeline' ? '3 pipelines' : '2 pipelines';
  const needsAction = clientNeedsAction(client.status);
  return `
    <article class="client-card${needsAction ? ' client-card--needs-action' : ''}" data-client-id="${client.clientId}" data-search="${esc(`${client.accountName} ${client.clientId}`.toLowerCase())}">
      <div class="client-card-header">
        <span class="client-avatar" aria-hidden="true">${esc(clientInitials(client.accountName))}</span>
        <div class="client-card-title-block">
          <h3>${esc(client.accountName)}</h3>
          <div class="client-card-slug">/${client.clientId}</div>
        </div>
        ${renderCardMenu(client.clientId, client.accountName)}
      </div>
      <div class="client-card-meta">
        <span class="status-badge status-${client.status}">${statusLabel(client.status)}</span>
        <span class="client-card-meta-divider" aria-hidden="true">·</span>
        <span>${pipelineLabel}</span>
        <span class="client-card-meta-divider" aria-hidden="true">·</span>
        <span data-sync-meta>${formatRelativeSync(client.lastSyncAt, client.status)}</span>
      </div>
      ${needsAction ? `<p class="client-card-action-hint">${esc(clientActionHint(client.status))}</p>` : ''}
      ${kpis.totalLeads != null ? `
        <div class="client-card-stats">
          <div class="client-card-stat">
            <div class="client-card-stat-value">${fmtDkk(kpis.totalLeads)}</div>
            <div class="client-card-stat-label">Leads</div>
          </div>
          <div class="client-card-stat">
            <div class="client-card-stat-value">${fmtDkk(kpis.clientsWon)}</div>
            <div class="client-card-stat-label">Won</div>
          </div>
          <div class="client-card-stat">
            <div class="client-card-stat-value">${fmtRevenueDkk(kpis.wonRevenue)}</div>
            <div class="client-card-stat-label">Revenue</div>
          </div>
        </div>
      ` : ''}
      <div class="client-card-actions">
        <a class="admin-btn" href="/admin/${client.clientId}">Settings</a>
        <a class="admin-btn admin-btn--primary" href="/${encodeURIComponent(client.clientId)}" target="_blank" rel="noopener noreferrer" title="Open client dashboard">Dashboard</a>
        <button class="admin-btn admin-btn--secondary" type="button" onclick="syncClient('${client.clientId}', this)">${ICON_SYNC} Sync</button>
      </div>
    </article>
  `;
}

function filterHubCards() {
  const query = (document.getElementById('hub-search')?.value || '').trim().toLowerCase();
  let visible = 0;
  document.querySelectorAll('#client-grid .client-card').forEach((card) => {
    const match = !query || (card.dataset.search || '').includes(query);
    card.style.display = match ? '' : 'none';
    if (match) visible += 1;
  });
  const empty = document.getElementById('hub-no-results');
  if (empty) empty.style.display = query && !visible ? '' : 'none';
}

function renderAddClientPanel() {
  return `
    <details class="add-client-panel" id="add-client-panel">
      <summary class="add-client-summary">
        <h2>${ICON_PLUS} Add new client</h2>
        <span class="add-client-summary-hint">Click to expand</span>
      </summary>
      <p class="add-client-desc">Creates the account and opens the setup page where you pick the metrics model and connect GHL.</p>
      <div class="add-client-body">
        <div class="setup-grid setup-grid--3">
          <div class="field-group">
            <label for="new-account-name">Account name</label>
            <input id="new-account-name" type="text" placeholder="ScanTherm" oninput="suggestNewClientSlug()" />
          </div>
          <div class="field-group">
            <label for="new-client-slug">Admin slug</label>
            <input id="new-client-slug" type="text" placeholder="scantherm" oninput="checkNewClientSlug()" />
            <div id="slug-status" class="slug-status"></div>
          </div>
          <div class="field-group">
            <label for="new-location-id">GHL location ID</label>
            <input id="new-location-id" type="text" placeholder="Optional — can be added later" />
          </div>
        </div>
        <div class="setup-actions" style="border-top:0;padding-top:16px;margin-top:0">
          <div></div>
          <button class="admin-btn admin-btn--primary" type="button" onclick="createClient()">${ICON_PLUS} Create client</button>
        </div>
      </div>
    </details>
  `;
}

async function loadAdminHub() {
  const dashboard = document.getElementById('dashboard');
  const user = await requireStaffAuth();
  if (!user) return;

  dashboard.innerHTML = `
    ${renderBrandTopbar(renderStaffAdminChrome('clients'))}
    ${wrapDashboardShell(`
      <div class="loading-state">
        <div class="spinner"></div>
        Loading clients...
      </div>
    `)}`;

  try {
    const data = await adminFetch('/api/clients');
    dashboard.innerHTML = renderAdminHubPage(data.clients || []);
  } catch (error) {
    dashboard.innerHTML = `
      ${renderBrandTopbar(renderStaffAdminChrome('clients'))}
      ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
    `;
  }
}

let slugCheckTimer = null;

function suggestNewClientSlug() {
  const name = document.getElementById('new-account-name')?.value || '';
  const slugInput = document.getElementById('new-client-slug');
  if (!slugInput || slugInput.dataset.userEdited === 'true') return;
  slugInput.value = name.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  checkNewClientSlug();
}

function checkNewClientSlug() {
  const slugInput = document.getElementById('new-client-slug');
  if (slugInput) slugInput.dataset.userEdited = 'true';
  clearTimeout(slugCheckTimer);
  slugCheckTimer = setTimeout(async () => {
    const slug = document.getElementById('new-client-slug')?.value || '';
    const statusEl = document.getElementById('slug-status');
    if (!statusEl || !slug) {
      if (statusEl) statusEl.textContent = '';
      return;
    }
    try {
      const result = await adminFetch(`/api/clients/check-slug?slug=${encodeURIComponent(slug)}`);
      statusEl.className = `slug-status ${result.available ? 'ok' : 'bad'}`;
      statusEl.textContent = result.available
        ? `Available · ${result.adminUrl}`
        : `Unavailable (${result.reason || 'taken'})`;
    } catch (error) {
      statusEl.className = 'slug-status bad';
      statusEl.textContent = error.message;
    }
  }, 300);
}

async function createClient() {
  const accountName = document.getElementById('new-account-name')?.value?.trim();
  const clientId = document.getElementById('new-client-slug')?.value?.trim();
  const locationId = document.getElementById('new-location-id')?.value?.trim();
  if (!accountName || !clientId) {
    window.alert('Account name and slug are required.');
    return;
  }
  try {
    await adminFetch('/api/clients', {
      method: 'POST',
      body: JSON.stringify({ accountName, clientId, locationId: locationId || null }),
    });
    showToast('Client created', 'success');
    window.location.href = `/admin/${encodeURIComponent(clientId)}`;
  } catch (error) {
    showToast(error.message, 'error');
  }
}

let hubSyncPollTimer = null;
let hubSyncPendingIds = new Set();
let hubSyncPollStartedAt = 0;
let hubSyncBaselineAt = new Map();

function stopHubSyncPolling() {
  if (hubSyncPollTimer) {
    clearInterval(hubSyncPollTimer);
    hubSyncPollTimer = null;
  }
  hubSyncPendingIds = new Set();
  hubSyncPollStartedAt = 0;
  hubSyncBaselineAt = new Map();
}

function isClientSyncing(client) {
  return client.status === 'syncing' || client.lastSyncStatus === 'syncing';
}

function hubBatchStillPending(clients) {
  if (!hubSyncPendingIds.size) return false;
  const byId = new Map((clients || []).map((client) => [client.clientId, client]));
  for (const clientId of hubSyncPendingIds) {
    const client = byId.get(clientId);
    if (!client) continue;
    if (isClientSyncing(client)) return true;
    if (client.lastSyncStatus === 'error') continue;
    const baseline = hubSyncBaselineAt.get(clientId);
    if (baseline === client.lastSyncAt) return true;
  }
  return false;
}

async function pollHubSyncProgress() {
  if (!IS_ADMIN_HUB || !document.getElementById('client-grid')) {
    stopHubSyncPolling();
    return;
  }

  if (hubSyncPollStartedAt && Date.now() - hubSyncPollStartedAt > 15 * 60 * 1000) {
    stopHubSyncPolling();
    showToast('Some sync jobs are still running. Refresh the page in a minute.', 'error');
    return;
  }

  try {
    const data = await adminFetch('/api/clients');
    const clients = data.clients || [];
    updateHubCardsFromClients(clients);

    if (hubBatchStillPending(clients)) return;

    const pendingIds = new Set(hubSyncPendingIds);
    stopHubSyncPolling();
    const dashboard = document.getElementById('dashboard');
    if (dashboard) {
      dashboard.innerHTML = renderAdminHubPage(clients);
    }
    const failed = clients.filter((client) =>
      pendingIds.has(client.clientId) && client.lastSyncStatus === 'error',
    );
    if (failed.length) {
      showToast(`${failed.length} sync(s) failed`, 'error');
    } else {
      showToast('All clients synced', 'success');
    }
  } catch {
    // Keep polling while background jobs run.
  }
}

function startHubSyncPolling(clientIds = [], clients = []) {
  stopHubSyncPolling();
  hubSyncPendingIds = new Set(clientIds);
  hubSyncPollStartedAt = Date.now();
  hubSyncBaselineAt = new Map(
    (clients || [])
      .filter((client) => clientIds.includes(client.clientId))
      .map((client) => [client.clientId, client.lastSyncAt]),
  );
  markHubCardsSyncing(clientIds);
  pollHubSyncProgress();
  hubSyncPollTimer = setInterval(pollHubSyncProgress, 3000);
}
function markHubCardsSyncing(clientIds = []) {
  clientIds.forEach((clientId) => {
    const card = document.querySelector(`.client-card[data-client-id="${clientId}"]`);
    if (!card) return;
    const badge = card.querySelector('.status-badge');
    if (badge) {
      badge.className = 'status-badge status-syncing';
      badge.textContent = statusLabel('syncing');
    }
    const meta = card.querySelector('[data-sync-meta]');
    if (meta) meta.textContent = 'Syncing now...';
  });
}

function updateHubCardsFromClients(clients) {
  (clients || []).forEach((client) => {
    const card = document.querySelector(`.client-card[data-client-id="${client.clientId}"]`);
    if (!card) return;
    const badge = card.querySelector('.status-badge');
    if (badge) {
      badge.className = `status-badge status-${client.status}`;
      badge.textContent = statusLabel(client.status);
    }
    const meta = card.querySelector('[data-sync-meta]');
    if (meta) meta.textContent = formatRelativeSync(client.lastSyncAt, client.status);
  });
}

async function syncAllClients(button) {
  if (button) button.disabled = true;
  try {
    showToast('Syncing all clients...');
    const data = await adminFetch('/api/clients', {
      method: 'POST',
      body: JSON.stringify({ action: 'sync-all' }),
    });

    if (data.queued) {
      const count = data.count ?? (data.clientIds || []).length;
      showToast(`Syncing ${count} client${count === 1 ? '' : 's'} in background`, 'success');
      const hubData = await adminFetch('/api/clients');
      startHubSyncPolling(data.clientIds || [], hubData.clients || []);
      return;
    }

    const failed = (data.results || []).filter((row) => !row.success);
    if (failed.length) {
      showToast(`${failed.length} sync(s) failed`, 'error');
    } else {
      showToast('All clients synced', 'success');
    }
    await loadAdminHub();
  } catch (error) {
    showToast(error.message, 'error');
  } finally {
    if (button) button.disabled = false;
  }
}

async function deleteClient(clientId) {
  const label = clientId;
  const ok = window.confirm(
    `Delete "${label}" permanently?\n\nThis removes the account, GHL token, and all synced snapshot data. This cannot be undone.`,
  );
  if (!ok) return;

  const typed = window.prompt(`Type "${clientId}" to confirm deletion:`);
  if (typed !== clientId) {
    showToast('Deletion cancelled — slug did not match.', 'error');
    return;
  }

  try {
    await adminFetch(`/api/clients/${encodeURIComponent(clientId)}`, { method: 'DELETE' });
    showToast(`Deleted ${clientId}`, 'success');
    if (IS_ADMIN_HUB) {
      await loadAdminHub();
    } else {
      window.location.href = '/admin';
    }
  } catch (error) {
    showToast(error.message, 'error');
  }
}

async function syncClient(clientId, button) {
  if (button) {
    button.disabled = true;
    button.textContent = 'Syncing...';
  }
  try {
    await adminFetch(`/api/clients/${encodeURIComponent(clientId)}/sync`, { method: 'POST', body: '{}' });
    showToast('Sync completed', 'success');
    if (IS_ADMIN_HUB) await loadAdminHub();
    else if (IS_ADMIN_CLIENT) {
      await loadSetupAccount();
      if (accountCanPreviewDashboard(setupAccount)) loadDashboard(true, { background: true });
    }
    else loadDashboard(true, { background: true });
  } catch (error) {
    showToast(error.message, 'error');
  } finally {
    if (button) {
      button.disabled = false;
      const label = button.dataset.syncLabel || 'Sync';
      button.innerHTML = button.dataset.syncLabel ? `${ICON_SYNC} ${label}` : label;
    }
  }
}

function getMetricsModelLabels(account, pipelines = setupPipelines) {
  const pipelineMap = new Map((pipelines || []).map((pipeline) => [pipeline.id, pipeline.name]));
  if (account.dedupeEnabled) {
    const winName = pipelineMap.get(account.winPipelineId) || account.winPipelineId || '—';
    return {
      typeLabel: 'Funnel + deduplication',
      winLabel: `Win pipeline: ${winName}`,
    };
  }
  if (account.winPipelineId) {
    const winName = pipelineMap.get(account.winPipelineId) || account.winPipelineId;
    return {
      typeLabel: 'Simple (single win pipeline)',
      winLabel: `Win pipeline: ${winName}`,
    };
  }
  return {
    typeLabel: 'Simple (no deduplication)',
    winLabel: 'All won opportunities',
  };
}

const ICON_LAYER = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/></svg>';
const ICON_MERGE = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.4"/><circle cx="6" cy="18" r="2.4"/><circle cx="18" cy="15" r="2.4"/><path d="M6 8.4V15.6"/><path d="M8.2 6.4C14 6.4 14 12.6 15.8 13.4"/></svg>';
const ICON_TARGET = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/></svg>';
const ICON_LOCK = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="10.5" width="15" height="9" rx="2"/><path d="M8 10.5V7a4 4 0 018 0v3.5"/></svg>';
const ICON_UNLOCK = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="10.5" width="15" height="9" rx="2"/><path d="M8 10.5V7a4 4 0 017.8-1.2"/></svg>';
const ICON_TAG = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 12.7L12.7 20.6a2 2 0 01-2.8 0l-7-7a2 2 0 010-2.8L10.8 3H19a2 2 0 012 2v7.7z"/><circle cx="15" cy="8" r="1.2"/></svg>';
const ICON_HASH = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9h14M5 15h14M10 3L8 21M16 3l-2 18"/></svg>';
const ICON_EDIT = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>';
const ICON_WARNING = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9L2.6 18a1.5 1.5 0 001.3 2.2h16.2a1.5 1.5 0 001.3-2.2L13.7 3.9a1.5 1.5 0 00-3.4 0z"/><path d="M12 9v4"/><path d="M12 16.5h.01"/></svg>';


function renderMetricsModelPanel(account) {
  const labels = getMetricsModelLabels(account);
  const showWizard = !account.metricsModelSetAt || metricsModelChangeMode;
  const wizardClass = showWizard ? ' is-wizard' : ' is-locked';
  const initialMode = account.dedupeEnabled ? 'dedupe' : (account.winPipelineId ? 'pipeline' : 'simple');
  const lockedCopy = account.metricsModelLockedAt
    ? `Locked since ${new Date(account.metricsModelLockedAt).toLocaleDateString('en-GB')}`
    : 'Editable until first successful sync';
  const badgeClass = account.metricsModelLockedAt ? 'metrics-model-badge is-locked' : 'metrics-model-badge';

  if (!showWizard) {
    return `
      <div class="metrics-model-panel is-locked">
        <div class="metrics-model-header">
          <div class="metrics-model-heading">
            <h3 class="metrics-model-title">Metrics model</h3>
          </div>
          <span class="${badgeClass}">${account.metricsModelLockedAt ? ICON_LOCK : ICON_UNLOCK} ${account.metricsModelLockedAt ? 'Locked' : 'Editable'}</span>
        </div>
        <p class="metrics-model-copy">
          Defines how clients won, revenue, Bundlinje, ROAS, and won-revenue charts are calculated.
        </p>
        <div class="metrics-model-facts">
          <div class="metrics-model-fact is-config">
            <span class="metrics-model-fact-icon">${ICON_TAG}</span>
            <div class="metrics-model-fact-body">
              <div class="metrics-model-fact-label">Model</div>
              <div class="metrics-model-fact-value">${labels.typeLabel}</div>
            </div>
          </div>
          <div class="metrics-model-fact is-config">
            <span class="metrics-model-fact-icon">${ICON_TARGET}</span>
            <div class="metrics-model-fact-body">
              <div class="metrics-model-fact-label">Win source</div>
              <div class="metrics-model-fact-value">${labels.winLabel}</div>
            </div>
          </div>
          <div class="metrics-model-fact">
            <span class="metrics-model-fact-icon">${account.metricsModelLockedAt ? ICON_LOCK : ICON_UNLOCK}</span>
            <div class="metrics-model-fact-body">
              <div class="metrics-model-fact-label">Status</div>
              <div class="metrics-model-fact-value">${lockedCopy}</div>
            </div>
          </div>
          <div class="metrics-model-fact">
            <span class="metrics-model-fact-icon">${ICON_HASH}</span>
            <div class="metrics-model-fact-body">
              <div class="metrics-model-fact-label">Version</div>
              <div class="metrics-model-fact-value">v${account.metricsModelVersion || 1}</div>
            </div>
          </div>
        </div>
        <div class="metrics-model-actions">
          <button class="admin-btn" type="button" onclick="startMetricsModelChange()">${ICON_EDIT} Change metrics model</button>
        </div>
      </div>
    `;
  }

  return `
    <div class="metrics-model-panel${wizardClass}">
      <div class="metrics-model-header">
        <div class="metrics-model-heading">
          <h3 class="metrics-model-title">${metricsModelChangeMode ? 'Change metrics model' : 'Metrics model'}</h3>
        </div>
      </div>
      <p class="metrics-model-copy">How should wins and revenue be counted for this client?</p>
      <div class="metrics-option-cards">
        <label class="metrics-option-card">
          <input type="radio" name="metrics-model-type" value="simple" ${initialMode === 'simple' ? 'checked' : ''} onchange="onMetricsModelTypeChange()" />
          <span class="metrics-option-card-top">
            <span class="metrics-option-card-icon">${ICON_LAYER}</span>
            <span class="metrics-option-card-title">Simple</span>
            <span class="metrics-option-card-radio">${ICON_CHECK}</span>
          </span>
          <span class="metrics-option-card-desc">Every won deal counts, from any pipeline. For clients without duplicate opportunities.</span>
        </label>
        <label class="metrics-option-card">
          <input type="radio" name="metrics-model-type" value="dedupe" ${initialMode === 'dedupe' ? 'checked' : ''} onchange="onMetricsModelTypeChange()" />
          <span class="metrics-option-card-top">
            <span class="metrics-option-card-icon">${ICON_MERGE}</span>
            <span class="metrics-option-card-title">Funnel + dedup</span>
            <span class="metrics-option-card-radio">${ICON_CHECK}</span>
          </span>
          <span class="metrics-option-card-desc">Wins count from one win pipeline only (e.g. Eftersalg). Duplicates are merged by contact.</span>
        </label>
      </div>
      <div class="metrics-model-win-select" id="metrics-win-pipeline-wrap" style="${initialMode === 'dedupe' ? '' : 'display:none'}">
        ${renderPipelineSelect('metrics-win-pipeline', 'Win pipeline (required)', account.winPipelineId || account.afterSalesPipelineId, setupPipelines)}
      </div>
      ${metricsModelChangeMode ? `
        <div class="metrics-confirm-strip">
          <div class="metrics-confirm-strip-title">${ICON_WARNING} Applying this recalculates revenue, clients won and all charts</div>
          <div class="metrics-confirm-strip-row">
            <label class="metrics-confirm-check">
              <input id="metrics-acknowledge-impact" type="checkbox" onchange="updateMetricsApplyState()" />
              <span>I understand the numbers will change</span>
            </label>
            <input id="metrics-confirm-slug" type="text" placeholder="Type ${CLIENT_SLUG} to confirm" autocomplete="off" oninput="updateMetricsApplyState()" />
          </div>
        </div>
      ` : ''}
      <div class="metrics-model-actions">
        ${metricsModelChangeMode ? `<button class="admin-btn" type="button" onclick="cancelMetricsModelChange()">Cancel</button>` : ''}
        <button
          id="metrics-apply-btn"
          class="admin-btn ${metricsModelChangeMode ? 'admin-btn--danger-solid' : 'admin-btn--primary'}"
          type="button"
          onclick="saveMetricsModel()"
          ${metricsModelChangeMode ? 'disabled' : ''}
        >
          ${ICON_CHECK} ${metricsModelChangeMode ? 'Apply change' : 'Save metrics model'}
        </button>
      </div>
    </div>
  `;
}

function updateMetricsApplyState() {
  const btn = document.getElementById('metrics-apply-btn');
  if (!btn || !metricsModelChangeMode) return;
  const ack = Boolean(document.getElementById('metrics-acknowledge-impact')?.checked);
  const slug = document.getElementById('metrics-confirm-slug')?.value?.trim() || '';
  btn.disabled = !(ack && slug === CLIENT_SLUG);
}

function onMetricsModelTypeChange() {
  const mode = document.querySelector('input[name="metrics-model-type"]:checked')?.value;
  const wrap = document.getElementById('metrics-win-pipeline-wrap');
  if (wrap) wrap.style.display = mode === 'dedupe' ? '' : 'none';
}

async function saveMetricsModel() {
  const mode = document.querySelector('input[name="metrics-model-type"]:checked')?.value || 'simple';
  const dedupeEnabled = mode === 'dedupe';
  const winPipelineId = dedupeEnabled
    ? (document.getElementById('metrics-win-pipeline')?.value || null)
    : null;

  if (dedupeEnabled && !winPipelineId) {
    showToast('Select a win pipeline for deduplication mode.', 'error');
    return;
  }

  const payload = {
    dedupeEnabled,
    winPipelineId,
    afterSalesPipelineId: dedupeEnabled ? winPipelineId : undefined,
  };

  if (metricsModelChangeMode) {
    payload.confirmSlug = document.getElementById('metrics-confirm-slug')?.value?.trim() || '';
    payload.acknowledgeImpact = Boolean(document.getElementById('metrics-acknowledge-impact')?.checked);
  }

  try {
    await adminFetch(`/api/clients/${encodeURIComponent(CLIENT_SLUG)}/metrics-model`, {
      method: 'POST',
      body: JSON.stringify(payload),
    });
    metricsModelChangeMode = false;
    showToast('Metrics model saved', 'success');
    await loadSetupAccount();
    if (accountCanPreviewDashboard(setupAccount)) {
      loadDashboard(true, { background: true });
    }
  } catch (error) {
    showToast(error.message, 'error');
  }
}

function startMetricsModelChange() {
  metricsModelChangeMode = true;
  if (setupAccount) {
    const panel = document.getElementById('setup-panel-mount');
    if (panel) panel.innerHTML = renderClientSetupPanel(setupAccount);
  }
}

function cancelMetricsModelChange() {
  metricsModelChangeMode = false;
  if (setupAccount) {
    const panel = document.getElementById('setup-panel-mount');
    if (panel) panel.innerHTML = renderClientSetupPanel(setupAccount);
  }
}

function renderPipelineSelect(id, label, value, pipelines, hint = '') {
  return `
    <div class="field-group">
      <label for="${id}">${label}</label>
      <select id="${id}">
        <option value="">— Select pipeline —</option>
        ${pipelines.map((pipeline) => `
          <option value="${esc(pipeline.id)}" ${pipeline.id === value ? 'selected' : ''}>${esc(pipeline.name)}</option>
        `).join('')}
      </select>
      ${hint ? `<p class="field-hint">${esc(hint)}</p>` : ''}
    </div>
  `;
}

function getSetupProgressSteps(account) {
  return [
    {
      id: 'metrics',
      label: 'Metrics',
      done: Boolean(account.metricsModelSetAt),
    },
    {
      id: 'ghl',
      label: 'GHL',
      done: Boolean(account.hasGhlToken && account.locationId),
    },
    {
      id: 'pipelines',
      label: 'Pipelines',
      done: Boolean(account.newLeadsPipelineId && account.salesPipelineId),
    },
    {
      id: 'meta',
      label: 'Meta',
      done: account.metaSyncStatus === 'ok',
      partial: Boolean(account.metaAdAccountId && account.metaSyncStatus !== 'ok'),
    },
  ];
}

function renderSetupProgressStrip(account) {
  const steps = getSetupProgressSteps(account);
  const checkIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>';
  return `
    <nav class="setup-progress" aria-label="Setup progress">
      ${steps.map((step, index) => {
        const stateClass = step.done ? ' is-done' : (step.partial ? ' is-partial' : '');
        const mark = step.done
          ? `<span class="setup-progress-mark">${checkIcon}</span>`
          : `<span class="setup-progress-mark">${index + 1}</span>`;
        return `
          <button type="button" class="setup-progress-step${stateClass}" onclick="scrollToSetupSection('${step.id}')">
            ${mark}
            <span class="setup-progress-label">${step.label}</span>
          </button>
        `;
      }).join('')}
    </nav>
  `;
}

function scrollToSetupSection(sectionId) {
  const target = document.getElementById(`setup-section-${sectionId}`);
  if (!target) return;
  target.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function renderMetaSetupSection(account) {
