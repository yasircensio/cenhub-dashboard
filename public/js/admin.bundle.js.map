function refreshClientFacingTopbar() {
  if (!IS_REPORT_VIEW && !IS_CLIENT_VIEW) return;
  const existing = document.querySelector('#dashboard > .brand-topbar');
  if (!existing) return;
  const wrap = document.createElement('div');
  wrap.innerHTML = renderAppTopbar().trim();
  const header = wrap.firstElementChild;
  if (header) existing.replaceWith(header);
}

