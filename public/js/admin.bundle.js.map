  }

  dashboard.innerHTML = `
    ${renderBrandTopbar()}
    ${wrapDashboardShell(`
    <div class="auth-page">
      <div class="auth-card">
        <div class="auth-card-header">
          <div class="auth-card-title-row">
            <div class="auth-card-icon" aria-hidden="true">${ICON_AUTH_LOCK}</div>
            <h1>Staff login</h1>
          </div>
          <p>Manage client dashboards and admin settings.</p>
        </div>
