async function toggleFbLeadSyncEnabled(clientId, enabled) {
  try {
    await adminFetch(`/api/clients/${encodeURIComponent(clientId)}`, {
      method: 'PUT',
      body: JSON.stringify({ fbLeadSyncEnabled: enabled }),
    });
    showToast(enabled ? 'Automatic FB lead sync enabled' : 'Automatic FB lead sync disabled', 'success');
    const client = fbLeadSyncState.clients.find((row) => row.clientId === clientId);
    if (client) client.fbLeadSyncEnabled = enabled;
  } catch (error) {
    showToast(error.message || 'Failed to update auto-sync setting.', 'error');
    await loadFbLeadSyncPage({ silent: true });
  }
}

function bindFbLeadSyncToggles() {
  document.querySelectorAll('[data-fb-sync-toggle]').forEach((input) => {
    input.onchange = () => toggleFbLeadSyncEnabled(input.dataset.fbSyncToggle, input.checked);
  });
}

async function loadFbLeadPreflightForClients(clients, { quick = false } = {}) {
  const suffix = quick ? '&quick=1' : '';
  await Promise.all((clients || []).map(async (client) => {
    const prev = fbLeadSyncState.preflightByClient[client.clientId] || {};
    try {
      const next = await adminFetch(
        `/api/fb-lead-sync/preflight?client=${encodeURIComponent(client.clientId)}${suffix}`,
      );
      fbLeadSyncState.preflightByClient[client.clientId] = quick
        ? {
          ...next,
          metaLeadCount90d: next.metaLeadCount90d ?? prev.metaLeadCount90d ?? null,
          estimatedMissing: next.estimatedMissing ?? prev.estimatedMissing ?? null,
          sampleSize: next.sampleSize || prev.sampleSize || 0,
          sampleWouldUpdate: next.sampleWouldUpdate ?? prev.sampleWouldUpdate ?? 0,
        }
        : next;
    } catch (error) {
      fbLeadSyncState.preflightByClient[client.clientId] = {
        ...prev,
        preflightError: error.message,
      };
    }
  }));
}

function scheduleFbLeadFullPreflight(clients) {
  if (!clients?.length) return;
  loadFbLeadPreflightForClients(clients, { quick: false })
    .then(() => refreshFbLeadClientRowsUi())
    .catch(() => {});
}

async function loadFbLeadHistory(limit = 50) {
  const data = await adminFetch(`/api/fb-lead-sync/history?limit=${limit}`);
  fbLeadSyncState.historyRuns = data.runs || [];
  return data;
}

function renderFbLeadRunPanel(clientId, mode = 'recent') {
  const client = fbLeadSyncState.clients.find((row) => row.clientId === clientId);
  const ready = clientHasReadyPreview(client);
  const modeLabel = mode === 'backfill' ? 'Backfill (90 days)' : 'Recent (2 days)';
  return `
    <div class="fb-lead-run-panel" id="fb-lead-run-panel">
      <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start">
        <div>
          <strong>${esc(client?.accountName || clientId)}</strong>
          <div style="color:var(--text-soft);font-size:13px;margin-top:4px">${esc(modeLabel)}</div>
        </div>
        <button class="admin-btn admin-btn--ghost" type="button" onclick="closeFbLeadRunPanel()">Close</button>
      </div>
      ${mode === 'backfill' && ready
        ? '<div class="fb-lead-banner" style="margin-top:12px;margin-bottom:0;background:#e8f7ef;border-color:#b8e6cf;color:#138b53">Preview complete — use <strong>Apply</strong> on that run in <strong>Run history</strong> below.</div>'
        : (mode === 'backfill' && clientPreviewAllSynced(client)
          ? '<div class="fb-lead-banner" style="margin-top:12px;margin-bottom:0;background:#e8f7ef;border-color:#b8e6cf;color:#138b53">All contacts already have <strong>Fb Lead id</strong> — nothing to apply.</div>'
          : (mode === 'backfill' ? '<div class="fb-lead-banner" style="margin-top:12px;margin-bottom:0">Run Preview first. Backfill only matches leads Meta still has (~90 days).</div>' : ''))}
      <div class="fb-lead-run-actions">
        <button class="admin-btn admin-btn--secondary" type="button" id="fb-lead-preview-btn">Preview (dry run)</button>
      </div>
      <div class="fb-lead-progress-wrap" id="fb-lead-progress-wrap" hidden>
        <div class="fb-lead-progress-label" id="fb-lead-progress-label">Starting…</div>
        <div class="fb-lead-progress" id="fb-lead-progress">
          <div class="fb-lead-progress-bar" id="fb-lead-progress-bar"></div>
        </div>
      </div>
      <div id="fb-lead-run-results" style="margin-top:12px"></div>
    </div>
  `;
}

function closeFbLeadRunPanel() {
  const mount = document.getElementById('fb-lead-run-panel-mount');
  if (mount) mount.innerHTML = '';
  fbLeadSyncState.activeRun = null;
}

function openFbLeadRunPanel(clientId, mode) {
  const client = fbLeadSyncState.clients.find((row) => row.clientId === clientId);
  if (!clientFbLeadFieldReady(client)) {
    showToast(getClientFbLeadFieldHint(client), 'error');
    return;
  }
  const mount = document.getElementById('fb-lead-run-panel-mount');
  if (!mount) return;
  fbLeadSyncState.activeRun = {
    clientId,
    mode,
    runId: null,
    previewOk: clientHasReadyPreview(fbLeadSyncState.clients.find((row) => row.clientId === clientId)),
  };
  mount.innerHTML = renderFbLeadRunPanel(clientId, mode);
  const previewBtn = document.getElementById('fb-lead-preview-btn');
  if (previewBtn) previewBtn.onclick = () => runFbLeadSyncBatch({ clientId, mode, dryRun: true });
  mount.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function renderFbLeadRunResults(summary) {
  const rows = summary.rows || [];
  if (!rows.length) {
    return `<div class="sync-history-empty" style="padding:12px">No rows in this batch.</div>`;
  }
  const body = rows.map((row) => `
    <tr>
      <td>${esc(row.email || row.phone || '—')}</td>
      <td><code>${esc(row.metaLeadId || '—')}</code></td>
      <td>${esc(row.contactId || '—')}</td>
      <td>${renderSyncStatusBadge(row.status)}</td>
    </tr>
  `).join('');
  const processed = summary.nextBatchOffset ?? ((summary.batchOffset || 0) + (summary.batchProcessed || 0));
  const total = summary.inWindow || processed;
  return `
    <div class="fb-lead-audit-scroll">
      <table class="sync-history-table">
        <thead><tr><th>Email / phone</th><th>Meta lead id</th><th>GHL contact</th><th>Status</th></tr></thead>
        <tbody>${body}</tbody>
      </table>
    </div>
    <p style="color:var(--text-soft);font-size:12px;margin-top:8px">
      ${processed} / ${total} leads scanned · ${summary.updated || 0} would update/updated · ${summary.errors || 0} errors
    </p>
  `;
}

function renderGlobalApplyProgress(clientId, mode, contactCount = 0) {
  const client = fbLeadSyncState.clients.find((row) => row.clientId === clientId);
  const modeLabel = mode === 'backfill' ? '90-day backfill' : 'recent sync';
  const countLabel = contactCount > 0 ? `${contactCount} contact(s)` : 'contacts';
  return `
    <div class="fb-lead-apply-progress-card" id="fb-lead-global-progress-card">
      <div class="fb-lead-apply-progress-header">
        <div>
          <strong>Writing to GHL — ${esc(modeLabel)}</strong>
          <div class="fb-lead-apply-progress-sub">${esc(client?.accountName || clientId)} · ${esc(countLabel)}</div>
        </div>
        <span class="fb-lead-badge is-ok" id="fb-lead-apply-status-badge">Running</span>
      </div>
      <div class="fb-lead-apply-progress-stats" id="fb-lead-global-progress-stats">Preparing…</div>
      <div class="fb-lead-progress is-visible is-indeterminate" id="fb-lead-global-progress">
        <div class="fb-lead-progress-bar" id="fb-lead-global-progress-bar"></div>
      </div>
      <div class="fb-lead-progress-label" id="fb-lead-global-progress-label">Starting apply — do not close this page</div>
    </div>
  `;
}

function startGlobalApplyProgress(clientId, mode, contactCount = 0) {
  const mount = document.getElementById('fb-lead-apply-progress-mount');
  if (!mount) return;
  fbLeadSyncState.isApplying = true;
  fbLeadSyncState.applyStartedAt = Date.now();
  fbLeadSyncState.applyProgress = null;
  mount.innerHTML = renderGlobalApplyProgress(clientId, mode, contactCount);
  mount.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  if (fbLeadSyncState.applyWaitTimer) clearInterval(fbLeadSyncState.applyWaitTimer);
  fbLeadSyncState.applyWaitTimer = window.setInterval(() => {
    if (!fbLeadSyncState.isApplying) return;
    const elapsed = Math.floor((Date.now() - fbLeadSyncState.applyStartedAt) / 1000);
    const saved = fbLeadSyncState.applyProgress;
    if (saved?.total > 0) {
      updateGlobalApplyProgress({ ...saved, waiting: true, elapsed });
    } else {
      updateGlobalApplyProgress({ waiting: true, elapsed });
    }
  }, 1000);
}

function updateGlobalApplyProgress({
  processed,
  total,
  written,
  waiting = false,
  elapsed = 0,
  complete = false,
  error = '',
} = {}) {
  const card = document.getElementById('fb-lead-global-progress-card');
  const progress = document.getElementById('fb-lead-global-progress');
  const bar = document.getElementById('fb-lead-global-progress-bar');
  const label = document.getElementById('fb-lead-global-progress-label');
  const stats = document.getElementById('fb-lead-global-progress-stats');
  const badge = document.getElementById('fb-lead-apply-status-badge');
  if (!card || !progress || !bar || !label) return;

  const prev = fbLeadSyncState.applyProgress || {};
  const nextProcessed = processed ?? prev.processed ?? 0;
  const nextTotal = total ?? prev.total ?? 0;
  const nextWritten = written ?? prev.written ?? 0;

  if (!complete && !error && (nextTotal > 0 || nextProcessed > 0)) {
    fbLeadSyncState.applyProgress = {
      processed: nextProcessed,
      total: nextTotal,
      written: nextWritten,
    };
  }

  const hasProgress = nextTotal > 0 || nextProcessed > 0;

  if (waiting && !hasProgress && !complete) {
    progress.classList.add('is-indeterminate');
    bar.style.width = '35%';
    if (stats) stats.textContent = 'Contacting Meta and GHL…';
    label.textContent = `Writing to GHL… (${elapsed}s — do not close this page)`;
    return;
  }

  progress.classList.remove('is-indeterminate');
  const pct = nextTotal > 0
    ? Math.min(100, Math.round((nextProcessed / nextTotal) * 100))
    : (complete ? 100 : 0);
  bar.style.width = `${pct}%`;
  if (stats) {
    stats.textContent = complete
      ? `${nextWritten} written to GHL · ${nextProcessed} / ${nextTotal} contacts processed`
      : `${nextWritten} written · ${nextProcessed} / ${nextTotal} contacts (${pct}%)`;
  }
  if (complete) {
    card.classList.add('is-complete');
    card.classList.remove('is-error');
    label.textContent = `Complete — ${nextWritten} contact(s) updated in GHL`;
    if (badge) {
      badge.textContent = 'Complete';
      badge.classList.add('is-ok');
      badge.classList.remove('is-missing');
    }
  } else if (error) {
    card.classList.add('is-error');
    card.classList.remove('is-complete');
    label.textContent = error;
    if (badge) {
      badge.textContent = 'Failed';
      badge.classList.remove('is-ok');
      badge.classList.add('is-missing');
    }
  } else if (waiting && hasProgress) {
    label.textContent = nextProcessed >= nextTotal
      ? `Finishing up… (${elapsed}s)`
      : `Batch in progress — ${nextProcessed} / ${nextTotal} leads (${pct}%) · ${elapsed}s`;
  } else {
    label.textContent = `Writing to GHL — ${nextProcessed} / ${nextTotal} leads (${pct}%)`;
  }
}

function stopGlobalApplyProgress({ success = true, keepVisibleMs = 6000 } = {}) {
  fbLeadSyncState.isApplying = false;
  fbLeadSyncState.applyProgress = null;
  if (fbLeadSyncState.applyWaitTimer) {
    clearInterval(fbLeadSyncState.applyWaitTimer);
    fbLeadSyncState.applyWaitTimer = null;
  }
  window.setTimeout(() => {
    const mount = document.getElementById('fb-lead-apply-progress-mount');
    if (mount && !fbLeadSyncState.isApplying) mount.innerHTML = '';
  }, keepVisibleMs);
}

function setFbLeadProgress({ processed = 0, total = 0, complete = false, label = '' } = {}) {
  const wrap = document.getElementById('fb-lead-progress-wrap');
  const progressBar = document.getElementById('fb-lead-progress-bar');
  const progressLabel = document.getElementById('fb-lead-progress-label');
  if (!wrap || !progressBar) return;
  wrap.hidden = false;
  wrap.classList.toggle('is-complete', complete);
  const pct = total > 0 ? Math.min(100, Math.round((processed / total) * 100)) : (complete ? 100 : 0);
  progressBar.style.width = `${pct}%`;
  if (progressLabel) {
    progressLabel.textContent = label
      || (complete
        ? `Complete — ${processed} / ${total} leads (${pct}%)`
        : `Processing — ${processed} / ${total} leads (${pct}%)`);
  }
}

function hideFbLeadProgress(reset = true) {
  const wrap = document.getElementById('fb-lead-progress-wrap');
  const progressBar = document.getElementById('fb-lead-progress-bar');
  if (!wrap) return;
  if (reset) {
    wrap.hidden = true;
    wrap.classList.remove('is-complete');
    if (progressBar) progressBar.style.width = '0%';
  }
}

function updateFbLeadHistoryClearButton() {
  const clearBtn = document.getElementById('fb-lead-history-clear-all');
  if (!clearBtn) return;
  const hasRuns = (fbLeadSyncState.historyRuns || []).length > 0;
  clearBtn.disabled = !hasRuns;
}

function updateFbLeadCronSummaryUi() {
  const mount = document.getElementById('fb-lead-cron-summary-24h');
  if (!mount || !fbLeadSyncState.cronSummary24h) return;
  mount.outerHTML = renderFbLeadCronSummary24h(fbLeadSyncState.cronSummary24h);
}

async function refreshFbLeadHistoryUi() {
  await loadFbLeadHistory();
  const historyMount = document.getElementById('fb-lead-history-mount');
  if (!historyMount) return;
  const locationByClient = Object.fromEntries(
    fbLeadSyncState.clients.map((row) => [row.clientId, row.locationId]),
  );
  historyMount.innerHTML = renderFbLeadHistoryRows(fbLeadSyncState.historyRuns, locationByClient);
  updateFbLeadHistoryClearButton();
}

function bindFbLeadHistoryClearButton() {
  const clearBtn = document.getElementById('fb-lead-history-clear-all');
  if (clearBtn) clearBtn.onclick = () => clearFbLeadSyncHistory();
  const routineToggle = document.getElementById('fb-lead-show-routine-cron');
  if (routineToggle) {
    routineToggle.checked = fbLeadSyncState.showRoutineCronRuns;
    routineToggle.onchange = () => {
      fbLeadSyncState.showRoutineCronRuns = routineToggle.checked;
      const historyMount = document.getElementById('fb-lead-history-mount');
      if (!historyMount) return;
      const locationByClient = Object.fromEntries(
        fbLeadSyncState.clients.map((row) => [row.clientId, row.locationId]),
      );
      historyMount.innerHTML = renderFbLeadHistoryRows(fbLeadSyncState.historyRuns, locationByClient);
    };
  }
  updateFbLeadHistoryClearButton();
}

async function clearFbLeadSyncHistory() {
  if (!isStaffAdmin()) return;
  const confirmed = window.confirm(
    'Delete all FB lead sync run history?\n\nThis only clears the log — it does not change GHL contacts or Meta data.',
  );
  if (!confirmed) return;
  try {
    const result = await adminFetch('/api/fb-lead-sync/history', { method: 'DELETE' });
    showToast(`Cleared ${result.deleted || 0} run(s).`, 'success');
    await refreshFbLeadHistoryUi();
    await loadFbLeadSyncPage({ silent: true });
  } catch (error) {
    showToast(error.message || 'Failed to clear FB lead sync log.', 'error');
  }
}

async function deleteFbLeadRun(runId) {
  if (!isStaffAdmin()) return;
  const confirmed = window.confirm(`Delete run #${runId} from history?`);
  if (!confirmed) return;
  try {
    await adminFetch(`/api/fb-lead-sync/history/${runId}`, { method: 'DELETE' });
    showToast('Run deleted.', 'success');
    await refreshFbLeadHistoryUi();
    await loadFbLeadSyncPage({ silent: true });
  } catch (error) {
    showToast(error.message || 'Failed to delete run.', 'error');
  }
}

async function runFbLeadSyncBatch({ clientId, mode, dryRun, resumeRunId = null }) {
  const previewBtn = document.getElementById('fb-lead-preview-btn');
  const resultsMount = document.getElementById('fb-lead-run-results');
  if (previewBtn) previewBtn.disabled = true;

  const batchLimit = dryRun ? 12 : 10;
  const resumeRun = resumeRunId != null
    ? fbLeadSyncState.historyRuns.find((row) => Number(row.id) === Number(resumeRunId))
    : null;
  let runId = resumeRun?.id || fbLeadSyncState.activeRun?.runId || null;
  let offset = resumeRun ? (Number(resumeRun.batchOffset) || 0) : 0;
  let lastSummary = null;
  let allRows = [];
  let completed = false;
  const applyRunId = resumeRunId ?? fbLeadSyncState.activeRun?.previewRunId ?? null;
  const previewRun = applyRunId != null
    ? fbLeadSyncState.historyRuns.find((row) => Number(row.id) === Number(applyRunId))
    : null;
  const expectedContacts = resumeRun
    ? partialSyncRemaining(resumeRun)
    : (previewRun?.updated
      ?? fbLeadSyncState.previewOkByClient[clientId]?.updated
      ?? 0);

  if (!dryRun) {
    fbLeadSyncState.applyingRunId = applyRunId;
    startGlobalApplyProgress(clientId, mode, expectedContacts);
    await refreshFbLeadHistoryUi();
  }

  try {
    if (!resumeRunId) {
      const partial = findPartialSyncRun(clientId, mode, dryRun);
      if (partial) {
        const remaining = partialSyncRemaining(partial);
        const label = dryRun ? 'preview' : 'apply';
        const confirmed = window.confirm(
          `A ${label} for ${clientId} was interrupted (${partial.updated || 0} processed, ${remaining} remaining).\n\n`
          + `Resume the interrupted ${label}?`,
        );
        if (confirmed) {
          runId = partial.id;
          offset = Number(partial.batchOffset) || 0;
        }
      }
    }

    if (dryRun) {
      setFbLeadProgress({ processed: offset, total: 0, label: offset > 0 ? 'Resuming preview…' : 'Fetching Meta leads…' });
    } else {
      updateGlobalApplyProgress({ waiting: true, elapsed: 0 });
    }

    if (dryRun && offset === 0) {
      const prepared = await adminFetchWithRetry('/api/fb-lead-sync/prepare', {
        method: 'POST',
        body: JSON.stringify({
          clientId,
          mode,
          dryRun,
          runId,
        }),
      });
      const prep = prepared.summary || prepared;
      runId = prep.runId;
      offset = 0;
      setFbLeadProgress({
        processed: 0,
        total: prep.inWindow || 0,
        label: `Matching ${prep.inWindow || 0} Meta leads to GHL…`,
      });
    } else if (!dryRun && offset === 0) {
      updateGlobalApplyProgress({
        waiting: false,
        processed: 0,
        total: expectedContacts || previewRun?.updated || 0,
      });
    }

    do {
      lastSummary = await adminFetchWithRetry('/api/fb-lead-sync/run', {
        method: 'POST',
        body: JSON.stringify({
          clientId,
          mode,
          dryRun,
          runId,
          previewRunId: dryRun ? null : applyRunId,
          batchOffset: offset,
          batchLimit,
        }),
      });
      const summary = lastSummary.summary || lastSummary;
      runId = summary.runId;
      offset = summary.nextBatchOffset ?? (summary.batchOffset + (summary.batchProcessed || 0));
      allRows = allRows.concat(summary.rows || []);
      if (fbLeadSyncState.activeRun) {
        fbLeadSyncState.activeRun.runId = runId;
      }
      const total = summary.inWindow || offset || expectedContacts;
      if (dryRun) {
        setFbLeadProgress({
          processed: offset,
          total,
          complete: !summary.hasMore,
        });
        if (resultsMount) {
          resultsMount.innerHTML = renderFbLeadRunResults({ ...summary, rows: allRows });
        }
      } else {
        updateGlobalApplyProgress({
          processed: offset,
          total,
          written: summary.updated || 0,
          complete: !summary.hasMore,
        });
      }
    } while ((lastSummary.summary || lastSummary).hasMore);

    completed = true;
    const finalSummary = lastSummary.summary || lastSummary;
    const finalTotal = finalSummary.inWindow || offset || expectedContacts;
    const finalProcessed = finalSummary.nextBatchOffset ?? offset;

    if (dryRun) {
      setFbLeadProgress({
        processed: finalProcessed,
        total: finalTotal,
        complete: true,
      });
      markFbLeadPreviewReady(clientId, mode, finalSummary.updated);
      if (fbLeadSyncState.activeRun) {
        fbLeadSyncState.activeRun.previewOk = (finalSummary.updated || 0) > 0;
      }
      showToast(
        (finalSummary.updated || 0) > 0
          ? 'Preview complete — use Apply in Run history below.'
          : 'Preview complete — all contacts already have Fb Lead id. Nothing to apply.',
        'success',
      );
      await refreshFbLeadHistoryUi();
      document.getElementById('fb-lead-history-mount')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      updateGlobalApplyProgress({
        processed: finalProcessed,
        total: finalTotal,
        written: finalSummary.updated || 0,
        complete: true,
      });
      delete fbLeadSyncState.previewOkByClient[clientId];
      try {
        const stored = JSON.parse(sessionStorage.getItem('fbLeadSyncPreviewOk') || '{}');
        delete stored[clientId];
        sessionStorage.setItem('fbLeadSyncPreviewOk', JSON.stringify(stored));
      } catch {
        // ignore
      }
      showToast('FB lead sync complete — Fb Lead id written to GHL', 'success');
      stopGlobalApplyProgress({ success: true });
    }
    await refreshFbLeadHistoryUi();
    const dash = await adminFetch('/api/fb-lead-sync');
    fbLeadSyncState.clients = dash.clients || [];
    hydrateFbLeadPreviewState(fbLeadSyncState.clients);
    await refreshFbLeadClientRowsUi();
  } catch (error) {
    if (dryRun) {
      hideFbLeadProgress(true);
    } else {
      updateGlobalApplyProgress({
        error: `Failed — ${error.message || 'Apply failed'}`,
      });
      stopGlobalApplyProgress({ success: false, keepVisibleMs: 12000 });
    }
    showToast(
      (error.message || (dryRun ? 'FB lead preview failed.' : 'FB lead apply failed.'))
      + (dryRun ? ' Partial progress is saved — use Resume in Run history or try Preview again.' : ' Partial progress is saved — use Resume in Run history.'),
      'error',
    );
    await refreshFbLeadHistoryUi();
  } finally {
    if (previewBtn) previewBtn.disabled = false;
    fbLeadSyncState.applyingRunId = null;
    if (!completed && dryRun) {
      hideFbLeadProgress(true);
    }
    if (!dryRun && !completed) {
      fbLeadSyncState.isApplying = false;
      await refreshFbLeadHistoryUi();
    }
  }
}

async function expandFbLeadRun(runId) {
  const row = document.getElementById(`fb-lead-run-audit-${runId}`);
  if (!row) return;
  if (!row.hidden) {
    row.hidden = true;
    return;
  }
  try {
    const data = await adminFetch(`/api/fb-lead-sync/history/${runId}`);
    const client = fbLeadSyncState.clients.find((item) => item.clientId === data.run.clientId);
    row.innerHTML = `<td colspan="7"><div class="fb-lead-audit-scroll" id="fb-lead-audit-scroll-${runId}">${renderFbLeadAuditTable(data.run.rows || [], data.run.locationId || client?.locationId)}</div></td>`;
    row.hidden = false;
    const scrollHost = document.getElementById(`fb-lead-audit-scroll-${runId}`);
    if (scrollHost) {
      scrollHost.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  } catch (error) {
    showToast(error.message || 'Failed to load run audit.', 'error');
  }
}

function viewFbLeadClientHistory(clientId) {
  const filtered = getFbLeadHistoryRunsForDisplay(
    fbLeadSyncState.historyRuns.filter((run) => run.clientId === clientId),
  );
  const historyMount = document.getElementById('fb-lead-history-mount');
  if (!historyMount) return;
  const locationByClient = Object.fromEntries(
    fbLeadSyncState.clients.map((row) => [row.clientId, row.locationId]),
  );
  historyMount.innerHTML = filtered.length
    ? renderFbLeadHistoryRows(filtered, locationByClient)
    : `<div class="sync-history-empty">No runs for ${esc(clientId)} yet.</div>`;
  historyMount.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

async function loadFbLeadSyncPage({ silent = false, fullPreflight = false } = {}) {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard) return;

  const user = await fetchStaffMe();
  if (!user) {
    if (!silent) {
      dashboard.innerHTML = `
        ${renderBrandTopbar('')}
        ${wrapDashboardShell(`
          <div class="page-hero admin-hub-hero"><h1>FB lead sync</h1><p>Sign in to manage FB lead ID sync.</p></div>
          <div class="sync-history-page">
            <div class="sync-history-empty" style="padding:24px;text-align:center">
              <a class="admin-btn admin-btn--primary" href="/login?next=${encodeURIComponent(`${window.location.pathname}${window.location.search}`)}">Sign in</a>
            </div>
          </div>
        `)}
      `;
    }
    return;
  }
  currentStaffUser = user;

  if (!silent) {
    dashboard.innerHTML = `
      ${renderBrandTopbar(renderStaffAdminChrome('fb-lead-sync'))}
      ${wrapDashboardShell('<div class="loading-state"><div class="spinner"></div><p>Loading FB lead sync...</p></div>')}
    `;
  }

  try {
    if (silent && fbLeadSyncState.isApplying) return;

    const [data] = await Promise.all([
      adminFetch('/api/fb-lead-sync'),
      loadFbLeadHistory(),
    ]);
    fbLeadSyncState.clients = data.clients || [];
    fbLeadSyncState.cronSummary24h = data.summary?.cronSummary24h || null;
    hydrateFbLeadPreviewState(fbLeadSyncState.clients);

    if (!silent) {
      dashboard.innerHTML = renderFbLeadSyncPage(data);
      bindFbLeadSyncToggles();
      const refreshBtn = document.getElementById('fb-lead-sync-refresh');
      if (refreshBtn) {
        refreshBtn.onclick = () => loadFbLeadSyncPage({ fullPreflight: true });
      }
      bindFbLeadHistoryClearButton();
      if (fbLeadSyncRefreshTimer) {
        clearInterval(fbLeadSyncRefreshTimer);
        fbLeadSyncRefreshTimer = null;
      }
      fbLeadSyncRefreshTimer = window.setInterval(() => {
        loadFbLeadSyncPage({ silent: true }).catch(() => {});
      }, 60_000);
    }

    if (!silent || fullPreflight) {
      await loadFbLeadPreflightForClients(fbLeadSyncState.clients, { quick: !fullPreflight });
    }
    if (silent) {
      updateFbLeadCronSummaryUi();
      await refreshFbLeadHistoryUi();
      await refreshFbLeadClientRowsUi();
    } else {
      await refreshFbLeadClientRowsUi();
    }

    if (fullPreflight) {
      await loadFbLeadPreflightForClients(fbLeadSyncState.clients, { quick: false });
      await refreshFbLeadClientRowsUi();
    } else if (!silent) {
      scheduleFbLeadFullPreflight(fbLeadSyncState.clients);
    }
  } catch (error) {
    if (!silent) {
      dashboard.innerHTML = `
        ${renderBrandTopbar(renderStaffAdminChrome('fb-lead-sync'))}
        ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
      `;
    }
  }
}

const metaReportsState = {
  filter: 'all',
  searchQuery: '',
  dashboardData: null,
  hubMounted: false,
  clientPayload: null,
  clientPageMounted: false,
  clientReportSettingsExpanded: false,
  clientShareExpanded: false,
  clientExcelSheetExpanded: false,
  clientToplineDraftMode: null,
  clientToplineModalPayload: null,
  activeMonthKey: null,
  selectedYear: new Date().getFullYear(),
  publicPayload: null,
  publicPageMounted: false,
  chartInstances: { roas: null, poas: null },
  chartScatterInstances: { roas: null, poas: null },
  chartTab: 'trend',
  chartRoasMode: 'kr',
  chartPoasMode: 'kr',
  chartScatterRoasMode: 'kr',
  chartScatterPoasMode: 'kr',
  chartScenarioRoasMode: 'x',
  chartScenarioPoasMode: 'x',
  chartSeries: null,
  scenarioSeries: null,
  scenarioSourcePayload: null,
  chartDemo: false,
  chartProjection: null,
  spendChartType: 'area',
  scenarioChartInstances: { roas: null, poas: null },
  budgetMultiplier: 2,
  budgetBaseline: 'year',
  scenarioMonthWindow: '6',
  scenarioSmoothUneven: true,
  scenarioBlendHistory: false,
  scenarioIncludeTrend: false,
  comparisonMode: 'mom',
  comparisonPeriodA: { startDate: null, endDate: null },
  comparisonPeriodB: { startDate: null, endDate: null },
  comparisonChartMode: 'kr',
  comparisonTab: 'table',
  reportViewMode: 'monthly',
  comparisonYearCache: {},
  comparisonResult: null,
  comparisonLoading: false,
  comparisonDatePickers: [],
  comparisonMonthMenuListenerBound: false,
  comparisonChartInstance: null,
  customValues: {
    mounted: false,
    overview: null,
    searchQuery: '',
    selectedClientId: null,
    selectedMonthKey: null,
    editorPayload: null,
    draftInputs: null,
    loadingEditor: false,
    saving: false,
    settingsSaving: false,
    settingsSavingScope: null,
  },
  ghlClients: {
    mounted: false,
    data: null,
    savingClientId: null,
  },
  clientToplineSaving: false,
};

const linkedReportsState = {
  origin: null,
  activePlatform: null,
  pair: null,
  metaPayload: null,
  googlePayload: null,
  publicDual: null,
};

function isGoogleAdsEditorActive() {
  if (IS_REPORT_VIEW) return false;
  if (linkedReportsState.activePlatform) {
    return linkedReportsState.activePlatform === 'google-ads';
  }
  return IS_ADMIN_GOOGLE_ADS_CLIENT;
}

function resetLinkedReportsState() {
  linkedReportsState.origin = null;
  linkedReportsState.activePlatform = null;
  linkedReportsState.pair = null;
  linkedReportsState.metaPayload = null;
  linkedReportsState.googlePayload = null;
  linkedReportsState.publicDual = null;
}

function linkedReportPairFromPayload(payload) {
  return payload?.linkedPair || payload?.pair || null;
}

function captureDualPublicPayload(payload) {
  if (!payload || payload.reportKind !== 'dual') {
    linkedReportsState.publicDual = null;
    if (!IS_ADMIN_META_REPORTS_CLIENT && !IS_ADMIN_GOOGLE_ADS_CLIENT) {
      linkedReportsState.pair = payload?.linkedPair || null;
    }
    return payload;
  }
  linkedReportsState.publicDual = payload;
  linkedReportsState.origin = payload.origin === 'google-ads' ? 'google-ads' : 'meta';
  linkedReportsState.pair = payload.pair || null;
  linkedReportsState.metaPayload = payload.meta || null;
  linkedReportsState.googlePayload = payload.google || null;
  if (!linkedReportsState.activePlatform || !(payload.platforms || []).includes(linkedReportsState.activePlatform)) {
    linkedReportsState.activePlatform = payload.origin === 'google-ads' ? 'google-ads' : 'meta';
  }
  return resolveLinkedActivePayload();
}

function resolveLinkedActivePayload() {
  if (linkedReportsState.activePlatform === 'google-ads') {
    return linkedReportsState.googlePayload || linkedReportsState.publicDual?.google || null;
  }
  if (linkedReportsState.activePlatform === 'meta') {
    return linkedReportsState.metaPayload || linkedReportsState.publicDual?.meta || null;
  }
  return null;
}

function hydrateAdminLinkedReports({ origin, metaPayload = null, googlePayload = null }) {
  linkedReportsState.origin = origin;
  linkedReportsState.metaPayload = metaPayload;
  linkedReportsState.googlePayload = googlePayload;
  linkedReportsState.pair = linkedReportPairFromPayload(metaPayload)
    || linkedReportPairFromPayload(googlePayload)
    || null;
  if (!linkedReportsState.activePlatform) {
    linkedReportsState.activePlatform = origin;
  }
  if (linkedReportsState.pair) {
    if (linkedReportsState.activePlatform === 'google-ads' && !googlePayload) {
      linkedReportsState.activePlatform = 'meta';
    }
    if (linkedReportsState.activePlatform === 'meta' && !metaPayload) {
      linkedReportsState.activePlatform = 'google-ads';
    }
  } else {
    linkedReportsState.activePlatform = origin;
  }
}

function renderLinkedReportPlatformTabs({ platforms = [], activePlatform = 'meta' } = {}) {
  if (!platforms.includes('meta') || !platforms.includes('google-ads')) return '';
  return `
    <div class="linked-report-platform-tabs" role="tablist" aria-label="Ad platforms">
      <button type="button" class="linked-report-platform-tab${activePlatform === 'meta' ? ' is-active' : ''}" data-linked-platform="meta" role="tab" aria-selected="${activePlatform === 'meta'}">Meta Ads</button>
      <button type="button" class="linked-report-platform-tab${activePlatform === 'google-ads' ? ' is-active' : ''}" data-linked-platform="google-ads" role="tab" aria-selected="${activePlatform === 'google-ads'}">Google Ads</button>
    </div>
  `;
}

function renderLinkedReportLinkControl() {
  const pair = linkedReportsState.pair;
  const origin = linkedReportsState.origin || (IS_ADMIN_GOOGLE_ADS_CLIENT ? 'google-ads' : 'meta');
  if (pair) {
    const partnerName = origin === 'meta' ? pair.googleAccountName : pair.metaAccountName;
    return `<button type="button" class="admin-btn admin-btn--secondary linked-report-link-btn" id="linked-report-link-btn">Linked · ${esc(partnerName || 'partner')}</button>`;
  }
  const label = origin === 'meta' ? 'Link Google Ads' : 'Link Meta report';
  return `<button type="button" class="admin-btn admin-btn--secondary linked-report-link-btn" id="linked-report-link-btn">${esc(label)}</button>`;
}

function linkedAdminOrigin() {
  return linkedReportsState.origin
    || (IS_ADMIN_GOOGLE_ADS_CLIENT ? 'google-ads' : 'meta');
}

function renderLinkedAdminPlatformTabsHtml() {
  const platforms = [];
  if (linkedReportsState.metaPayload) platforms.push('meta');
  if (linkedReportsState.googlePayload) platforms.push('google-ads');
  return renderLinkedReportPlatformTabs({
    platforms,
    activePlatform: linkedReportsState.activePlatform || linkedAdminOrigin(),
  });
}

function renderLinkedPublicPlatformTabsHtml() {
  const dual = linkedReportsState.publicDual;
  if (!dual?.platforms) return '';
  return renderLinkedReportPlatformTabs({
    platforms: dual.platforms,
    activePlatform: linkedReportsState.activePlatform || dual.origin || 'meta',
  });
}

function renderLinkedAdminEditorInner() {
  if (isGoogleAdsEditorActive() && linkedReportsState.googlePayload) {
    const payload = linkedReportsState.googlePayload;
    const uiPayload = googleAdsPayloadToMetaUiShape(payload);
    const monthKeys = payload.monthKeys || [];
    const activeKey = googleAdsReportsState.activeMonthKey || monthKeys[monthKeys.length - 1] || '';
    const monthPayload = googleAdsMonthToMetaUiShape(payload.months?.[activeKey] || null);
    const tabs = monthKeys.map((key) => `
      <button type="button" class="meta-report-tab${key === activeKey ? ' is-active' : ''}" data-google-ads-month-tab="${esc(key)}">${esc(metaMonthLabel(key))}</button>
    `).join('');
    return `
      ${renderLinkedAdminPlatformTabsHtml()}
      ${renderGoogleAdsReportClientControlPanel(payload)}
      <div class="meta-report-tabs" role="tablist">${tabs}</div>
      <div class="meta-report-month-panel" id="meta-report-month-panel">
        ${renderGoogleAdsReportMonthBody(monthPayload, {
          editable: true,
          yearPayload: uiPayload,
          activeMonthKey: activeKey,
        })}
      </div>
    `;
  }

  const payload = linkedReportsState.metaPayload || metaReportsState.clientPayload;
  const monthKeys = payload?.monthKeys || [];
  const activeKey = metaReportsState.activeMonthKey || monthKeys[monthKeys.length - 1] || '';
  const monthPayload = payload?.months?.[activeKey] || null;
  const settings = payload?.settings || {};
  const tabs = monthKeys.map((key) => `
    <button type="button" class="meta-report-tab${key === activeKey ? ' is-active' : ''}" data-meta-month-tab="${esc(key)}">${esc(metaMonthLabel(key))}</button>
  `).join('');
  return `
    ${renderLinkedAdminPlatformTabsHtml()}
    ${renderMetaReportClientControlPanel(payload)}
    <div class="meta-report-tabs" role="tablist">${tabs}</div>
    <div class="meta-report-month-panel" id="meta-report-month-panel">
      ${renderMetaReportMonthBody(monthPayload, getMetaReportMonthBodyOptions(settings, { editable: true, yearPayload: payload }))}
    </div>
  `;
}

function applyLinkedAdminPlatformState(platform) {
  linkedReportsState.activePlatform = platform;
  metaReportsState.clientShareExpanded = false;
  metaReportsState.clientReportSettingsExpanded = false;
  metaReportsState.clientExcelSheetExpanded = false;
  metaReportsState.reportViewMode = 'monthly';
  metaReportsState.chartProjection = null;
  if (platform === 'google-ads' && linkedReportsState.googlePayload) {
    const payload = linkedReportsState.googlePayload;
    const uiPayload = googleAdsPayloadToMetaUiShape(payload);
    googleAdsReportsState.clientPayload = payload;
    metaReportsState.clientPayload = uiPayload;
    googleAdsReportsState.selectedYear = Number(payload.year) || googleAdsReportsState.selectedYear;
    metaReportsState.selectedYear = googleAdsReportsState.selectedYear;
    if (!googleAdsReportsState.activeMonthKey || !(payload.monthKeys || []).includes(googleAdsReportsState.activeMonthKey)) {
      googleAdsReportsState.activeMonthKey = payload.monthKeys?.[payload.monthKeys.length - 1] || null;
    }
    metaReportsState.activeMonthKey = googleAdsReportsState.activeMonthKey;
    hydrateMetaReportSpendChartType(uiPayload);
    hydrateMetaReportScenarioSettings(uiPayload);
    return uiPayload;
  }
  const payload = linkedReportsState.metaPayload;
  metaReportsState.clientPayload = payload;
  if (payload?.year) metaReportsState.selectedYear = Number(payload.year);
  if (!metaReportsState.activeMonthKey || !(payload?.monthKeys || []).includes(metaReportsState.activeMonthKey)) {
    metaReportsState.activeMonthKey = payload?.monthKeys?.[payload.monthKeys.length - 1] || null;
  }
  hydrateMetaReportSpendChartType(payload);
  hydrateMetaReportScenarioSettings(payload);
  return payload;
}

function bindLinkedReportChrome({ publicView = false } = {}) {
  document.querySelectorAll('[data-linked-platform]').forEach((button) => {
    button.onclick = () => {
      const platform = button.getAttribute('data-linked-platform');
      if (!platform || platform === linkedReportsState.activePlatform) return;
      if (publicView) switchLinkedPublicPlatform(platform);
      else switchLinkedAdminPlatform(platform);
    };
  });
  const linkBtn = document.getElementById('linked-report-link-btn');
  if (linkBtn) linkBtn.onclick = () => openLinkedReportPickerModal();
}

function bindLinkedAdminEditorEvents() {
  bindLinkedReportChrome();
  if (isGoogleAdsEditorActive() && linkedReportsState.googlePayload) {
    bindGoogleAdsReportsClientEvents(linkedReportsState.googlePayload);
    return;
  }
  const payload = linkedReportsState.metaPayload || metaReportsState.clientPayload;
  if (payload) bindMetaReportsClientEvents(payload);
}

function switchLinkedAdminPlatform(platform) {
  const payload = applyLinkedAdminPlatformState(platform);
  const page = document.querySelector('.meta-report-client-page');
  if (!page || !payload) return;
  page.innerHTML = renderLinkedAdminEditorInner();
  bindLinkedAdminEditorEvents();
  const clientId = isGoogleAdsEditorActive()
    ? (linkedReportsState.googlePayload?.clientId || payload.clientId)
    : payload.clientId;
  void ensureMetaReportScenarioSource(payload, { editable: true }).then(() => {
    mountMetaReportCharts(payload, { editable: true, clientId });
  });
}

function publicLinkedActiveRawPayload() {
  if (linkedReportsState.activePlatform === 'google-ads') {
    return linkedReportsState.googlePayload || linkedReportsState.publicDual?.google || null;
  }
  if (linkedReportsState.publicDual) {
    return linkedReportsState.metaPayload || linkedReportsState.publicDual?.meta || null;
  }
  return metaReportsState.publicPayload;
}

function switchLinkedPublicPlatform(platform) {
  linkedReportsState.activePlatform = platform;
  const raw = publicLinkedActiveRawPayload();
  if (!raw) return;
  metaReportsState.activeMonthKey = null;
  metaReportsState.selectedYear = Number(raw.year) || metaReportsState.selectedYear;
  metaReportsState.comparisonYearCache = {};
  const chartPayload = raw.reportKind === 'google-ads' ? googleAdsPayloadToMetaUiShape(raw) : raw;
  hydrateMetaReportSpendChartType(chartPayload);
  hydrateMetaReportScenarioSettings(chartPayload);
  void ensureMetaReportScenarioSource(chartPayload, { editable: false }).then(() => {
    updatePublicMetaReportContent(raw);
    bindLinkedReportChrome({ publicView: true });
    const yearSelect = document.getElementById('meta-report-year');
    if (yearSelect && !yearSelect.onchange) bindPublicMetaReportEvents(raw);
  });
}

function renderLinkedReportPickerSkeleton(count = 5) {
  return Array.from({ length: count }).map(() => `
    <div class="linked-report-picker-skeleton" aria-hidden="true">
      <span class="linked-report-picker-skeleton-avatar"></span>
      <span class="linked-report-picker-skeleton-copy">
        <span class="meta-cv-skeleton-line meta-cv-skeleton-line--md"></span>
        <span class="meta-cv-skeleton-line meta-cv-skeleton-line--sm"></span>
      </span>
    </div>
  `).join('');
}

function renderLinkedReportPickerItems(candidates, query = '') {
  const needle = String(query || '').trim().toLowerCase();
  const pair = linkedReportsState.pair;
  const origin = linkedAdminOrigin();
  const currentId = origin === 'meta' ? pair?.googleClientId : pair?.metaClientId;
  const filtered = candidates.filter((row) => {
    if (!needle) return true;
    const haystack = [row.name, row.id, row.sub].filter(Boolean).join(' ').toLowerCase();
    return haystack.includes(needle);
  });
  if (!filtered.length) {
    return '<p class="linked-report-picker-empty">No matching accounts.</p>';
  }
  filtered.sort((a, b) => {
    const aLinked = a.id === currentId ? 0 : 1;
    const bLinked = b.id === currentId ? 0 : 1;
    if (aLinked !== bLinked) return aLinked - bLinked;
    return String(a.name || '').localeCompare(String(b.name || ''));
  });
  return filtered.map((row) => {
    const linked = row.id === currentId;
    const initial = String(row.name || row.id || '?').trim().charAt(0).toUpperCase();
    return `
      <button type="button" class="linked-report-picker-item${linked ? ' is-linked' : ''}" data-linked-pick-id="${esc(row.id)}"${linked ? ' aria-current="true"' : ''}>
        <span class="linked-report-picker-avatar" aria-hidden="true">${esc(initial)}</span>
        <span class="linked-report-picker-item-copy">
          <span class="linked-report-picker-item-name">${esc(row.name)}</span>
          <span class="linked-report-picker-item-id">${esc(row.sub || row.id)}</span>
        </span>
        ${linked ? '<span class="linked-report-picker-badge">Linked</span>' : ''}
      </button>
    `;
  }).join('');
}

async function saveLinkedReportPair(googleClientId, metaClientId) {
  const path = `/api/google-ads-reports/clients/${encodeURIComponent(googleClientId)}/settings`;
  return adminFetch(path, {
    method: 'PATCH',
    body: JSON.stringify({ linkedMetaClientId: metaClientId }),
  });
}

async function reloadLinkedAdminPairAndRender() {
  const origin = linkedAdminOrigin();
  if (origin === 'google-ads') {
    googleAdsReportsState.clientPageMounted = false;
    await loadGoogleAdsClientPage({ silent: true });
    return;
  }
  metaReportsState.clientPageMounted = false;
  await loadMetaReportsClientPage({ silent: true });
}

async function reloadCurrentLinkedEditor() {
  if (isGoogleAdsEditorActive() && linkedReportsState.googlePayload) {
    if (linkedReportsState.origin === 'meta') {
      const googleClientId = linkedReportsState.googlePayload.clientId;
      const nextPayload = await adminFetch(`/api/google-ads-reports/clients/${encodeURIComponent(googleClientId)}?year=${encodeURIComponent(googleAdsReportsState.selectedYear)}`);
      linkedReportsState.googlePayload = nextPayload;
      googleAdsReportsState.clientPayload = nextPayload;
      googleAdsReportsState.selectedYear = Number(nextPayload.year) || googleAdsReportsState.selectedYear;
      applyLinkedAdminPlatformState('google-ads');
      const page = document.querySelector('.meta-report-client-page');
      if (page) page.innerHTML = renderLinkedAdminEditorInner();
      bindLinkedAdminEditorEvents();
      const uiPayload = googleAdsPayloadToMetaUiShape(nextPayload);
      requestAnimationFrame(() => {
        mountMetaReportCharts(uiPayload, { editable: true, clientId: googleClientId });
      });
      return;
    }
    await loadGoogleAdsClientPage({ silent: true });
    return;
  }
  if (linkedReportsState.origin === 'google-ads' && linkedReportsState.metaPayload) {
    const clientId = linkedReportsState.metaPayload.clientId;
    const nextPayload = await adminFetch(`/api/meta-reports/clients/${encodeURIComponent(clientId)}?year=${encodeURIComponent(metaReportsState.selectedYear)}`);
    linkedReportsState.metaPayload = nextPayload;
    applyLinkedAdminPlatformState('meta');
    const page = document.querySelector('.meta-report-client-page');
    if (page) page.innerHTML = renderLinkedAdminEditorInner();
    bindLinkedAdminEditorEvents();
    requestAnimationFrame(() => {
      mountMetaReportCharts(nextPayload, { editable: true, clientId });
    });
    return;
  }
  await loadMetaReportsClientPage({ silent: true });
}

async function openLinkedReportPickerModal() {
  const origin = linkedAdminOrigin();
  const pair = linkedReportsState.pair;
  const title = origin === 'meta' ? 'Link Google Ads account' : 'Link Meta report';
  const partnerName = origin === 'meta' ? pair?.googleAccountName : pair?.metaAccountName;
  openMetaReportModal(`
    <div class="meta-report-modal-head">
      <h2 class="meta-report-modal-title">${esc(title)}</h2>
      <button type="button" class="meta-report-modal-close" aria-label="Close">&times;</button>
    </div>
    <p class="metrics-model-copy">One Meta report maps to one Google Ads report. Spend, leads, and share links stay independent.</p>
    <div class="linked-report-picker">
      ${pair ? `
        <div class="linked-report-picker-current">
          <div class="linked-report-picker-current-copy">
            <span class="linked-report-picker-current-label">Currently linked</span>
            <span class="linked-report-picker-current-name">${esc(partnerName || 'partner')}</span>
          </div>
          <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="linked-report-unlink-btn">Unlink</button>
        </div>
      ` : ''}
      <label class="linked-report-picker-field">
        <span>Search accounts</span>
        <input type="text" class="admin-input" id="linked-report-picker-search" placeholder="Name or ID" autocomplete="off" spellcheck="false" />
      </label>
      <div class="linked-report-picker-list" id="linked-report-picker-list" aria-busy="true">
        ${renderLinkedReportPickerSkeleton()}
      </div>
    </div>
  `);

  const listEl = document.getElementById('linked-report-picker-list');
  const searchEl = document.getElementById('linked-report-picker-search');
  const unlinkBtn = document.getElementById('linked-report-unlink-btn');
  const originMetaId = linkedReportsState.metaPayload?.clientId
    || (origin === 'meta' ? CLIENT_SLUG : pair?.metaClientId);
  const originGoogleId = linkedReportsState.googlePayload?.clientId
    || (origin === 'google-ads' ? CLIENT_SLUG : pair?.googleClientId);

  const bindPicker = (candidates) => {
    if (!listEl) return;
    listEl.setAttribute('aria-busy', 'false');
    const currentId = origin === 'meta' ? originGoogleId : originMetaId;
    const render = () => {
      listEl.innerHTML = renderLinkedReportPickerItems(candidates, searchEl?.value);
      listEl.querySelectorAll('[data-linked-pick-id]').forEach((button) => {
        button.onclick = async () => {
          const pickedId = button.getAttribute('data-linked-pick-id');
          if (!pickedId || pickedId === currentId) return;
          button.disabled = true;
          try {
            if (origin === 'meta') {
              await saveLinkedReportPair(pickedId, originMetaId);
            } else {
              await saveLinkedReportPair(originGoogleId, pickedId);
            }
            closeMetaReportModal();
            showToast('Reports linked', 'success');
            await reloadLinkedAdminPairAndRender();
          } catch (error) {
            showToast(error.message || 'Could not link reports', 'error');
            button.disabled = false;
          }
        };
      });
    };
    if (searchEl) searchEl.oninput = render;
    render();
  };

  if (unlinkBtn) {
    unlinkBtn.onclick = async () => {
      if (!originGoogleId) return;
      unlinkBtn.disabled = true;
      try {
        await saveLinkedReportPair(originGoogleId, null);
        closeMetaReportModal();
        showToast('Reports unlinked', 'success');
        linkedReportsState.pair = null;
        if (origin === 'meta') linkedReportsState.googlePayload = null;
        else linkedReportsState.metaPayload = null;
        linkedReportsState.activePlatform = origin;
        await reloadLinkedAdminPairAndRender();
      } catch (error) {
        showToast(error.message || 'Could not unlink', 'error');
        unlinkBtn.disabled = false;
      }
    };
  }

  try {
    if (origin === 'meta') {
      const data = await adminFetch('/api/google-ads-reports?filter=enabled');
      const candidates = (data.clients || [])
        .filter((client) => client.clientId && client.googleAdsReportEnabled && !client.needsSetup)
        .filter((client) => !client.linkedMetaClientId || String(client.linkedMetaClientId) === String(originMetaId))
        .map((client) => ({
          id: client.clientId,
          name: client.accountName,
          sub: client.googleCustomerLabel || client.googleCustomerId || client.clientId,
        }));
      bindPicker(candidates);
    } else {
      const data = await adminFetch('/api/meta-reports?filter=enabled');
      const candidates = (data.clients || [])
        .filter((client) => client.clientId && client.metaReportEnabled && !client.needsSetup)
        .filter((client) => !client.linkedGoogleClientId || String(client.linkedGoogleClientId) === String(originGoogleId))
        .map((client) => ({
          id: client.clientId,
          name: client.accountName,
          sub: client.clientId,
        }));
      bindPicker(candidates);
    }
  } catch (error) {
    if (listEl) {
      listEl.setAttribute('aria-busy', 'false');
      listEl.innerHTML = `<p class="linked-report-picker-empty">${esc(error.message || 'Could not load accounts')}</p>`;
    }
  }
}

async function fetchLinkedPartnerPayload(payload, origin) {
  const pair = linkedReportPairFromPayload(payload);
  if (!pair) return null;
  try {
    if (origin === 'meta' && pair.googleClientId) {
      const year = linkedReportsState.googlePayload?.year
        || googleAdsReportsState.selectedYear
        || payload.year;
      return await adminFetch(`/api/google-ads-reports/clients/${encodeURIComponent(pair.googleClientId)}?year=${encodeURIComponent(year)}`);
    }
    if (origin === 'google-ads' && pair.metaClientId) {
      const year = linkedReportsState.metaPayload?.year
        || metaReportsState.selectedYear
        || payload.year;
      return await adminFetch(`/api/meta-reports/clients/${encodeURIComponent(pair.metaClientId)}?year=${encodeURIComponent(year)}`);
    }
  } catch (error) {
    console.warn('Linked partner report failed to load', error);
  }
  return null;
}

const META_HUB_FILTER_OPTIONS = [
  { value: 'all', label: 'All' },
  { value: 'enabled', label: 'Live reports' },
  { value: 'meta-only', label: 'Meta only' },
  { value: 'needs-setup', label: 'Needs setup' },
];

function metaHubClientInitial(name) {
  const trimmed = String(name || '?').trim();
  return esc(trimmed.charAt(0).toUpperCase());
}

function filterMetaReportsClients(clients, filter, searchQuery = '') {
  let list = clients || [];
  if (filter === 'enabled') list = list.filter((client) => client.metaReportEnabled);
  if (filter === 'meta-only') list = list.filter((client) => !clientUsesCenhubMetaReportTopline(client));
  if (filter === 'needs-setup') list = list.filter((client) => client.needsSetup);
  const query = String(searchQuery || '').trim().toLowerCase();
  if (query) {
    list = list.filter((client) => {
      const haystack = [
        client.accountName,
        client.metaAdAccountId,
        client.clientId,
        client.metaName,
      ].filter(Boolean).join(' ').toLowerCase();
      return haystack.includes(query);
    });
  }
  return list;
}

function getMetaReportsHubView(dashboardData, filter, searchQuery = metaReportsState.searchQuery) {
  const allClients = dashboardData?.clients || [];
  const clients = filterMetaReportsClients(allClients, filter, searchQuery);
  const summary = dashboardData?.summary || {};
  return {
    clients,
    allClients,
    summary: {
      ...summary,
      totalListed: allClients.length,
    },
    meta: dashboardData?.meta || {},
    filter,
    searchQuery,
  };
}

function renderMetaHubSwitch({ label, attr, value, checked, disabled = false }) {
  if (!value) return `<div class="meta-hub-switch is-disabled"><span class="meta-hub-switch-label">${esc(label)}</span><span class="meta-report-muted">—</span></div>`;
  return `
    <label class="meta-hub-switch${disabled ? ' is-disabled' : ''}">
      <span class="meta-hub-switch-label">${esc(label)}</span>
      <span class="meta-hub-switch-track">
        <input type="checkbox" class="meta-hub-switch-input" ${attr}="${esc(value)}" ${checked ? 'checked' : ''} ${disabled ? 'disabled' : ''} aria-label="${esc(label)}" />
        <span class="meta-hub-switch-thumb"></span>
      </span>
    </label>
  `;
}

function metaReportFullUrl(reportPath) {
  if (!reportPath) return '';
  return `${window.location.origin}${reportPath}`;
}

function normalizeMetaReportSlugInput(value) {
  return String(value || '').trim().toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/[^a-z0-9-]/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
}

function resolveMetaReportShareSlug(payload) {
  const settings = payload.settings || {};
  if (settings.metaReportSlug) return settings.metaReportSlug;
  const token = String(payload.reportUrl || '').replace(/^\/report\//, '');
  const match = token.match(/^(.+)-(\d{4})$/);
  return match ? match[1] : '';
}

function resolveMetaReportShareCode(payload) {
  const token = String(payload.reportUrl || '').replace(/^\/report\//, '');
  const match = token.match(/-(\d{4})$/);
  return match ? match[1] : '';
}

function resolveMetaReportModalBottomlineSettings() {
  if (isGoogleAdsEditorActive() && googleAdsReportsState.clientPayload) {
    return googleAdsSettingsToMetaUx(googleAdsReportsState.clientPayload.settings || {});
  }
  return metaReportsState.clientPayload?.settings || {};
}

function closeMetaReportModal() {
  if (metaReportsState.clientReportSettingsExpanded && document.getElementById('meta-report-fee-editor')) {
    syncMetaReportBottomlineFeeDom(resolveMetaReportModalBottomlineSettings(), 'meta-report');
  }
  document.getElementById('meta-report-modal-root')?.remove();
  document.body.classList.remove('meta-report-modal-open');
  metaReportsState.clientShareExpanded = false;
  metaReportsState.clientExcelSheetExpanded = false;
  metaReportsState.clientReportSettingsExpanded = false;
  syncMetaReportControlPanelUi();
}

function openMetaReportModal(contentHtml, { wizard = false, wide = false } = {}) {
  closeMetaReportModal();
  const root = document.createElement('div');
  root.id = 'meta-report-modal-root';
  root.className = 'meta-report-modal-root';
  const modalClass = [
    'meta-report-modal',
    wizard ? 'is-wizard' : '',
    wide ? 'is-wide' : '',
  ].filter(Boolean).join(' ');
  root.innerHTML = `
    <div class="meta-report-modal-backdrop" data-meta-report-modal-close aria-hidden="true"></div>
    <div class="${modalClass}" role="dialog" aria-modal="true">
      ${contentHtml}
      <div class="meta-report-modal-save-row">
        ${renderMetaReportSaveIndicator('meta-report-modal-save-indicator')}
      </div>
    </div>
  `;
  document.body.appendChild(root);
  document.body.classList.add('meta-report-modal-open');
  root.querySelectorAll('[data-meta-report-modal-close]').forEach((el) => {
    el.addEventListener('click', closeMetaReportModal);
  });
  root.querySelector('.meta-report-modal-close')?.addEventListener('click', closeMetaReportModal);
}

function renderMetaReportShareModalContent(payload) {
  const settings = payload.settings || {};
  const enabled = Boolean(settings.metaReportEnabled);
  const reportUrl = payload.reportUrl || null;
  if (!reportUrl) return '';
  const fullUrl = metaReportFullUrl(reportUrl);
  const slug = resolveMetaReportShareSlug(payload);
  const code = resolveMetaReportShareCode(payload);

  return `
    <div class="meta-report-modal-head">
      <h2 class="meta-report-modal-title">Share link & slug</h2>
      <button type="button" class="meta-report-modal-close" aria-label="Close">&times;</button>
    </div>
    <p class="metrics-model-copy">Control the public report preview link and slug prefix for this client.</p>
    <div class="meta-report-share-panel">
      <div class="meta-report-share-preview-row">
        <span class="meta-report-share-preview-title">Preview</span>
        ${renderMetaHubSwitch({
          label: enabled ? 'Enabled' : 'Disabled',
          attr: 'data-meta-client-preview',
          value: payload.clientId,
          checked: enabled,
        })}
      </div>
      <div class="meta-report-share-field">
        <div class="meta-report-share-slug-row">
          <span class="meta-report-share-slug-prefix">/report/</span>
          <input type="text" id="meta-report-share-slug" class="admin-input meta-report-share-slug-input" value="${esc(slug)}" autocomplete="off" spellcheck="false" aria-label="Report slug" />
          <span class="meta-report-share-slug-suffix" id="meta-report-share-slug-suffix">-${esc(code || '····')}</span>
        </div>
      </div>
      <code class="meta-report-share-url" id="meta-report-share-url">${esc(fullUrl)}</code>
      <div class="meta-report-share-editor-actions">
        <button type="button" class="admin-btn admin-btn--ghost admin-btn--small" id="meta-report-rotate-token"${enabled ? '' : ' disabled'}>Rotate link</button>
        <div class="meta-report-share-editor-actions-end">
          <button type="button" class="admin-btn admin-btn--ghost admin-btn--small" data-meta-report-modal-close>Done</button>
          <button type="button" class="admin-btn admin-btn--primary admin-btn--small" id="meta-report-share-save">Save slug</button>
        </div>
      </div>
      ${enabled ? '' : '<p class="meta-report-share-note">Preview disabled — link won\u2019t load.</p>'}
    </div>
  `;
}

function openMetaReportShareModal(payload) {
  metaReportsState.clientShareExpanded = true;
  openMetaReportModal(renderMetaReportShareModalContent(payload));
  bindMetaReportShareEvents(payload);
}

function renderMetaReportShareSummary(payload, { hidden = false } = {}) {
  const settings = payload.settings || {};
  const enabled = Boolean(settings.metaReportEnabled);
  const slug = resolveMetaReportShareSlug(payload);
  const code = resolveMetaReportShareCode(payload);
  const slugLabel = slug ? `${slug}-${code || '····'}` : 'Not set';

  return `
    <div class="meta-report-share-summary" id="meta-report-share-summary"${hidden ? ' hidden' : ''}>
      <div class="meta-report-share-summary-main">
        <div class="meta-report-share-summary-row">
          <span class="meta-report-share-summary-label">Preview</span>
          <span class="meta-report-share-summary-value${enabled ? ' is-on' : ' is-off'}">${enabled ? 'Enabled' : 'Disabled'}</span>
        </div>
        <div class="meta-report-share-summary-row">
          <span class="meta-report-share-summary-label">Slug</span>
          <span class="meta-report-share-summary-value" id="meta-report-share-slug-display">${esc(slugLabel)}</span>
        </div>
      </div>
      <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="meta-report-share-edit">Edit</button>
    </div>
  `;
}

function syncMetaReportToolbarCopy(payload) {
  const btn = document.getElementById('meta-report-toolbar-copy-link');
  if (!btn) return;
  if (payload.reportUrl) {
    btn.setAttribute('data-copy-report-url', payload.reportUrl);
    btn.disabled = !payload.settings?.metaReportEnabled;
    btn.hidden = false;
  } else {
    btn.hidden = true;
  }
}

function applyMetaReportEnabledUi(payload, enabled) {
  if (!payload.settings) payload.settings = {};
  payload.settings.metaReportEnabled = enabled;

  document.getElementById('meta-report-control-panel')?.classList.toggle('is-share-disabled', !enabled);

  const summary = document.getElementById('meta-report-share-summary');
  if (summary) {
    summary.querySelectorAll('.meta-report-share-summary-row').forEach((row) => {
      if (row.querySelector('.meta-report-share-summary-label')?.textContent !== 'Preview') return;
      const previewValue = row.querySelector('.meta-report-share-summary-value');
      if (!previewValue) return;
      previewValue.textContent = enabled ? 'Enabled' : 'Disabled';
      previewValue.classList.toggle('is-on', enabled);
      previewValue.classList.toggle('is-off', !enabled);
    });
  }

  const previewToggle = document.querySelector('[data-meta-client-preview]');
  if (previewToggle) previewToggle.checked = enabled;
  const switchLabel = previewToggle?.closest('.meta-hub-switch')?.querySelector('.meta-hub-switch-label');
  if (switchLabel) switchLabel.textContent = enabled ? 'Enabled' : 'Disabled';

  const rotateBtn = document.getElementById('meta-report-rotate-token');
  if (rotateBtn) rotateBtn.disabled = !enabled;

  const panel = document.querySelector('.meta-report-share-panel');
  const existingNote = panel?.querySelector('.meta-report-share-note');
  if (!enabled) {
    if (!existingNote && panel) {
      const note = document.createElement('p');
      note.className = 'meta-report-share-note';
      note.textContent = 'Preview disabled — link won\u2019t load.';
      panel.appendChild(note);
    }
  } else if (existingNote) {
    existingNote.remove();
  }

  syncMetaReportToolbarCopy(payload);
}

function updateMetaReportHubCardReportState(clientId, enabled) {
  const card = document.querySelector(`[data-meta-hub-row="${clientId}"]`);
  if (!card) return;
  const badge = card.querySelector('.meta-report-badge');
  if (badge && !badge.classList.contains('meta-report-badge--setup')) {
    badge.className = enabled ? 'meta-report-badge meta-report-badge--on' : 'meta-report-badge meta-report-badge--off';
    badge.textContent = enabled ? 'Report live' : 'Report off';
  }
  card.querySelectorAll('[data-meta-bottomline], [data-meta-fee]').forEach((input) => {
    input.disabled = !enabled;
    input.closest('.meta-hub-switch')?.classList.toggle('is-disabled', !enabled);
  });
}

function updateMetaReportShareSummary(payload) {
  const summary = document.getElementById('meta-report-share-summary');
  if (!summary) return;
  const wrapper = document.createElement('div');
  wrapper.innerHTML = renderMetaReportShareSummary(payload).trim();
  const next = wrapper.firstElementChild;
  if (!next) return;
  next.hidden = metaReportsState.clientShareExpanded;
  summary.replaceWith(next);
  const editBtn = document.getElementById('meta-report-share-edit');
  if (editBtn) {
    const payload = metaReportsState.clientPayload;
    editBtn.onclick = () => {
      if (payload) openMetaReportShareModal(payload);
    };
  }
}

function syncMetaReportControlPanelUi() {
  const panel = document.getElementById('meta-report-control-panel');
  if (!panel) return;
  const shareExpanded = metaReportsState.clientShareExpanded;
  const reportExpanded = metaReportsState.clientReportSettingsExpanded;
  const excelExpanded = metaReportsState.clientExcelSheetExpanded;
  panel.classList.toggle('is-editing-share', shareExpanded);
  panel.classList.toggle('is-editing-report', reportExpanded);
  const status = document.getElementById('meta-report-control-status');
  if (status) status.hidden = shareExpanded || reportExpanded || excelExpanded;
}

function setMetaReportShareExpanded(expanded) {
  metaReportsState.clientShareExpanded = Boolean(expanded);
  if (expanded) {
    metaReportsState.clientReportSettingsExpanded = false;
  }
  const summary = document.getElementById('meta-report-share-summary');
  const editor = document.getElementById('meta-report-share-editor');
  if (summary) summary.hidden = expanded;
  if (editor) editor.hidden = !expanded;
  syncMetaReportControlPanelUi();
}

function renderMetaReportShareEditor(payload) {
  const settings = payload.settings || {};
  const enabled = Boolean(settings.metaReportEnabled);
  const reportUrl = payload.reportUrl || null;
  if (!reportUrl) return '';
  const fullUrl = metaReportFullUrl(reportUrl);
  const slug = resolveMetaReportShareSlug(payload);
  const code = resolveMetaReportShareCode(payload);
  const expanded = metaReportsState.clientShareExpanded;

  return `
    <div class="meta-report-control-editor meta-report-control-editor--share" id="meta-report-share-editor-wrap">
      <div class="meta-report-settings-card-head">
        <span class="meta-report-settings-card-title">Slug setting</span>
      </div>
      <div class="meta-report-share-editor" id="meta-report-share-editor"${expanded ? '' : ' hidden'}>
        <div class="meta-report-share-panel">
          <div class="meta-report-share-preview-row">
            <span class="meta-report-share-preview-title">Preview</span>
            ${renderMetaHubSwitch({
              label: enabled ? 'Enabled' : 'Disabled',
              attr: 'data-meta-client-preview',
              value: payload.clientId,
              checked: enabled,
            })}
          </div>
          <div class="meta-report-share-field">
            <div class="meta-report-share-slug-row">
              <span class="meta-report-share-slug-prefix">/report/</span>
              <input type="text" id="meta-report-share-slug" class="admin-input meta-report-share-slug-input" value="${esc(slug)}" autocomplete="off" spellcheck="false" aria-label="Report slug" />
              <span class="meta-report-share-slug-suffix" id="meta-report-share-slug-suffix">-${esc(code || '····')}</span>
            </div>
          </div>
          <code class="meta-report-share-url" id="meta-report-share-url">${esc(fullUrl)}</code>
          <div class="meta-report-share-editor-actions">
            <button type="button" class="admin-btn admin-btn--ghost admin-btn--small" id="meta-report-rotate-token"${enabled ? '' : ' disabled'}>Rotate link</button>
            <div class="meta-report-share-editor-actions-end">
              <button type="button" class="admin-btn admin-btn--ghost admin-btn--small" id="meta-report-share-done">Done</button>
              <button type="button" class="admin-btn admin-btn--primary admin-btn--small" id="meta-report-share-save">Save slug</button>
            </div>
          </div>
          ${enabled ? '' : '<p class="meta-report-share-note">Preview disabled — link won\u2019t load.</p>'}
        </div>
      </div>
    </div>
  `;
}

function resolveMetaReportExcelSheetUrl(settings = {}) {
  const url = String(settings?.metaReportExcelSheetUrl || '').trim();
  return url || null;
}

function renderMetaReportExcelSheetButton(settings = {}, { variant = 'primary' } = {}) {
  const url = resolveMetaReportExcelSheetUrl(settings);
  if (!url) return '';
  const btnClass = variant === 'secondary'
    ? 'admin-btn admin-btn--secondary'
    : 'admin-btn admin-btn--primary meta-report-excel-sheet-btn';
  return `<a class="${btnClass}" href="${esc(url)}" target="_blank" rel="noopener noreferrer">See Excel sheet</a>`;
}

function updateMetaReportPublicExcelSheetButton(settings = {}) {
  const host = document.getElementById('meta-report-public-excel-sheet-btn');
  if (!host) return;
  host.innerHTML = renderMetaReportExcelSheetButton(settings, { variant: 'secondary' });
}

function describeMetaReportExcelSheetLabel(url) {
  if (!url) return 'Not set';
  try {
    const parsed = new URL(url);
    const path = parsed.pathname.length > 24 ? `${parsed.pathname.slice(0, 24)}…` : parsed.pathname;
    return `${parsed.hostname}${path}`;
  } catch {
    return url.length > 40 ? `${url.slice(0, 40)}…` : url;
  }
}

function renderMetaReportExcelSheetSummary(settings = {}) {
  const url = resolveMetaReportExcelSheetUrl(settings);
  const label = describeMetaReportExcelSheetLabel(url);
  return `
    <div class="meta-report-excel-sheet-summary" id="meta-report-excel-sheet-summary">
      <div class="meta-report-excel-sheet-summary-main">
        <div class="meta-report-excel-sheet-summary-row">
          <span class="meta-report-excel-sheet-summary-label">Excel sheet</span>
          <span class="meta-report-excel-sheet-summary-value${url ? ' is-on' : ' is-off'}" id="meta-report-excel-sheet-summary-value">${esc(label)}</span>
        </div>
      </div>
      <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="meta-report-excel-sheet-edit">Edit</button>
    </div>
  `;
}

function renderMetaReportExcelSheetModalContent(payload) {
  const settings = payload.settings || {};
  const url = resolveMetaReportExcelSheetUrl(settings) || '';
  return `
    <div class="meta-report-modal-head">
      <h2 class="meta-report-modal-title">Excel sheet link</h2>
      <button type="button" class="meta-report-modal-close" aria-label="Close">&times;</button>
    </div>
    <p class="metrics-model-copy">Add a Google Sheets or Excel Online link. Clients see a “See Excel sheet” button on their report.</p>
    <div class="meta-report-share-panel">
      <div class="meta-report-share-field">
        <label for="meta-report-excel-sheet-url">Spreadsheet URL</label>
        <input
          type="url"
          id="meta-report-excel-sheet-url"
          class="admin-input meta-report-excel-sheet-url-input"
          value="${esc(url)}"
          placeholder="https://docs.google.com/spreadsheets/d/..."
          autocomplete="off"
          spellcheck="false"
          aria-label="Excel sheet URL"
        />
      </div>
      <div class="meta-report-share-editor-actions">
        ${url ? `<a class="admin-btn admin-btn--ghost admin-btn--small" href="${esc(url)}" target="_blank" rel="noopener noreferrer" id="meta-report-excel-sheet-preview">Preview link</a>` : '<span id="meta-report-excel-sheet-preview" hidden></span>'}
        <div class="meta-report-share-editor-actions-end">
          <button type="button" class="admin-btn admin-btn--ghost admin-btn--small" data-meta-report-modal-close>Done</button>
          <button type="button" class="admin-btn admin-btn--primary admin-btn--small" id="meta-report-excel-sheet-save">Save link</button>
        </div>
      </div>
    </div>
  `;
}

function openMetaReportExcelSheetModal(payload) {
  metaReportsState.clientExcelSheetExpanded = true;
  syncMetaReportControlPanelUi();
  openMetaReportModal(renderMetaReportExcelSheetModalContent(payload), { wide: true });
  bindMetaReportExcelSheetModalEvents(payload);
}

function updateMetaReportExcelSheetSummary(settings = {}) {
  const summary = document.getElementById('meta-report-excel-sheet-summary');
  if (!summary) return;
  const wrapper = document.createElement('div');
  wrapper.innerHTML = renderMetaReportExcelSheetSummary(settings).trim();
  const next = wrapper.firstElementChild;
  if (!next) return;
  summary.replaceWith(next);
  bindMetaReportExcelSheetSummaryEvents(metaReportsState.clientPayload);
}

function bindMetaReportExcelSheetSummaryEvents(payload) {
  const editBtn = document.getElementById('meta-report-excel-sheet-edit');
  if (!editBtn || !payload) return;
  editBtn.onclick = () => openMetaReportExcelSheetModal(payload);
}

function bindMetaReportExcelSheetModalEvents(payload) {
  const clientId = payload.clientId;
  const input = document.getElementById('meta-report-excel-sheet-url');
  const saveBtn = document.getElementById('meta-report-excel-sheet-save');
  if (!input || !saveBtn) return;

  const save = async () => {
    const previous = resolveMetaReportExcelSheetUrl(metaReportsState.clientPayload?.settings || {});
    const nextValue = input.value.trim();
    saveBtn.disabled = true;
    try {
      await saveMetaReportClientSettings(clientId, { metaReportExcelSheetUrl: nextValue || null }, () => {
        input.value = previous || '';
      });
      syncMetaReportExcelSheetUi(metaReportsState.clientPayload?.settings || {});
      closeMetaReportModal();
    } finally {
      saveBtn.disabled = false;
    }
  };

  saveBtn.onclick = save;
  input.onkeydown = (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      save();
    }
  };
}

function syncMetaReportExcelSheetUi(settings = {}) {
  const url = resolveMetaReportExcelSheetUrl(settings);
  const summaryValue = document.getElementById('meta-report-excel-sheet-summary-value');
  if (summaryValue) {
    summaryValue.textContent = describeMetaReportExcelSheetLabel(url);
    summaryValue.classList.toggle('is-on', Boolean(url));
    summaryValue.classList.toggle('is-off', !url);
  }
  const controlBarBtn = document.getElementById('meta-report-excel-sheet-toolbar-btn');
  if (controlBarBtn) {
    if (url) {
      controlBarBtn.href = url;
      controlBarBtn.hidden = false;
    } else {
      controlBarBtn.hidden = true;
    }
  }
  const publicBtnHost = document.getElementById('meta-report-public-excel-sheet-btn');
  if (publicBtnHost) {
    publicBtnHost.innerHTML = renderMetaReportExcelSheetButton(settings, { variant: 'secondary' });
  }
}

function renderMetaReportClientControlPanel(payload) {
  const settings = payload.settings || {};
  const shareExpanded = metaReportsState.clientShareExpanded;
  const reportExpanded = metaReportsState.clientReportSettingsExpanded;
  const excelExpanded = metaReportsState.clientExcelSheetExpanded;
  const hasLink = Boolean(payload.reportUrl);
  const statusHidden = shareExpanded || reportExpanded || excelExpanded;
  const missing = metaReportMonthsNeedingBackfill(payload);
  const resyncLabel = missing.length
    ? `${ICON_SYNC} Backfill ${missing.length} month${missing.length === 1 ? '' : 's'} from Meta`
    : `${ICON_SYNC} Re-sync year from Meta`;

  return `
    <div class="meta-report-control-panel${shareExpanded ? ' is-editing-share' : ''}${reportExpanded ? ' is-editing-report' : ''}${settings.metaReportEnabled ? '' : ' is-share-disabled'}" id="meta-report-control-panel">
      <div class="meta-report-control-bar">
        <div class="meta-report-control-bar-left meta-report-toolbar-left">
          <label class="meta-report-year-field">Year
            <select id="meta-report-year" class="admin-select">
              ${renderMetaReportYearSelectOptions(payload, { disableUnavailable: true })}
            </select>
          </label>
          <div class="meta-report-backfill-wrap">
            <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="meta-report-backfill">${resyncLabel}</button>
            <span class="meta-report-backfill-progress" id="meta-report-backfill-progress"></span>
          </div>
        </div>
        <div class="meta-report-control-bar-actions meta-report-toolbar-actions">
          <span class="meta-report-save-indicator" id="meta-report-save-indicator"><span class="meta-report-save-indicator-spinner"></span> Saving…</span>
          ${hasLink ? `<button type="button" class="admin-btn admin-btn--secondary" id="meta-report-toolbar-copy-link" data-copy-report-url="${esc(payload.reportUrl)}"${settings.metaReportEnabled ? '' : ' disabled'}>Copy link</button>` : ''}
          ${resolveMetaReportExcelSheetUrl(settings) ? `<a class="admin-btn admin-btn--secondary" id="meta-report-excel-sheet-toolbar-btn" href="${esc(resolveMetaReportExcelSheetUrl(settings))}" target="_blank" rel="noopener noreferrer">See Excel sheet</a>` : '<a class="admin-btn admin-btn--secondary" id="meta-report-excel-sheet-toolbar-btn" href="#" target="_blank" rel="noopener noreferrer" hidden>See Excel sheet</a>'}
          ${renderLinkedReportLinkControl()}
        </div>
      </div>
      ${hasLink ? `
        <div class="meta-report-control-status-rows"${statusHidden ? ' hidden' : ''} id="meta-report-control-status">
          <div class="meta-report-control-status-grid">
            ${renderMetaReportShareSummary(payload)}
            ${renderMetaReportBottomlineFeeSummary(settings, 'meta-report')}
          </div>
          <div class="meta-report-control-status-grid">
            <div id="meta-report-topline-source-host"${isMetaReportGhlListClient(settings) ? '' : ' hidden'}>
              ${isMetaReportGhlListClient(settings) ? renderMetaReportToplineSourceControl(payload) : ''}
            </div>
            ${renderMetaReportExcelSheetSummary(settings)}
          </div>
        </div>
      ` : `
        <p class="meta-report-share-empty">Share link will appear once this client has a Meta ad account configured.</p>
      `}
    </div>
  `;
}

function refreshMetaReportClientShareUi(payload) {
  syncMetaReportToolbarCopy(payload);
  updateMetaReportShareSummary(payload);
  updateMetaReportBottomlineFeeSummary(payload.settings || {}, 'meta-report');
  updateMetaReportExcelSheetSummary(payload.settings || {});
  document.getElementById('meta-report-control-panel')?.classList.toggle('is-share-disabled', !payload.settings?.metaReportEnabled);
  const urlEl = document.getElementById('meta-report-share-url');
  if (urlEl && payload.reportUrl) urlEl.textContent = metaReportFullUrl(payload.reportUrl);
  const suffixEl = document.getElementById('meta-report-share-slug-suffix');
  const code = resolveMetaReportShareCode(payload);
  if (suffixEl) suffixEl.textContent = `-${code || '····'}`;
  const slugInput = document.getElementById('meta-report-share-slug');
  if (slugInput) slugInput.value = resolveMetaReportShareSlug(payload);
  const rotateBtn = document.getElementById('meta-report-rotate-token');
  if (rotateBtn) rotateBtn.disabled = !payload.settings?.metaReportEnabled;
  const previewToggle = document.querySelector('[data-meta-client-preview]');
  if (previewToggle) previewToggle.checked = Boolean(payload.settings?.metaReportEnabled);
  setMetaReportShareExpanded(metaReportsState.clientShareExpanded);
}

function syncMetaReportShareCard(payload) {
  const wrap = document.getElementById('meta-report-share-editor-wrap');
  if (!wrap) return;
  const parent = wrap.parentElement;
  if (!parent) return;
  const markup = renderMetaReportShareEditor(payload);
  const shell = document.createElement('div');
  shell.innerHTML = markup.trim();
  const next = shell.firstElementChild;
  if (!next) return;
  parent.replaceChild(next, wrap);
  setMetaReportShareExpanded(metaReportsState.clientShareExpanded);
  bindMetaReportShareEvents(payload);
  syncMetaReportToolbarCopy(payload);
}

function bindMetaReportRotateButton(clientId) {
  const rotateBtn = document.getElementById('meta-report-rotate-token');
  if (!rotateBtn) return;
  rotateBtn.onclick = async () => {
    if (!window.confirm('Rotate the share link? The old link will stop working.')) return;
    rotateBtn.disabled = true;
    try {
      const result = await patchMetaReportSettings(clientId, { rotateAccessToken: true });
      const reportUrl = result.settings?.reportUrl || null;
      const currentPayload = metaReportsState.clientPayload;
      if (currentPayload) {
        currentPayload.reportUrl = reportUrl;
        if (result.settings) currentPayload.settings = { ...currentPayload.settings, ...result.settings };
      }
      const nextPayload = currentPayload || { clientId, reportUrl, settings: result.settings || {} };
      metaReportsState.clientPayload = nextPayload;
      if (metaReportsState.clientShareExpanded) {
        refreshMetaReportClientShareUi(nextPayload);
      } else {
        syncMetaReportShareCard(nextPayload);
      }
      showToast('Share link rotated', 'success');
    } catch (error) {
      showToast(error.message || 'Rotate failed', 'error');
    } finally {
      const btn = document.getElementById('meta-report-rotate-token');
      if (btn) btn.disabled = false;
    }
  };
}

function bindMetaReportShareEvents(payload) {
  const clientId = payload.clientId;
  bindMetaReportCopyButtons();
  bindMetaReportRotateButton(clientId);

  const editBtn = document.getElementById('meta-report-share-edit');
  if (editBtn) {
    editBtn.onclick = () => openMetaReportShareModal(payload);
  }

  const doneBtn = document.getElementById('meta-report-share-done');
  if (doneBtn) {
    doneBtn.onclick = closeMetaReportModal;
  }

  const saveBtn = document.getElementById('meta-report-share-save');
  if (saveBtn) {
    saveBtn.onclick = async () => {
      const input = document.getElementById('meta-report-share-slug');
      const normalized = normalizeMetaReportSlugInput(input?.value);
      if (!normalized || normalized.length < 2) {
        showToast('Enter a valid slug (at least 2 characters).', 'error');
        return;
      }
      saveBtn.disabled = true;
      try {
        const result = await patchMetaReportSettings(clientId, { metaReportSlug: normalized });
        const settings = result.settings || {};
        const currentPayload = metaReportsState.clientPayload || payload;
        currentPayload.settings = { ...currentPayload.settings, ...settings };
        currentPayload.reportUrl = settings.reportUrl || null;
        metaReportsState.clientPayload = currentPayload;
        refreshMetaReportClientShareUi(currentPayload);
        closeMetaReportModal();
        showToast('Share link slug saved', 'success');
      } catch (error) {
        showToast(error.message || 'Save failed', 'error');
      } finally {
        const btn = document.getElementById('meta-report-share-save');
        if (btn) btn.disabled = false;
      }
    };
  }

  const slugInput = document.getElementById('meta-report-share-slug');
  if (slugInput) {
    slugInput.oninput = () => {
      slugInput.value = normalizeMetaReportSlugInput(slugInput.value);
    };
  }

  const previewToggle = document.querySelector('[data-meta-client-preview]');
  if (previewToggle) {
    let previewSaveSeq = 0;
    previewToggle.onchange = async () => {
      const seq = ++previewSaveSeq;
      const enabled = previewToggle.checked;
      const previous = !enabled;
      const currentPayload = metaReportsState.clientPayload || payload;
      applyMetaReportEnabledUi(currentPayload, enabled);
      const switchEl = previewToggle.closest('.meta-hub-switch');
      switchEl?.classList.add('is-saving');
      try {
        const result = await patchMetaReportSettings(clientId, { metaReportEnabled: enabled }, { fast: true });
        if (seq !== previewSaveSeq) return;
        const settings = result.settings || {};
        currentPayload.settings = { ...currentPayload.settings, ...settings };
        currentPayload.reportUrl = settings.reportUrl ?? currentPayload.reportUrl;
        metaReportsState.clientPayload = currentPayload;
        applyMetaReportEnabledUi(currentPayload, Boolean(settings.metaReportEnabled));
        showToast(enabled ? 'Client preview enabled' : 'Client preview disabled', 'success');
      } catch (error) {
        if (seq !== previewSaveSeq) return;
        applyMetaReportEnabledUi(currentPayload, previous);
        previewToggle.checked = previous;
        showToast(error.message || 'Update failed', 'error');
      } finally {
        if (seq === previewSaveSeq) switchEl?.classList.remove('is-saving');
      }
    };
  }
}

function renderMetaReportHubCard(client) {
  const canEdit = Boolean(client.clientId);
  const rowKey = client.clientId || client.metaAdAccountId || '';
  const cardClass = client.needsSetup ? 'is-setup' : '';
  const statusBadge = client.needsSetup
    ? '<span class="meta-report-badge meta-report-badge--setup">Needs setup</span>'
    : (client.metaReportEnabled
      ? '<span class="meta-report-badge meta-report-badge--on">Report live</span>'
      : '<span class="meta-report-badge meta-report-badge--off">Report off</span>');
  const typeLabel = resolveMetaReportHubTypeLabel(client);
  const nameMarkup = canEdit
    ? `<a href="/admin/meta-reports/${encodeURIComponent(client.clientId)}" class="meta-hub-card-name">${esc(client.accountName)}</a>`
    : `<span class="meta-hub-card-name">${esc(client.accountName)}</span>`;

  const actionButtons = [];
  if (client.needsSetup) {
    actionButtons.push(`<button type="button" class="admin-btn admin-btn--primary" data-meta-provision="${esc(client.metaAdAccountId)}" data-meta-provision-name="${esc(client.accountName)}">Add client</button>`);
  } else if (canEdit) {
    actionButtons.push(`<a class="admin-btn" href="/admin/meta-reports/${encodeURIComponent(client.clientId)}">Edit report</a>`);
    if (client.reportUrl && client.metaReportEnabled) {
      actionButtons.push(`<a class="admin-btn admin-btn--primary" href="${esc(client.reportUrl)}" target="_blank" rel="noopener noreferrer" title="Open client report">View Report</a>`);
    }
    actionButtons.push(client.reportUrl
      ? `<button type="button" class="admin-btn admin-btn--secondary" data-copy-report-url="${esc(client.reportUrl)}">Copy link</button>`
      : `<a class="admin-btn admin-btn--secondary" href="/admin/meta-reports/${encodeURIComponent(client.clientId)}">Enable report</a>`);
  }
  const actionsClass = actionButtons.length === 1
    ? 'meta-hub-card-actions meta-hub-card-actions--single'
    : (actionButtons.length >= 3
      ? 'client-card-actions'
      : 'meta-hub-card-actions');

  return `
    <article class="meta-hub-card ${cardClass}" data-meta-hub-row="${esc(rowKey)}">
      <div class="meta-hub-card-head">
        <span class="meta-hub-avatar" aria-hidden="true">${metaHubClientInitial(client.accountName)}</span>
        <div class="meta-hub-card-title">
          ${nameMarkup}
          <div class="meta-hub-card-slug">act_${esc(client.metaAdAccountId || '—')}</div>
        </div>
      </div>
      <div class="meta-hub-card-meta">
        ${statusBadge}
        ${client.linkedGoogleAccountName ? `<span class="meta-report-badge meta-report-badge--linked">Linked · ${esc(client.linkedGoogleAccountName)}</span>` : ''}
        <span class="meta-hub-card-meta-dot" aria-hidden="true">·</span>
        <span>${esc(typeLabel)}</span>
      </div>
      <div class="meta-hub-card-toggles">
        ${renderMetaHubSwitch({
          label: 'Report',
          attr: 'data-meta-report-enabled',
          value: canEdit ? client.clientId : null,
          checked: client.metaReportEnabled,
        })}
        ${renderMetaHubSwitch({
          label: 'Bottomline',
          attr: 'data-meta-bottomline',
          value: canEdit ? client.clientId : null,
          checked: client.metaReportShowBottomline,
          disabled: !client.metaReportEnabled,
        })}
        ${renderMetaHubSwitch({
          label: 'Censio fee',
          attr: 'data-meta-fee',
          value: canEdit ? client.clientId : null,
          checked: client.metaReportFeeEnabled,
          disabled: !client.metaReportEnabled,
        })}
      </div>
      ${actionButtons.length ? `<div class="${actionsClass}">${actionButtons.join('')}</div>` : ''}
    </article>
  `;
}

function renderMetaReportsClientCards(clients, filter = 'all', searchQuery = '') {
  if (!clients.length) {
    const message = searchQuery
      ? `No clients match “${searchQuery}”.`
      : (filter === 'all'
        ? 'No Meta ad accounts found. Check META_SYSTEM_USER_TOKEN and META_BUSINESS_ID, or add clients manually.'
        : 'No clients match this filter.');
    return `
      <div class="meta-hub-empty">
        <h3>No clients to show</h3>
        <p>${esc(message)}</p>
      </div>
    `;
  }
  return clients.map((client) => renderMetaReportHubCard(client)).join('');
}

function renderMetaReportsBannerHtml(metaInfo) {
  if (!metaInfo?.partnerFetchError) return '';
  return `
    <div class="meta-hub-banner">
      <strong>Meta Business Manager listing unavailable</strong>
      ${esc(metaInfo.partnerFetchError)} Showing only clients already configured in the app.
    </div>
  `;
}

function renderMetaHubFiltersHtml(activeFilter) {
  return META_HUB_FILTER_OPTIONS.map((option) => `
    <button
      type="button"
      class="meta-hub-filter${activeFilter === option.value ? ' is-active' : ''}"
      data-meta-filter="${esc(option.value)}"
    >${esc(option.label)}</button>
  `).join('');
}

function recomputeMetaReportsSummaryCounts() {
  const all = metaReportsState.dashboardData?.clients || [];
  const summary = metaReportsState.dashboardData?.summary || {};
  metaReportsState.dashboardData.summary = {
    ...summary,
    inAppCount: all.filter((client) => client.inApp).length,
    enabledCount: all.filter((client) => client.metaReportEnabled).length,
    needsSetupCount: all.filter((client) => client.needsSetup).length,
    totalListed: all.length,
  };
}

function mergeHubClient(clientId, patch) {
  const all = metaReportsState.dashboardData?.clients;
  if (!all) return null;
  const index = all.findIndex((client) => client.clientId === clientId);
  if (index < 0) return null;
  all[index] = { ...all[index], ...patch };
  recomputeMetaReportsSummaryCounts();
  return all[index];
}

function updateMetaReportsHubDom(viewData) {
  const bannerEl = document.getElementById('meta-reports-banner');
  const cardsEl = document.getElementById('meta-reports-cards');
  const countEl = document.getElementById('meta-reports-count');
  if (bannerEl) bannerEl.innerHTML = renderMetaReportsBannerHtml(viewData.meta);
  if (countEl) countEl.textContent = `${viewData.clients.length} client${viewData.clients.length === 1 ? '' : 's'}`;
  if (cardsEl) {
    cardsEl.innerHTML = renderMetaReportsClientCards(viewData.clients, viewData.filter, viewData.searchQuery);
    bindMetaReportsHubRowEvents(cardsEl);
  }
}

function renderMetaReportsClientTabs(payload) {
  const monthKeys = payload.monthKeys || [];
  const activeKey = metaReportsState.activeMonthKey || monthKeys[monthKeys.length - 1] || '';
  return monthKeys.map((key) => `
    <button type="button" class="meta-report-tab${key === activeKey ? ' is-active' : ''}" data-meta-month-tab="${esc(key)}">${esc(metaMonthLabel(key))}</button>
  `).join('');
}

function syncMetaReportToplineSourceBar(payload) {
  const host = document.getElementById('meta-report-topline-source-host');
  if (!host || !payload) return;
  const settings = payload.settings || {};
  if (!isMetaReportGhlListClient(settings)) {
    host.innerHTML = '';
    host.hidden = true;
    return;
  }
  host.hidden = false;
  host.innerHTML = renderMetaReportToplineSourceControl(payload);
  bindMetaReportToplineSourceControl(payload.clientId, payload);
}

function bindMetaReportToplineSourceControl(clientId, payload) {
  if (!clientId || !payload) return;

  const changeBtn = document.getElementById('meta-report-topline-change');
  if (changeBtn) {
    changeBtn.onclick = () => openMetaReportToplineChangeModal(payload);
  }
}

function bindMetaMonthSourceOverrideEvents(clientId, settings, {
  prefix,
  getMonthKey,
  getMonthPayload,
  onSuccess,
}) {
  const manualBtn = document.getElementById(`${prefix}-use-manual-month`);
  const restoreBtn = document.getElementById(`${prefix}-restore-month-source`);
  if (manualBtn) {
    manualBtn.onclick = async () => {
      const monthKey = getMonthKey();
      if (!monthKey) return;
      manualBtn.disabled = true;
      try {
        const result = await adminFetch(
          `/api/meta-reports/clients/${encodeURIComponent(clientId)}/months/${encodeURIComponent(monthKey)}/use-manual`,
          { method: 'POST', body: '{}' },
        );
        onSuccess(result, monthKey);
        showToast('Manual values enabled for this month', 'success');
      } catch (error) {
        showToast(error.message || 'Could not switch to manual mode', 'error');
      } finally {
        manualBtn.disabled = false;
      }
    };
  }

  if (restoreBtn) {
    restoreBtn.onclick = async () => {
      const monthKey = getMonthKey();
      if (!monthKey) return;
      restoreBtn.disabled = true;
      try {
        const monthPayload = getMonthPayload?.() || null;
        const restoreToCenhub = monthHasCenhubSnapshot(monthPayload, settings);
        const endpoint = restoreToCenhub ? 'sync-ghl' : 'use-meta';
        const result = await adminFetch(
          `/api/meta-reports/clients/${encodeURIComponent(clientId)}/months/${encodeURIComponent(monthKey)}/${endpoint}`,
          {
            method: 'POST',
            body: restoreToCenhub ? JSON.stringify({ overwriteManual: true }) : '{}',
          },
        );
        onSuccess(result, monthKey);
        showToast(
          restoreToCenhub ? 'Cenhub data restored for this month' : 'Meta restored for this month',
          'success',
        );
      } catch (error) {
        showToast(error.message || 'Could not restore month data source', 'error');
      } finally {
        restoreBtn.disabled = false;
      }
    };
  }
}

function rebindMetaReportMonthPanelEvents(clientId, payload) {
  bindMetaReportsClientEditEvents(clientId, payload);
  if (isMetaReportGhlListClient(payload?.settings || {})) {
    bindMetaReportMonthManualEvents(clientId, payload);
    if (resolveClientToplineMode(payload.settings) === 'cenhub') {
      bindMetaToplineCenhubActionEvents({
        clientId,
        prefix: 'meta-report',
        getMonthKey: () => metaReportsState.activeMonthKey,
        getYear: () => metaReportsState.selectedYear,
        onMonthUpdated: async (result, monthKey) => {
          if (result?.monthPayload && monthKey) {
            refreshMetaReportMonthPanel(result.monthPayload);
          }
        },
      });
    }
  }
}

function bindMetaReportMonthManualEvents(clientId, payload) {
  bindMetaMonthSourceOverrideEvents(clientId, payload?.settings || {}, {
    prefix: 'meta-report',
    getMonthKey: () => metaReportsState.activeMonthKey,
    getMonthPayload: () => {
      const monthKey = metaReportsState.activeMonthKey;
      return monthKey ? payload?.months?.[monthKey] || null : null;
    },
    onSuccess: (result, monthKey) => {
      if (result?.monthPayload && monthKey) {
        payload.months = payload.months || {};
        payload.months[monthKey] = result.monthPayload;
        refreshMetaReportMonthPanel(result.monthPayload);
      }
    },
  });
}

function getMetaReportCalendarYear(payload) {
  const fromPayload = Number(payload?.currentYear);
  if (Number.isFinite(fromPayload) && fromPayload >= 2000) return fromPayload;
  return new Date().getFullYear();
}

function getMetaReportYearOptions(payload) {
  // Always anchor to calendar this/last year — never to the selected report year.
  const currentYear = getMetaReportCalendarYear(payload);
  const previousYear = currentYear - 1;
  const availability = new Map();
  if (Array.isArray(payload?.years)) {
    payload.years.forEach((entry) => {
      const year = Number(entry?.year);
      if (Number.isFinite(year)) availability.set(year, entry.available !== false);
    });
  }
  const previousAvailable = availability.has(previousYear)
    ? availability.get(previousYear)
    : payload?.previousYearHasData === true;
  return [
    { year: currentYear, available: true },
    { year: previousYear, available: Boolean(previousAvailable) },
  ];
}

function renderMetaReportYearSelectOptions(payload, { disableUnavailable = false } = {}) {
  const selectedYear = Number(metaReportsState.selectedYear) || Number(payload?.year);
  return getMetaReportYearOptions(payload).map(({ year, available }) => {
    const disabled = disableUnavailable && !available;
    return `<option value="${year}"${Number(selectedYear) === year ? ' selected' : ''}${disabled ? ' disabled' : ''}>${year}${!available ? ' (no data)' : ''}</option>`;
  }).join('');
}

function syncMetaReportSelectedYear(payload, { disableUnavailable = false } = {}) {
  const options = getMetaReportYearOptions(payload);
  const selected = Number(metaReportsState.selectedYear);
  const selectedOption = options.find((entry) => entry.year === selected);
  if (selectedOption && (!disableUnavailable || selectedOption.available)) {
    metaReportsState.selectedYear = selectedOption.year;
    return;
  }
  const payloadYear = Number(payload?.year);
  const payloadOption = options.find((entry) => entry.year === payloadYear);
  if (payloadOption && (!disableUnavailable || payloadOption.available)) {
    metaReportsState.selectedYear = payloadOption.year;
    return;
  }
  const fallback = options.find((entry) => entry.available) || options[0];
  if (fallback) metaReportsState.selectedYear = fallback.year;
}

function refreshMetaReportMonthPanel(monthPayload) {
  const payload = metaReportsState.clientPayload;
  if (!payload || !metaReportsState.activeMonthKey) return;
  payload.months = payload.months || {};
  payload.months[metaReportsState.activeMonthKey] = monthPayload;
  const panel = document.getElementById('meta-report-month-panel');
  if (!panel) return;
  syncMetaReportMonthPanelDom(
    monthPayload,
    getMetaReportMonthBodyOptions(payload.settings, { editable: true, yearPayload: payload }),
    payload,
  );
  rebindMetaReportMonthPanelEvents(payload.clientId, payload);
  refreshMetaReportBackfillControl(payload);
}

function refreshMetaReportBackfillControl(payload) {
  const toolbarLeft = document.querySelector('.meta-report-client-page .meta-report-toolbar-left');
  const wrap = document.querySelector('.meta-report-backfill-wrap');
  const missing = metaReportMonthsNeedingBackfill(payload);
  const label = missing.length
    ? `${ICON_SYNC} Backfill ${missing.length} month${missing.length === 1 ? '' : 's'} from Meta`
    : `${ICON_SYNC} Re-sync year from Meta`;
  const btn = document.getElementById('meta-report-backfill');
  if (btn) {
    btn.innerHTML = label;
    btn.disabled = false;
  } else if (toolbarLeft) {
    const div = document.createElement('div');
    div.className = 'meta-report-backfill-wrap';
    div.innerHTML = `
      <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="meta-report-backfill">${label}</button>
      <span class="meta-report-backfill-progress" id="meta-report-backfill-progress"></span>
    `;
    toolbarLeft.appendChild(div);
    bindMetaReportBackfillButton(payload.clientId);
  }
  if (wrap && !btn && !toolbarLeft) wrap.remove();
}

function updateMetaReportsClientContent(payload) {
  metaReportsState.clientPayload = payload;
  metaReportsState.chartProjection = null;
  const monthKeys = payload.monthKeys || [];
  if (!metaReportsState.activeMonthKey) {
    metaReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  } else if (!monthKeys.includes(metaReportsState.activeMonthKey)) {
    metaReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  }

  syncMetaReportSelectedYear(payload, { disableUnavailable: true });
  const yearSelect = document.getElementById('meta-report-year');
  if (yearSelect) {
    yearSelect.innerHTML = renderMetaReportYearSelectOptions(payload, { disableUnavailable: true });
  }

  syncMetaReportToolbarCopy(payload);
  refreshMetaReportClientShareUi(payload);

  const settings = payload.settings || {};
  const monthPayload = payload.months?.[metaReportsState.activeMonthKey] || null;
  syncMetaReportSettingsControls(settings, monthPayload);

  const tabsEl = document.querySelector('.meta-report-tabs');
  if (tabsEl) {
    tabsEl.innerHTML = renderMetaReportsClientTabs(payload);
    bindMetaReportsClientTabEvents(payload);
  }

  syncMetaReportToplineSourceBar(payload);

  const panel = document.getElementById('meta-report-month-panel');
  if (panel) {
    syncMetaReportMonthPanelDom(
      payload.months?.[metaReportsState.activeMonthKey],
      getMetaReportMonthBodyOptions(settings, { editable: true, yearPayload: payload }),
      payload,
    );
    rebindMetaReportMonthPanelEvents(payload.clientId, payload);
  }
  refreshMetaReportBackfillControl(payload);
  void ensureMetaReportScenarioSource(payload, { editable: true });
}

function updatePublicMetaReportContent(payload) {
  const activePayload = payload?.reportKind === 'dual' ? captureDualPublicPayload(payload) : payload;
  metaReportsState.publicPayload = activePayload;
  const isGoogleAds = activePayload.reportKind === 'google-ads'
    || linkedReportsState.activePlatform === 'google-ads';
  const uiPayload = isGoogleAds ? googleAdsPayloadToMetaUiShape(activePayload) : activePayload;
  syncMetaReportPublicBranding(uiPayload);
  const subtitleEl = document.getElementById('meta-report-public-subtitle');
  if (subtitleEl) {
    subtitleEl.textContent = isGoogleAds ? 'Google Ads performance report' : 'Meta ads performance report';
  }
  document.querySelectorAll('[data-linked-platform]').forEach((tab) => {
    const on = tab.getAttribute('data-linked-platform') === (linkedReportsState.activePlatform || (isGoogleAds ? 'google-ads' : 'meta'));
    tab.classList.toggle('is-active', on);
    tab.setAttribute('aria-selected', on ? 'true' : 'false');
  });
  refreshClientFacingTopbar();
  updateMetaReportPublicExcelSheetButton(uiPayload.settings || {});
  const monthKeys = uiPayload.monthKeys || [];
  if (!metaReportsState.activeMonthKey) {
    metaReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  } else if (!monthKeys.includes(metaReportsState.activeMonthKey)) {
    metaReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  }

  syncMetaReportSelectedYear(uiPayload, { disableUnavailable: true });
  const yearSelect = document.getElementById('meta-report-year');
  if (yearSelect) {
    yearSelect.innerHTML = renderMetaReportYearSelectOptions(uiPayload, { disableUnavailable: true });
  }

  const tabsEl = document.querySelector('.meta-report-tabs');
  if (tabsEl) {
    tabsEl.innerHTML = monthKeys.map((key) => `
      <button type="button" class="meta-report-tab${key === metaReportsState.activeMonthKey ? ' is-active' : ''}" data-meta-month-tab="${esc(key)}">${esc(metaMonthLabel(key))}</button>
    `).join('');
    bindPublicMetaReportTabEvents(activePayload);
  }

  const panel = document.getElementById('meta-report-month-panel');
  if (panel) {
    if (isGoogleAds) {
      panel.innerHTML = renderGoogleAdsReportMonthBody(
        uiPayload.months?.[metaReportsState.activeMonthKey],
        { editable: false, yearPayload: uiPayload, activeMonthKey: metaReportsState.activeMonthKey },
      );
      requestAnimationFrame(() => {
        mountMetaReportCharts(uiPayload, { editable: false });
      });
    } else {
      syncMetaReportMonthPanelDom(
        uiPayload.months?.[metaReportsState.activeMonthKey],
        getMetaReportMonthBodyOptions(uiPayload.settings, { editable: false }),
        uiPayload,
      );
    }
  }
}

const META_MONTH_LABELS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const META_MONTH_LABELS_FULL = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];

function metaFmtKr(value) {
  const amount = Number(value) || 0;
  return `Dkr ${amount.toLocaleString('da-DK', { minimumFractionDigits: 0, maximumFractionDigits: 2 })}`;
}

function metaFmtNum(value, digits = 0) {
  const amount = Number(value) || 0;
  return amount.toLocaleString('da-DK', { minimumFractionDigits: digits, maximumFractionDigits: digits });
}

function metaReportFmtBaselineAmount(value) {
  const amount = Number(value) || 0;
  if (amount <= 0) return '—';
  return metaFmtKr(amount);
}

function metaFmtX(value) {
  const amount = Number(value);
  if (!Number.isFinite(amount)) return '—';
  if (amount === 0) return '0.00x';
  return `${amount.toFixed(2)}x`;
}

function metaMonthLabel(monthKey) {
  const month = Number(String(monthKey || '').slice(5, 7));
  return META_MONTH_LABELS[month - 1] || monthKey;
}

function metaMonthLabelFull(monthKey) {
  const month = Number(String(monthKey || '').slice(5, 7));
  return META_MONTH_LABELS_FULL[month - 1] || metaMonthLabel(monthKey);
}

function metaReportMonthBounds(monthKey) {
  const normalized = String(monthKey || '').trim();
  if (!/^\d{4}-\d{2}$/.test(normalized)) return { start: '', end: '' };
  const [year, month] = normalized.split('-').map(Number);
  const daysInMonth = new Date(year, month, 0).getDate();
  const monthPart = String(month).padStart(2, '0');
  return {
    start: `${year}-${monthPart}-01`,
    end: `${year}-${monthPart}-${String(daysInMonth).padStart(2, '0')}`,
  };
}

function metaReportMonthPeriodAligned(monthPayload) {
  if (!monthPayload?.monthKey) return true;
  const bounds = metaReportMonthBounds(monthPayload.monthKey);
  const start = String(monthPayload.periodStart || '').slice(0, 10);
  const end = String(monthPayload.periodEnd || '').slice(0, 10);
  if (start === bounds.start && end === bounds.end) return true;
  const spend = Number(monthPayload.meta?.spend ?? monthPayload.google?.spend) || 0;
  // Trust fetched ad snapshots when the API already normalized the period.
  if (monthPayload.metaFetchedAt && spend > 0) return true;
  if (monthPayload.googleFetchedAt && spend > 0) return true;
  return false;
}

function resolveMetaReportActiveMonthPayload(payload = null) {
  const livePayload = payload || metaReportsState.clientPayload || metaReportsState.publicPayload;
  const activeKey = metaReportsState.activeMonthKey;
  if (!livePayload || !activeKey) return null;
  return livePayload.months?.[activeKey] || null;
}

function switchMetaReportMonthTab(monthKey, { editable = false } = {}) {
  if (!monthKey) return;
  if (metaReportsState.reportViewMode === 'comparison') {
    metaReportsState.reportViewMode = 'monthly';
  }
  metaReportsState.activeMonthKey = monthKey;

  const payload = metaReportsState.clientPayload || metaReportsState.publicPayload;
  if (!payload) return;

  document.querySelectorAll('[data-meta-month-tab]').forEach((tab) => {
    tab.classList.toggle('is-active', tab.getAttribute('data-meta-month-tab') === monthKey);
  });

  const publicGoogle = !editable && (
    payload.reportKind === 'google-ads'
    || linkedReportsState.activePlatform === 'google-ads'
  );
  if (publicGoogle) {
    const raw = payload.reportKind === 'google-ads'
      ? payload
      : (linkedReportsState.googlePayload || payload);
    const uiPayload = googleAdsPayloadToMetaUiShape(raw);
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) {
      panel.innerHTML = renderGoogleAdsReportMonthBody(
        uiPayload.months?.[monthKey],
        { editable: false, yearPayload: uiPayload, activeMonthKey: monthKey },
      );
      requestAnimationFrame(() => {
        mountMetaReportCharts(uiPayload, { editable: false });
      });
    }
    return;
  }

  if (editable) {
    /* topline section re-rendered via refreshMetaReportMonthPanel */
  }

  const { series } = resolveMetaReportChartSeries(payload, { allowDemo: !editable });
  if (series.length) metaReportsState.chartSeries = series;

  void (async () => {
    const monthPayload = payload.months?.[monthKey];
    if (
      editable
      && payload.clientId
      && monthPayload
      && !metaReportMonthPeriodAligned(monthPayload)
    ) {
      try {
        const result = await adminFetch(
          `/api/meta-reports/clients/${encodeURIComponent(payload.clientId)}/months/${encodeURIComponent(monthKey)}`,
        );
        if (result?.monthPayload) {
          payload.months[monthKey] = result.monthPayload;
        }
      } catch (_) {
        /* keep local payload if refetch fails */
      }
    }

    syncMetaReportMonthPanelDom(null, getMetaReportMonthBodyOptions(payload.settings || {}, {
      editable,
      yearPayload: payload,
    }), payload);

    if (editable && payload.clientId) {
      rebindMetaReportMonthPanelEvents(payload.clientId, payload);
    }

    syncMetaReportSettingsControls(payload.settings || {}, resolveMetaReportActiveMonthPayload(payload));

    void ensureMetaReportScenarioSource(payload, { editable }).then(() => {
      syncMetaReportScenario(payload);
    });
  })();
}

function metaReportMonthsNeedingBackfill(payload) {
  const monthKeys = payload?.monthKeys || [];
  return monthKeys.filter((key) => !payload.months?.[key]?.metaFetchedAt);
}

function metaReportTone(value) {
  const amount = Number(value);
  if (!Number.isFinite(amount) || amount === 0) return 'neutral';
  return amount > 0 ? 'positive' : 'negative';
}

function renderMetaReportHighlightStrip(monthPayload) {
  if (!monthPayload || monthPayload.meta?.emptyMonth) return '';
  const roasX = Number(monthPayload.topline?.roasX) || 0;
  const items = [
    { label: 'Ad spend', value: metaFmtKr(monthPayload.meta?.spend), tone: 'neutral' },
    { label: 'Leads', value: metaFmtNum(monthPayload.topline?.leads), tone: 'neutral' },
    { label: 'Return on ad spend', value: metaFmtX(roasX), tone: metaReportTone(roasX) },
  ];
  if (monthPayload.bottomline) {
    const useFee = Number(monthPayload.bottomline.feePercent) > 0;
    const profitValue = useFee ? monthPayload.bottomline.poiKr : monthPayload.bottomline.poasKr;
    items.push({
      label: useFee ? 'Profit on investment' : 'Profit on ad spend',
      value: metaFmtKr(profitValue),
      tone: metaReportTone(profitValue),
    });
  } else {
    items.push({
      label: 'Won leads',
      value: metaFmtNum(monthPayload.topline?.wonLeads),
      tone: 'neutral',
    });
  }
  return `
    <div class="meta-report-highlight-strip">
      ${items.map(({ label, value, tone }) => `
        <div class="meta-report-highlight-item${tone && tone !== 'neutral' ? ` is-${tone}` : ''}">
          <div class="meta-report-highlight-label">${esc(label)}</div>
          <div class="meta-report-highlight-value">${esc(value)}</div>
        </div>
      `).join('')}
    </div>
  `;
}

function renderMetaReportMetricTable(title, rows, accent = 'meta', { badge = '', highlightLastN = 0 } = {}) {
  const rowsHtml = rows.map(([label, value, unit], index) => {
    const isHighlight = highlightLastN > 0 && index >= rows.length - highlightLastN;
    return `
      <tr class="${isHighlight ? `is-highlight accent-${accent}` : ''}">
        <th scope="row">${esc(label)}</th>
        <td>${esc(String(value ?? '—'))}${unit ? `<span class="meta-report-row-unit">${esc(unit)}</span>` : ''}</td>
      </tr>
    `;
  }).join('');
  return `
    <section class="meta-report-group">
      <div class="meta-report-group-head">
        <span class="meta-report-group-bar meta-report-group-bar--${accent}" aria-hidden="true"></span>
        <h3 class="meta-report-group-title">${esc(title)}</h3>
        ${badge ? `<span class="meta-report-group-badge">${esc(badge)}</span>` : ''}
      </div>
      <div class="meta-report-group-table-wrap">
        <table class="meta-report-group-table">
          <tbody>${rowsHtml}</tbody>
        </table>
      </div>
    </section>
  `;
}

function getMetaReportMonthBodyOptions(settings = {}, { editable = false, yearPayload = null } = {}) {
  return { editable, yearPayload, settings };
}

function shouldShowMetaReportYearVisuals(monthPayload, yearPayload, { editable = false } = {}) {
  if (!monthPayload || monthPayload.meta?.emptyMonth) return false;
  if (!yearPayload) return false;
  const { series, demo } = resolveMetaReportChartSeries(yearPayload, { allowDemo: !editable });
  const adMonths = series.filter((point) => point.hasData).length;
  if (adMonths < META_REPORT_CHART_MIN_POINTS) return false;
  if (demo) return false;
  return true;
}

const META_REPORT_CHART_MIN_POINTS = 2;
const META_REPORT_SCENARIO_MAX_HISTORICAL = 9;
const META_REPORT_SCENARIO_PROJECTED_MONTHS = 4;
const META_REPORT_SPEND_CHART_TYPE_OPTIONS = [
  { value: 'area', label: 'Area' },
  { value: 'bar', label: 'Bar' },
];

const META_REPORT_SCENARIO_MONTH_WINDOW_OPTIONS = [
  { value: '3', label: 'Last 3 ad months' },
  { value: '6', label: 'Last 6 ad months' },
  { value: '9', label: 'Last 9 ad months' },
  { value: '12', label: 'Last 12 ad months' },
  { value: 'all', label: 'All ad-active months' },
];

const META_REPORT_SCENARIO_FIXED_ELASTICITY = 0.80;
const META_SCENARIO_TREND_R_THRESHOLD = 0.35;

const META_REPORT_SCENARIO_MODEL_PILLS = [
  { id: 'scenarioSmoothUneven', label: 'Remove uneven months', defaultOn: true },
  { id: 'scenarioBlendHistory', label: 'Balance recent months', defaultOn: false },
  { id: 'scenarioIncludeTrend', label: 'Follow trend', defaultOn: false },
];

function normalizeMetaReportSpendChartType(value) {
  const normalized = String(value || 'area').trim().toLowerCase();
  return META_REPORT_SPEND_CHART_TYPE_OPTIONS.some((entry) => entry.value === normalized)
    ? normalized
    : 'area';
}

function hydrateMetaReportSpendChartType(payload) {
  metaReportsState.spendChartType = normalizeMetaReportSpendChartType(
    payload?.settings?.metaReportSpendChartType,
  );
}

function normalizeMetaReportScenarioPill(value, fallback = false) {
  if (typeof value === 'boolean') return value;
  if (value == null) return fallback;
  const normalized = String(value).trim().toLowerCase();
  if (normalized === 'true' || normalized === '1') return true;
  if (normalized === 'false' || normalized === '0') return false;
  return fallback;
}

function normalizeMetaReportScenarioMonthWindow(value) {
  const normalized = String(value || '6').trim().toLowerCase();
  return META_REPORT_SCENARIO_MONTH_WINDOW_OPTIONS.some((entry) => entry.value === normalized)
    ? normalized
    : '6';
}

function normalizeMetaReportBudgetBaseline(value) {
  const normalized = String(value || 'year').trim().toLowerCase();
  if (normalized === 'month' || normalized === 'last') return normalized;
  return 'year';
}

function normalizeMetaReportBudgetMultiplier(value) {
  const parsed = Number.parseFloat(value);
  if (!Number.isFinite(parsed)) return 2;
  return Math.min(3, Math.max(0.5, Math.round(parsed * 10) / 10));
}

function getMetaReportScenarioPillsFromState() {
  return {
    smoothUneven: Boolean(metaReportsState.scenarioSmoothUneven),
    blendHistory: Boolean(metaReportsState.scenarioBlendHistory),
    includeTrend: Boolean(metaReportsState.scenarioIncludeTrend),
  };
}

function applyMetaReportScenarioPillsToState(pills = {}) {
  metaReportsState.scenarioSmoothUneven = Boolean(pills.smoothUneven);
  metaReportsState.scenarioBlendHistory = Boolean(pills.blendHistory);
  metaReportsState.scenarioIncludeTrend = Boolean(pills.includeTrend);
}

function describeActiveMetaReportScenarioPills() {
  return META_REPORT_SCENARIO_MODEL_PILLS
    .filter((pill) => Boolean(metaReportsState[pill.id]))
    .map((pill) => pill.label);
}

function hydrateMetaReportScenarioSettings(payload) {
  const settings = payload?.settings || {};
  metaReportsState.budgetMultiplier = normalizeMetaReportBudgetMultiplier(settings.metaReportBudgetMultiplier);
  metaReportsState.budgetBaseline = normalizeMetaReportBudgetBaseline(settings.metaReportBudgetBaseline);
  metaReportsState.scenarioMonthWindow = normalizeMetaReportScenarioMonthWindow(settings.metaReportScenarioMonthWindow);
  applyMetaReportScenarioPillsToState({
    smoothUneven: normalizeMetaReportScenarioPill(settings.metaReportScenarioSmoothUneven, true),
    blendHistory: normalizeMetaReportScenarioPill(settings.metaReportScenarioBlendHistory, false),
    includeTrend: normalizeMetaReportScenarioPill(settings.metaReportScenarioIncludeTrend, false),
  });
}

function renderMetaReportScenarioModelPills() {
  return `
    <div class="meta-report-scenario-pill-section" id="meta-report-scenario-pills-wrap">
      <div class="meta-report-scenario-pill-row" role="group" aria-label="Forecast options">
        ${META_REPORT_SCENARIO_MODEL_PILLS.map(({ id, label }) => {
          const active = Boolean(metaReportsState[id]);
          return `
            <button type="button" class="meta-report-scenario-pill${active ? ' is-active' : ''}" data-scenario-pill="${esc(id)}" aria-pressed="${active}">${esc(label)}</button>
          `;
        }).join('')}
      </div>
    </div>
  `;
}

function renderMetaReportSpendChartTypePicker({ editable = false } = {}) {
  const current = metaReportsState.spendChartType || 'area';
  return `
    <div class="meta-report-spend-chart-type" role="group" aria-label="Spend chart type">
      ${META_REPORT_SPEND_CHART_TYPE_OPTIONS.map(({ value, label }) => `
        <button type="button" class="meta-report-chart-toggle-btn${value === current ? ' is-active' : ''}" data-spend-chart-type="${esc(value)}"${editable ? '' : ' disabled'}>${esc(label)}</button>
      `).join('')}
    </div>
  `;
}

function isMetaReportCensioClient(payload) {
  const clientId = String(payload?.clientId || '').toLowerCase();
  const accountName = String(payload?.accountName || '');
  return clientId === 'censio' || /censio/i.test(accountName);
}

function monthHasChartData(monthPayload) {
  if (!monthPayload || monthPayload.meta?.emptyMonth) return false;
  if (!metaReportMonthPeriodAligned(monthPayload)) {
    const leads = Number(monthPayload.topline?.leads) || 0;
    return leads > 0;
  }
  const spend = Number(monthPayload.meta?.spend) || 0;
  const leads = Number(monthPayload.topline?.leads) || 0;
  return spend > 0 || leads > 0;
}

function buildMetaReportChartSeries(payload) {
  const monthKeys = payload?.monthKeys || [];
  const months = payload?.months || {};
  const series = [];

  for (const monthKey of monthKeys) {
    const monthPayload = months[monthKey];
    if (!monthPayload || monthPayload.meta?.emptyMonth) {
      series.push({
        monthKey,
        label: metaMonthLabel(monthKey),
        periodEnd: monthPayload?.periodEnd || null,
        roasKr: null,
        roasX: null,
        poasKr: null,
        poasX: null,
        spend: 0,
        leads: 0,
        wonLeads: 0,
        avgLeadValue: 0,
        avgProfitPerWon: 0,
        hasData: false,
      });
      continue;
    }

    const hasBottomline = Boolean(monthPayload.bottomline);

    series.push({
      monthKey,
      label: metaMonthLabel(monthKey),
      periodEnd: monthPayload.periodEnd || null,
      roasKr: Number(monthPayload.topline?.roasKr) || 0,
      roasX: Number(monthPayload.topline?.roasX) || 0,
      poasKr: hasBottomline ? (Number(monthPayload.bottomline.poasKr) || 0) : null,
      poasX: hasBottomline ? (Number(monthPayload.bottomline.poasX) || 0) : null,
      spend: Number(monthPayload.meta?.spend) || 0,
      leads: Number(monthPayload.topline?.leads) || 0,
      wonLeads: Number(monthPayload.topline?.wonLeads) || 0,
      avgLeadValue: Number(monthPayload.topline?.avgLeadValue) || 0,
      avgProfitPerWon: Number(monthPayload.inputs?.avgProfitPerWon) || 0,
      hasData: monthHasChartData(monthPayload),
    });
  }

  return series;
}

function getMetaReportDemoSeries(clientId, accountName, year, monthKeys) {
  const probe = { clientId, accountName };
  if (!isMetaReportCensioClient(probe)) return null;

  const now = new Date();
  const currentYear = now.getFullYear();
  const currentMonth = now.getMonth() + 1;
  const targetYear = Number(year) || currentYear;

  let keys = (monthKeys || []).filter((key) => {
    const keyYear = Number(String(key).slice(0, 4));
    const keyMonth = Number(String(key).slice(5, 7));
    if (keyYear !== targetYear) return false;
    if (targetYear === currentYear && keyMonth > currentMonth) return false;
    return true;
  });

  if (!keys.length) {
    const limit = targetYear === currentYear ? Math.min(8, currentMonth) : 8;
    keys = Array.from({ length: limit }, (_, index) => `${targetYear}-${String(index + 1).padStart(2, '0')}`);
  }

  return keys.map((monthKey, index) => {
    const t = keys.length > 1 ? index / (keys.length - 1) : 0;
    const spend = Math.round(8000 + t * 10000);
    const roasKr = Math.round(2000 + t * 15000);
    const roasX = Number((0.5 + t * 2.5).toFixed(2));
    const poasKr = Math.round(1500 + t * 12000);
    const poasX = Number((0.4 + t * 2.2).toFixed(2));
    const leads = Math.round(20 + t * 80);
    const wonLeads = Math.max(1, Math.round(leads * (0.08 + t * 0.04)));

    return {
      monthKey,
      label: metaMonthLabel(monthKey),
      roasKr,
      roasX,
      poasKr,
      poasX,
      spend,
      leads,
      wonLeads,
      avgLeadValue: 85000,
      avgProfitPerWon: 42000,
      hasData: true,
      demo: true,
    };
  });
}

function metaReportScenarioPointHasTopline(point) {
  return metaReportParseAmount(point?.spend) > 0
    && metaReportParseAmount(point?.leads) > 0
    && metaReportParseAmount(point?.wonLeads) > 0
    && metaReportParseAmount(point?.avgLeadValue) > 0;
}

function metaReportScenarioPointHasBottomlineInputs(point) {
  return metaReportScenarioPointHasTopline(point)
    && metaReportParseAmount(point?.avgProfitPerWon) > 0;
}

function filterMetaReportScenarioSeries(series = [], { hasBottomline = false } = {}) {
  const predicate = hasBottomline
    ? metaReportScenarioPointHasBottomlineInputs
    : metaReportScenarioPointHasTopline;
  return series.filter(predicate);
}

function resolveMetaReportChartSeries(payload, { allowDemo = true } = {}) {
  const real = buildMetaReportChartSeries(payload);
  const adMonths = real.filter((point) => point.hasData).length;
  if (adMonths >= META_REPORT_CHART_MIN_POINTS) {
    return { series: real, demo: false };
  }
  if (allowDemo && isMetaReportCensioClient(payload)) {
    const demo = getMetaReportDemoSeries(
      payload.clientId,
      payload.accountName,
      payload.year || metaReportsState.selectedYear,
      payload.monthKeys,
    );
    if (demo && demo.length >= META_REPORT_CHART_MIN_POINTS) {
      return { series: demo, demo: true };
    }
  }
  return { series: real, demo: false };
}

function metaReportParseAmount(value) {
  const parsed = Number.parseFloat(value);
  return Number.isFinite(parsed) ? parsed : 0;
}

function metaReportRoundMoney(value) {
  return Math.round(metaReportParseAmount(value) * 100) / 100;
}

function metaReportRoundRatio(value) {
  return Math.round(metaReportParseAmount(value) * 100000000) / 100000000;
}

function metaReportAggregateSeriesEfficiency(series = []) {
  let totalSpend = 0;
  let totalLeads = 0;
  let totalWon = 0;
  let weightedLeadValue = 0;
  let weightedProfit = 0;

  for (const point of series) {
    const spend = metaReportParseAmount(point.spend);
    const leads = metaReportParseAmount(point.leads);
    const wonLeads = metaReportParseAmount(point.wonLeads);
    if (spend <= 0 && leads <= 0) continue;
    totalSpend += spend;
    totalLeads += leads;
    totalWon += wonLeads;
    weightedLeadValue += wonLeads * metaReportParseAmount(point.avgLeadValue);
    weightedProfit += wonLeads * metaReportParseAmount(point.avgProfitPerWon);
  }

  const spendMonths = series.filter((point) => metaReportParseAmount(point.spend) > 0).length;
  return {
    avgCpl: totalLeads > 0 ? metaReportRoundMoney(totalSpend / totalLeads) : 0,
    winRate: totalLeads > 0 ? metaReportRoundRatio(totalWon / totalLeads) : 0,
    avgLeadValue: totalWon > 0 ? metaReportRoundMoney(weightedLeadValue / totalWon) : 0,
    avgProfitPerWon: totalWon > 0 ? metaReportRoundMoney(weightedProfit / totalWon) : 0,
    avgMonthlySpend: spendMonths > 0 ? metaReportRoundMoney(totalSpend / spendMonths) : 0,
  };
}

const META_SCENARIO_MIN_EFFICIENCY_MONTHS = 2;
const META_SCENARIO_MIN_TREND_MONTHS = 4;
const META_SCENARIO_SPEND_RAMP_CAP = 2;
const META_SCENARIO_MAD_MULTIPLIER = 2.5;
const META_SCENARIO_MAX_MONTHLY_TREND = 0.03;

function metaReportScenarioParseDate(value) {
  if (!value) return null;
  const text = String(value).slice(0, 10);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return null;
  const date = new Date(`${text}T12:00:00.000Z`);
  return Number.isNaN(date.getTime()) ? null : date;
}

function metaReportScenarioIsIncompleteMonth(point, asOfDate = new Date(), { hasBottomline = false } = {}) {
  const periodEnd = metaReportScenarioParseDate(point.periodEnd);
  if (!periodEnd) return true;
  const today = asOfDate.toISOString().slice(0, 10);
  if (String(point.periodEnd).slice(0, 10) < today) return false;
  const hasScenarioInputs = hasBottomline
    ? metaReportScenarioPointHasBottomlineInputs(point)
    : metaReportScenarioPointHasTopline(point);
  return !hasScenarioInputs;
}

function metaReportScenarioIsAdActive(point) {
  return metaReportParseAmount(point.spend) > 0 && metaReportParseAmount(point.leads) > 0;
}

function metaReportScenarioMedian(values = []) {
  const sorted = values.filter((value) => Number.isFinite(value)).slice().sort((a, b) => a - b);
  if (!sorted.length) return 0;
  const mid = Math.floor(sorted.length / 2);
  return sorted.length % 2 === 0 ? (sorted[mid - 1] + sorted[mid]) / 2 : sorted[mid];
}

function metaReportScenarioMad(values = []) {
  const med = metaReportScenarioMedian(values);
  return metaReportScenarioMedian(values.map((value) => Math.abs(value - med)));
}

function metaReportScenarioLinearRegression(points = []) {
  const n = points.length;
  if (n < 2) return { slope: 0, intercept: 0, r: 0 };
  let sumX = 0; let sumY = 0; let sumXY = 0; let sumXX = 0; let sumYY = 0;
  for (const point of points) {
    const x = metaReportParseAmount(point.x);
    const y = metaReportParseAmount(point.y);
    sumX += x; sumY += y; sumXY += x * y; sumXX += x * x; sumYY += y * y;
  }
  const denom = (n * sumXX) - (sumX * sumX);
  if (denom === 0) return { slope: 0, intercept: sumY / n, r: 0 };
  const slope = ((n * sumXY) - (sumX * sumY)) / denom;
  const intercept = (sumY - (slope * sumX)) / n;
  const rDenom = Math.sqrt(((n * sumXX) - (sumX * sumX)) * ((n * sumYY) - (sumY * sumY)));
  const r = rDenom > 0 ? ((n * sumXY) - (sumX * sumY)) / rDenom : 0;
  return { slope, intercept, r };
}

function metaReportScenarioEnrichMonth(point) {
  const spend = metaReportParseAmount(point.spend);
  const leads = metaReportParseAmount(point.leads);
  const wonLeads = metaReportParseAmount(point.wonLeads);
  const avgLeadValue = metaReportParseAmount(point.avgLeadValue);
  const avgProfitPerWon = metaReportParseAmount(point.avgProfitPerWon);
  const totalLeadValue = metaReportRoundMoney(wonLeads * avgLeadValue);
  const totalProfit = metaReportRoundMoney(wonLeads * avgProfitPerWon);
  return {
    ...point,
    spend,
    leads,
    wonLeads,
    avgLeadValue,
    avgProfitPerWon,
    cpl: leads > 0 ? metaReportRoundMoney(spend / leads) : 0,
    totalLeadValue,
    totalProfit,
    efficiencyIndex: spend > 0 ? totalLeadValue / spend : 0,
    profitEfficiencyIndex: spend > 0 ? totalProfit / spend : 0,
  };
}

function metaReportPrepareScenarioSeries(series = [], {
  windowMonths = '6',
  asOfDate = new Date(),
  smoothOutliers = true,
  hasBottomline = false,
} = {}) {
  const windowLimit = normalizeMetaReportScenarioMonthWindow(windowMonths) === 'all'
    ? Infinity
    : Number.parseInt(normalizeMetaReportScenarioMonthWindow(windowMonths), 10) || 6;
  const adActive = series
    .filter(metaReportScenarioIsAdActive)
    .filter((point) => !metaReportScenarioIsIncompleteMonth(point, asOfDate, { hasBottomline }))
    .map(metaReportScenarioEnrichMonth);
  const monthsAvailable = adActive.length;
  const windowed = windowLimit === Infinity ? adActive : adActive.slice(-windowLimit);
  let outliersAdjusted = 0;
  let months = windowed;
  if (smoothOutliers && windowed.length >= 3) {
    const cplValues = windowed.map((point) => metaReportParseAmount(point.cpl));
    const leadValues = windowed.map((point) => metaReportParseAmount(point.leads));
    const cplMed = metaReportScenarioMedian(cplValues);
    const leadMed = metaReportScenarioMedian(leadValues);
    const cplMad = metaReportScenarioMad(cplValues);
    const leadMad = metaReportScenarioMad(leadValues);
    months = windowed.map((point) => {
      const next = { ...point };
      let changed = false;
      const originalLeads = metaReportParseAmount(point.leads);
      if (cplMad > 0) {
        const lower = cplMed - (META_SCENARIO_MAD_MULTIPLIER * cplMad);
        const upper = cplMed + (META_SCENARIO_MAD_MULTIPLIER * cplMad);
        const cappedCpl = Math.min(upper, Math.max(lower, metaReportParseAmount(point.cpl)));
        if (cappedCpl !== metaReportParseAmount(point.cpl)) {
          next.cpl = metaReportRoundMoney(cappedCpl);
          next.leads = Math.max(1, Math.round(metaReportParseAmount(point.spend) / cappedCpl));
          changed = true;
        }
      }
      if (leadMad > 0) {
        const lower = leadMed - (META_SCENARIO_MAD_MULTIPLIER * leadMad);
        const upper = leadMed + (META_SCENARIO_MAD_MULTIPLIER * leadMad);
        const cappedLeads = Math.min(upper, Math.max(lower, metaReportParseAmount(point.leads)));
        if (Math.round(cappedLeads) !== Math.round(originalLeads)) {
          next.leads = Math.max(1, Math.round(cappedLeads));
          changed = true;
        }
      }
      if (changed) {
        outliersAdjusted += 1;
        const monthWinRate = originalLeads > 0
          ? metaReportParseAmount(point.wonLeads) / originalLeads
          : 0;
        const rescaledLeads = metaReportParseAmount(next.leads);
        next.wonLeads = Math.max(0, Math.round(rescaledLeads * monthWinRate));
        next.totalLeadValue = metaReportRoundMoney(next.wonLeads * metaReportParseAmount(point.avgLeadValue));
        const spend = metaReportParseAmount(next.spend);
        next.totalProfit = metaReportRoundMoney(next.wonLeads * metaReportParseAmount(point.avgProfitPerWon));
        next.efficiencyIndex = spend > 0 ? next.totalLeadValue / spend : 0;
        next.profitEfficiencyIndex = spend > 0 ? next.totalProfit / spend : 0;
      }
      return next;
    });
  }
  return {
    months,
    monthsAvailable,
    monthsUsed: months.length,
    outliersAdjusted,
    confidence: metaReportResolveScenarioConfidence(months.length),
  };
}

function metaReportScenarioRecencyEfficiency(months = []) {
  if (months.length < META_SCENARIO_MIN_EFFICIENCY_MONTHS) return null;
  let weightedSpend = 0; let weightedLeads = 0; let weightedWon = 0;
  let weightedLeadValue = 0; let weightedProfit = 0; let totalSpend = 0;
  months.forEach((point, index) => {
    const weight = index + 1;
    weightedSpend += metaReportParseAmount(point.spend) * weight;
    weightedLeads += metaReportParseAmount(point.leads) * weight;
    weightedWon += metaReportParseAmount(point.wonLeads) * weight;
    weightedLeadValue += metaReportParseAmount(point.wonLeads) * metaReportParseAmount(point.avgLeadValue) * weight;
    weightedProfit += metaReportParseAmount(point.wonLeads) * metaReportParseAmount(point.avgProfitPerWon) * weight;
    totalSpend += metaReportParseAmount(point.spend);
  });
  return {
    avgCpl: weightedLeads > 0 ? metaReportRoundMoney(weightedSpend / weightedLeads) : 0,
    winRate: weightedLeads > 0 ? metaReportRoundRatio(weightedWon / weightedLeads) : 0,
    avgLeadValue: weightedWon > 0 ? metaReportRoundMoney(weightedLeadValue / weightedWon) : 0,
    avgProfitPerWon: weightedWon > 0 ? metaReportRoundMoney(weightedProfit / weightedWon) : 0,
    avgMonthlySpend: months.length > 0 ? metaReportRoundMoney(totalSpend / months.length) : 0,
  };
}

function metaReportScenarioPooledEfficiency(months = []) {
  return metaReportAggregateSeriesEfficiency(months);
}

function metaReportScenarioBlendEfficiency(left, right, leftWeight = 0.5) {
  if (!left || !right) return left || right;
  const rightWeight = 1 - leftWeight;
  return {
    avgCpl: metaReportRoundMoney((left.avgCpl * leftWeight) + (right.avgCpl * rightWeight)),
    winRate: metaReportRoundRatio((left.winRate * leftWeight) + (right.winRate * rightWeight)),
    avgLeadValue: metaReportRoundMoney((left.avgLeadValue * leftWeight) + (right.avgLeadValue * rightWeight)),
    avgProfitPerWon: metaReportRoundMoney((left.avgProfitPerWon * leftWeight) + (right.avgProfitPerWon * rightWeight)),
    avgMonthlySpend: metaReportRoundMoney((left.avgMonthlySpend * leftWeight) + (right.avgMonthlySpend * rightWeight)),
  };
}

function metaReportEfficiencyFromPreparedMonth(point) {
  const leads = metaReportParseAmount(point.leads);
  const wonLeads = metaReportParseAmount(point.wonLeads);
  return {
    avgCpl: metaReportParseAmount(point.cpl),
    winRate: leads > 0 ? metaReportRoundRatio(wonLeads / leads) : 0,
    avgLeadValue: metaReportParseAmount(point.avgLeadValue),
    avgProfitPerWon: metaReportParseAmount(point.avgProfitPerWon),
    avgMonthlySpend: metaReportParseAmount(point.spend),
  };
}

function metaReportResolveScenarioProjectionEfficiency(prepared, recencyEfficiency, {
  hasBottomline = false,
  activeMonthKey = null,
  asOfDate = new Date(),
} = {}) {
  const months = prepared?.months || [];
  if (!months.length || !recencyEfficiency) return recencyEfficiency;
  const last = months[months.length - 1];
  const targetKey = activeMonthKey || metaReportMonthKeyFromDate(asOfDate);
  if (!targetKey || last.monthKey !== targetKey) return recencyEfficiency;
  const hasInputs = hasBottomline
    ? metaReportScenarioPointHasBottomlineInputs(last)
    : metaReportScenarioPointHasTopline(last);
  if (!hasInputs) return recencyEfficiency;
  return metaReportScenarioBlendEfficiency(
    metaReportEfficiencyFromPreparedMonth(last),
    recencyEfficiency,
    0.65,
  );
}

function metaReportScenarioMonthlyTrend(months = [], elasticity = 0.75, {
  dampenHotStreak = false,
  metricKey = 'efficiencyIndex',
} = {}) {
  if (months.length < META_SCENARIO_MIN_TREND_MONTHS) {
    return { trendRate: 0, trendDirection: 'flat', trendRatePct: 0, trendR: 0 };
  }
  const spends = months.map((point) => metaReportParseAmount(point.spend)).filter((value) => value > 0);
  const medianSpend = metaReportScenarioMedian(spends) || 1;
  const residuals = months.map((point, index) => {
    const spend = metaReportParseAmount(point.spend);
    const metricValue = metaReportParseAmount(point[metricKey]);
    const safeEfficiency = metricValue > 0 ? metricValue : 0.000001;
    const safeSpend = spend > 0 ? spend : medianSpend;
    return {
      x: index,
      y: Math.log(safeEfficiency) - (elasticity * Math.log(safeSpend / medianSpend)),
    };
  });
  const { slope, r } = metaReportScenarioLinearRegression(residuals);
  let trendRate = Math.max(-META_SCENARIO_MAX_MONTHLY_TREND, Math.min(META_SCENARIO_MAX_MONTHLY_TREND, slope));
  if (dampenHotStreak) {
    const efficiencyValues = months.map((point) => metaReportParseAmount(point[metricKey])).filter((value) => value > 0);
    const fullMedian = metaReportScenarioMedian(efficiencyValues);
    const recentAvg = months.slice(-3).reduce((sum, point) => sum + metaReportParseAmount(point[metricKey]), 0) / Math.min(3, months.length);
    if (fullMedian > 0 && recentAvg > fullMedian * 1.15 && trendRate > 0) trendRate *= 0.5;
  }
  let trendDirection = 'flat';
  if (Math.abs(trendRate) >= 0.005) trendDirection = trendRate > 0 ? 'up' : 'down';
  return { trendRate, trendDirection, trendRatePct: metaReportRoundRatio(trendRate * 100), trendR: metaReportRoundRatio(r) };
}

function metaReportScenarioCalibrateElasticity() {
  return META_REPORT_SCENARIO_FIXED_ELASTICITY;
}

function metaReportResolveScenarioConfidence(monthsUsed = 0) {
  const count = Number.parseInt(monthsUsed, 10) || 0;
  if (count < 4) return 'low';
  if (count < 7) return 'medium';
  return 'high';
}

function metaReportComputeScenarioEfficiency(months = [], {
  blendHistory = false,
  includeTrend = false,
  cautionStrongMonths = false,
  hasBottomline = false,
} = {}) {
  const presetElasticity = META_REPORT_SCENARIO_FIXED_ELASTICITY;
  const elasticity = metaReportScenarioCalibrateElasticity();
  const recencyWeighted = metaReportScenarioRecencyEfficiency(months);
  const pooled = metaReportScenarioPooledEfficiency(months);
  if (!recencyWeighted || recencyWeighted.avgCpl <= 0) {
    return { efficiency: null, elasticity, presetElasticity, trendRate: 0, trendDirection: 'flat', trendRatePct: 0, trendR: 0 };
  }
  const efficiency = blendHistory ? metaReportScenarioBlendEfficiency(pooled, recencyWeighted, 0.5) : recencyWeighted;
  let trendInfo = { trendRate: 0, trendDirection: 'flat', trendRatePct: 0, trendR: 0 };
  if (includeTrend) {
    const trendMetricKey = hasBottomline ? 'profitEfficiencyIndex' : 'efficiencyIndex';
    const computedTrend = metaReportScenarioMonthlyTrend(months, elasticity, {
      dampenHotStreak: cautionStrongMonths,
      metricKey: trendMetricKey,
    });
    if (Math.abs(computedTrend.trendR) >= META_SCENARIO_TREND_R_THRESHOLD) trendInfo = computedTrend;
  }
  return { efficiency, elasticity, presetElasticity, ...trendInfo };
}

function metaReportProjectBudgetAtSpend({
  baselineSpend,
  spend,
  efficiency,
  elasticity = 0.75,
  trendAdj = 1,
  hasBottomline = false,
} = {}) {
  const baseSpend = metaReportParseAmount(baselineSpend);
  const amount = metaReportParseAmount(spend);
  if (amount <= 0 || baseSpend <= 0 || !efficiency || efficiency.avgCpl <= 0) {
    return { spend: 0, leads: 0, wonLeads: 0, totalLeadValue: 0, roasKr: 0, roasX: 0, poasKr: null, poasX: null };
  }
  const baselineLeads = baseSpend / efficiency.avgCpl;
  const spendMultiplier = amount / baseSpend;
  const adjustedTrend = metaReportParseAmount(trendAdj) > 0 ? metaReportParseAmount(trendAdj) : 1;
  const leads = Math.max(0, Math.round(baselineLeads * (spendMultiplier ** elasticity) * adjustedTrend));
  const wonLeads = Math.round(leads * efficiency.winRate);
  const totalLeadValue = metaReportRoundMoney(wonLeads * efficiency.avgLeadValue);
  const roasKr = metaReportRoundMoney(totalLeadValue - amount);
  const roasX = amount > 0 ? metaReportRoundRatio(roasKr / amount) : 0;
  let poasKr = null;
  let poasX = null;
  if (hasBottomline && efficiency.avgProfitPerWon > 0) {
    const totalProfit = metaReportRoundMoney(wonLeads * efficiency.avgProfitPerWon);
    poasKr = metaReportRoundMoney(totalProfit - amount);
    poasX = amount > 0 ? metaReportRoundRatio(poasKr / amount) : 0;
  }
  return { spend: amount, leads, wonLeads, totalLeadValue, roasKr, roasX, poasKr, poasX };
}

function metaReportSpendFromMonthKey(series = [], payload = null, monthKey = null) {
  if (!monthKey) return 0;
  const monthPayload = payload?.months?.[monthKey];
  if (monthPayload && !monthPayload.meta?.emptyMonth && metaReportMonthPeriodAligned(monthPayload)) {
    const spend = metaReportParseAmount(monthPayload.meta?.spend ?? monthPayload.google?.spend);
    if (spend > 0) return spend;
  }
  const point = series.find((entry) => entry.monthKey === monthKey);
  return point ? metaReportParseAmount(point.spend) : 0;
}

function metaReportPrepareBaselineSpendWindow(series = [], {
  windowMonths = '6',
  asOfDate = new Date(),
} = {}) {
  const windowLimit = normalizeMetaReportScenarioMonthWindow(windowMonths) === 'all'
    ? Infinity
    : Number.parseInt(normalizeMetaReportScenarioMonthWindow(windowMonths), 10) || 6;
  const today = asOfDate.toISOString().slice(0, 10);
  const withSpend = series
    .filter((point) => metaReportParseAmount(point.spend) > 0)
    .filter((point) => {
      const periodEnd = String(point.periodEnd || '').slice(0, 10);
      return !periodEnd || periodEnd < today;
    });
  return windowLimit === Infinity ? withSpend : withSpend.slice(-windowLimit);
}

function resolveMetaReportWindowAverageBaselineSpend(spendMonths = []) {
  if (!spendMonths.length) return 0;
  const total = spendMonths.reduce((sum, point) => sum + metaReportParseAmount(point.spend), 0);
  return total > 0 ? metaReportRoundMoney(total / spendMonths.length) : 0;
}

function buildMetaReportScenarioProjection(series, payload) {
  const pills = getMetaReportScenarioPillsFromState();
  const scenarioPayload = resolveMetaReportScenarioPayload(payload) || payload;
  const hasBottomline = payloadHasMetaReportBottomline(scenarioPayload);
  const scenarioSeries = filterMetaReportScenarioSeries(series, { hasBottomline });
  return metaReportProjectBudgetScenario({
    series: scenarioSeries,
    multiplier: metaReportsState.budgetMultiplier,
    hasBottomline,
    blendHistory: pills.blendHistory,
    includeTrend: pills.includeTrend,
    monthWindow: metaReportsState.scenarioMonthWindow,
    baselineMode: metaReportsState.budgetBaseline,
    activeMonthKey: resolveMetaReportScenarioActiveMonthKey(scenarioPayload),
    smoothOutliers: pills.smoothUneven,
    payload: scenarioPayload,
  });
}

function isMetaReportViewingPastYear(payload) {
  const viewYear = Number(payload?.year || metaReportsState.selectedYear);
  const currentYear = getMetaReportCalendarYear(payload);
  return Number.isFinite(viewYear) && viewYear < currentYear;
}

function updateMetaReportScenarioSource(payload) {
  if (!payload) return;
  const calendarYear = getMetaReportCalendarYear(payload);
  if (Number(payload.year) !== calendarYear) return;
  const { series, demo } = resolveMetaReportChartSeries(payload, { allowDemo: false });
  if (!series.length || demo) {
    metaReportsState.scenarioSourcePayload = null;
    metaReportsState.scenarioSeries = null;
    return;
  }
  metaReportsState.scenarioSourcePayload = payload;
  metaReportsState.scenarioSeries = series;
}

function resolveMetaReportScenarioPayload(payload) {
  if (isMetaReportViewingPastYear(payload) && metaReportsState.scenarioSourcePayload) {
    return metaReportsState.scenarioSourcePayload;
  }
  return payload;
}

function resolveMetaReportScenarioSeries(payload) {
  if (metaReportsState.chartSeries?.length) {
    return metaReportsState.chartSeries;
  }
  if (isMetaReportViewingPastYear(payload)) {
    return metaReportsState.scenarioSeries || [];
  }
  return [];
}

function resolveMetaReportScenarioActiveMonthKey(payload) {
  if (isMetaReportViewingPastYear(payload)) {
    return metaReportMonthKeyFromDate(new Date());
  }
  return metaReportsState.activeMonthKey;
}

async function ensureMetaReportScenarioSource(payload, { editable = false } = {}) {
  if (!payload || !isMetaReportViewingPastYear(payload) || metaReportsState.scenarioSeries?.length) {
    return;
  }
  const currentYear = getMetaReportCalendarYear(payload);
  const clientId = payload.clientId;
  const isGoogleAds = payload.reportKind === 'google-ads';
  try {
    if (editable && clientId) {
      const reportsPath = isGoogleAds ? '/api/google-ads-reports' : '/api/meta-reports';
      const currentPayload = await adminFetch(
        `${reportsPath}/clients/${encodeURIComponent(clientId)}?year=${encodeURIComponent(currentYear)}`,
      );
      updateMetaReportScenarioSource(
        isGoogleAds ? googleAdsPayloadToMetaUiShape(currentPayload) : currentPayload,
      );
      return;
    }
    if (REPORT_TOKEN) {
      const currentPayload = await fetch(
        `/api/meta-reports/public/${encodeURIComponent(REPORT_TOKEN)}?year=${encodeURIComponent(currentYear)}`,
      ).then(async (response) => {
        const body = await response.json();
        if (!response.ok) throw new Error(body.error || 'Report not found');
        return body;
      });
      updateMetaReportScenarioSource(
        currentPayload.reportKind === 'google-ads'
          ? googleAdsPayloadToMetaUiShape(currentPayload)
          : currentPayload,
      );
    }
  } catch (_) {
    /* keep table/chart view usable even if scenario prefetch fails */
  }
}

function resolveMetaReportLastMonthBaseline(series = [], {
  activeMonthKey = null,
  asOfDate = new Date(),
  payload = null,
} = {}) {
  const referenceKey = activeMonthKey || metaReportMonthKeyFromDate(asOfDate);
  if (!referenceKey) return null;

  const previousKey = metaReportAddMonthsToMonthKey(referenceKey, -1);
  if (!previousKey) return null;

  const spendFromPayload = metaReportSpendFromMonthKey(series, payload, previousKey);
  if (spendFromPayload > 0) {
    return {
      monthKey: previousKey,
      label: metaMonthLabel(previousKey),
      spend: spendFromPayload,
    };
  }

  const sorted = series
    .filter((point) => metaReportParseAmount(point.spend) > 0)
    .sort((left, right) => String(left.monthKey).localeCompare(String(right.monthKey)));
  const previous = sorted.find((point) => point.monthKey === previousKey);
  if (!previous) return null;

  return {
    monthKey: previousKey,
    label: metaMonthLabel(previousKey),
    spend: metaReportParseAmount(previous.spend),
  };
}

function resolveMetaReportPreparedWindowAverageSpend(preparedMonths = []) {
  if (!preparedMonths.length) return 0;
  const total = preparedMonths.reduce((sum, point) => sum + metaReportParseAmount(point.spend), 0);
  return total > 0 ? metaReportRoundMoney(total / preparedMonths.length) : 0;
}

function resolveMetaReportLatestPreparedSpend(preparedMonths = []) {
  for (let index = preparedMonths.length - 1; index >= 0; index -= 1) {
    const spend = metaReportParseAmount(preparedMonths[index]?.spend);
    if (spend > 0) return spend;
  }
  return 0;
}

function resolveMetaReportScenarioBaselineSpend(series, prepared, {
  baselineMode = 'year',
  activeMonthKey = null,
  asOfDate = new Date(),
  payload = null,
} = {}) {
  const preparedMonths = prepared?.months || [];
  let spend = 0;

  if (baselineMode === 'month' && activeMonthKey) {
    spend = metaReportSpendFromMonthKey(series, payload, activeMonthKey);
    if (spend <= 0) {
      const month = preparedMonths.find((point) => point.monthKey === activeMonthKey);
      if (month && metaReportParseAmount(month.spend) > 0) {
        spend = metaReportParseAmount(month.spend);
      }
    }
  } else if (baselineMode === 'last') {
    const lastMonth = resolveMetaReportLastMonthBaseline(series, { activeMonthKey, asOfDate, payload });
    if (lastMonth?.spend > 0) spend = lastMonth.spend;
  } else if (baselineMode === 'year') {
    const spendWindow = metaReportPrepareBaselineSpendWindow(series, {
      windowMonths: metaReportsState.scenarioMonthWindow,
      asOfDate,
    });
    spend = resolveMetaReportWindowAverageBaselineSpend(spendWindow);
    if (spend <= 0) spend = resolveMetaReportPreparedWindowAverageSpend(preparedMonths);
  }

  if (spend <= 0) spend = resolveMetaReportPreparedWindowAverageSpend(preparedMonths);
  if (spend <= 0) spend = resolveMetaReportLatestPreparedSpend(preparedMonths);

  return spend;
}

function metaReportProjectBudgetScenario({
  series = [],
  baselineSpend,
  multiplier = 1,
  hasBottomline = false,
  blendHistory = false,
  includeTrend = false,
  cautionStrongMonths = false,
  monthWindow = '6',
  baselineMode = 'year',
  activeMonthKey = null,
  asOfDate = new Date(),
  smoothOutliers = true,
  payload = null,
} = {}) {
  const prepared = metaReportPrepareScenarioSeries(series, {
    windowMonths: monthWindow,
    asOfDate,
    smoothOutliers,
    hasBottomline,
  });
  const efficiencyResult = metaReportComputeScenarioEfficiency(prepared.months, {
    blendHistory,
    includeTrend,
    cautionStrongMonths,
    hasBottomline,
  });
  let resolvedBaselineSpend = metaReportParseAmount(baselineSpend);
  if (!resolvedBaselineSpend) {
    resolvedBaselineSpend = resolveMetaReportScenarioBaselineSpend(series, prepared, {
      baselineMode,
      activeMonthKey,
      asOfDate,
      payload,
    });
  }
  const mult = metaReportParseAmount(multiplier) || 1;
  let { efficiency, elasticity, trendRate } = efficiencyResult;
  efficiency = metaReportResolveScenarioProjectionEfficiency(prepared, efficiency, {
    hasBottomline,
    activeMonthKey,
    asOfDate,
  });
  const insufficientData = !efficiency
    || efficiency.avgCpl <= 0
    || resolvedBaselineSpend <= 0
    || prepared.monthsUsed < META_SCENARIO_MIN_EFFICIENCY_MONTHS;
  if (insufficientData) {
    return {
      ...efficiencyResult,
      efficiency,
      prepared,
      baseline: metaReportProjectBudgetAtSpend({ baselineSpend: 0, spend: 0, efficiency }),
      projected: metaReportProjectBudgetAtSpend({ baselineSpend: 0, spend: 0, efficiency }),
      projectedConservative: null,
      projectedOptimistic: null,
      multiplier: mult,
      baselineSpend: resolvedBaselineSpend,
      hasBottomline,
      insufficientData: true,
      insufficientReason: prepared.monthsUsed < META_SCENARIO_MIN_EFFICIENCY_MONTHS
        ? 'need_more_months'
        : resolvedBaselineSpend <= 0
          ? 'need_baseline_spend'
          : 'need_efficiency',
    };
  }
  const trendAdj = Math.exp(trendRate * 1);
  const baseline = metaReportProjectBudgetAtSpend({
    baselineSpend: resolvedBaselineSpend,
    spend: resolvedBaselineSpend,
    efficiency,
    elasticity,
    trendAdj: 1,
    hasBottomline,
  });
  const projected = metaReportProjectBudgetAtSpend({
    baselineSpend: resolvedBaselineSpend,
    spend: metaReportRoundMoney(resolvedBaselineSpend * mult),
    efficiency,
    elasticity,
    trendAdj,
    hasBottomline,
  });
  const projectedConservative = metaReportProjectBudgetAtSpend({
    baselineSpend: resolvedBaselineSpend,
    spend: metaReportRoundMoney(resolvedBaselineSpend * mult),
    efficiency,
    elasticity,
    trendAdj: Math.exp(Math.min(trendRate, 0) * 1),
    hasBottomline,
  });
  const projectedOptimistic = metaReportProjectBudgetAtSpend({
    baselineSpend: resolvedBaselineSpend,
    spend: metaReportRoundMoney(resolvedBaselineSpend * mult),
    efficiency,
    elasticity,
    trendAdj: Math.exp(Math.max(trendRate, 0) * 1),
    hasBottomline,
  });
  return {
    ...efficiencyResult,
    efficiency,
    prepared,
    baseline,
    projected,
    projectedConservative,
    projectedOptimistic,
    multiplier: mult,
    baselineSpend: resolvedBaselineSpend,
    hasBottomline,
    insufficientData: false,
  };
}

function metaReportBuildScenarioProjectionMonthKeys(count = META_REPORT_SCENARIO_PROJECTED_MONTHS, asOfDate = new Date()) {
  const currentKey = metaReportMonthKeyFromDate(asOfDate);
  if (!currentKey || count <= 0) return [];
  const keys = [];
  for (let step = 1; step <= count; step += 1) {
    keys.push(metaReportAddMonthsToMonthKey(currentKey, step));
  }
  return keys;
}

function metaReportResolveScenarioStepMultiplier(stepIndex, targetMultiplier = 1) {
  const targetMult = metaReportParseAmount(targetMultiplier) || 1;
  const step = Number.parseInt(stepIndex, 10) || 1;
  if (targetMult <= META_SCENARIO_SPEND_RAMP_CAP) return targetMult;
  if (step <= 1) return META_SCENARIO_SPEND_RAMP_CAP;
  return targetMult;
}

function buildMetaReportScenarioProjectionSteps(projection, {
  months = META_REPORT_SCENARIO_PROJECTED_MONTHS,
  hasBottomline = false,
  asOfDate = new Date(),
  targetMultiplier = null,
} = {}) {
  if (!projection || projection.insufficientData) return [];
  const baseSpend = metaReportParseAmount(projection.baselineSpend);
  const targetMult = metaReportParseAmount(targetMultiplier ?? projection.multiplier) || 1;
  const efficiency = projection.efficiency;
  const elasticity = projection.elasticity || 0.75;
  const trendRate = projection.trendRate || 0;
  const projectionMonthKeys = metaReportBuildScenarioProjectionMonthKeys(months, asOfDate);
  const steps = [];
  for (let step = 1; step <= months; step += 1) {
    const stepMult = metaReportResolveScenarioStepMultiplier(step, targetMult);
    const spend = metaReportRoundMoney(baseSpend * stepMult);
    const trendAdj = Math.exp(trendRate * step);
    const metrics = metaReportProjectBudgetAtSpend({
      baselineSpend: baseSpend,
      spend,
      efficiency,
      elasticity,
      trendAdj,
      hasBottomline,
    });
    const monthKey = projectionMonthKeys[step - 1] || null;
    steps.push({
      label: monthKey ? metaMonthLabel(monthKey) : `+${step} mo`,
      monthKey,
      spendMultiplier: metaReportRoundRatio(stepMult),
      spend: metrics.spend,
      leads: metrics.leads,
      wonLeads: metrics.wonLeads,
      totalLeadValue: metrics.totalLeadValue,
      roasKr: metrics.roasKr,
      roasX: metrics.roasX,
      poasKr: metrics.poasKr,
      poasX: metrics.poasX,
    });
  }
  return steps;
}

function metaReportSpendAxisTick(value) {
  const amount = Number(value) || 0;
  if (Math.abs(amount) >= 1000000) return `${(amount / 1000000).toFixed(1)}M`;
  if (Math.abs(amount) >= 1000) return `${Math.round(amount / 1000)}K`;
  return amount;
}

function metaReportSpendMultiplierValue(spend, baselineSpend) {
  const base = metaReportParseAmount(baselineSpend);
  const amount = metaReportParseAmount(spend);
  if (base <= 0) return 0;
  return metaReportRoundRatio(amount / base);
}

function resolveMetaReportSpendChartBaseline(series, projection = null) {
  const fromProjection = metaReportParseAmount(projection?.baselineSpend);
  if (fromProjection > 0) return fromProjection;
  return metaReportAggregateSeriesEfficiency(series).avgMonthlySpend;
}

function trimMetaReportScenarioSeries(series, maxMonths = META_REPORT_SCENARIO_MAX_HISTORICAL) {
  const filtered = series.filter((point) => metaReportParseAmount(point.spend) > 0);
  return filtered.length > maxMonths ? filtered.slice(-maxMonths) : filtered;
}

function metaReportMonthKeyFromDate(date = new Date()) {
  const value = date instanceof Date ? date : new Date(date);
  if (Number.isNaN(value.getTime())) return null;
  return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, '0')}`;
}

function metaReportAddMonthsToMonthKey(monthKey, offset = 0) {
  const normalized = String(monthKey || '').trim();
  if (!/^\d{4}-\d{2}$/.test(normalized)) return null;
  const [year, month] = normalized.split('-').map(Number);
  const date = new Date(year, (month - 1) + offset, 1);
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
}

function metaReportDeltaPct(nextValue, baseValue) {
  const base = metaReportParseAmount(baseValue);
  const next = metaReportParseAmount(nextValue);
  if (!base) return null;
  return metaReportRoundRatio(((next - base) / Math.abs(base)) * 100);
}

function metaReportFormatDeltaPct(value) {
  if (value == null || !Number.isFinite(value)) return '';
  const sign = value > 0 ? '+' : '';
  return `${sign}${value.toFixed(0)}%`;
}

function metaReportResolveBaselineSpend(payload, series, projection = null) {
  if (projection?.baselineSpend > 0) return metaReportParseAmount(projection.baselineSpend);
  const pills = getMetaReportScenarioPillsFromState();
  const hasBottomline = payloadHasMetaReportBottomline(payload);
  const prepared = projection?.prepared
    || metaReportPrepareScenarioSeries(series, {
      windowMonths: metaReportsState.scenarioMonthWindow,
      smoothOutliers: pills.smoothUneven,
      hasBottomline,
    });
  return resolveMetaReportScenarioBaselineSpend(series, prepared, {
    baselineMode: metaReportsState.budgetBaseline,
    activeMonthKey: resolveMetaReportScenarioActiveMonthKey(payload),
    payload,
  });
}

function resolveMetaReportScenarioDisplayTimeline(payload, fallbackSeries = []) {
  if (metaReportsState.chartSeries?.length) {
    return metaReportsState.chartSeries;
  }
  if (payload) {
    return buildMetaReportChartSeries(payload);
  }
  return fallbackSeries;
}

function resolveMetaReportScenarioActiveTimeline(series = []) {
  const currentKey = metaReportMonthKeyFromDate(new Date());
  return series.filter((point) => !currentKey || !point.monthKey || point.monthKey <= currentKey);
}

function resolveMetaReportScenarioAdActiveSeries(timeline, kind) {
  const activeTimeline = resolveMetaReportScenarioActiveTimeline(timeline);
  if (kind === 'poas') {
    return activeTimeline.filter((point) => (
      point.poasKr != null && point.poasX != null && metaReportParseAmount(point.spend) > 0
    ));
  }
  return activeTimeline.filter((point) => metaReportParseAmount(point.spend) > 0);
}

function resolveMetaReportScenarioLastAdActiveIndex(series = []) {
  return series.reduce((lastIndex, point, index) => (
    metaReportParseAmount(point.spend) > 0 ? index : lastIndex
  ), -1);
}

function resolveMetaReportScenarioMonthWindowLimit(windowValue = metaReportsState.scenarioMonthWindow) {
  const normalized = normalizeMetaReportScenarioMonthWindow(windowValue);
  if (normalized === 'all') return Infinity;
  return Number.parseInt(normalized, 10) || 6;
}

function resolveMetaReportScenarioChartSeries(series) {
  const currentKey = metaReportMonthKeyFromDate(new Date());
  const filtered = series.filter((point) => {
    if (metaReportParseAmount(point.spend) <= 0) return false;
    if (currentKey && point.monthKey && point.monthKey > currentKey) return false;
    return true;
  });
  const windowLimit = resolveMetaReportScenarioMonthWindowLimit();
  const maxMonths = windowLimit === Infinity ? META_REPORT_SCENARIO_MAX_HISTORICAL : windowLimit;
  return trimMetaReportScenarioSeries(filtered, maxMonths);
}

function resolveMetaReportScenarioBaselineHints(series = [], projection = null, payload = null) {
  const activePayload = payload || metaReportsState.clientPayload || null;
  const baselineSeries = metaReportsState.chartSeries?.length ? metaReportsState.chartSeries : series;
  const pills = getMetaReportScenarioPillsFromState();
  const hasBottomline = payloadHasMetaReportBottomline(activePayload);
  const prepared = projection?.prepared || metaReportPrepareScenarioSeries(baselineSeries, {
    windowMonths: metaReportsState.scenarioMonthWindow,
    smoothOutliers: pills.smoothUneven,
    hasBottomline,
  });
  const activeKey = resolveMetaReportScenarioActiveMonthKey(activePayload);
  const currentKey = metaReportMonthKeyFromDate(new Date());
  const reportYear = getMetaReportCalendarYear(activePayload)
    || activePayload?.year || metaReportsState.selectedYear
    || (activeKey ? Number(String(activeKey).slice(0, 4)) : null);
  const spendArgs = { activeMonthKey: activeKey, asOfDate: new Date(), payload: activePayload };
  const spendWindow = metaReportPrepareBaselineSpendWindow(baselineSeries, {
    windowMonths: metaReportsState.scenarioMonthWindow,
    asOfDate: new Date(),
  });

  const lastMonthMeta = resolveMetaReportLastMonthBaseline(baselineSeries, spendArgs);
  const windowAverage = resolveMetaReportWindowAverageBaselineSpend(spendWindow);
  const lastMonthSpend = resolveMetaReportScenarioBaselineSpend(baselineSeries, prepared, {
    baselineMode: 'last',
    ...spendArgs,
  });
  const selectedMonthSpend = resolveMetaReportScenarioBaselineSpend(baselineSeries, prepared, {
    baselineMode: 'month',
    ...spendArgs,
  });

  const currentInReportYear = Boolean(
    currentKey
    && reportYear
    && String(currentKey).startsWith(`${reportYear}-`),
  );

  return {
    windowAverage,
    windowMonthCount: spendWindow.length || prepared.monthsUsed || prepared.months.length || 0,
    selectedMonthSpend,
    selectedMonthLabel: activeKey ? metaMonthLabel(activeKey) : '',
    activeKey,
    currentMonthSpend: currentInReportYear
      ? metaReportSpendFromMonthKey(baselineSeries, activePayload, currentKey)
      : 0,
    currentMonthLabel: currentInReportYear ? metaMonthLabel(currentKey) : '',
    currentKey: currentInReportYear ? currentKey : null,
    lastMonthSpend,
    lastMonthLabel: lastMonthMeta?.label || '',
    lastMonthKey: lastMonthMeta?.monthKey || null,
  };
}

function renderMetaReportBaselineSelectOptions(hints = null, selectedMode = 'year') {
  const windowValue = hints?.windowAverage > 0 ? metaReportFmtBaselineAmount(hints.windowAverage) : '—';
  const lastValue = hints?.lastMonthSpend > 0 ? metaReportFmtBaselineAmount(hints.lastMonthSpend) : '—';
  const monthValue = hints?.selectedMonthSpend > 0 ? metaReportFmtBaselineAmount(hints.selectedMonthSpend) : '—';
  const normalized = normalizeMetaReportBudgetBaseline(selectedMode);
  const lastLabel = hints?.lastMonthLabel ? `Last month · ${hints.lastMonthLabel}` : 'Last month';
  return `
    <option value="year"${normalized === 'year' ? ' selected' : ''}>Window average · ${esc(windowValue)}</option>
    <option value="last"${normalized === 'last' ? ' selected' : ''}>${esc(lastLabel)} · ${esc(lastValue)}</option>
    <option value="month"${normalized === 'month' ? ' selected' : ''}>Selected month · ${esc(monthValue)}</option>
  `;
}

function syncMetaReportBaselineUi(series = [], projection = null, payload = null) {
  const hints = resolveMetaReportScenarioBaselineHints(series, projection, payload);
  const baselineSelect = document.getElementById('meta-report-budget-baseline');
  if (baselineSelect) {
    const selected = baselineSelect.value || metaReportsState.budgetBaseline;
    baselineSelect.innerHTML = renderMetaReportBaselineSelectOptions(hints, selected);
    baselineSelect.value = normalizeMetaReportBudgetBaseline(selected);
  }
}

function renderMetaReportScenarioInsufficientMessage(projection) {
  const monthsAvailable = projection?.prepared?.monthsAvailable ?? 0;
  const monthsUsed = projection?.prepared?.monthsUsed ?? 0;
  const baselineSpend = metaReportParseAmount(projection?.baselineSpend);
  const reason = projection?.insufficientReason || '';

  if (reason === 'need_baseline_spend' || (monthsUsed >= META_SCENARIO_MIN_EFFICIENCY_MONTHS && baselineSpend <= 0)) {
    return 'Could not resolve baseline spend for the selected baseline mode. Try Window average or choose a month with ad spend.';
  }
  if (monthsAvailable > 0 && monthsAvailable < META_SCENARIO_MIN_EFFICIENCY_MONTHS) {
    return `Only ${monthsAvailable} month${monthsAvailable === 1 ? '' : 's'} in the history window has ad spend, leads, won leads, and average lead value (need at least ${META_SCENARIO_MIN_EFFICIENCY_MONTHS}).`;
  }
  if (monthsUsed >= META_SCENARIO_MIN_EFFICIENCY_MONTHS && reason === 'need_efficiency') {
    return 'Could not estimate efficiency from the selected history window. Check that won leads and average lead value are filled in for those months.';
  }
  return 'Add at least two months with ad spend, leads, won leads, and average lead value in the selected history window to model a budget scenario.';
}

function renderMetaReportScenarioContextStrip(projection) {
  if (!projection || projection.insufficientData) {
    return `<p class="meta-report-scenario-context" id="meta-report-scenario-context">${esc(renderMetaReportScenarioInsufficientMessage(projection))}</p>`;
  }
  const activePills = describeActiveMetaReportScenarioPills();
  const pillSummary = activePills.length ? activePills.join(' · ') : 'Recent months only';
  const trendLabel = projection.trendDirection === 'up'
    ? `trend up ${Math.abs(projection.trendRatePct || 0).toFixed(1)}%/mo`
    : projection.trendDirection === 'down'
      ? `trend down ${Math.abs(projection.trendRatePct || 0).toFixed(1)}%/mo`
      : 'trend flat';
  const outlierNote = projection.prepared?.outliersAdjusted
    ? ` · ${projection.prepared.outliersAdjusted} uneven month${projection.prepared.outliersAdjusted === 1 ? '' : 's'} removed`
    : '';
  const confidenceLabels = { low: 'Low confidence', medium: 'Medium confidence', high: 'High confidence' };
  const confidenceLabel = confidenceLabels[projection.prepared?.confidence] || '';
  const confidenceNote = confidenceLabel ? ` · ${confidenceLabel} (${projection.prepared?.monthsUsed || 0} mo data)` : '';
  return `<p class="meta-report-scenario-context" id="meta-report-scenario-context"><strong>Active:</strong> ${esc(pillSummary)} · last ${projection.prepared?.monthsUsed || 0} ad months · ${esc(trendLabel)}${esc(outlierNote)}${esc(confidenceNote)}</p>`;
}

function payloadHasMetaReportBottomline(payload) {
  if (payload?.settings?.metaReportShowBottomline === false) return false;
  return seriesHasBottomline(metaReportsState.chartSeries || buildMetaReportChartSeries(payload));
}

function seriesHasBottomline(series = []) {
  return series.some((point) => point.poasKr != null && point.poasX != null);
}

