    <div class="sync-history-page meta-reports-page meta-report-client-page">
      ${renderLinkedAdminEditorInner()}
    </div>
    `)}
  `;
}

function metaReportClientDisplayName(payload) {
  return String(payload?.accountName || payload?.clientId || '').trim() || 'Meta report';
}

function syncMetaReportPublicBranding(payload) {
  const clientName = metaReportClientDisplayName(payload);
  document.title = `${clientName} · Censio Analytics`;
  const heroTitle = document.querySelector('.meta-report-public-hero h1');
  if (heroTitle) heroTitle.textContent = clientName;
}

function renderPublicMetaReportPage(payload) {
  const isGoogleAds = payload.reportKind === 'google-ads'
    || linkedReportsState.activePlatform === 'google-ads';
  const uiPayload = isGoogleAds ? googleAdsPayloadToMetaUiShape(payload) : payload;
  const clientName = metaReportClientDisplayName(uiPayload);
  const monthKeys = uiPayload.monthKeys || [];
  const activeKey = metaReportsState.activeMonthKey || monthKeys[monthKeys.length - 1] || '';
  const monthPayload = uiPayload.months?.[activeKey] || null;
  const monthBody = isGoogleAds
    ? renderGoogleAdsReportMonthBody(monthPayload, { editable: false, yearPayload: uiPayload, activeMonthKey: activeKey })
    : renderMetaReportMonthBody(monthPayload, getMetaReportMonthBodyOptions(uiPayload.settings, { editable: false, yearPayload: uiPayload }));
  const tabs = monthKeys.map((key) => `
    <button type="button" class="meta-report-tab${key === activeKey ? ' is-active' : ''}" data-meta-month-tab="${esc(key)}">${esc(metaMonthLabel(key))}</button>
  `).join('');
  const subtitle = isGoogleAds ? 'Google Ads performance report' : 'Meta ads performance report';

  return `
    ${renderAppTopbar()}
    ${wrapDashboardShell(`
    <div class="page-hero admin-hub-hero meta-premium-page-hero meta-report-public-hero">
      <div class="meta-premium-page-hero-inner">
        <h1>${esc(clientName)}</h1>
        <p class="meta-report-public-subtitle" id="meta-report-public-subtitle">${esc(subtitle)}</p>
      </div>
    </div>
    <div class="meta-reports-page meta-reports-page--public">
      ${renderLinkedPublicPlatformTabsHtml()}
      <div class="meta-report-toolbar">
        <div class="meta-report-toolbar-left">
          <label class="meta-report-year-field">Year
            <select id="meta-report-year" class="admin-select">
              ${renderMetaReportYearSelectOptions(uiPayload, { disableUnavailable: true })}
            </select>
          </label>
          <span class="meta-report-year-loading-banner" id="meta-report-public-year-loading-banner" hidden aria-live="polite"></span>
        </div>
        <div class="meta-report-toolbar-actions" id="meta-report-public-excel-sheet-btn">
          ${renderMetaReportExcelSheetButton(uiPayload.settings || {}, { variant: 'secondary' })}
        </div>
      </div>
      <div class="meta-report-tabs" role="tablist">${tabs}</div>
      <div class="meta-report-month-panel" id="meta-report-month-panel">
        ${monthBody}
      </div>
    </div>
    <div class="brand-footer brand-footer--public-report">
      Report by <strong>Censio Analytics</strong>
    </div>
    `)}
  `;
