async function toggleFbLeadSyncEnabled(clientId, enabled) {
  try {
    await adminFetch(`/api/clients/${encodeURIComponent(clientId)}`, {
      method: 'PUT',
      body: JSON.stringify({ fbLeadSyncEnabled: enabled }),
    });
    showToast(enabled ? 'Automatic FB lead sync enabled' : 'Automatic FB lead sync disabled', 'success');
    const client = fbLeadSyncState.clients.find((row) => row.clientId === clientId);
    if (client) client.fbLeadSyncEnabled = enabled;
  } catch (error) {
    showToast(error.message || 'Failed to update auto-sync setting.', 'error');
    await loadFbLeadSyncPage({ silent: true });
  }
}

function bindFbLeadSyncToggles() {
  document.querySelectorAll('[data-fb-sync-toggle]').forEach((input) => {
    input.onchange = () => toggleFbLeadSyncEnabled(input.dataset.fbSyncToggle, input.checked);
  });
}

async function loadFbLeadPreflightForClients(clients, { quick = false } = {}) {
  const suffix = quick ? '&quick=1' : '';
  await Promise.all((clients || []).map(async (client) => {
    const prev = fbLeadSyncState.preflightByClient[client.clientId] || {};
    try {
      const next = await adminFetch(
        `/api/fb-lead-sync/preflight?client=${encodeURIComponent(client.clientId)}${suffix}`,
      );
      fbLeadSyncState.preflightByClient[client.clientId] = quick
        ? {
          ...next,
          metaLeadCount90d: next.metaLeadCount90d ?? prev.metaLeadCount90d ?? null,
          estimatedMissing: next.estimatedMissing ?? prev.estimatedMissing ?? null,
          sampleSize: next.sampleSize || prev.sampleSize || 0,
          sampleWouldUpdate: next.sampleWouldUpdate ?? prev.sampleWouldUpdate ?? 0,
        }
        : next;
    } catch (error) {
      fbLeadSyncState.preflightByClient[client.clientId] = {
        ...prev,
        preflightError: error.message,
      };
    }
  }));
}

function scheduleFbLeadFullPreflight(clients) {
  if (!clients?.length) return;
  loadFbLeadPreflightForClients(clients, { quick: false })
    .then(() => refreshFbLeadClientRowsUi())
    .catch(() => {});
}

async function loadFbLeadHistory(limit = 50) {
  const data = await adminFetch(`/api/fb-lead-sync/history?limit=${limit}`);
  fbLeadSyncState.historyRuns = data.runs || [];
  return data;
}

function renderFbLeadRunPanel(clientId, mode = 'recent') {
  const client = fbLeadSyncState.clients.find((row) => row.clientId === clientId);
  const ready = clientHasReadyPreview(client);
  const modeLabel = mode === 'backfill' ? 'Backfill (90 days)' : 'Recent (2 days)';
  return `
    <div class="fb-lead-run-panel" id="fb-lead-run-panel">
      <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start">
        <div>
          <strong>${esc(client?.accountName || clientId)}</strong>
          <div style="color:var(--text-soft);font-size:13px;margin-top:4px">${esc(modeLabel)}</div>
        </div>
        <button class="admin-btn admin-btn--ghost" type="button" onclick="closeFbLeadRunPanel()">Close</button>
      </div>
      ${mode === 'backfill' && ready
        ? '<div class="fb-lead-banner" style="margin-top:12px;margin-bottom:0;background:#e8f7ef;border-color:#b8e6cf;color:#138b53">Preview complete — use <strong>Apply</strong> on that run in <strong>Run history</strong> below.</div>'
        : (mode === 'backfill' && clientPreviewAllSynced(client)
          ? '<div class="fb-lead-banner" style="margin-top:12px;margin-bottom:0;background:#e8f7ef;border-color:#b8e6cf;color:#138b53">All contacts already have <strong>Fb Lead id</strong> — nothing to apply.</div>'
          : (mode === 'backfill' ? '<div class="fb-lead-banner" style="margin-top:12px;margin-bottom:0">Run Preview first. Backfill only matches leads Meta still has (~90 days).</div>' : ''))}
      <div class="fb-lead-run-actions">
        <button class="admin-btn admin-btn--secondary" type="button" id="fb-lead-preview-btn">Preview (dry run)</button>
      </div>
      <div class="fb-lead-progress-wrap" id="fb-lead-progress-wrap" hidden>
        <div class="fb-lead-progress-label" id="fb-lead-progress-label">Starting…</div>
        <div class="fb-lead-progress" id="fb-lead-progress">
          <div class="fb-lead-progress-bar" id="fb-lead-progress-bar"></div>
        </div>
      </div>
      <div id="fb-lead-run-results" style="margin-top:12px"></div>
    </div>
  `;
}

function closeFbLeadRunPanel() {
  const mount = document.getElementById('fb-lead-run-panel-mount');
  if (mount) mount.innerHTML = '';
  fbLeadSyncState.activeRun = null;
}

function openFbLeadRunPanel(clientId, mode) {
  const client = fbLeadSyncState.clients.find((row) => row.clientId === clientId);
  if (!clientFbLeadFieldReady(client)) {
    showToast(getClientFbLeadFieldHint(client), 'error');
    return;
  }
  const mount = document.getElementById('fb-lead-run-panel-mount');
  if (!mount) return;
  fbLeadSyncState.activeRun = {
    clientId,
    mode,
    runId: null,
    previewOk: clientHasReadyPreview(fbLeadSyncState.clients.find((row) => row.clientId === clientId)),
  };
  mount.innerHTML = renderFbLeadRunPanel(clientId, mode);
  const previewBtn = document.getElementById('fb-lead-preview-btn');
  if (previewBtn) previewBtn.onclick = () => runFbLeadSyncBatch({ clientId, mode, dryRun: true });
  mount.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function renderFbLeadRunResults(summary) {
  const rows = summary.rows || [];
  if (!rows.length) {
    return `<div class="sync-history-empty" style="padding:12px">No rows in this batch.</div>`;
  }
  const body = rows.map((row) => `
    <tr>
      <td>${esc(row.email || row.phone || '—')}</td>
      <td><code>${esc(row.metaLeadId || '—')}</code></td>
      <td>${esc(row.contactId || '—')}</td>
      <td>${renderSyncStatusBadge(row.status)}</td>
    </tr>
  `).join('');
  const processed = summary.nextBatchOffset ?? ((summary.batchOffset || 0) + (summary.batchProcessed || 0));
  const total = summary.inWindow || processed;
  return `
    <div class="fb-lead-audit-scroll">
      <table class="sync-history-table">
        <thead><tr><th>Email / phone</th><th>Meta lead id</th><th>GHL contact</th><th>Status</th></tr></thead>
        <tbody>${body}</tbody>
      </table>
    </div>
    <p style="color:var(--text-soft);font-size:12px;margin-top:8px">
      ${processed} / ${total} leads scanned · ${summary.updated || 0} would update/updated · ${summary.errors || 0} errors
    </p>
  `;
}

function renderGlobalApplyProgress(clientId, mode, contactCount = 0) {
  const client = fbLeadSyncState.clients.find((row) => row.clientId === clientId);
  const modeLabel = mode === 'backfill' ? '90-day backfill' : 'recent sync';
  const countLabel = contactCount > 0 ? `${contactCount} contact(s)` : 'contacts';
  return `
    <div class="fb-lead-apply-progress-card" id="fb-lead-global-progress-card">
      <div class="fb-lead-apply-progress-header">
        <div>
          <strong>Writing to GHL — ${esc(modeLabel)}</strong>
          <div class="fb-lead-apply-progress-sub">${esc(client?.accountName || clientId)} · ${esc(countLabel)}</div>
        </div>
        <span class="fb-lead-badge is-ok" id="fb-lead-apply-status-badge">Running</span>
      </div>
      <div class="fb-lead-apply-progress-stats" id="fb-lead-global-progress-stats">Preparing…</div>
      <div class="fb-lead-progress is-visible is-indeterminate" id="fb-lead-global-progress">
        <div class="fb-lead-progress-bar" id="fb-lead-global-progress-bar"></div>
      </div>
      <div class="fb-lead-progress-label" id="fb-lead-global-progress-label">Starting apply — do not close this page</div>
    </div>
  `;
}

function startGlobalApplyProgress(clientId, mode, contactCount = 0) {
  const mount = document.getElementById('fb-lead-apply-progress-mount');
  if (!mount) return;
  fbLeadSyncState.isApplying = true;
  fbLeadSyncState.applyStartedAt = Date.now();
  fbLeadSyncState.applyProgress = null;
  mount.innerHTML = renderGlobalApplyProgress(clientId, mode, contactCount);
  mount.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  if (fbLeadSyncState.applyWaitTimer) clearInterval(fbLeadSyncState.applyWaitTimer);
  fbLeadSyncState.applyWaitTimer = window.setInterval(() => {
    if (!fbLeadSyncState.isApplying) return;
    const elapsed = Math.floor((Date.now() - fbLeadSyncState.applyStartedAt) / 1000);
    const saved = fbLeadSyncState.applyProgress;
    if (saved?.total > 0) {
      updateGlobalApplyProgress({ ...saved, waiting: true, elapsed });
    } else {
      updateGlobalApplyProgress({ waiting: true, elapsed });
    }
  }, 1000);
}

function updateGlobalApplyProgress({
  processed,
  total,
  written,
  waiting = false,
  elapsed = 0,
  complete = false,
  error = '',
} = {}) {
  const card = document.getElementById('fb-lead-global-progress-card');
  const progress = document.getElementById('fb-lead-global-progress');
  const bar = document.getElementById('fb-lead-global-progress-bar');
  const label = document.getElementById('fb-lead-global-progress-label');
  const stats = document.getElementById('fb-lead-global-progress-stats');
  const badge = document.getElementById('fb-lead-apply-status-badge');
  if (!card || !progress || !bar || !label) return;

  const prev = fbLeadSyncState.applyProgress || {};
  const nextProcessed = processed ?? prev.processed ?? 0;
  const nextTotal = total ?? prev.total ?? 0;
  const nextWritten = written ?? prev.written ?? 0;

  if (!complete && !error && (nextTotal > 0 || nextProcessed > 0)) {
    fbLeadSyncState.applyProgress = {
      processed: nextProcessed,
      total: nextTotal,
      written: nextWritten,
    };
  }

  const hasProgress = nextTotal > 0 || nextProcessed > 0;

  if (waiting && !hasProgress && !complete) {
    progress.classList.add('is-indeterminate');
    bar.style.width = '35%';
    if (stats) stats.textContent = 'Contacting Meta and GHL…';
    label.textContent = `Writing to GHL… (${elapsed}s — do not close this page)`;
    return;
  }

  progress.classList.remove('is-indeterminate');
  const pct = nextTotal > 0
    ? Math.min(100, Math.round((nextProcessed / nextTotal) * 100))
    : (complete ? 100 : 0);
  bar.style.width = `${pct}%`;
  if (stats) {
    stats.textContent = complete
      ? `${nextWritten} written to GHL · ${nextProcessed} / ${nextTotal} contacts processed`
      : `${nextWritten} written · ${nextProcessed} / ${nextTotal} contacts (${pct}%)`;
  }
  if (complete) {
    card.classList.add('is-complete');
    card.classList.remove('is-error');
    label.textContent = `Complete — ${nextWritten} contact(s) updated in GHL`;
    if (badge) {
      badge.textContent = 'Complete';
      badge.classList.add('is-ok');
      badge.classList.remove('is-missing');
    }
  } else if (error) {
    card.classList.add('is-error');
    card.classList.remove('is-complete');
    label.textContent = error;
    if (badge) {
      badge.textContent = 'Failed';
      badge.classList.remove('is-ok');
      badge.classList.add('is-missing');
    }
  } else if (waiting && hasProgress) {
    label.textContent = nextProcessed >= nextTotal
      ? `Finishing up… (${elapsed}s)`
      : `Batch in progress — ${nextProcessed} / ${nextTotal} leads (${pct}%) · ${elapsed}s`;
  } else {
    label.textContent = `Writing to GHL — ${nextProcessed} / ${nextTotal} leads (${pct}%)`;
  }
}

function stopGlobalApplyProgress({ success = true, keepVisibleMs = 6000 } = {}) {
  fbLeadSyncState.isApplying = false;
  fbLeadSyncState.applyProgress = null;
  if (fbLeadSyncState.applyWaitTimer) {
    clearInterval(fbLeadSyncState.applyWaitTimer);
    fbLeadSyncState.applyWaitTimer = null;
  }
  window.setTimeout(() => {
    const mount = document.getElementById('fb-lead-apply-progress-mount');
    if (mount && !fbLeadSyncState.isApplying) mount.innerHTML = '';
  }, keepVisibleMs);
}

function setFbLeadProgress({ processed = 0, total = 0, complete = false, label = '' } = {}) {
  const wrap = document.getElementById('fb-lead-progress-wrap');
  const progressBar = document.getElementById('fb-lead-progress-bar');
  const progressLabel = document.getElementById('fb-lead-progress-label');
  if (!wrap || !progressBar) return;
  wrap.hidden = false;
  wrap.classList.toggle('is-complete', complete);
  const pct = total > 0 ? Math.min(100, Math.round((processed / total) * 100)) : (complete ? 100 : 0);
  progressBar.style.width = `${pct}%`;
  if (progressLabel) {
    progressLabel.textContent = label
      || (complete
        ? `Complete — ${processed} / ${total} leads (${pct}%)`
        : `Processing — ${processed} / ${total} leads (${pct}%)`);
  }
}

function hideFbLeadProgress(reset = true) {
  const wrap = document.getElementById('fb-lead-progress-wrap');
  const progressBar = document.getElementById('fb-lead-progress-bar');
  if (!wrap) return;
  if (reset) {
    wrap.hidden = true;
    wrap.classList.remove('is-complete');
    if (progressBar) progressBar.style.width = '0%';
  }
}

function updateFbLeadHistoryClearButton() {
  const clearBtn = document.getElementById('fb-lead-history-clear-all');
  if (!clearBtn) return;
  const hasRuns = (fbLeadSyncState.historyRuns || []).length > 0;
  clearBtn.disabled = !hasRuns;
}

function updateFbLeadCronSummaryUi() {
  const mount = document.getElementById('fb-lead-cron-summary-24h');
  if (!mount || !fbLeadSyncState.cronSummary24h) return;
  mount.outerHTML = renderFbLeadCronSummary24h(fbLeadSyncState.cronSummary24h);
}

async function refreshFbLeadHistoryUi() {
  await loadFbLeadHistory();
  const historyMount = document.getElementById('fb-lead-history-mount');
  if (!historyMount) return;
  const locationByClient = Object.fromEntries(
    fbLeadSyncState.clients.map((row) => [row.clientId, row.locationId]),
  );
  historyMount.innerHTML = renderFbLeadHistoryRows(fbLeadSyncState.historyRuns, locationByClient);
  updateFbLeadHistoryClearButton();
}

function bindFbLeadHistoryClearButton() {
  const clearBtn = document.getElementById('fb-lead-history-clear-all');
  if (clearBtn) clearBtn.onclick = () => clearFbLeadSyncHistory();
  const routineToggle = document.getElementById('fb-lead-show-routine-cron');
  if (routineToggle) {
    routineToggle.checked = fbLeadSyncState.showRoutineCronRuns;
    routineToggle.onchange = () => {
      fbLeadSyncState.showRoutineCronRuns = routineToggle.checked;
      const historyMount = document.getElementById('fb-lead-history-mount');
      if (!historyMount) return;
      const locationByClient = Object.fromEntries(
        fbLeadSyncState.clients.map((row) => [row.clientId, row.locationId]),
      );
      historyMount.innerHTML = renderFbLeadHistoryRows(fbLeadSyncState.historyRuns, locationByClient);
    };
  }
  updateFbLeadHistoryClearButton();
}

async function clearFbLeadSyncHistory() {
  if (!isStaffAdmin()) return;
  const confirmed = window.confirm(
    'Delete all FB lead sync run history?\n\nThis only clears the log — it does not change GHL contacts or Meta data.',
  );
  if (!confirmed) return;
  try {
    const result = await adminFetch('/api/fb-lead-sync/history', { method: 'DELETE' });
    showToast(`Cleared ${result.deleted || 0} run(s).`, 'success');
    await refreshFbLeadHistoryUi();
    await loadFbLeadSyncPage({ silent: true });
  } catch (error) {
    showToast(error.message || 'Failed to clear FB lead sync log.', 'error');
  }
}

async function deleteFbLeadRun(runId) {
  if (!isStaffAdmin()) return;
  const confirmed = window.confirm(`Delete run #${runId} from history?`);
  if (!confirmed) return;
  try {
    await adminFetch(`/api/fb-lead-sync/history/${runId}`, { method: 'DELETE' });
    showToast('Run deleted.', 'success');
    await refreshFbLeadHistoryUi();
    await loadFbLeadSyncPage({ silent: true });
  } catch (error) {
    showToast(error.message || 'Failed to delete run.', 'error');
  }
}

async function runFbLeadSyncBatch({ clientId, mode, dryRun, resumeRunId = null }) {
  const previewBtn = document.getElementById('fb-lead-preview-btn');
  const resultsMount = document.getElementById('fb-lead-run-results');
  if (previewBtn) previewBtn.disabled = true;

  const batchLimit = dryRun ? 12 : 10;
  const resumeRun = resumeRunId != null
    ? fbLeadSyncState.historyRuns.find((row) => Number(row.id) === Number(resumeRunId))
    : null;
  let runId = resumeRun?.id || fbLeadSyncState.activeRun?.runId || null;
  let offset = resumeRun ? (Number(resumeRun.batchOffset) || 0) : 0;
  let lastSummary = null;
  let allRows = [];
  let completed = false;
  const applyRunId = resumeRunId ?? fbLeadSyncState.activeRun?.previewRunId ?? null;
  const previewRun = applyRunId != null
    ? fbLeadSyncState.historyRuns.find((row) => Number(row.id) === Number(applyRunId))
    : null;
  const expectedContacts = resumeRun
    ? partialSyncRemaining(resumeRun)
    : (previewRun?.updated
      ?? fbLeadSyncState.previewOkByClient[clientId]?.updated
      ?? 0);

  if (!dryRun) {
    fbLeadSyncState.applyingRunId = applyRunId;
    startGlobalApplyProgress(clientId, mode, expectedContacts);
    await refreshFbLeadHistoryUi();
  }

  try {
    if (!resumeRunId) {
      const partial = findPartialSyncRun(clientId, mode, dryRun);
      if (partial) {
        const remaining = partialSyncRemaining(partial);
        const label = dryRun ? 'preview' : 'apply';
        const confirmed = window.confirm(
          `A ${label} for ${clientId} was interrupted (${partial.updated || 0} processed, ${remaining} remaining).\n\n`
          + `Resume the interrupted ${label}?`,
        );
        if (confirmed) {
          runId = partial.id;
          offset = Number(partial.batchOffset) || 0;
        }
      }
    }

    if (dryRun) {
      setFbLeadProgress({ processed: offset, total: 0, label: offset > 0 ? 'Resuming preview…' : 'Fetching Meta leads…' });
    } else {
      updateGlobalApplyProgress({ waiting: true, elapsed: 0 });
    }

    if (dryRun && offset === 0) {
      const prepared = await adminFetchWithRetry('/api/fb-lead-sync/prepare', {
        method: 'POST',
        body: JSON.stringify({
          clientId,
          mode,
          dryRun,
          runId,
        }),
      });
      const prep = prepared.summary || prepared;
      runId = prep.runId;
      offset = 0;
      setFbLeadProgress({
        processed: 0,
        total: prep.inWindow || 0,
        label: `Matching ${prep.inWindow || 0} Meta leads to GHL…`,
      });
    } else if (!dryRun && offset === 0) {
      updateGlobalApplyProgress({
        waiting: false,
        processed: 0,
        total: expectedContacts || previewRun?.updated || 0,
      });
    }

    do {
      lastSummary = await adminFetchWithRetry('/api/fb-lead-sync/run', {
        method: 'POST',
        body: JSON.stringify({
          clientId,
          mode,
          dryRun,
          runId,
          previewRunId: dryRun ? null : applyRunId,
          batchOffset: offset,
          batchLimit,
        }),
      });
      const summary = lastSummary.summary || lastSummary;
      runId = summary.runId;
      offset = summary.nextBatchOffset ?? (summary.batchOffset + (summary.batchProcessed || 0));
      allRows = allRows.concat(summary.rows || []);
      if (fbLeadSyncState.activeRun) {
        fbLeadSyncState.activeRun.runId = runId;
      }
      const total = summary.inWindow || offset || expectedContacts;
      if (dryRun) {
        setFbLeadProgress({
          processed: offset,
          total,
          complete: !summary.hasMore,
        });
        if (resultsMount) {
          resultsMount.innerHTML = renderFbLeadRunResults({ ...summary, rows: allRows });
        }
      } else {
        updateGlobalApplyProgress({
          processed: offset,
          total,
          written: summary.updated || 0,
          complete: !summary.hasMore,
        });
      }
    } while ((lastSummary.summary || lastSummary).hasMore);

    completed = true;
    const finalSummary = lastSummary.summary || lastSummary;
    const finalTotal = finalSummary.inWindow || offset || expectedContacts;
    const finalProcessed = finalSummary.nextBatchOffset ?? offset;

    if (dryRun) {
      setFbLeadProgress({
        processed: finalProcessed,
        total: finalTotal,
        complete: true,
      });
      markFbLeadPreviewReady(clientId, mode, finalSummary.updated);
      if (fbLeadSyncState.activeRun) {
        fbLeadSyncState.activeRun.previewOk = (finalSummary.updated || 0) > 0;
      }
      showToast(
        (finalSummary.updated || 0) > 0
          ? 'Preview complete — use Apply in Run history below.'
          : 'Preview complete — all contacts already have Fb Lead id. Nothing to apply.',
        'success',
      );
      await refreshFbLeadHistoryUi();
      document.getElementById('fb-lead-history-mount')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      updateGlobalApplyProgress({
        processed: finalProcessed,
        total: finalTotal,
        written: finalSummary.updated || 0,
        complete: true,
      });
      delete fbLeadSyncState.previewOkByClient[clientId];
      try {
        const stored = JSON.parse(sessionStorage.getItem('fbLeadSyncPreviewOk') || '{}');
        delete stored[clientId];
        sessionStorage.setItem('fbLeadSyncPreviewOk', JSON.stringify(stored));
      } catch {
        // ignore
      }
      showToast('FB lead sync complete — Fb Lead id written to GHL', 'success');
      stopGlobalApplyProgress({ success: true });
    }
    await refreshFbLeadHistoryUi();
    const dash = await adminFetch('/api/fb-lead-sync');
    fbLeadSyncState.clients = dash.clients || [];
    hydrateFbLeadPreviewState(fbLeadSyncState.clients);
    await refreshFbLeadClientRowsUi();
  } catch (error) {
    if (dryRun) {
      hideFbLeadProgress(true);
    } else {
      updateGlobalApplyProgress({
        error: `Failed — ${error.message || 'Apply failed'}`,
      });
      stopGlobalApplyProgress({ success: false, keepVisibleMs: 12000 });
    }
    showToast(
      (error.message || (dryRun ? 'FB lead preview failed.' : 'FB lead apply failed.'))
      + (dryRun ? ' Partial progress is saved — use Resume in Run history or try Preview again.' : ' Partial progress is saved — use Resume in Run history.'),
      'error',
    );
    await refreshFbLeadHistoryUi();
  } finally {
    if (previewBtn) previewBtn.disabled = false;
    fbLeadSyncState.applyingRunId = null;
    if (!completed && dryRun) {
      hideFbLeadProgress(true);
    }
    if (!dryRun && !completed) {
      fbLeadSyncState.isApplying = false;
      await refreshFbLeadHistoryUi();
    }
  }
}

async function expandFbLeadRun(runId) {
  const row = document.getElementById(`fb-lead-run-audit-${runId}`);
  if (!row) return;
  if (!row.hidden) {
    row.hidden = true;
    return;
  }
  try {
    const data = await adminFetch(`/api/fb-lead-sync/history/${runId}`);
    const client = fbLeadSyncState.clients.find((item) => item.clientId === data.run.clientId);
    row.innerHTML = `<td colspan="7"><div class="fb-lead-audit-scroll" id="fb-lead-audit-scroll-${runId}">${renderFbLeadAuditTable(data.run.rows || [], data.run.locationId || client?.locationId)}</div></td>`;
    row.hidden = false;
    const scrollHost = document.getElementById(`fb-lead-audit-scroll-${runId}`);
    if (scrollHost) {
      scrollHost.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  } catch (error) {
    showToast(error.message || 'Failed to load run audit.', 'error');
  }
}

function viewFbLeadClientHistory(clientId) {
  const filtered = getFbLeadHistoryRunsForDisplay(
    fbLeadSyncState.historyRuns.filter((run) => run.clientId === clientId),
  );
  const historyMount = document.getElementById('fb-lead-history-mount');
  if (!historyMount) return;
  const locationByClient = Object.fromEntries(
    fbLeadSyncState.clients.map((row) => [row.clientId, row.locationId]),
  );
  historyMount.innerHTML = filtered.length
    ? renderFbLeadHistoryRows(filtered, locationByClient)
    : `<div class="sync-history-empty">No runs for ${esc(clientId)} yet.</div>`;
  historyMount.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

async function loadFbLeadSyncPage({ silent = false, fullPreflight = false } = {}) {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard) return;

  const user = await fetchStaffMe();
  if (!user) {
    if (!silent) {
      dashboard.innerHTML = `
        ${renderBrandTopbar('')}
        ${wrapDashboardShell(`
          <div class="page-hero admin-hub-hero"><h1>FB lead sync</h1><p>Sign in to manage FB lead ID sync.</p></div>
          <div class="sync-history-page">
            <div class="sync-history-empty" style="padding:24px;text-align:center">
              <a class="admin-btn admin-btn--primary" href="/login?next=${encodeURIComponent(`${window.location.pathname}${window.location.search}`)}">Sign in</a>
            </div>
          </div>
        `)}
      `;
    }
    return;
  }
  currentStaffUser = user;

  if (!silent) {
    dashboard.innerHTML = `
      ${renderBrandTopbar(renderStaffAdminChrome('fb-lead-sync'))}
      ${wrapDashboardShell('<div class="loading-state"><div class="spinner"></div><p>Loading FB lead sync...</p></div>')}
    `;
  }

  try {
    if (silent && fbLeadSyncState.isApplying) return;

    const [data] = await Promise.all([
      adminFetch('/api/fb-lead-sync'),
      loadFbLeadHistory(),
    ]);
    fbLeadSyncState.clients = data.clients || [];
    fbLeadSyncState.cronSummary24h = data.summary?.cronSummary24h || null;
    hydrateFbLeadPreviewState(fbLeadSyncState.clients);

    if (!silent) {
      dashboard.innerHTML = renderFbLeadSyncPage(data);
      bindFbLeadSyncToggles();
      const refreshBtn = document.getElementById('fb-lead-sync-refresh');
      if (refreshBtn) {
        refreshBtn.onclick = () => loadFbLeadSyncPage({ fullPreflight: true });
      }
      bindFbLeadHistoryClearButton();
      if (fbLeadSyncRefreshTimer) {
        clearInterval(fbLeadSyncRefreshTimer);
        fbLeadSyncRefreshTimer = null;
      }
      fbLeadSyncRefreshTimer = window.setInterval(() => {
        loadFbLeadSyncPage({ silent: true }).catch(() => {});
      }, 60_000);
    }

    if (!silent || fullPreflight) {
      await loadFbLeadPreflightForClients(fbLeadSyncState.clients, { quick: !fullPreflight });
    }
    if (silent) {
      updateFbLeadCronSummaryUi();
      await refreshFbLeadHistoryUi();
      await refreshFbLeadClientRowsUi();
    } else {
      await refreshFbLeadClientRowsUi();
    }

    if (fullPreflight) {
      await loadFbLeadPreflightForClients(fbLeadSyncState.clients, { quick: false });
      await refreshFbLeadClientRowsUi();
    } else if (!silent) {
      scheduleFbLeadFullPreflight(fbLeadSyncState.clients);
    }
  } catch (error) {
    if (!silent) {
      dashboard.innerHTML = `
        ${renderBrandTopbar(renderStaffAdminChrome('fb-lead-sync'))}
        ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
      `;
    }
  }
}

const metaReportsState = {
  filter: 'all',
  searchQuery: '',
  dashboardData: null,
  hubMounted: false,
  clientPayload: null,
  clientPageMounted: false,
  clientReportSettingsExpanded: false,
  clientShareExpanded: false,
  activeMonthKey: null,
  selectedYear: new Date().getFullYear(),
  publicPayload: null,
  publicPageMounted: false,
  customValues: {
    mounted: false,
    overview: null,
    searchQuery: '',
    selectedClientId: null,
    selectedMonthKey: null,
    editorPayload: null,
    draftInputs: null,
    loadingEditor: false,
    saving: false,
    settingsSaving: false,
    settingsSavingScope: null,
  },
};

const META_HUB_FILTER_OPTIONS = [
  { value: 'all', label: 'All' },
  { value: 'enabled', label: 'Live reports' },
  { value: 'meta-only', label: 'Meta only' },
  { value: 'needs-setup', label: 'Needs setup' },
];

function metaHubClientInitial(name) {
  const trimmed = String(name || '?').trim();
  return esc(trimmed.charAt(0).toUpperCase());
}

function filterMetaReportsClients(clients, filter, searchQuery = '') {
  let list = clients || [];
  if (filter === 'enabled') list = list.filter((client) => client.metaReportEnabled);
  if (filter === 'meta-only') list = list.filter((client) => !client.hasGhl);
  if (filter === 'needs-setup') list = list.filter((client) => client.needsSetup);
  const query = String(searchQuery || '').trim().toLowerCase();
  if (query) {
    list = list.filter((client) => {
      const haystack = [
        client.accountName,
        client.metaAdAccountId,
        client.clientId,
        client.metaName,
      ].filter(Boolean).join(' ').toLowerCase();
      return haystack.includes(query);
    });
  }
  return list;
}

function getMetaReportsHubView(dashboardData, filter, searchQuery = metaReportsState.searchQuery) {
  const allClients = dashboardData?.clients || [];
  const clients = filterMetaReportsClients(allClients, filter, searchQuery);
  const summary = dashboardData?.summary || {};
  return {
    clients,
    allClients,
    summary: {
      ...summary,
      totalListed: allClients.length,
    },
    meta: dashboardData?.meta || {},
    filter,
    searchQuery,
  };
}

function renderMetaHubSwitch({ label, attr, value, checked, disabled = false }) {
  if (!value) return `<div class="meta-hub-switch is-disabled"><span class="meta-hub-switch-label">${esc(label)}</span><span class="meta-report-muted">—</span></div>`;
  return `
    <label class="meta-hub-switch${disabled ? ' is-disabled' : ''}">
      <span class="meta-hub-switch-label">${esc(label)}</span>
      <span class="meta-hub-switch-track">
        <input type="checkbox" class="meta-hub-switch-input" ${attr}="${esc(value)}" ${checked ? 'checked' : ''} ${disabled ? 'disabled' : ''} aria-label="${esc(label)}" />
        <span class="meta-hub-switch-thumb"></span>
      </span>
    </label>
  `;
}

function metaReportFullUrl(reportPath) {
  if (!reportPath) return '';
  return `${window.location.origin}${reportPath}`;
}

function normalizeMetaReportSlugInput(value) {
  return String(value || '').trim().toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/[^a-z0-9-]/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
}

function resolveMetaReportShareSlug(payload) {
  const settings = payload.settings || {};
  if (settings.metaReportSlug) return settings.metaReportSlug;
  const token = String(payload.reportUrl || '').replace(/^\/report\//, '');
  const match = token.match(/^(.+)-(\d{4})$/);
  return match ? match[1] : '';
}

function resolveMetaReportShareCode(payload) {
  const token = String(payload.reportUrl || '').replace(/^\/report\//, '');
  const match = token.match(/-(\d{4})$/);
  return match ? match[1] : '';
}

function renderMetaReportShareSummary(payload, { hidden = false } = {}) {
  const settings = payload.settings || {};
  const enabled = Boolean(settings.metaReportEnabled);
  const slug = resolveMetaReportShareSlug(payload);
  const code = resolveMetaReportShareCode(payload);
  const slugLabel = slug ? `${slug}-${code || '····'}` : 'Not set';

  return `
    <div class="meta-report-share-summary" id="meta-report-share-summary"${hidden ? ' hidden' : ''}>
      <div class="meta-report-share-summary-main">
        <div class="meta-report-share-summary-row">
          <span class="meta-report-share-summary-label">Preview</span>
          <span class="meta-report-share-summary-value${enabled ? ' is-on' : ' is-off'}">${enabled ? 'Enabled' : 'Disabled'}</span>
        </div>
        <div class="meta-report-share-summary-row">
          <span class="meta-report-share-summary-label">Slug</span>
          <span class="meta-report-share-summary-value" id="meta-report-share-slug-display">${esc(slugLabel)}</span>
        </div>
      </div>
      <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="meta-report-share-edit">Edit</button>
    </div>
  `;
}

function syncMetaReportToolbarCopy(payload) {
  const btn = document.getElementById('meta-report-toolbar-copy-link');
  if (!btn) return;
  if (payload.reportUrl) {
    btn.setAttribute('data-copy-report-url', payload.reportUrl);
    btn.disabled = !payload.settings?.metaReportEnabled;
    btn.hidden = false;
  } else {
    btn.hidden = true;
  }
}

function applyMetaReportEnabledUi(payload, enabled) {
  if (!payload.settings) payload.settings = {};
  payload.settings.metaReportEnabled = enabled;

  document.getElementById('meta-report-share-card')?.classList.toggle('is-disabled', !enabled);

  const summary = document.getElementById('meta-report-share-summary');
  if (summary) {
    summary.querySelectorAll('.meta-report-share-summary-row').forEach((row) => {
      if (row.querySelector('.meta-report-share-summary-label')?.textContent !== 'Preview') return;
      const previewValue = row.querySelector('.meta-report-share-summary-value');
      if (!previewValue) return;
      previewValue.textContent = enabled ? 'Enabled' : 'Disabled';
      previewValue.classList.toggle('is-on', enabled);
      previewValue.classList.toggle('is-off', !enabled);
    });
  }

  const previewToggle = document.querySelector('[data-meta-client-preview]');
  if (previewToggle) previewToggle.checked = enabled;
  const switchLabel = previewToggle?.closest('.meta-hub-switch')?.querySelector('.meta-hub-switch-label');
  if (switchLabel) switchLabel.textContent = enabled ? 'Enabled' : 'Disabled';

  const rotateBtn = document.getElementById('meta-report-rotate-token');
  if (rotateBtn) rotateBtn.disabled = !enabled;

  const panel = document.querySelector('.meta-report-share-panel');
  const existingNote = panel?.querySelector('.meta-report-share-note');
  if (!enabled) {
    if (!existingNote && panel) {
      const note = document.createElement('p');
      note.className = 'meta-report-share-note';
      note.textContent = 'Preview disabled — link won\u2019t load.';
      panel.appendChild(note);
    }
  } else if (existingNote) {
    existingNote.remove();
  }

  syncMetaReportToolbarCopy(payload);
}

function updateMetaReportHubCardReportState(clientId, enabled) {
  const card = document.querySelector(`[data-meta-hub-row="${clientId}"]`);
  if (!card) return;
  const badge = card.querySelector('.meta-report-badge');
  if (badge && !badge.classList.contains('meta-report-badge--setup')) {
    badge.className = enabled ? 'meta-report-badge meta-report-badge--on' : 'meta-report-badge meta-report-badge--off';
    badge.textContent = enabled ? 'Report live' : 'Report off';
  }
  card.querySelectorAll('[data-meta-bottomline], [data-meta-fee]').forEach((input) => {
    input.disabled = !enabled;
    input.closest('.meta-hub-switch')?.classList.toggle('is-disabled', !enabled);
  });
}

function updateMetaReportShareSummary(payload) {
  const summary = document.getElementById('meta-report-share-summary');
  if (!summary) return;
  const wrapper = document.createElement('div');
  wrapper.innerHTML = renderMetaReportShareSummary(payload).trim();
  const next = wrapper.firstElementChild;
  if (!next) return;
  next.hidden = metaReportsState.clientShareExpanded;
  summary.replaceWith(next);
  const editBtn = document.getElementById('meta-report-share-edit');
  if (editBtn) editBtn.onclick = () => setMetaReportShareExpanded(true);
}

function setMetaReportShareExpanded(expanded) {
  metaReportsState.clientShareExpanded = Boolean(expanded);
  const card = document.getElementById('meta-report-share-card');
  const summary = document.getElementById('meta-report-share-summary');
  const editor = document.getElementById('meta-report-share-editor');
  card?.classList.toggle('is-editing', expanded);
  if (summary) summary.hidden = expanded;
  if (editor) editor.hidden = !expanded;
}

function renderMetaReportShareCard(payload) {
  const settings = payload.settings || {};
  const enabled = Boolean(settings.metaReportEnabled);
  const reportUrl = payload.reportUrl || null;
  const fullUrl = metaReportFullUrl(reportUrl);
  const slug = resolveMetaReportShareSlug(payload);
  const code = resolveMetaReportShareCode(payload);
  const expanded = metaReportsState.clientShareExpanded;
  const hasLink = Boolean(reportUrl);

  return `
    <div class="meta-report-share-card${enabled ? '' : ' is-disabled'}${expanded ? ' is-editing' : ''}" id="meta-report-share-card">
      <div class="meta-report-settings-card-head">
        <span class="meta-report-settings-card-title">Slug setting</span>
      </div>
      ${hasLink ? renderMetaReportShareSummary(payload, { hidden: expanded }) : `
        <p class="meta-report-share-empty">Share link will appear once this client has a Meta ad account configured.</p>
      `}
      ${hasLink ? `
      <div class="meta-report-share-editor" id="meta-report-share-editor"${expanded ? '' : ' hidden'}>
        <div class="meta-report-share-panel">
          <div class="meta-report-share-preview-row">
            <span class="meta-report-share-preview-title">Preview</span>
            ${renderMetaHubSwitch({
              label: enabled ? 'Enabled' : 'Disabled',
              attr: 'data-meta-client-preview',
              value: payload.clientId,
              checked: enabled,
            })}
          </div>
          <div class="meta-report-share-field">
            <div class="meta-report-share-slug-row">
              <span class="meta-report-share-slug-prefix">/report/</span>
              <input type="text" id="meta-report-share-slug" class="admin-input meta-report-share-slug-input" value="${esc(slug)}" autocomplete="off" spellcheck="false" aria-label="Report slug" />
              <span class="meta-report-share-slug-suffix" id="meta-report-share-slug-suffix">-${esc(code || '····')}</span>
            </div>
          </div>
          <code class="meta-report-share-url" id="meta-report-share-url">${esc(fullUrl)}</code>
          <div class="meta-report-share-editor-actions">
            <button type="button" class="admin-btn admin-btn--ghost admin-btn--small" id="meta-report-rotate-token"${enabled ? '' : ' disabled'}>Rotate link</button>
            <div class="meta-report-share-editor-actions-end">
              <button type="button" class="admin-btn admin-btn--ghost admin-btn--small" id="meta-report-share-done">Done</button>
              <button type="button" class="admin-btn admin-btn--primary admin-btn--small" id="meta-report-share-save">Save slug</button>
            </div>
          </div>
          ${enabled ? '' : '<p class="meta-report-share-note">Preview disabled — link won\u2019t load.</p>'}
        </div>
      </div>
      ` : ''}
    </div>
  `;
}

function refreshMetaReportClientShareUi(payload) {
  syncMetaReportToolbarCopy(payload);
  updateMetaReportShareSummary(payload);
  const card = document.getElementById('meta-report-share-card');
  if (card) card.classList.toggle('is-disabled', !payload.settings?.metaReportEnabled);
  const urlEl = document.getElementById('meta-report-share-url');
  if (urlEl && payload.reportUrl) urlEl.textContent = metaReportFullUrl(payload.reportUrl);
  const suffixEl = document.getElementById('meta-report-share-slug-suffix');
  const code = resolveMetaReportShareCode(payload);
  if (suffixEl) suffixEl.textContent = `-${code || '····'}`;
  const slugInput = document.getElementById('meta-report-share-slug');
  if (slugInput) slugInput.value = resolveMetaReportShareSlug(payload);
  const rotateBtn = document.getElementById('meta-report-rotate-token');
  if (rotateBtn) rotateBtn.disabled = !payload.settings?.metaReportEnabled;
  const previewToggle = document.querySelector('[data-meta-client-preview]');
  if (previewToggle) previewToggle.checked = Boolean(payload.settings?.metaReportEnabled);
  setMetaReportShareExpanded(metaReportsState.clientShareExpanded);
}

function syncMetaReportShareCard(payload) {
  const card = document.getElementById('meta-report-share-card');
  if (!card) return;
  const parent = card.parentElement;
  if (!parent) return;
  const markup = renderMetaReportShareCard(payload);
  const wrapper = document.createElement('div');
  wrapper.innerHTML = markup.trim();
  const nextCard = wrapper.firstElementChild;
  if (!nextCard) return;
  parent.replaceChild(nextCard, card);
  setMetaReportShareExpanded(metaReportsState.clientShareExpanded);
  bindMetaReportShareEvents(payload);
  syncMetaReportToolbarCopy(payload);
}

function bindMetaReportRotateButton(clientId) {
  const rotateBtn = document.getElementById('meta-report-rotate-token');
  if (!rotateBtn) return;
  rotateBtn.onclick = async () => {
    if (!window.confirm('Rotate the share link? The old link will stop working.')) return;
    rotateBtn.disabled = true;
    try {
      const result = await patchMetaReportSettings(clientId, { rotateAccessToken: true });
      const reportUrl = result.settings?.reportUrl || null;
      const currentPayload = metaReportsState.clientPayload;
      if (currentPayload) {
        currentPayload.reportUrl = reportUrl;
        if (result.settings) currentPayload.settings = { ...currentPayload.settings, ...result.settings };
      }
      const nextPayload = currentPayload || { clientId, reportUrl, settings: result.settings || {} };
      metaReportsState.clientPayload = nextPayload;
      if (metaReportsState.clientShareExpanded) {
        refreshMetaReportClientShareUi(nextPayload);
      } else {
        syncMetaReportShareCard(nextPayload);
      }
      showToast('Share link rotated', 'success');
    } catch (error) {
      showToast(error.message || 'Rotate failed', 'error');
    } finally {
      const btn = document.getElementById('meta-report-rotate-token');
      if (btn) btn.disabled = false;
    }
  };
}

function bindMetaReportShareEvents(payload) {
  const clientId = payload.clientId;
  bindMetaReportCopyButtons();
  bindMetaReportRotateButton(clientId);

  const editBtn = document.getElementById('meta-report-share-edit');
  if (editBtn) {
    editBtn.onclick = () => setMetaReportShareExpanded(true);
  }

  const doneBtn = document.getElementById('meta-report-share-done');
  if (doneBtn) {
    doneBtn.onclick = () => setMetaReportShareExpanded(false);
  }

  const saveBtn = document.getElementById('meta-report-share-save');
  if (saveBtn) {
    saveBtn.onclick = async () => {
      const input = document.getElementById('meta-report-share-slug');
      const normalized = normalizeMetaReportSlugInput(input?.value);
      if (!normalized || normalized.length < 2) {
        showToast('Enter a valid slug (at least 2 characters).', 'error');
        return;
      }
      saveBtn.disabled = true;
      try {
        const result = await patchMetaReportSettings(clientId, { metaReportSlug: normalized });
        const settings = result.settings || {};
        const currentPayload = metaReportsState.clientPayload || payload;
        currentPayload.settings = { ...currentPayload.settings, ...settings };
        currentPayload.reportUrl = settings.reportUrl || null;
        metaReportsState.clientPayload = currentPayload;
        refreshMetaReportClientShareUi(currentPayload);
        setMetaReportShareExpanded(false);
        showToast('Share link slug saved', 'success');
      } catch (error) {
        showToast(error.message || 'Save failed', 'error');
      } finally {
        const btn = document.getElementById('meta-report-share-save');
        if (btn) btn.disabled = false;
      }
    };
  }

  const slugInput = document.getElementById('meta-report-share-slug');
  if (slugInput) {
    slugInput.oninput = () => {
      slugInput.value = normalizeMetaReportSlugInput(slugInput.value);
    };
  }

  const previewToggle = document.querySelector('[data-meta-client-preview]');
  if (previewToggle) {
    let previewSaveSeq = 0;
    previewToggle.onchange = async () => {
      const seq = ++previewSaveSeq;
      const enabled = previewToggle.checked;
      const previous = !enabled;
      const currentPayload = metaReportsState.clientPayload || payload;
      applyMetaReportEnabledUi(currentPayload, enabled);
      const switchEl = previewToggle.closest('.meta-hub-switch');
      switchEl?.classList.add('is-saving');
      try {
        const result = await patchMetaReportSettings(clientId, { metaReportEnabled: enabled }, { fast: true });
        if (seq !== previewSaveSeq) return;
        const settings = result.settings || {};
        currentPayload.settings = { ...currentPayload.settings, ...settings };
        currentPayload.reportUrl = settings.reportUrl ?? currentPayload.reportUrl;
        metaReportsState.clientPayload = currentPayload;
        applyMetaReportEnabledUi(currentPayload, Boolean(settings.metaReportEnabled));
        showToast(enabled ? 'Client preview enabled' : 'Client preview disabled', 'success');
      } catch (error) {
        if (seq !== previewSaveSeq) return;
        applyMetaReportEnabledUi(currentPayload, previous);
        previewToggle.checked = previous;
        showToast(error.message || 'Update failed', 'error');
      } finally {
        if (seq === previewSaveSeq) switchEl?.classList.remove('is-saving');
      }
    };
  }
}

function renderMetaReportHubCard(client) {
  const canEdit = Boolean(client.clientId);
  const rowKey = client.clientId || client.metaAdAccountId || '';
  const cardClass = client.needsSetup ? 'is-setup' : '';
  const statusBadge = client.needsSetup
    ? '<span class="meta-report-badge meta-report-badge--setup">Needs setup</span>'
    : (client.metaReportEnabled
      ? '<span class="meta-report-badge meta-report-badge--on">Report live</span>'
      : '<span class="meta-report-badge meta-report-badge--off">Report off</span>');
  const typeLabel = client.hasGhl ? 'GHL + Meta' : 'Meta only';
  const nameMarkup = canEdit
    ? `<a href="/admin/meta-reports/${encodeURIComponent(client.clientId)}" class="meta-hub-card-name">${esc(client.accountName)}</a>`
    : `<span class="meta-hub-card-name">${esc(client.accountName)}</span>`;

  const actionButtons = [];
  if (client.needsSetup) {
    actionButtons.push(`<button type="button" class="admin-btn admin-btn--primary" data-meta-provision="${esc(client.metaAdAccountId)}" data-meta-provision-name="${esc(client.accountName)}">Add client</button>`);
  } else if (canEdit) {
    actionButtons.push(`<a class="admin-btn" href="/admin/meta-reports/${encodeURIComponent(client.clientId)}">Edit report</a>`);
    actionButtons.push(client.reportUrl
      ? `<button type="button" class="admin-btn admin-btn--secondary" data-copy-report-url="${esc(client.reportUrl)}">Copy link</button>`
      : `<a class="admin-btn admin-btn--secondary" href="/admin/meta-reports/${encodeURIComponent(client.clientId)}">Enable report</a>`);
  }
  const actionsClass = actionButtons.length === 1 ? 'meta-hub-card-actions meta-hub-card-actions--single' : 'meta-hub-card-actions';

  return `
    <article class="meta-hub-card ${cardClass}" data-meta-hub-row="${esc(rowKey)}">
      <div class="meta-hub-card-head">
        <span class="meta-hub-avatar" aria-hidden="true">${metaHubClientInitial(client.accountName)}</span>
        <div class="meta-hub-card-title">
          ${nameMarkup}
          <div class="meta-hub-card-slug">act_${esc(client.metaAdAccountId || '—')}</div>
        </div>
      </div>
      <div class="meta-hub-card-meta">
        ${statusBadge}
        <span class="meta-hub-card-meta-dot" aria-hidden="true">·</span>
        <span>${esc(typeLabel)}</span>
      </div>
      <div class="meta-hub-card-toggles">
        ${renderMetaHubSwitch({
          label: 'Report',
          attr: 'data-meta-report-enabled',
          value: canEdit ? client.clientId : null,
          checked: client.metaReportEnabled,
        })}
        ${renderMetaHubSwitch({
          label: 'Bottomline',
          attr: 'data-meta-bottomline',
          value: canEdit ? client.clientId : null,
          checked: client.metaReportShowBottomline,
          disabled: !client.metaReportEnabled,
        })}
        ${renderMetaHubSwitch({
          label: 'Censio fee',
          attr: 'data-meta-fee',
          value: canEdit ? client.clientId : null,
          checked: client.metaReportFeeEnabled,
          disabled: !client.metaReportEnabled,
        })}
      </div>
      ${actionButtons.length ? `<div class="${actionsClass}">${actionButtons.join('')}</div>` : ''}
    </article>
  `;
}

function renderMetaReportsClientCards(clients, filter = 'all', searchQuery = '') {
  if (!clients.length) {
    const message = searchQuery
      ? `No clients match “${searchQuery}”.`
      : (filter === 'all'
        ? 'No Meta ad accounts found. Check META_SYSTEM_USER_TOKEN and META_BUSINESS_ID, or add clients manually.'
        : 'No clients match this filter.');
    return `
      <div class="meta-hub-empty">
        <h3>No clients to show</h3>
        <p>${esc(message)}</p>
      </div>
    `;
  }
  return clients.map((client) => renderMetaReportHubCard(client)).join('');
}

function renderMetaReportsBannerHtml(metaInfo) {
  if (!metaInfo?.partnerFetchError) return '';
  return `
    <div class="meta-hub-banner">
      <strong>Meta Business Manager listing unavailable</strong>
      ${esc(metaInfo.partnerFetchError)} Showing only clients already configured in the app.
    </div>
  `;
}

function renderMetaHubFiltersHtml(activeFilter) {
  return META_HUB_FILTER_OPTIONS.map((option) => `
    <button
      type="button"
      class="meta-hub-filter${activeFilter === option.value ? ' is-active' : ''}"
      data-meta-filter="${esc(option.value)}"
    >${esc(option.label)}</button>
  `).join('');
}

function recomputeMetaReportsSummaryCounts() {
  const all = metaReportsState.dashboardData?.clients || [];
  const summary = metaReportsState.dashboardData?.summary || {};
  metaReportsState.dashboardData.summary = {
    ...summary,
    inAppCount: all.filter((client) => client.inApp).length,
    enabledCount: all.filter((client) => client.metaReportEnabled).length,
    needsSetupCount: all.filter((client) => client.needsSetup).length,
    totalListed: all.length,
  };
}

function mergeHubClient(clientId, patch) {
  const all = metaReportsState.dashboardData?.clients;
  if (!all) return null;
  const index = all.findIndex((client) => client.clientId === clientId);
  if (index < 0) return null;
  all[index] = { ...all[index], ...patch };
  recomputeMetaReportsSummaryCounts();
  return all[index];
}

function updateMetaReportsHubDom(viewData) {
  const bannerEl = document.getElementById('meta-reports-banner');
  const cardsEl = document.getElementById('meta-reports-cards');
  const countEl = document.getElementById('meta-reports-count');
  if (bannerEl) bannerEl.innerHTML = renderMetaReportsBannerHtml(viewData.meta);
  if (countEl) countEl.textContent = `${viewData.clients.length} client${viewData.clients.length === 1 ? '' : 's'}`;
  if (cardsEl) {
    cardsEl.innerHTML = renderMetaReportsClientCards(viewData.clients, viewData.filter, viewData.searchQuery);
    bindMetaReportsHubRowEvents(cardsEl);
  }
}

function renderMetaReportsClientTabs(payload) {
  const monthKeys = payload.monthKeys || [];
  const activeKey = metaReportsState.activeMonthKey || monthKeys[monthKeys.length - 1] || '';
  return monthKeys.map((key) => `
    <button type="button" class="meta-report-tab${key === activeKey ? ' is-active' : ''}" data-meta-month-tab="${esc(key)}">${esc(metaMonthLabel(key))}</button>
  `).join('');
}

function getMetaReportCalendarYear(payload) {
  const fromPayload = Number(payload?.currentYear);
  if (Number.isFinite(fromPayload) && fromPayload >= 2000) return fromPayload;
  return new Date().getFullYear();
}

function getMetaReportYearOptions(payload) {
  // Always anchor to calendar this/last year — never to the selected report year.
  const currentYear = getMetaReportCalendarYear(payload);
  const previousYear = currentYear - 1;
  const availability = new Map();
  if (Array.isArray(payload?.years)) {
    payload.years.forEach((entry) => {
      const year = Number(entry?.year);
      if (Number.isFinite(year)) availability.set(year, entry.available !== false);
    });
  }
  const previousAvailable = availability.has(previousYear)
    ? availability.get(previousYear)
    : payload?.previousYearHasData === true;
  return [
    { year: currentYear, available: true },
    { year: previousYear, available: Boolean(previousAvailable) },
  ];
}

function renderMetaReportYearSelectOptions(payload, { disableUnavailable = false } = {}) {
  const selectedYear = Number(metaReportsState.selectedYear) || Number(payload?.year);
  return getMetaReportYearOptions(payload).map(({ year, available }) => {
    const disabled = disableUnavailable && !available;
    return `<option value="${year}"${Number(selectedYear) === year ? ' selected' : ''}${disabled ? ' disabled' : ''}>${year}${!available ? ' (no data)' : ''}</option>`;
  }).join('');
}

function syncMetaReportSelectedYear(payload, { disableUnavailable = false } = {}) {
  const options = getMetaReportYearOptions(payload);
  const selected = Number(metaReportsState.selectedYear);
  const selectedOption = options.find((entry) => entry.year === selected);
  if (selectedOption && (!disableUnavailable || selectedOption.available)) {
    metaReportsState.selectedYear = selectedOption.year;
    return;
  }
  const payloadYear = Number(payload?.year);
  const payloadOption = options.find((entry) => entry.year === payloadYear);
  if (payloadOption && (!disableUnavailable || payloadOption.available)) {
    metaReportsState.selectedYear = payloadOption.year;
    return;
  }
  const fallback = options.find((entry) => entry.available) || options[0];
  if (fallback) metaReportsState.selectedYear = fallback.year;
}

function refreshMetaReportMonthPanel(monthPayload) {
  const payload = metaReportsState.clientPayload;
  if (!payload || !metaReportsState.activeMonthKey) return;
  payload.months = payload.months || {};
  payload.months[metaReportsState.activeMonthKey] = monthPayload;
  const panel = document.getElementById('meta-report-month-panel');
  if (!panel) return;
  panel.innerHTML = renderMetaReportMonthBody(
    monthPayload,
    getMetaReportMonthBodyOptions(payload.settings, { editable: true }),
  );
  bindMetaReportsClientEditEvents(payload.clientId, payload);
  refreshMetaReportBackfillControl(payload);
}

function refreshMetaReportBackfillControl(payload) {
  const toolbarLeft = document.querySelector('.meta-report-client-page .meta-report-toolbar-left');
  const wrap = document.querySelector('.meta-report-backfill-wrap');
  const missing = metaReportMonthsNeedingBackfill(payload);
  if (!missing.length) {
    if (wrap) wrap.remove();
    return;
  }
  const label = `${ICON_SYNC} Backfill ${missing.length} month${missing.length === 1 ? '' : 's'} from Meta`;
  const btn = document.getElementById('meta-report-backfill');
  if (btn) {
    btn.innerHTML = label;
    btn.disabled = false;
  } else if (toolbarLeft) {
    const div = document.createElement('div');
    div.className = 'meta-report-backfill-wrap';
    div.innerHTML = `
      <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="meta-report-backfill">${label}</button>
      <span class="meta-report-backfill-progress" id="meta-report-backfill-progress"></span>
    `;
    toolbarLeft.appendChild(div);
    bindMetaReportBackfillButton(payload.clientId);
  }
}

function updateMetaReportsClientContent(payload) {
  metaReportsState.clientPayload = payload;
  const monthKeys = payload.monthKeys || [];
  if (!metaReportsState.activeMonthKey) {
    metaReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  } else if (!monthKeys.includes(metaReportsState.activeMonthKey)) {
    metaReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  }

  syncMetaReportSelectedYear(payload, { disableUnavailable: true });
  const yearSelect = document.getElementById('meta-report-year');
  if (yearSelect) {
    yearSelect.innerHTML = renderMetaReportYearSelectOptions(payload, { disableUnavailable: true });
  }

  syncMetaReportToolbarCopy(payload);
  syncMetaReportShareCard(payload);

  const settings = payload.settings || {};
  const monthPayload = payload.months?.[metaReportsState.activeMonthKey] || null;
  syncMetaReportSettingsControls(settings, monthPayload);

  const tabsEl = document.querySelector('.meta-report-tabs');
  if (tabsEl) {
    tabsEl.innerHTML = renderMetaReportsClientTabs(payload);
    bindMetaReportsClientTabEvents(payload);
  }

  const panel = document.getElementById('meta-report-month-panel');
  if (panel) {
    panel.innerHTML = renderMetaReportMonthBody(
      payload.months?.[metaReportsState.activeMonthKey],
      getMetaReportMonthBodyOptions(settings, { editable: true }),
    );
    bindMetaReportsClientEditEvents(payload.clientId, payload);
  }
  refreshMetaReportBackfillControl(payload);
}

function updatePublicMetaReportContent(payload) {
  metaReportsState.publicPayload = payload;
  const monthKeys = payload.monthKeys || [];
  if (!metaReportsState.activeMonthKey) {
    metaReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  } else if (!monthKeys.includes(metaReportsState.activeMonthKey)) {
    metaReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  }

  syncMetaReportSelectedYear(payload, { disableUnavailable: true });
  const yearSelect = document.getElementById('meta-report-year');
  if (yearSelect) {
    yearSelect.innerHTML = renderMetaReportYearSelectOptions(payload, { disableUnavailable: true });
  }

  const tabsEl = document.querySelector('.meta-report-tabs');
  if (tabsEl) {
    tabsEl.innerHTML = monthKeys.map((key) => `
      <button type="button" class="meta-report-tab${key === metaReportsState.activeMonthKey ? ' is-active' : ''}" data-meta-month-tab="${esc(key)}">${esc(metaMonthLabel(key))}</button>
    `).join('');
    bindPublicMetaReportTabEvents(payload);
  }

  const panel = document.getElementById('meta-report-month-panel');
  if (panel) {
    panel.innerHTML = renderMetaReportMonthBody(
      payload.months?.[metaReportsState.activeMonthKey],
      getMetaReportMonthBodyOptions(payload.settings, { editable: false }),
    );
  }
}

const META_MONTH_LABELS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function metaFmtKr(value) {
  const amount = Number(value) || 0;
  return `Dkr ${amount.toLocaleString('da-DK', { minimumFractionDigits: 0, maximumFractionDigits: 2 })}`;
}

function metaFmtNum(value, digits = 0) {
  const amount = Number(value) || 0;
  return amount.toLocaleString('da-DK', { minimumFractionDigits: digits, maximumFractionDigits: digits });
}

function metaFmtX(value) {
  const amount = Number(value);
  if (!Number.isFinite(amount)) return '—';
  if (amount === 0) return '0.00x';
  return `${amount.toFixed(2)}x`;
}

function metaMonthLabel(monthKey) {
  const month = Number(String(monthKey || '').slice(5, 7));
  return META_MONTH_LABELS[month - 1] || monthKey;
}

function metaReportMonthsNeedingBackfill(payload) {
  const monthKeys = payload?.monthKeys || [];
  return monthKeys.filter((key) => !payload.months?.[key]?.metaFetchedAt);
}

function metaReportTone(value) {
  const amount = Number(value);
  if (!Number.isFinite(amount) || amount === 0) return 'neutral';
  return amount > 0 ? 'positive' : 'negative';
}

function renderMetaReportHighlightStrip(monthPayload) {
  if (!monthPayload || monthPayload.meta?.emptyMonth) return '';
  const roasX = Number(monthPayload.topline?.roasX) || 0;
  const items = [
    { label: 'Ad spend', value: metaFmtKr(monthPayload.meta?.spend), tone: 'neutral' },
    { label: 'Leads', value: metaFmtNum(monthPayload.topline?.leads), tone: 'neutral' },
    { label: 'Return on ad spend', value: metaFmtX(roasX), tone: metaReportTone(roasX) },
  ];
  if (monthPayload.bottomline) {
    const useFee = Number(monthPayload.bottomline.feePercent) > 0;
    const profitValue = useFee ? monthPayload.bottomline.poiKr : monthPayload.bottomline.poasKr;
    items.push({
      label: useFee ? 'Profit on investment' : 'Profit on ad spend',
      value: metaFmtKr(profitValue),
      tone: metaReportTone(profitValue),
    });
  } else {
    items.push({
      label: 'Won leads',
      value: metaFmtNum(monthPayload.topline?.wonLeads),
      tone: 'neutral',
    });
  }
  return `
    <div class="meta-report-highlight-strip">
      ${items.map(({ label, value, tone }) => `
        <div class="meta-report-highlight-item${tone && tone !== 'neutral' ? ` is-${tone}` : ''}">
          <div class="meta-report-highlight-label">${esc(label)}</div>
          <div class="meta-report-highlight-value">${esc(value)}</div>
        </div>
      `).join('')}
    </div>
  `;
}

function renderMetaReportMetricTable(title, rows, accent = 'meta', { badge = '', highlightLastN = 0 } = {}) {
  const rowsHtml = rows.map(([label, value, unit], index) => {
    const isHighlight = highlightLastN > 0 && index >= rows.length - highlightLastN;
    return `
      <tr class="${isHighlight ? `is-highlight accent-${accent}` : ''}">
        <th scope="row">${esc(label)}</th>
        <td>${esc(String(value ?? '—'))}${unit ? `<span class="meta-report-row-unit">${esc(unit)}</span>` : ''}</td>
      </tr>
    `;
  }).join('');
  return `
    <section class="meta-report-group">
      <div class="meta-report-group-head">
        <span class="meta-report-group-bar meta-report-group-bar--${accent}" aria-hidden="true"></span>
        <h3 class="meta-report-group-title">${esc(title)}</h3>
        ${badge ? `<span class="meta-report-group-badge">${esc(badge)}</span>` : ''}
      </div>
      <div class="meta-report-group-table-wrap">
        <table class="meta-report-group-table">
          <tbody>${rowsHtml}</tbody>
        </table>
      </div>
    </section>
  `;
}

function getMetaReportMonthBodyOptions(settings = {}, { editable = false } = {}) {
  return { editable };
}

function renderMetaReportMonthBody(monthPayload, { editable = false } = {}) {
  if (!monthPayload) {
    return '<div class="meta-report-empty">No data for this month yet.</div>';
  }
  if (monthPayload.meta?.emptyMonth) {
    return `<div class="meta-report-empty">No ad spend recorded for this month yet.${editable ? ' Click "Refresh from Meta" below, or use "Backfill from Meta" above to pull historical months.' : ''}</div>`;
  }

  let editPanelHtml = '';
  if (editable) {
    editPanelHtml = `
      <div class="meta-report-edit-panel" id="meta-report-edit-panel">
        <h3>Edit month inputs</h3>
        <div class="meta-report-edit-grid">
          <label>Period start<input type="date" id="meta-report-period-start" value="${esc(monthPayload.periodStart || '')}" /></label>
          <label>Period end<input type="date" id="meta-report-period-end" value="${esc(monthPayload.periodEnd || '')}" /></label>
          <label>Won leads<input type="number" step="any" id="meta-report-won-leads" value="${esc(monthPayload.topline?.wonLeads ?? '')}" /></label>
          <label>Avg lead value<input type="number" step="any" id="meta-report-avg-lead-value" value="${esc(monthPayload.topline?.avgLeadValue ?? '')}" /></label>
          <label>Avg profit per won<input type="number" step="any" id="meta-report-avg-profit" value="${esc(monthPayload.inputs?.avgProfitPerWon ?? '')}" /></label>
        </div>
        <div class="meta-report-edit-actions">
          <button type="button" class="admin-btn admin-btn--ghost" id="meta-report-refresh-meta">${ICON_SYNC} Refresh from Meta</button>
          <button type="button" class="admin-btn admin-btn--primary" id="meta-report-save-month">Save month</button>
        </div>
      </div>
    `;
  }

  const metaRows = [
    ['Total spend', metaFmtKr(monthPayload.meta?.spend), ''],
    ['Cost Pr Mile (CPM)', metaFmtKr(monthPayload.meta?.cpm), ''],
    ['Impressions', metaFmtNum(monthPayload.meta?.impressions), ''],
    ['Reach', metaFmtNum(monthPayload.meta?.reach), ''],
    ['Click', metaFmtNum(monthPayload.meta?.clicks), ''],
    ['CTR', metaFmtNum(monthPayload.meta?.conversionRatePercent, 2), '%'],
  ];
  const toplineRows = [
    ['Leads', metaFmtNum(monthPayload.topline?.leads), ''],
    ['Cost Per Lead (CPL)', metaFmtKr(monthPayload.topline?.cpl), ''],
    ['Won leads', metaFmtNum(monthPayload.topline?.wonLeads), ''],
    ['Total Lead Value', metaFmtKr(monthPayload.topline?.totalLeadValue), ''],
    ['Average Lead Value', metaFmtKr(monthPayload.topline?.avgLeadValue), ''],
    ['Client acquisition cost (CAC)', metaFmtKr(monthPayload.topline?.cac), ''],
    ['Return on Ads Spend (ROAS)', metaFmtKr(monthPayload.topline?.roasKr), ''],
    ['Return on Ads Spend % (ROAS)', metaFmtX(monthPayload.topline?.roasX), ''],
  ];

  let groupsHtml = '';
  groupsHtml += renderMetaReportMetricTable('Meta ads', metaRows, 'meta');
  groupsHtml += renderMetaReportMetricTable('Topline KPI\'er', toplineRows, 'topline', { highlightLastN: 2 });

  if (monthPayload.bottomline) {
    const bottomRows = [
      ['Leads', metaFmtNum(monthPayload.bottomline.leads), ''],
      ['Won leads', metaFmtNum(monthPayload.bottomline.wonLeads), ''],
      ['Total Lead Value', metaFmtKr(monthPayload.bottomline.totalLeadValue), ''],
      ['Average Lead Value', metaFmtKr(monthPayload.bottomline.avgLeadValue), ''],
      ['Client acquisition cost (CAC)', metaFmtKr(monthPayload.bottomline.cac), ''],
      ['Avg Total Profit', metaFmtKr(monthPayload.bottomline.totalProfit), ''],
      ['Avg Single Profit Order', metaFmtKr(monthPayload.bottomline.avgProfitPerWon), ''],
      ['Profit on Ads Spend (POAS)', metaFmtKr(monthPayload.bottomline.poasKr), ''],
      ['Profit on Ads Spend % (POAS)', metaFmtX(monthPayload.bottomline.poasX), ''],
    ];
    if (monthPayload.bottomline.feeMode) {
      const feeLabel = monthPayload.bottomline.feeLabel
        || (monthPayload.bottomline.feeMode === 'marketing'
          ? 'Censio marketing fee'
          : `Censio performance fee (${metaFmtNum(monthPayload.bottomline.feePercent, 0)}%)`);
      bottomRows.push([feeLabel, metaFmtKr(monthPayload.bottomline.censioFee), '']);
      bottomRows.push(['Profit on Investment (POI)', metaFmtKr(monthPayload.bottomline.poiKr), '']);
      bottomRows.push(['Profit on Investment % (POI)', metaFmtX(monthPayload.bottomline.poiX), '']);
    }
    groupsHtml += renderMetaReportMetricTable('Bottomline KPI\'er', bottomRows, 'bottomline', { highlightLastN: 2 });
  }

  const previewLabel = editable ? 'Report preview' : 'Report';
  const previewHtml = `
    <div class="meta-report-preview-card">
      <div class="meta-report-preview-card-label">${previewLabel}</div>
      ${renderMetaReportHighlightStrip(monthPayload)}
    </div>
  `;
  const tablesHtml = groupsHtml ? `
    <div class="meta-report-tables-card">
      <div class="meta-report-tables-card-label">Details</div>
      <div class="meta-report-groups-stack">${groupsHtml}</div>
    </div>
  ` : '';

  return `${editPanelHtml}${previewHtml}${tablesHtml}`;
}

