  const rows = (data.clients || []).map((client) => `
    <tr>
      <td><strong>${esc(client.accountName)}</strong><div class="meta-cv-client-meta">${esc(client.clientId)}</div></td>
      <td>${client.hasGhl ? 'Connected' : 'Not connected'}</td>
      <td>
        <label style="display:inline-flex;align-items:center;gap:8px">
          <input type="checkbox" data-ghl-list-toggle="${esc(client.clientId)}"${client.onGhlList ? ' checked' : ''}${!client.hasGhl ? ' disabled' : ''} />
          On Cenhub list
        </label>
      </td>
      <td>${client.snapshotFetchedAt ? esc(metaCvFormatUpdatedAt(client.snapshotFetchedAt)) : '—'}${client.snapshotStale ? ' · stale' : ''}</td>
      <td>
        ${client.onGhlList ? `<a class="admin-btn admin-btn--ghost" href="/admin/meta-reports/custom-values">Custom values</a>` : ''}
      </td>
    </tr>
