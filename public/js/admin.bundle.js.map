function metaReportComparisonAddMonths(monthKey, offset = 0) {
  const normalized = String(monthKey || '').trim();
  if (!/^\d{4}-\d{2}$/.test(normalized)) return null;
  const [year, month] = normalized.split('-').map(Number);
  const date = new Date(year, (month - 1) + offset, 1);
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
}

function metaReportComparisonMonthKeysInRange(startKey, endKey) {
  if (!startKey || !endKey) return [];
  const [start, end] = startKey <= endKey ? [startKey, endKey] : [endKey, startKey];
  const keys = [];
  let cursor = start;
  while (cursor && cursor <= end) {
    keys.push(cursor);
    if (cursor === end) break;
    cursor = metaReportComparisonAddMonths(cursor, 1);
  }
  return keys;
}

function metaReportComparisonParseDate(value) {
  const normalized = String(value || '').trim().slice(0, 10);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(normalized)) return null;
  const [year, month, day] = normalized.split('-').map(Number);
  const date = new Date(year, month - 1, day);
  if (date.getFullYear() !== year || date.getMonth() !== month - 1 || date.getDate() !== day) return null;
  return normalized;
}

function metaReportComparisonDaysInclusive(startDate, endDate) {
  const start = metaReportComparisonParseDate(startDate);
  const end = metaReportComparisonParseDate(endDate);
  if (!start || !end || start > end) return 0;
  const [sy, sm, sd] = start.split('-').map(Number);
  const [ey, em, ed] = end.split('-').map(Number);
  const startMs = Date.UTC(sy, sm - 1, sd);
  const endMs = Date.UTC(ey, em - 1, ed);
  return Math.floor((endMs - startMs) / 86400000) + 1;
}

function metaReportComparisonOverlapDays(rangeAStart, rangeAEnd, rangeBStart, rangeBEnd) {
  const start = rangeAStart > rangeBStart ? rangeAStart : rangeBStart;
  const end = rangeAEnd < rangeBEnd ? rangeAEnd : rangeBEnd;
  if (!start || !end || start > end) return 0;
  return metaReportComparisonDaysInclusive(start, end);
}

function metaReportComparisonMonthKeyFromDate(dateValue) {
  const parsed = metaReportComparisonParseDate(dateValue);
  return parsed ? parsed.slice(0, 7) : null;
}

function metaReportComparisonMonthKeysOverlappingDates(startDate, endDate) {
  const start = metaReportComparisonParseDate(startDate);
  const end = metaReportComparisonParseDate(endDate);
  if (!start || !end) return [];
  const [rangeStart, rangeEnd] = start <= end ? [start, end] : [end, start];
  const keys = [];
  let cursor = metaReportComparisonMonthKeyFromDate(rangeStart);
  const endKey = metaReportComparisonMonthKeyFromDate(rangeEnd);
  while (cursor && cursor <= endKey) {
    keys.push(cursor);
    if (cursor === endKey) break;
    cursor = metaReportComparisonAddMonths(cursor, 1);
  }
  return keys;
}

function metaReportComparisonMonthEffectivePeriod(monthPayload, monthKey) {
  const bounds = metaReportMonthBounds(monthKey || monthPayload?.monthKey);
  const start = metaReportComparisonParseDate(monthPayload?.periodStart) || bounds.start;
  const end = metaReportComparisonParseDate(monthPayload?.periodEnd) || bounds.end;
  if (start && end && start <= end) return { start, end };
  return bounds;
}

function metaReportComparisonFormatDateLabel(dateValue) {
  const parsed = metaReportComparisonParseDate(dateValue);
  if (!parsed) return '—';
  const [year, month, day] = parsed.split('-').map(Number);
  return `${day} ${META_MONTH_LABELS[month - 1] || month} ${year}`;
}

function metaReportComparisonFormatDateRangeLabel(startDate, endDate) {
  const start = metaReportComparisonParseDate(startDate);
  const end = metaReportComparisonParseDate(endDate);
  if (!start || !end) return '—';
  if (start === end) return metaReportComparisonFormatDateLabel(start);
  const startYear = start.slice(0, 4);
  const endYear = end.slice(0, 4);
  const startMonth = start.slice(5, 7);
  const endMonth = end.slice(5, 7);
  if (startYear === endYear && startMonth === endMonth) {
    const [, sm, sd] = start.split('-').map(Number);
    const [, , ed] = end.split('-').map(Number);
    return `${sd}–${ed} ${META_MONTH_LABELS[sm - 1] || sm} ${startYear}`;
  }
  if (startYear === endYear) {
    return `${metaReportComparisonFormatDateLabel(start).replace(` ${startYear}`, '')}–${metaReportComparisonFormatDateLabel(end)}`;
  }
  return `${metaReportComparisonFormatDateLabel(start)} – ${metaReportComparisonFormatDateLabel(end)}`;
}

function metaReportComparisonMonthPayloadDates(monthPayload, monthKey) {
  const period = metaReportComparisonMonthEffectivePeriod(monthPayload, monthKey);
  return {
    startDate: period.start,
    endDate: period.end,
    startMonthKey: monthKey,
    endMonthKey: monthKey,
  };
}

function metaReportComparisonFullMonthDates(monthKey) {
  const bounds = metaReportMonthBounds(monthKey);
  return {
    startDate: bounds.start,
    endDate: bounds.end,
    startMonthKey: monthKey,
    endMonthKey: monthKey,
  };
}

function metaReportComparisonFormatDisplayLabel(mode, period) {
  const normalized = metaReportComparisonNormalizePeriod(period);
  if (!normalized) return '—';
  if (mode === 'mom' || mode === 'months') {
    return metaReportComparisonPeriodLabel(normalized.startMonthKey, normalized.endMonthKey);
  }
  if (mode === 'ytd') {
    return normalized.startDate.slice(0, 4);
  }
  return metaReportComparisonFormatDateRangeLabel(normalized.startDate, normalized.endDate);
}

function metaReportComparisonAggregateForMode(mode, monthsMap, period) {
  const normalized = metaReportComparisonNormalizePeriod(period);
  if (!normalized) {
    return {
      label: '—',
      monthKeys: [],
      monthCount: 0,
      expectedMonthCount: 0,
      partialData: false,
      hasData: false,
      hasBottomline: false,
      metrics: metaReportComparisonAggregateDateRange({}, null, null).metrics,
    };
  }
  let agg;
  if (mode === 'mom' || mode === 'months') {
    agg = metaReportAggregateComparisonRange(monthsMap, normalized.startMonthKey, normalized.endMonthKey);
  } else {
    agg = metaReportComparisonAggregateDateRange(monthsMap, normalized.startDate, normalized.endDate);
  }
  agg.label = metaReportComparisonFormatDisplayLabel(mode, normalized);
  return agg;
}

function metaReportComparisonNormalizePeriod(period = null) {
  if (!period) return null;
  const startDate = metaReportComparisonParseDate(period.startDate)
    || (period.startMonthKey ? metaReportMonthBounds(period.startMonthKey).start : null);
  const endDate = metaReportComparisonParseDate(period.endDate)
    || (period.endMonthKey ? metaReportMonthBounds(period.endMonthKey).end : null);
  if (!startDate || !endDate) return null;
  const [normalizedStart, normalizedEnd] = startDate <= endDate
    ? [startDate, endDate]
    : [endDate, startDate];
  return {
    startDate: normalizedStart,
    endDate: normalizedEnd,
    startMonthKey: metaReportComparisonMonthKeyFromDate(normalizedStart),
    endMonthKey: metaReportComparisonMonthKeyFromDate(normalizedEnd),
  };
}

function metaReportComparisonPeriodLabel(startKey, endKey) {
  if (!startKey || !endKey) return '—';
  if (startKey === endKey) {
    return `${metaMonthLabel(startKey)} ${String(startKey).slice(0, 4)}`;
  }
  const startYear = String(startKey).slice(0, 4);
  const endYear = String(endKey).slice(0, 4);
  if (startYear === endYear) {
    return `${metaMonthLabel(startKey)}–${metaMonthLabel(endKey)} ${startYear}`;
  }
  return `${metaMonthLabel(startKey)} ${startYear}–${metaMonthLabel(endKey)} ${endYear}`;
}

function metaReportMonthHasComparisonData(monthPayload) {
  if (!monthPayload || monthPayload.meta?.emptyMonth) return false;
  return metaReportParseAmount(monthPayload.meta?.spend) > 0
    || metaReportParseAmount(monthPayload.topline?.leads) > 0;
}

function metaReportAggregateComparisonRange(monthsMap = {}, startKey, endKey) {
  const rangeKeys = metaReportComparisonMonthKeysInRange(startKey, endKey);
  const included = [];
  let hasBottomline = false;

  let spend = 0;
  let impressions = 0;
  let reach = 0;
  let clicks = 0;
  let leads = 0;
  let wonLeads = 0;
  let totalLeadValue = 0;
  let totalProfit = 0;
  let censioFeeSum = 0;
  let weightedLeadValue = 0;
  let weightedProfitPerWon = 0;
  let weightedCpm = 0;
  let cpmWeight = 0;

  for (const key of rangeKeys) {
    const month = monthsMap[key];
    if (!metaReportMonthHasComparisonData(month)) continue;
    included.push(key);
    if (month.bottomline) hasBottomline = true;

    const monthSpend = metaReportParseAmount(month.meta?.spend);
    const monthImpressions = metaReportParseAmount(month.meta?.impressions);
    const monthLeads = metaReportParseAmount(month.topline?.leads);
    const monthWon = metaReportParseAmount(month.topline?.wonLeads);

    spend += monthSpend;
    impressions += monthImpressions;
    reach += metaReportParseAmount(month.meta?.reach);
    clicks += metaReportParseAmount(month.meta?.clicks);
    leads += monthLeads;
    wonLeads += monthWon;
    totalLeadValue += metaReportParseAmount(month.topline?.totalLeadValue);

    if (monthWon > 0) {
      weightedLeadValue += metaReportParseAmount(month.topline?.avgLeadValue) * monthWon;
      if (month.bottomline) {
        weightedProfitPerWon += metaReportParseAmount(month.bottomline.avgProfitPerWon) * monthWon;
      }
    }

    if (monthImpressions > 0) {
      weightedCpm += metaReportParseAmount(month.meta?.cpm) * monthImpressions;
      cpmWeight += monthImpressions;
    }

    if (month.bottomline) {
      totalProfit += metaReportParseAmount(month.bottomline.totalProfit);
      censioFeeSum += metaReportParseAmount(month.bottomline.censioFee);
    }
  }

  const cpl = leads > 0 ? Math.round((spend / leads) * 100) / 100 : 0;
  const cac = wonLeads > 0 ? Math.round((spend / wonLeads) * 100) / 100 : 0;
  const avgLeadValue = wonLeads > 0 ? Math.round((weightedLeadValue / wonLeads) * 100) / 100 : 0;
  const avgProfitPerWon = wonLeads > 0 ? Math.round((weightedProfitPerWon / wonLeads) * 100) / 100 : 0;
  const cpm = cpmWeight > 0 ? Math.round((weightedCpm / cpmWeight) * 100) / 100 : 0;
  const conversionRatePercent = impressions > 0 ? Math.round(((clicks / impressions) * 100) * 100000000) / 100000000 : 0;
  const roasKr = Math.round((totalLeadValue - spend) * 100) / 100;
  const roasX = spend > 0 ? Math.round((roasKr / spend) * 100000000) / 100000000 : 0;
  const poasKr = Math.round((totalProfit - spend) * 100) / 100;
  const poasX = spend > 0 ? Math.round((poasKr / spend) * 100000000) / 100000000 : 0;
  const poiKr = hasBottomline ? Math.round((poasKr - censioFeeSum) * 100) / 100 : 0;
  const poiX = spend > 0 && hasBottomline ? Math.round((poiKr / spend) * 100000000) / 100000000 : 0;

  return {
    startKey,
    endKey,
    label: metaReportComparisonPeriodLabel(startKey, endKey),
    monthKeys: included,
    monthCount: included.length,
    expectedMonthCount: rangeKeys.length,
    partialData: included.length > 0 && included.length < rangeKeys.length,
    hasData: included.length > 0,
    hasBottomline,
    metrics: {
      spend,
      cpm,
      impressions,
      reach,
      clicks,
      conversionRatePercent,
      leads,
      cpl,
      wonLeads,
      totalLeadValue,
      avgLeadValue,
      cac,
      roasKr,
      roasX,
      totalProfit,
      avgProfitPerWon,
      poasKr,
      poasX,
      censioFee: censioFeeSum,
      poiKr,
      poiX,
    },
  };
}

function metaReportComparisonAggregateDateRange(monthsMap = {}, startDate, endDate) {
  const start = metaReportComparisonParseDate(startDate);
  const end = metaReportComparisonParseDate(endDate);
  if (!start || !end) {
    return {
      startDate: startDate || null,
      endDate: endDate || null,
      label: '—',
      monthKeys: [],
      monthCount: 0,
      expectedMonthCount: 0,
      partialData: false,
      hasData: false,
      hasBottomline: false,
      metrics: metaReportAggregateComparisonRange({}, '0000-00', '0000-00').metrics,
    };
  }

  const [rangeStart, rangeEnd] = start <= end ? [start, end] : [end, start];
  const rangeKeys = metaReportComparisonMonthKeysOverlappingDates(rangeStart, rangeEnd);
  const included = [];
  let hasBottomline = false;
  let expectedOverlapDays = 0;
  let coveredOverlapDays = 0;

  let spend = 0;
  let impressions = 0;
  let reach = 0;
  let clicks = 0;
  let leads = 0;
  let wonLeads = 0;
  let totalLeadValue = 0;
  let totalProfit = 0;
  let censioFeeSum = 0;
  let weightedLeadValue = 0;
  let weightedProfitPerWon = 0;
  let weightedCpm = 0;
  let cpmWeight = 0;

  for (const key of rangeKeys) {
    const month = monthsMap[key];
    const effective = metaReportComparisonMonthEffectivePeriod(month, key);
    const overlap = metaReportComparisonOverlapDays(rangeStart, rangeEnd, effective.start, effective.end);
    if (overlap <= 0) continue;
    expectedOverlapDays += overlap;

    if (!metaReportMonthHasComparisonData(month)) continue;
    included.push(key);
    coveredOverlapDays += overlap;
    if (month.bottomline) hasBottomline = true;

    const totalDays = metaReportComparisonDaysInclusive(effective.start, effective.end);
    const fraction = totalDays > 0 ? overlap / totalDays : 0;

    const monthSpend = metaReportParseAmount(month.meta?.spend) * fraction;
    const monthImpressions = metaReportParseAmount(month.meta?.impressions) * fraction;
    const monthLeads = metaReportParseAmount(month.topline?.leads) * fraction;
    const monthWon = metaReportParseAmount(month.topline?.wonLeads) * fraction;

    spend += monthSpend;
    impressions += monthImpressions;
    reach += metaReportParseAmount(month.meta?.reach) * fraction;
    clicks += metaReportParseAmount(month.meta?.clicks) * fraction;
    leads += monthLeads;
    wonLeads += monthWon;
    totalLeadValue += metaReportParseAmount(month.topline?.totalLeadValue) * fraction;

    if (monthWon > 0) {
      weightedLeadValue += metaReportParseAmount(month.topline?.avgLeadValue) * monthWon;
      if (month.bottomline) {
        weightedProfitPerWon += metaReportParseAmount(month.bottomline.avgProfitPerWon) * monthWon;
      }
    }

    if (monthImpressions > 0) {
      weightedCpm += metaReportParseAmount(month.meta?.cpm) * monthImpressions;
      cpmWeight += monthImpressions;
    }

    if (month.bottomline) {
      totalProfit += metaReportParseAmount(month.bottomline.totalProfit) * fraction;
      censioFeeSum += metaReportParseAmount(month.bottomline.censioFee) * fraction;
    }
  }

  const cpl = leads > 0 ? Math.round((spend / leads) * 100) / 100 : 0;
  const cac = wonLeads > 0 ? Math.round((spend / wonLeads) * 100) / 100 : 0;
  const avgLeadValue = wonLeads > 0 ? Math.round((weightedLeadValue / wonLeads) * 100) / 100 : 0;
  const avgProfitPerWon = wonLeads > 0 ? Math.round((weightedProfitPerWon / wonLeads) * 100) / 100 : 0;
  const cpm = cpmWeight > 0 ? Math.round((weightedCpm / cpmWeight) * 100) / 100 : 0;
  const conversionRatePercent = impressions > 0 ? Math.round(((clicks / impressions) * 100) * 100000000) / 100000000 : 0;
  const roasKr = Math.round((totalLeadValue - spend) * 100) / 100;
  const roasX = spend > 0 ? Math.round((roasKr / spend) * 100000000) / 100000000 : 0;
  const poasKr = Math.round((totalProfit - spend) * 100) / 100;
  const poasX = spend > 0 ? Math.round((poasKr / spend) * 100000000) / 100000000 : 0;
  const poiKr = hasBottomline ? Math.round((poasKr - censioFeeSum) * 100) / 100 : 0;
  const poiX = spend > 0 && hasBottomline ? Math.round((poiKr / spend) * 100000000) / 100000000 : 0;

  return {
    startDate: rangeStart,
    endDate: rangeEnd,
    label: metaReportComparisonFormatDateRangeLabel(rangeStart, rangeEnd),
    monthKeys: included,
    monthCount: included.length,
    expectedMonthCount: rangeKeys.length,
    partialData: expectedOverlapDays > 0 && coveredOverlapDays < expectedOverlapDays,
    hasData: included.length > 0,
    hasBottomline,
    metrics: {
      spend,
      cpm,
      impressions,
      reach,
      clicks,
      conversionRatePercent,
      leads,
      cpl,
      wonLeads,
      totalLeadValue,
      avgLeadValue,
      cac,
      roasKr,
      roasX,
      totalProfit,
      avgProfitPerWon,
      poasKr,
      poasX,
      censioFee: censioFeeSum,
      poiKr,
      poiX,
    },
  };
}

function metaReportComparisonMergedMonthsMap(payload, periodA, periodB) {
  const years = metaReportComparisonYearsNeeded(periodA, periodB);
  const merged = { ...(payload?.months || {}) };
  years.forEach((year) => {
    if (Number(payload?.year) !== Number(year)) {
      Object.assign(merged, metaReportComparisonMonthsForYear(payload, year));
    }
  });
  return merged;
}

function metaReportResolveComparisonPresetDates(payload, mode = 'mom') {
  const anchorKey = metaReportsState.activeMonthKey || null;
  const monthsMap = metaReportComparisonMergedMonthsMap(payload, null, null);
  if (mode === 'custom') {
    return {
      mode,
      periodA: metaReportComparisonNormalizePeriod(metaReportsState.comparisonPeriodA),
      periodB: metaReportComparisonNormalizePeriod(metaReportsState.comparisonPeriodB),
    };
  }
  if (mode === 'months') {
    const periodA = metaReportComparisonNormalizePeriod(metaReportsState.comparisonPeriodA);
    const periodB = metaReportComparisonNormalizePeriod(metaReportsState.comparisonPeriodB);
    const isSingleMonth = (period) => period && period.startMonthKey === period.endMonthKey;
    if (isSingleMonth(periodA) && isSingleMonth(periodB)) {
      return { mode, periodA, periodB };
    }
    if (!anchorKey) return { mode, periodA: null, periodB: null };
    const previousKey = metaReportComparisonAddMonths(anchorKey, -1);
    return {
      mode,
      periodA: metaReportComparisonFullMonthDates(anchorKey),
      periodB: previousKey ? metaReportComparisonFullMonthDates(previousKey) : null,
    };
  }
  if (!anchorKey) return { mode, periodA: null, periodB: null };

  if (mode === 'mom') {
    const previousKey = metaReportComparisonAddMonths(anchorKey, -1);
    return {
      mode,
      periodA: metaReportComparisonFullMonthDates(anchorKey),
      periodB: previousKey ? metaReportComparisonFullMonthDates(previousKey) : null,
    };
  }
  if (mode === 'ytd') {
    const year = String(anchorKey).slice(0, 4);
    const month = String(anchorKey).slice(5, 7);
    const priorYear = String(Number(year) - 1);
    const anchorBounds = metaReportMonthBounds(anchorKey);
    const priorKey = `${priorYear}-${month}`;
    const priorBounds = metaReportMonthBounds(priorKey);
    return {
      mode,
      periodA: {
        startDate: `${year}-01-01`,
        endDate: anchorBounds.end,
        startMonthKey: `${year}-01`,
        endMonthKey: anchorKey,
      },
      periodB: {
        startDate: `${priorYear}-01-01`,
        endDate: priorBounds.end,
        startMonthKey: `${priorYear}-01`,
        endMonthKey: priorKey,
      },
    };
  }
  return { mode, periodA: null, periodB: null };
}

function metaReportApplyComparisonPresetDefaults(payload, mode = metaReportsState.comparisonMode) {
  const resolved = metaReportResolveComparisonPresetDates(payload, mode);
  if (resolved.periodA) metaReportsState.comparisonPeriodA = { ...resolved.periodA };
  if (resolved.periodB) metaReportsState.comparisonPeriodB = { ...resolved.periodB };
  return resolved;
}

function metaReportResolveComparisonPresets({
  activeMonthKey = null,
  mode = 'mom',
} = {}) {
  const payload = metaReportsState.clientPayload || metaReportsState.publicPayload;
  return metaReportResolveComparisonPresetDates(payload, mode);
}

function metaReportComparisonMetricDefs(hasBottomline = false) {
  const defs = [
    { id: 'spend', label: 'Ad spend', group: 'meta', format: 'kr', higherIsBetter: null },
    { id: 'cpm', label: 'CPM', group: 'meta', format: 'kr', higherIsBetter: false },
    { id: 'impressions', label: 'Impressions', group: 'meta', format: 'num', higherIsBetter: true },
    { id: 'reach', label: 'Reach', group: 'meta', format: 'num', higherIsBetter: true },
    { id: 'clicks', label: 'Clicks', group: 'meta', format: 'num', higherIsBetter: true },
    { id: 'conversionRatePercent', label: 'CTR', group: 'meta', format: 'pct', higherIsBetter: true },
    { id: 'leads', label: 'Leads', group: 'topline', format: 'num', higherIsBetter: true },
    { id: 'cpl', label: 'CPL', group: 'topline', format: 'kr', higherIsBetter: false },
    { id: 'wonLeads', label: 'Won leads', group: 'topline', format: 'num', higherIsBetter: true },
    { id: 'totalLeadValue', label: 'Total lead value', group: 'topline', format: 'kr', higherIsBetter: true },
    { id: 'avgLeadValue', label: 'Average lead value', group: 'topline', format: 'kr', higherIsBetter: true },
    { id: 'cac', label: 'CAC', group: 'topline', format: 'kr', higherIsBetter: false },
    { id: 'roasKr', label: 'ROAS', group: 'topline', format: 'kr', higherIsBetter: true },
    { id: 'roasX', label: 'ROAS %', group: 'topline', format: 'x', higherIsBetter: true },
  ];
  if (hasBottomline) {
    defs.push(
      { id: 'totalProfit', label: 'Total profit', group: 'bottomline', format: 'kr', higherIsBetter: true },
      { id: 'avgProfitPerWon', label: 'Avg profit per won', group: 'bottomline', format: 'kr', higherIsBetter: true },
      { id: 'poasKr', label: 'POAS', group: 'bottomline', format: 'kr', higherIsBetter: true },
      { id: 'poasX', label: 'POAS %', group: 'bottomline', format: 'x', higherIsBetter: true },
      { id: 'poiKr', label: 'POI', group: 'bottomline', format: 'kr', higherIsBetter: true },
      { id: 'poiX', label: 'POI %', group: 'bottomline', format: 'x', higherIsBetter: true },
    );
  }
  return defs;
}

function metaReportComparisonHeroIds(hasBottomline = false) {
  if (hasBottomline) return ['spend', 'leads', 'wonLeads', 'roasKr', 'totalLeadValue', 'poasKr'];
  return ['spend', 'leads', 'wonLeads', 'roasKr', 'totalLeadValue'];
}

function metaReportComparisonChartIds(hasBottomline = false, chartMode = 'kr') {
  const base = ['spend', 'leads', 'totalLeadValue'];
  if (chartMode === 'x') {
    return [...base, 'roasX', ...(hasBottomline ? ['poasX'] : [])];
  }
  return [...base, 'roasKr', ...(hasBottomline ? ['poasKr'] : [])];
}

function metaReportBuildYtdByMonthComparison(monthsMapA, monthsMapB, periodA, periodB) {
  if (!periodA || !periodB) return [];
  const keysA = metaReportComparisonMonthKeysInRange(periodA.startMonthKey, periodA.endMonthKey);
  const priorYear = String(periodB.startMonthKey || '').slice(0, 4);
  return keysA.map((keyA) => {
    const monthPart = String(keyA).slice(5, 7);
    const keyB = `${priorYear}-${monthPart}`;
    const aggA = metaReportAggregateComparisonRange(monthsMapA, keyA, keyA);
    const aggB = metaReportAggregateComparisonRange(monthsMapB, keyB, keyB);
    return {
      monthKey: keyA,
      label: metaMonthLabel(keyA),
      periodA: aggA.hasData ? aggA.metrics : null,
      periodB: aggB.hasData ? aggB.metrics : null,
      hasDataA: aggA.hasData,
      hasDataB: aggB.hasData,
    };
  });
}

function metaReportBuildComparison({
  monthsMap = {},
  monthsMapA = null,
  monthsMapB = null,
  periodA = null,
  periodB = null,
  mode = 'mom',
} = {}) {
  const map = monthsMapA || monthsMapB || monthsMap;
  const normalizedA = metaReportComparisonNormalizePeriod(periodA);
  const normalizedB = metaReportComparisonNormalizePeriod(periodB);

  if (!normalizedA?.startDate || !normalizedA?.endDate || !normalizedB?.startDate || !normalizedB?.endDate) {
    return {
      mode,
      insufficientData: true,
      samePeriod: false,
      periodA: null,
      periodB: null,
      deltas: {},
      heroMetrics: [],
      detailRows: [],
      ytdByMonth: [],
      hasBottomline: false,
    };
  }

  const samePeriod = normalizedA.startDate === normalizedB.startDate
    && normalizedA.endDate === normalizedB.endDate;
  const aggA = metaReportComparisonAggregateForMode(mode, map, periodA);
  const aggB = metaReportComparisonAggregateForMode(mode, map, periodB);
  const hasBottomline = aggA.hasBottomline || aggB.hasBottomline;
  const insufficientData = !aggA.hasData && !aggB.hasData;
  const metricDefs = metaReportComparisonMetricDefs(hasBottomline);
  const deltas = {};
  const detailRows = metricDefs.map((def) => {
    const valueA = aggA.metrics[def.id];
    const valueB = aggB.metrics[def.id];
    const pct = metaReportDeltaPct(valueA, valueB);
    deltas[def.id] = { pct, abs: Math.round((metaReportParseAmount(valueA) - metaReportParseAmount(valueB)) * 100) / 100 };
    return { ...def, valueA, valueB, deltaPct: pct };
  });
  const heroMetrics = metaReportComparisonHeroIds(hasBottomline).map((id) => {
    const def = metricDefs.find((entry) => entry.id === id);
    return {
      id,
      label: def?.label || id,
      valueA: aggA.metrics[id],
      valueB: aggB.metrics[id],
      deltaPct: deltas[id]?.pct ?? null,
      format: def?.format || 'num',
      higherIsBetter: def?.higherIsBetter ?? null,
    };
  });
  const ytdByMonth = mode === 'ytd'
    ? metaReportBuildYtdByMonthComparison(map, map, normalizedA, normalizedB)
    : [];

  return {
    mode,
    insufficientData,
    samePeriod,
    hasBottomline,
    periodA: aggA,
    periodB: aggB,
    deltas,
    heroMetrics,
    detailRows,
    ytdByMonth,
  };
}

function metaReportComparisonYearsNeeded(periodA, periodB) {
  const years = new Set();
  for (const period of [periodA, periodB]) {
    const normalized = metaReportComparisonNormalizePeriod(period);
    if (!normalized) continue;
    if (normalized.startDate) years.add(normalized.startDate.slice(0, 4));
    if (normalized.endDate) years.add(normalized.endDate.slice(0, 4));
  }
  return [...years].filter(Boolean);
}

function metaReportComparisonMonthsForYear(payload, year) {
  if (!payload || Number(payload.year) === Number(year)) {
    return payload?.months || {};
  }
  const cached = metaReportsState.comparisonYearCache?.[year];
  return cached?.months || {};
}

function metaReportComparisonAvailableMonthKeys(payload) {
  const keys = new Set();
  const addFromPayload = (source) => {
    if (!source) return;
    Object.entries(source.months || {}).forEach(([key, month]) => {
      if (metaReportMonthHasComparisonData(month)) keys.add(key);
    });
  };
  addFromPayload(payload);
  Object.values(metaReportsState.comparisonYearCache || {}).forEach(addFromPayload);
  return [...keys].sort();
}

function metaReportComparisonPresetDisabled(presetId, payload) {
  const activeKey = metaReportsState.activeMonthKey;
  if (!activeKey) return true;
  if (presetId === 'mom') {
    return !metaReportComparisonAddMonths(activeKey, -1);
  }
  return false;
}

function metaReportComparisonFmtValue(value, format = 'num', hasData = true) {
  if (!hasData) return '—';
  if (format === 'kr') return metaFmtKr(value);
  if (format === 'x') return metaFmtX(value);
  if (format === 'pct') return `${metaFmtNum(value, 2)}%`;
  return metaFmtNum(value);
}

function metaReportComparisonDeltaTone(deltaPct, higherIsBetter = null) {
  if (deltaPct == null || !Number.isFinite(deltaPct) || deltaPct === 0) return 'neutral';
  if (higherIsBetter === false) {
    return deltaPct < 0 ? 'positive' : 'negative';
  }
  if (higherIsBetter === true) {
    return deltaPct > 0 ? 'positive' : 'negative';
  }
  return deltaPct > 0 ? 'positive' : 'negative';
}

function metaReportComparisonPeriodsFromState(payload) {
  const mode = metaReportsState.comparisonMode || 'mom';
  if (mode === 'mom' || mode === 'ytd') {
    const resolved = metaReportResolveComparisonPresetDates(payload, mode);
    if (resolved.periodA) metaReportsState.comparisonPeriodA = { ...resolved.periodA };
    if (resolved.periodB) metaReportsState.comparisonPeriodB = { ...resolved.periodB };
    return { periodA: resolved.periodA, periodB: resolved.periodB, mode };
  }

  let periodA = metaReportComparisonNormalizePeriod(metaReportsState.comparisonPeriodA);
  let periodB = metaReportComparisonNormalizePeriod(metaReportsState.comparisonPeriodB);
  if (!periodA || !periodB) {
    const resolved = metaReportApplyComparisonPresetDefaults(payload, mode);
    periodA = resolved.periodA;
    periodB = resolved.periodB;
  }
  return { periodA, periodB, mode };
}

function metaReportComparisonMaps(payload, periodA, periodB) {
  const monthsMap = metaReportComparisonMergedMonthsMap(payload, periodA, periodB);
  return { monthsMapA: monthsMap, monthsMapB: monthsMap };
}

async function ensureMetaReportComparisonYears(payload, { editable = false } = {}) {
  const { periodA, periodB } = metaReportComparisonPeriodsFromState(payload);
  const years = metaReportComparisonYearsNeeded(periodA, periodB);
  const currentYear = String(payload?.year || metaReportsState.selectedYear);
  const missingYears = years.filter((year) => year !== currentYear && !metaReportsState.comparisonYearCache[year]);
  if (!missingYears.length) return;

  for (const year of missingYears) {
    try {
      let fetched;
      if (editable && payload?.clientId) {
        const reportsPath = payload.reportKind === 'google-ads'
          ? '/api/google-ads-reports'
          : '/api/meta-reports';
        fetched = await adminFetch(`${reportsPath}/clients/${encodeURIComponent(payload.clientId)}?year=${encodeURIComponent(year)}`);
      } else if (REPORT_TOKEN) {
        fetched = await fetch(`/api/meta-reports/public/${encodeURIComponent(REPORT_TOKEN)}?year=${encodeURIComponent(year)}`)
          .then(async (response) => {
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Report not found');
            return data;
          });
      }
      if (fetched) {
        metaReportsState.comparisonYearCache[year] = fetched.reportKind === 'google-ads'
          ? googleAdsPayloadToMetaUiShape(fetched)
          : fetched;
      }
    } catch (_) {
      /* leave cache empty for unavailable years */
    }
  }
}

function computeMetaReportComparison(payload) {
  const { periodA, periodB, mode } = metaReportComparisonPeriodsFromState(payload);
  const monthsMap = metaReportComparisonMergedMonthsMap(payload, periodA, periodB);
  return metaReportBuildComparison({
    monthsMap,
    periodA,
    periodB,
    mode,
  });
}

function metaReportComparisonDateInputBounds(payload) {
  const keys = metaReportComparisonAvailableMonthKeys(payload);
  if (!keys.length) return { min: '', max: '' };
  const monthsMap = metaReportComparisonMergedMonthsMap(payload, null, null);
  let min = '';
  let max = '';
  keys.forEach((key) => {
    const period = metaReportComparisonMonthEffectivePeriod(monthsMap[key], key);
    if (!min || period.start < min) min = period.start;
    if (!max || period.end > max) max = period.end;
  });
  return { min, max };
}

function metaReportComparisonMonthInputBounds(payload) {
  const years = new Set();
  if (payload?.year) years.add(String(payload.year));
  Object.keys(metaReportsState.comparisonYearCache || {}).forEach((year) => years.add(String(year)));
  metaReportComparisonAvailableMonthKeys(payload).forEach((key) => years.add(String(key).slice(0, 4)));
  if (!years.size) {
    const anchorKey = metaReportsState.activeMonthKey;
    if (anchorKey) years.add(String(anchorKey).slice(0, 4));
  }
  if (!years.size) {
    const year = String(new Date().getFullYear());
    return { min: `${year}-01`, max: `${year}-12` };
  }
  const sorted = [...years].sort((a, b) => Number(a) - Number(b));
  return { min: `${sorted[0]}-01`, max: `${sorted[sorted.length - 1]}-12` };
}

function metaReportComparisonReportYears(payload) {
  const years = new Set();
  const addFromPayload = (source) => {
    if (!source) return;
    if (source.year) years.add(String(source.year));
    Object.keys(source.months || {}).forEach((key) => {
      if (/^\d{4}-\d{2}$/.test(key)) years.add(String(key).slice(0, 4));
    });
  };
  addFromPayload(payload);
  Object.values(metaReportsState.comparisonYearCache || {}).forEach(addFromPayload);
  if (!years.size && metaReportsState.activeMonthKey) {
    years.add(String(metaReportsState.activeMonthKey).slice(0, 4));
  }
  if (!years.size) years.add(String(new Date().getFullYear()));
  const sorted = [...years].sort((a, b) => Number(a) - Number(b));
  const startYear = Number(sorted[0]);
  const endYear = Number(sorted[sorted.length - 1]);
  const fullRange = [];
  for (let year = startYear; year <= endYear; year += 1) fullRange.push(String(year));
  return fullRange;
}

function metaReportComparisonMonthPickerYears(payload) {
  return metaReportComparisonReportYears(payload);
}

function renderMetaReportComparisonMonthDropdown(part, value, options, label) {
  const selected = options.find((entry) => entry.value === value) || options[0];
  const selectedValue = selected?.value || value || '';
  const selectedLabel = selected?.label || value || '—';
  const items = options.map((entry) => (
    `<button type="button" class="meta-report-comparison-month-option${entry.value === selectedValue ? ' is-selected' : ''}" data-value="${esc(entry.value)}" role="option" aria-selected="${entry.value === selectedValue}">${esc(entry.label)}</button>`
  )).join('');
  return `
    <div class="meta-report-comparison-month-dropdown" data-comparison-month-part="${esc(part)}" data-selected-value="${esc(selectedValue)}">
      <button type="button" class="meta-report-comparison-month-trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="${esc(label)}">
        <span class="meta-report-comparison-month-trigger-value">${esc(selectedLabel)}</span>
        <span class="meta-report-comparison-month-trigger-icon" aria-hidden="true">▾</span>
      </button>
      <div class="meta-report-comparison-month-menu meta-report-comparison-month-menu--${esc(part)}" data-comparison-menu-part="${esc(part)}" role="listbox" hidden>${items}</div>
    </div>
  `;
}

function metaReportComparisonMonthKeyParts(monthKey) {
  if (!monthKey || !/^\d{4}-\d{2}$/.test(monthKey)) {
    const anchorKey = metaReportsState.activeMonthKey;
    if (anchorKey && /^\d{4}-\d{2}$/.test(anchorKey)) {
      return { month: anchorKey.slice(5, 7), year: anchorKey.slice(0, 4) };
    }
    const now = new Date();
    return {
      month: String(now.getMonth() + 1).padStart(2, '0'),
      year: String(now.getFullYear()),
    };
  }
  return { month: monthKey.slice(5, 7), year: monthKey.slice(0, 4) };
}

function renderMetaReportComparisonMonthInput(side, monthKey, payload) {
  const years = metaReportComparisonMonthPickerYears(payload);
  const { month, year } = metaReportComparisonMonthKeyParts(monthKey);
  const monthLabel = side === 'b' ? 'Comparison month' : 'Current month';
  const yearLabel = side === 'b' ? 'Comparison year' : 'Current year';
  const monthOptions = META_MONTH_LABELS.map((label, index) => ({
    value: String(index + 1).padStart(2, '0'),
    label,
  }));
  const yearOptions = years.map((entry) => ({ value: entry, label: entry }));
  return `
    <div class="meta-report-comparison-month-picker" data-comparison-month-side="${esc(side)}">
      ${renderMetaReportComparisonMonthDropdown('month', month, monthOptions, monthLabel)}
      ${renderMetaReportComparisonMonthDropdown('year', year, yearOptions, yearLabel)}
    </div>
  `;
}

function renderMetaReportComparisonMonthPickerSide(side, monthKey, payload) {
  const sideClass = side === 'b' ? 'is-b' : 'is-a';
  return `
    <div class="meta-report-comparison-duel-side ${sideClass}">
      ${renderMetaReportComparisonMonthInput(side, monthKey, payload)}
    </div>
  `;
}

function applyMetaReportComparisonMonthChange(payload, side, monthKey, { editable = false } = {}) {
  if (!monthKey || !/^\d{4}-\d{2}$/.test(monthKey)) return;
  const stateKey = side === 'b' ? 'comparisonPeriodB' : 'comparisonPeriodA';
  metaReportsState[stateKey] = metaReportComparisonFullMonthDates(monthKey);
  metaReportsState.comparisonMode = 'months';
  document.querySelectorAll('[data-comparison-preset]').forEach((button) => {
    const isMonths = button.getAttribute('data-comparison-preset') === 'months';
    button.classList.toggle('active', isMonths);
    button.setAttribute('aria-pressed', isMonths);
  });
  void refreshMetaReportComparison(payload, { editable });
}

function positionMetaReportComparisonMonthMenu(trigger, menu, dropdown) {
  const rect = trigger.getBoundingClientRect();
  const part = dropdown?.getAttribute('data-comparison-month-part') || 'month';
  const minWidth = part === 'year' ? 120 : 176;
  menu.style.left = `${rect.left + rect.width / 2}px`;
  menu.style.top = `${rect.bottom + 6}px`;
  menu.style.width = `${Math.max(minWidth, rect.width + 28)}px`;
  menu.style.minWidth = `${minWidth}px`;
}

function openMetaReportComparisonMonthMenu(trigger, menu, dropdown) {
  closeMetaReportComparisonMonthMenus(menu);
  if (menu.parentElement !== document.body) {
    menu._metaComparisonOwner = dropdown;
    document.body.appendChild(menu);
  }
  menu.hidden = false;
  dropdown.classList.add('is-open');
  trigger.setAttribute('aria-expanded', 'true');
  positionMetaReportComparisonMonthMenu(trigger, menu, dropdown);
}

function closeMetaReportComparisonMonthMenus(exceptMenu = null) {
  document.querySelectorAll('.meta-report-comparison-month-menu').forEach((menu) => {
    if (menu === exceptMenu) return;
    menu.hidden = true;
    const dropdown = menu._metaComparisonOwner
      || menu.closest('.meta-report-comparison-month-dropdown');
    const trigger = dropdown?.querySelector('.meta-report-comparison-month-trigger');
    dropdown?.classList.remove('is-open');
    trigger?.setAttribute('aria-expanded', 'false');
    if (menu._metaComparisonOwner && menu.parentElement === document.body) {
      menu._metaComparisonOwner.appendChild(menu);
    }
  });
}

function bindMetaReportComparisonMonthInputs(payload, { editable = false } = {}) {
  document.querySelectorAll('[data-comparison-month-side]').forEach((wrap) => {
    const side = wrap.getAttribute('data-comparison-month-side');
    if (!side) return;

    const monthDropdown = wrap.querySelector('[data-comparison-month-part="month"]');
    const yearDropdown = wrap.querySelector('[data-comparison-month-part="year"]');

    const applyFromWrap = () => {
      const month = monthDropdown?.getAttribute('data-selected-value') || '';
      const year = yearDropdown?.getAttribute('data-selected-value') || '';
      if (!month || !year) return;
      applyMetaReportComparisonMonthChange(payload, side, `${year}-${month}`, { editable });
    };

    wrap.querySelectorAll('.meta-report-comparison-month-dropdown').forEach((dropdown) => {
      const trigger = dropdown.querySelector('.meta-report-comparison-month-trigger');
      const menu = dropdown.querySelector('.meta-report-comparison-month-menu');
      if (!trigger || !menu) return;

      trigger.onclick = (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (!menu.hidden) {
          closeMetaReportComparisonMonthMenus();
          return;
        }
        openMetaReportComparisonMonthMenu(trigger, menu, dropdown);
      };

      dropdown.querySelectorAll('.meta-report-comparison-month-option').forEach((option) => {
        option.onclick = (event) => {
          event.preventDefault();
          event.stopPropagation();
          const value = option.getAttribute('data-value') || '';
          dropdown.setAttribute('data-selected-value', value);
          const valueEl = trigger.querySelector('.meta-report-comparison-month-trigger-value');
          if (valueEl) valueEl.textContent = option.textContent || value;
          dropdown.querySelectorAll('.meta-report-comparison-month-option').forEach((entry) => {
            const selected = entry === option;
            entry.classList.toggle('is-selected', selected);
            entry.setAttribute('aria-selected', String(selected));
          });
          closeMetaReportComparisonMonthMenus();
          applyFromWrap();
        };
      });
    });

    const sideEl = wrap.closest('.meta-report-comparison-duel-side');
    if (sideEl) {
      sideEl.onclick = (event) => {
        if (event.target.closest('.meta-report-comparison-month-dropdown')) return;
        const rect = wrap.getBoundingClientRect();
        const targetDropdown = event.clientX < rect.left + rect.width / 2 ? monthDropdown : yearDropdown;
        targetDropdown?.querySelector('.meta-report-comparison-month-trigger')?.click();
      };
    }
  });

  if (!metaReportsState.comparisonMonthMenuListenerBound) {
    document.addEventListener('click', (event) => {
      if (event.target.closest('.meta-report-comparison-month-menu')
        || event.target.closest('.meta-report-comparison-month-trigger')) return;
      closeMetaReportComparisonMonthMenus();
    });
    window.addEventListener('resize', () => closeMetaReportComparisonMonthMenus());
    window.addEventListener('scroll', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('.meta-report-comparison-month-menu')) return;
      closeMetaReportComparisonMonthMenus();
    }, true);
    metaReportsState.comparisonMonthMenuListenerBound = true;
  }
}

function renderMetaReportComparisonMonthPickersPanel(periodA, periodB, payload) {
  const bounds = metaReportComparisonMonthInputBounds(payload);
  const monthA = periodA?.startMonthKey || metaReportsState.activeMonthKey || bounds.min?.slice(0, 7) || '';
  const monthB = periodB?.startMonthKey || metaReportComparisonAddMonths(monthA, -1) || bounds.min?.slice(0, 7) || '';

  return `
    <div class="meta-report-comparison-duel is-month-pickers" id="meta-report-comparison-range-panel" role="group" aria-label="Compare months">
      ${renderMetaReportComparisonMonthPickerSide('a', monthA, payload)}
      <div class="meta-report-comparison-duel-divider" aria-hidden="true">vs</div>
      ${renderMetaReportComparisonMonthPickerSide('b', monthB, payload)}
    </div>
  `;
}

function metaReportComparisonMonthKeyFromDate(dateValue) {
  const parsed = metaReportComparisonParseDate(dateValue);
  return parsed ? parsed.slice(0, 7) : '';
}

const metaReportComparisonDatePickerState = {
  inputKey: null,
  side: null,
  bound: null,
  anchorEl: null,
  viewYear: null,
  viewMonth: null,
  payload: null,
  editable: false,
};

function getMetaReportComparisonDatePickerFieldBounds(payload, side, bound) {
  const dateBounds = metaReportComparisonDateInputBounds(payload);
  const stateKey = side === 'b' ? 'comparisonPeriodB' : 'comparisonPeriodA';
  const period = metaReportsState[stateKey] || {};
  let min = dateBounds.min || undefined;
  let max = dateBounds.max || undefined;
  if (bound === 'start' && period.endDate) max = period.endDate;
  if (bound === 'end' && period.startDate) min = period.startDate;
  return metaReportComparisonSafePickerBounds(min, max);
}

function renderMetaReportComparisonDateInput(side, bound, value, bounds, period = null) {
  const inputKey = `${side}-${bound}`;
  const label = bound === 'start' ? 'From date' : 'To date';
  const display = value ? metaReportComparisonFormatDateLabel(value) : 'Select date';
  const emptyClass = value ? ' has-value' : ' is-empty';
  return `
    <button type="button" class="meta-report-comparison-date-trigger${emptyClass}" data-comparison-date-trigger="${esc(inputKey)}" aria-label="${esc(label)}" aria-haspopup="dialog">
      <span class="meta-report-comparison-date-trigger-value">${esc(display)}</span>
    </button>
    <input type="hidden" data-comparison-date="${esc(inputKey)}" value="${esc(value || '')}" />
  `;
}

function renderMetaReportComparisonCustomRangeSide(side, start, end, bounds, period = null) {
  const sideClass = side === 'b' ? 'is-b' : 'is-a';
  return `
    <div class="meta-report-comparison-duel-side ${sideClass}">
      <div class="meta-report-comparison-custom-range">
        <div class="meta-report-comparison-custom-range-field" data-comparison-range="${esc(side)}-start">
          ${renderMetaReportComparisonDateInput(side, 'start', start, bounds, period)}
        </div>
        <span class="meta-report-comparison-custom-range-sep" aria-hidden="true">–</span>
        <div class="meta-report-comparison-custom-range-field" data-comparison-range="${esc(side)}-end">
          ${renderMetaReportComparisonDateInput(side, 'end', end, bounds, period)}
        </div>
        <span class="meta-report-comparison-date-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </span>
      </div>
    </div>
  `;
}

function parseComparisonDateKey(key) {
  const match = String(key || '').match(/^([ab])-(start|end)$/);
  if (!match) return null;
  return { side: match[1], bound: match[2], stateKey: match[1] === 'b' ? 'comparisonPeriodB' : 'comparisonPeriodA' };
}

function metaReportComparisonSafePickerBounds(minDate, maxDate) {
  const min = minDate || undefined;
  const max = maxDate || undefined;
  if (min && max && min > max) return { min: max, max: min };
  return { min, max };
}

function syncMetaReportComparisonDateDisplays() {
  document.querySelectorAll('[data-comparison-date]').forEach((input) => {
    const inputKey = input.getAttribute('data-comparison-date');
    const trigger = document.querySelector(`[data-comparison-date-trigger="${inputKey}"]`);
    if (!inputKey || !trigger) return;
    const value = input.value || '';
    const valueEl = trigger.querySelector('.meta-report-comparison-date-trigger-value');
    if (valueEl) valueEl.textContent = value ? metaReportComparisonFormatDateLabel(value) : 'Select date';
    trigger.classList.toggle('has-value', Boolean(value));
    trigger.classList.toggle('is-empty', !value);
  });
}

function applyMetaReportComparisonDateChange(payload, inputKey, dateStr, { editable = false } = {}) {
  const parsed = parseComparisonDateKey(inputKey);
  if (!parsed || !dateStr) return;
  const { side, bound, stateKey } = parsed;
  if (!metaReportsState[stateKey]) {
    metaReportsState[stateKey] = { startDate: null, endDate: null };
  }
  const period = metaReportsState[stateKey];
  period[`${bound}Date`] = dateStr;
  if (period.startDate && period.endDate && period.startDate > period.endDate) {
    if (bound === 'end') {
      period.startDate = period.endDate;
    } else {
      period.endDate = period.startDate;
    }
  }
  const startInput = document.querySelector(`[data-comparison-date="${side}-start"]`);
  const endInput = document.querySelector(`[data-comparison-date="${side}-end"]`);
  if (startInput) startInput.value = period.startDate || '';
  if (endInput) endInput.value = period.endDate || '';
  syncMetaReportComparisonDateDisplays();
  metaReportsState.comparisonMode = 'custom';
  document.querySelectorAll('[data-comparison-preset]').forEach((button) => {
    const isCustom = button.getAttribute('data-comparison-preset') === 'custom';
    button.classList.toggle('active', isCustom);
    button.setAttribute('aria-pressed', isCustom);
  });
  void refreshMetaReportComparison(payload, { editable });
}

function ensureMetaReportComparisonDatePickerPopover() {
  if (document.getElementById('meta-report-comparison-date-popover')) return;
  const backdrop = document.createElement('div');
  backdrop.id = 'meta-report-comparison-date-backdrop';
  backdrop.className = 'meta-report-comparison-date-backdrop';
  backdrop.hidden = true;
  backdrop.addEventListener('click', closeMetaReportComparisonDatePicker);
  document.body.appendChild(backdrop);

  const popover = document.createElement('div');
  popover.id = 'meta-report-comparison-date-popover';
  popover.className = 'meta-report-comparison-date-popover';
  popover.hidden = true;
  popover.setAttribute('role', 'dialog');
  popover.setAttribute('aria-modal', 'true');
  document.body.appendChild(popover);
}

function isMetaReportComparisonDatePickerDayDisabled(iso, payload, side, bound) {
  const { min, max } = getMetaReportComparisonDatePickerFieldBounds(payload, side, bound);
  if (min && iso < min) return true;
  if (max && iso > max) return true;
  return false;
}

function metaReportComparisonDatePickerCanShiftMonth(delta) {
  const { viewYear, viewMonth, payload, side, bound } = metaReportComparisonDatePickerState;
  if (!viewYear || !viewMonth || !payload || !side || !bound) return false;
  let nextMonth = viewMonth + delta;
  let nextYear = viewYear;
  if (nextMonth < 1) { nextMonth = 12; nextYear -= 1; }
  if (nextMonth > 12) { nextMonth = 1; nextYear += 1; }
  const targetKey = `${nextYear}-${String(nextMonth).padStart(2, '0')}`;
  const { min, max } = getMetaReportComparisonDatePickerFieldBounds(payload, side, bound);
  const minKey = min ? min.slice(0, 7) : null;
  const maxKey = max ? max.slice(0, 7) : null;
  if (minKey && targetKey < minKey) return false;
  if (maxKey && targetKey > maxKey) return false;
  return true;
}

function renderMetaReportComparisonDatePickerDayCell(iso, dayNum, isOutside, todayIso, selectedValue, rangeStart, rangeEnd, payload, side, bound) {
  const classes = ['date-picker-day'];
  if (isOutside) classes.push('is-outside');
  if (iso === todayIso) classes.push('is-today');
  if (iso === selectedValue) classes.push('is-selected');
  if (rangeStart && rangeEnd) {
    const start = rangeStart <= rangeEnd ? rangeStart : rangeEnd;
    const end = rangeStart <= rangeEnd ? rangeEnd : rangeStart;
    if (iso >= start && iso <= end) classes.push('is-in-range');
    if (iso === rangeStart) classes.push('is-range-start');
    if (iso === rangeEnd) classes.push('is-range-end');
  }
  if (isMetaReportComparisonDatePickerDayDisabled(iso, payload, side, bound)) {
    classes.push('is-disabled');
    return `<button type="button" class="${classes.join(' ')}" disabled aria-disabled="true">${dayNum}</button>`;
  }
  return `<button type="button" class="${classes.join(' ')}" onclick="selectMetaReportComparisonDatePickerDay('${iso}')">${dayNum}</button>`;
}

function renderMetaReportComparisonDatePickerPopover() {
  const popover = document.getElementById('meta-report-comparison-date-popover');
  const { viewYear, viewMonth, inputKey, payload, side, bound } = metaReportComparisonDatePickerState;
  if (!popover || !inputKey || !viewYear || !viewMonth || !payload || !side || !bound) return;

  const monthLabel = new Intl.DateTimeFormat('en-GB', {
    month: 'long',
    year: 'numeric',
  }).format(new Date(viewYear, viewMonth - 1, 1));
  const weekdays = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'];
  const firstDay = new Date(viewYear, viewMonth - 1, 1);
  const mondayOffset = (firstDay.getDay() + 6) % 7;
  const daysInMonth = new Date(viewYear, viewMonth, 0).getDate();
  const daysInPrevMonth = new Date(viewYear, viewMonth - 1, 0).getDate();
  const todayIso = isoFromParts(new Date().getFullYear(), new Date().getMonth() + 1, new Date().getDate());
  const selectedInput = document.querySelector(`[data-comparison-date="${inputKey}"]`);
  const selectedValue = selectedInput?.value || '';
  const stateKey = side === 'b' ? 'comparisonPeriodB' : 'comparisonPeriodA';
  const period = metaReportsState[stateKey] || {};
  const rangeStart = period.startDate || '';
  const rangeEnd = period.endDate || '';
  const { min, max } = getMetaReportComparisonDatePickerFieldBounds(payload, side, bound);

  let cells = '';
  for (let index = mondayOffset - 1; index >= 0; index -= 1) {
    const day = daysInPrevMonth - index;
    const month = viewMonth === 1 ? 12 : viewMonth - 1;
    const year = viewMonth === 1 ? viewYear - 1 : viewYear;
    const iso = isoFromParts(year, month, day);
    cells += renderMetaReportComparisonDatePickerDayCell(iso, day, true, todayIso, selectedValue, rangeStart, rangeEnd, payload, side, bound);
  }
  for (let day = 1; day <= daysInMonth; day += 1) {
    const iso = isoFromParts(viewYear, viewMonth, day);
    cells += renderMetaReportComparisonDatePickerDayCell(iso, day, false, todayIso, selectedValue, rangeStart, rangeEnd, payload, side, bound);
  }
  const trailing = (7 - ((mondayOffset + daysInMonth) % 7)) % 7;
  for (let day = 1; day <= trailing; day += 1) {
    const month = viewMonth === 12 ? 1 : viewMonth + 1;
    const year = viewMonth === 12 ? viewYear + 1 : viewYear;
    const iso = isoFromParts(year, month, day);
    cells += renderMetaReportComparisonDatePickerDayCell(iso, day, true, todayIso, selectedValue, rangeStart, rangeEnd, payload, side, bound);
  }

  const hint = bound === 'start' && max
    ? `<span class="date-picker-hint">Through ${esc(metaReportComparisonFormatDateLabel(max))}</span>`
    : bound === 'end' && min
      ? `<span class="date-picker-hint">From ${esc(metaReportComparisonFormatDateLabel(min))}</span>`
      : '';

  popover.innerHTML = `
    <div class="date-picker-panel">
      <div class="date-picker-header">
        <div class="date-picker-title">${esc(monthLabel)}</div>
        <div class="date-picker-nav">
          <button type="button" class="date-picker-nav-btn" aria-label="Previous month" onclick="shiftMetaReportComparisonDatePickerMonth(-1)" ${metaReportComparisonDatePickerCanShiftMonth(-1) ? '' : 'disabled'}>${ICON_CHEVRON_LEFT}</button>
          <button type="button" class="date-picker-nav-btn" aria-label="Next month" onclick="shiftMetaReportComparisonDatePickerMonth(1)" ${metaReportComparisonDatePickerCanShiftMonth(1) ? '' : 'disabled'}>${ICON_CHEVRON_RIGHT}</button>
        </div>
      </div>
      <div class="date-picker-weekdays">
        ${weekdays.map((day) => `<div class="date-picker-weekday">${day}</div>`).join('')}
      </div>
      <div class="date-picker-grid">${cells}</div>
      <div class="date-picker-footer">
        ${hint}
        <button type="button" class="date-picker-footer-btn" onclick="clearMetaReportComparisonDatePickerField()">Clear</button>
      </div>
    </div>
  `;
}

function positionMetaReportComparisonDatePickerPopover() {
  const popover = document.getElementById('meta-report-comparison-date-popover');
  const anchor = metaReportComparisonDatePickerState.anchorEl;
  if (!popover || !anchor) return;
  popover.hidden = false;
  popover.style.visibility = 'hidden';
  popover.style.left = '0';
  popover.style.top = '0';
  popover.style.transform = '';
  const rect = anchor.getBoundingClientRect();
  const popRect = popover.getBoundingClientRect();
  const margin = 8;
  let top = rect.bottom + margin;
  let left = rect.left + rect.width / 2 - popRect.width / 2;
  if (window.innerWidth <= 640) {
    left = Math.max(16, (window.innerWidth - popRect.width) / 2);
    top = Math.max(16, (window.innerHeight - popRect.height) / 2);
  } else {
    if (left + popRect.width > window.innerWidth - 16) left = window.innerWidth - popRect.width - 16;
    if (left < 16) left = 16;
    if (top + popRect.height > window.innerHeight - 16) top = Math.max(16, rect.top - popRect.height - margin);
  }
  popover.style.top = `${top}px`;
  popover.style.left = `${left}px`;
  popover.style.visibility = '';
}

function openMetaReportComparisonDatePicker(inputKey, anchorEl, payload, { editable = false } = {}) {
  ensureMetaReportComparisonDatePickerPopover();
  const popover = document.getElementById('meta-report-comparison-date-popover');
  const backdrop = document.getElementById('meta-report-comparison-date-backdrop');
  const parsed = parseComparisonDateKey(inputKey);
  if (!popover || !backdrop || !anchorEl || !parsed) return;
  if (metaReportComparisonDatePickerState.inputKey === inputKey && !popover.hidden) {
    closeMetaReportComparisonDatePicker();
    return;
  }
  closeMetaReportComparisonDatePicker();
  const selectedInput = document.querySelector(`[data-comparison-date="${inputKey}"]`);
  const selectedValue = selectedInput?.value || '';
  let viewYear = new Date().getFullYear();
  let viewMonth = new Date().getMonth() + 1;
  if (/^\d{4}-\d{2}-\d{2}$/.test(selectedValue)) {
    viewYear = Number(selectedValue.slice(0, 4));
    viewMonth = Number(selectedValue.slice(5, 7));
  } else {
    const { min } = getMetaReportComparisonDatePickerFieldBounds(payload, parsed.side, parsed.bound);
    if (min && /^\d{4}-\d{2}-\d{2}$/.test(min)) {
      viewYear = Number(min.slice(0, 4));
      viewMonth = Number(min.slice(5, 7));
    }
  }
  metaReportComparisonDatePickerState.inputKey = inputKey;
  metaReportComparisonDatePickerState.side = parsed.side;
  metaReportComparisonDatePickerState.bound = parsed.bound;
  metaReportComparisonDatePickerState.anchorEl = anchorEl;
  metaReportComparisonDatePickerState.viewYear = viewYear;
  metaReportComparisonDatePickerState.viewMonth = viewMonth;
  metaReportComparisonDatePickerState.payload = payload;
  metaReportComparisonDatePickerState.editable = editable;
  renderMetaReportComparisonDatePickerPopover();
  backdrop.hidden = false;
  anchorEl.classList.add('is-active');
  positionMetaReportComparisonDatePickerPopover();
}

function closeMetaReportComparisonDatePicker() {
  const popover = document.getElementById('meta-report-comparison-date-popover');
  const backdrop = document.getElementById('meta-report-comparison-date-backdrop');
  if (popover) popover.hidden = true;
  if (backdrop) backdrop.hidden = true;
  metaReportComparisonDatePickerState.anchorEl?.classList.remove('is-active');
  metaReportComparisonDatePickerState.inputKey = null;
  metaReportComparisonDatePickerState.side = null;
  metaReportComparisonDatePickerState.bound = null;
  metaReportComparisonDatePickerState.anchorEl = null;
  metaReportComparisonDatePickerState.payload = null;
}

function shiftMetaReportComparisonDatePickerMonth(delta) {
  if (!metaReportComparisonDatePickerCanShiftMonth(delta)) return;
  let { viewYear, viewMonth } = metaReportComparisonDatePickerState;
  viewMonth += delta;
  if (viewMonth < 1) { viewMonth = 12; viewYear -= 1; }
  if (viewMonth > 12) { viewMonth = 1; viewYear += 1; }
  metaReportComparisonDatePickerState.viewYear = viewYear;
  metaReportComparisonDatePickerState.viewMonth = viewMonth;
  renderMetaReportComparisonDatePickerPopover();
  positionMetaReportComparisonDatePickerPopover();
}

function selectMetaReportComparisonDatePickerDay(isoDate) {
  const { inputKey, payload, editable } = metaReportComparisonDatePickerState;
  if (!inputKey || !payload || !isoDate) return;
  const input = document.querySelector(`[data-comparison-date="${inputKey}"]`);
  if (input) input.value = isoDate;
  closeMetaReportComparisonDatePicker();
  applyMetaReportComparisonDateChange(payload, inputKey, isoDate, { editable });
}

function clearMetaReportComparisonDatePickerField() {
  const { inputKey, payload, editable } = metaReportComparisonDatePickerState;
  if (!inputKey || !payload) return;
  closeMetaReportComparisonDatePicker();
  const parsed = parseComparisonDateKey(inputKey);
  if (!parsed) return;
  const { side, bound, stateKey } = parsed;
  if (!metaReportsState[stateKey]) metaReportsState[stateKey] = { startDate: null, endDate: null };
  metaReportsState[stateKey][`${bound}Date`] = null;
  const input = document.querySelector(`[data-comparison-date="${inputKey}"]`);
  if (input) input.value = '';
  syncMetaReportComparisonDateDisplays();
  void refreshMetaReportComparison(payload, { editable });
}

function closeMetaReportComparisonDatePickers() {
  closeMetaReportComparisonDatePicker();
}

function destroyMetaReportComparisonDatePickers() {
  closeMetaReportComparisonDatePicker();
}

function bindMetaReportComparisonDateInputs(payload, { editable = false } = {}) {
  destroyMetaReportComparisonDatePickers();
  syncMetaReportComparisonDateDisplays();
  document.querySelectorAll('[data-comparison-date-trigger]').forEach((trigger) => {
    trigger.onclick = (event) => {
      event.preventDefault();
      event.stopPropagation();
      const inputKey = trigger.getAttribute('data-comparison-date-trigger');
      if (!inputKey) return;
      openMetaReportComparisonDatePicker(inputKey, trigger, payload, { editable });
    };
  });
  document.querySelectorAll('.meta-report-comparison-custom-range').forEach((rangeEl) => {
    rangeEl.onclick = (event) => {
      const field = event.target.closest('.meta-report-comparison-custom-range-field');
      if (!field) return;
      const trigger = field.querySelector('[data-comparison-date-trigger]');
      if (!trigger) return;
      event.preventDefault();
      event.stopPropagation();
      const inputKey = trigger.getAttribute('data-comparison-date-trigger');
      if (inputKey) openMetaReportComparisonDatePicker(inputKey, trigger, payload, { editable });
    };
  });
  if (!metaReportsState.comparisonDatePickerListenerBound) {
    window.addEventListener('resize', closeMetaReportComparisonDatePicker);
    window.addEventListener('scroll', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('#meta-report-comparison-date-popover')) return;
      closeMetaReportComparisonDatePicker();
    }, true);
    metaReportsState.comparisonDatePickerListenerBound = true;
  }
}

function metaReportComparisonYtdSpanLabel(startDate, endDate) {
  const start = metaReportComparisonParseDate(startDate);
  const end = metaReportComparisonParseDate(endDate);
  if (!start || !end) return '';
  const sm = Number(start.slice(5, 7));
  const em = Number(end.slice(5, 7));
  const sy = start.slice(0, 4);
  const ey = end.slice(0, 4);
  if (sy !== ey) return metaReportComparisonFormatDateRangeLabel(start, end);
  if (sm === 1 && em === 12) return 'Full year';
  if (sm === em) return `Through ${META_MONTH_LABELS[sm - 1]}`;
  return `${META_MONTH_LABELS[sm - 1]} – ${META_MONTH_LABELS[em - 1]}`;
}

function metaReportComparisonPresetPeriodDisplay(mode, period) {
  const normalized = metaReportComparisonNormalizePeriod(period);
  if (!normalized) return { value: '—', hint: '' };
  if (mode === 'mom' || mode === 'months') {
    const monthKey = normalized.startMonthKey || normalized.endMonthKey;
    const year = String(monthKey || normalized.startDate).slice(0, 4);
    return { value: `${metaMonthLabel(monthKey)} ${year}`, hint: '' };
  }
  if (mode === 'ytd') {
    const span = metaReportComparisonYtdSpanLabel(normalized.startDate, normalized.endDate);
    return {
      value: normalized.startDate.slice(0, 4),
      hint: span && span !== 'Full year' ? span : '',
    };
  }
  return {
    value: metaReportComparisonFormatDateRangeLabel(normalized.startDate, normalized.endDate),
    hint: '',
  };
}

function renderMetaReportComparisonDuelSide(side, display, partialData = false) {
  const hintHtml = display.hint
    ? `<span class="meta-report-comparison-duel-hint">${esc(display.hint)}</span>`
    : '';
  const partialClass = partialData ? ' is-partial' : '';
  const partialTitle = partialData ? ' title="Partial data"' : '';
  return `
    <div class="meta-report-comparison-duel-side is-${esc(side)}${partialClass}"${partialTitle}>
      <span class="meta-report-comparison-duel-value">${esc(display.value)}</span>
      ${hintHtml}
    </div>
  `;
}

function renderMetaReportComparisonSummaryBar(periodA, periodB, comparison = null) {
  const partialA = comparison?.periodA?.partialData === true;
  const partialB = comparison?.periodB?.partialData === true;
  const displayA = metaReportComparisonPresetPeriodDisplay(metaReportsState.comparisonMode || 'mom', periodA);
  const displayB = metaReportComparisonPresetPeriodDisplay(metaReportsState.comparisonMode || 'mom', periodB);
  return `
    <div class="meta-report-comparison-duel" id="meta-report-comparison-range-panel" role="group" aria-label="Compared periods">
      ${renderMetaReportComparisonDuelSide('a', displayA, partialA)}
      <div class="meta-report-comparison-duel-divider" aria-hidden="true">vs</div>
      ${renderMetaReportComparisonDuelSide('b', displayB, partialB)}
    </div>
  `;
}

function renderMetaReportComparisonCustomDatesPanel(periodA, periodB, payload) {
  const bounds = metaReportComparisonDateInputBounds(payload);
  const startA = periodA?.startDate || bounds.min || '';
  const endA = periodA?.endDate || startA;
  const startB = periodB?.startDate || bounds.min || '';
  const endB = periodB?.endDate || startB;

  return `
    <div class="meta-report-comparison-duel is-custom-dates" id="meta-report-comparison-range-panel" role="group" aria-label="Custom compared periods">
      ${renderMetaReportComparisonCustomRangeSide('a', startA, endA, bounds, periodA)}
      <div class="meta-report-comparison-duel-divider" aria-hidden="true">vs</div>
      ${renderMetaReportComparisonCustomRangeSide('b', startB, endB, bounds, periodB)}
    </div>
  `;
}

function renderMetaReportComparisonPeriodControls(periodA, periodB, payload, comparison = null) {
  const mode = metaReportsState.comparisonMode || 'mom';
  if (mode === 'custom') {
    return renderMetaReportComparisonCustomDatesPanel(periodA, periodB, payload);
  }
  if (mode === 'months') {
    return renderMetaReportComparisonMonthPickersPanel(periodA, periodB, payload);
  }
  return renderMetaReportComparisonSummaryBar(periodA, periodB, comparison);
}

function renderMetaReportComparisonPeriodTiles(periodA, periodB, payload, comparison = null) {
  return renderMetaReportComparisonPeriodControls(periodA, periodB, payload, comparison);
}

function renderMetaReportComparisonChangeCell(deltaPct, higherIsBetter, hasDataA = true, hasDataB = true) {
  const tone = metaReportComparisonDeltaTone(deltaPct, higherIsBetter);
  if (!hasDataA && !hasDataB) {
    return '<span class="meta-report-comparison-change is-neutral">—</span>';
  }
  if (!hasDataA || !hasDataB) {
    return '<span class="meta-report-comparison-change is-neutral">—</span>';
  }
  if (deltaPct == null || !Number.isFinite(deltaPct)) {
    return '<span class="meta-report-comparison-change is-neutral">—</span>';
  }
  const arrow = deltaPct > 0 ? '↑' : deltaPct < 0 ? '↓' : '—';
  const pct = metaReportFormatDeltaPct(deltaPct);
  return `<span class="meta-report-comparison-change is-${tone}">${esc(arrow)} ${esc(pct)}</span>`;
}

function renderMetaReportComparisonGroupTable(title, rowSpecs, accent, comparison, { highlightLastN = 0 } = {}) {
  if (!comparison || comparison.insufficientData || comparison.samePeriod) return '';
  const labelA = comparison.periodA.label;
  const labelB = comparison.periodB.label;
  const hasDataA = comparison.periodA.hasData !== false;
  const hasDataB = comparison.periodB.hasData !== false;
  const rowsHtml = rowSpecs.map((spec, index) => {
    const valueA = comparison.periodA.metrics[spec.metricId];
    const valueB = comparison.periodB.metrics[spec.metricId];
    const deltaPct = hasDataA && hasDataB ? metaReportDeltaPct(valueA, valueB) : null;
    const isHighlight = highlightLastN > 0 && index >= rowSpecs.length - highlightLastN;
    return `
      <tr class="${isHighlight ? `is-highlight accent-${accent}` : ''}">
        <th scope="row">${esc(spec.label)}</th>
        <td class="meta-report-comparison-col-a">${esc(metaReportComparisonFmtValue(valueA, spec.format, hasDataA))}</td>
        <td class="meta-report-comparison-col-b">${esc(metaReportComparisonFmtValue(valueB, spec.format, hasDataB))}</td>
        <td class="meta-report-comparison-col-change">${renderMetaReportComparisonChangeCell(deltaPct, spec.higherIsBetter, hasDataA, hasDataB)}</td>
      </tr>
    `;
  }).join('');
  return `
    <section class="meta-report-group">
      <div class="meta-report-group-head">
        <span class="meta-report-group-bar meta-report-group-bar--${accent}" aria-hidden="true"></span>
        <h3 class="meta-report-group-title">${esc(title)}</h3>
      </div>
      <div class="meta-report-group-table-wrap">
        <table class="meta-report-group-table meta-report-comparison-table">
          <thead>
            <tr>
              <th scope="col">Metric</th>
              <th scope="col" class="meta-report-comparison-col-a">${esc(labelA)}</th>
              <th scope="col" class="meta-report-comparison-col-b">${esc(labelB)}</th>
              <th scope="col" class="meta-report-comparison-col-change">Change</th>
            </tr>
          </thead>
          <tbody>${rowsHtml}</tbody>
        </table>
      </div>
    </section>
  `;
}

function renderMetaReportComparisonTableSkeleton() {
  const rowHtml = Array.from({ length: 6 }).map(() => `
    <div class="meta-report-comparison-skeleton-row">
      <div class="meta-report-comparison-skeleton-cell meta-report-comparison-skeleton-cell--label"></div>
      <div class="meta-report-comparison-skeleton-cell"></div>
      <div class="meta-report-comparison-skeleton-cell"></div>
      <div class="meta-report-comparison-skeleton-cell meta-report-comparison-skeleton-cell--short"></div>
    </div>
  `).join('');
  return `
    <div class="meta-report-comparison-skeleton" aria-busy="true" aria-label="Loading comparison data">
      <div class="meta-report-comparison-skeleton-group">
        <div class="meta-cv-skeleton-line meta-cv-skeleton-line--sm"></div>
        ${rowHtml}
      </div>
      <div class="meta-report-comparison-skeleton-group">
        <div class="meta-cv-skeleton-line meta-cv-skeleton-line--sm"></div>
        ${rowHtml}
      </div>
    </div>
  `;
}

function renderMetaReportComparisonTables(comparison) {
  if (metaReportsState.comparisonLoading) {
    return renderMetaReportComparisonTableSkeleton();
  }
  if (!comparison || comparison.insufficientData) {
    return '<p class="meta-report-comparison-empty">Select two periods with ad data to compare performance.</p>';
  }
  if (comparison.samePeriod) {
    return '<p class="meta-report-comparison-warning">Both periods are the same. Choose different ranges to compare.</p>';
  }
  const groupsHtml = META_REPORT_COMPARISON_TABLE_GROUPS
    .filter((group) => !group.bottomlineOnly || comparison.hasBottomline)
    .map((group) => renderMetaReportComparisonGroupTable(
      group.title,
      group.rows,
      group.accent,
      comparison,
      { highlightLastN: group.highlightLastN || 0 },
    ))
    .join('');
  return `<div class="meta-report-groups-stack">${groupsHtml}</div>`;
}

const META_REPORT_COMPARISON_SUMMARY_LABELS = {
  spend: 'Ad spend',
  leads: 'Leads',
  wonLeads: 'Won leads',
  roasKr: 'Return on ad spend',
  totalLeadValue: 'Total lead value',
  poasKr: 'Profit on ad spend',
};

function renderMetaReportComparisonSummarySkeleton() {
  const items = Array.from({ length: 5 }).map(() => `
    <div class="meta-report-comparison-summary-skeleton-item" aria-hidden="true">
      <div class="meta-cv-skeleton-line meta-cv-skeleton-line--sm"></div>
      <div class="meta-cv-skeleton-line meta-cv-skeleton-line--lg"></div>
      <div class="meta-cv-skeleton-line meta-cv-skeleton-line--sm"></div>
    </div>
  `).join('');
  return `
    <aside class="meta-report-comparison-summary" aria-label="Comparison summary" aria-busy="true">
      <h3 class="meta-report-comparison-summary-heading">Key changes</h3>
      <div class="meta-report-comparison-summary-stack">${items}</div>
    </aside>
  `;
}

function renderMetaReportComparisonSummaryBoxes(comparison) {
  if (metaReportsState.comparisonLoading) {
    return renderMetaReportComparisonSummarySkeleton();
  }
  if (!comparison || comparison.insufficientData || comparison.samePeriod) {
    return '';
  }
  const periodLabelA = comparison.periodA?.label || 'Period A';
  const periodLabelB = comparison.periodB?.label || 'Period B';
  const hasDataA = comparison.periodA?.hasData !== false;
  const hasDataB = comparison.periodB?.hasData !== false;
  const heroMetrics = comparison.heroMetrics || [];

  const items = heroMetrics.map((metric) => {
    const label = META_REPORT_COMPARISON_SUMMARY_LABELS[metric.id] || metric.label || metric.id;
    const tone = metaReportComparisonDeltaTone(metric.deltaPct, metric.higherIsBetter);
    const valueHtml = esc(metaReportComparisonFmtValue(metric.valueA, metric.format, hasDataA));
    let changeHtml = '—';
    if (hasDataA && hasDataB && metric.deltaPct != null && Number.isFinite(metric.deltaPct)) {
      const arrow = metric.deltaPct > 0 ? '↑' : metric.deltaPct < 0 ? '↓' : '—';
      changeHtml = `${arrow} ${esc(metaReportFormatDeltaPct(metric.deltaPct))} vs ${esc(periodLabelB)}`;
    }
    return `
      <div class="meta-report-comparison-summary-item${tone !== 'neutral' ? ` is-${tone}` : ''}">
        <div class="meta-report-comparison-summary-label">${esc(label)}</div>
        <div class="meta-report-comparison-summary-value">${valueHtml}</div>
        <div class="meta-report-comparison-summary-change">${changeHtml}</div>
      </div>
    `;
  }).join('');

  if (!items) return '';

  return `
    <aside class="meta-report-comparison-summary" aria-label="Comparison summary">
      <h3 class="meta-report-comparison-summary-heading">Key changes · ${esc(periodLabelA)}</h3>
      <div class="meta-report-comparison-summary-stack">${items}</div>
    </aside>
  `;
}

function renderMetaReportViewModeTabs() {
  const viewMode = metaReportsState.reportViewMode || 'monthly';
  return `
    <div class="meta-report-view-mode-tabs" role="tablist" aria-label="Report views">
      <button type="button" class="meta-report-chart-tab${viewMode === 'monthly' ? ' is-active' : ''}" data-report-view-mode="monthly" role="tab" aria-selected="${viewMode === 'monthly'}">Monthly report</button>
      <button type="button" class="meta-report-chart-tab${viewMode === 'comparison' ? ' is-active' : ''}" data-report-view-mode="comparison" role="tab" aria-selected="${viewMode === 'comparison'}">Period comparison</button>
    </div>
  `;
}

function renderMetaReportComparisonView() {
  const payload = metaReportsState.clientPayload || metaReportsState.publicPayload;
  const comparison = metaReportsState.comparisonResult || computeMetaReportComparison(payload);
  const { periodA, periodB } = metaReportComparisonPeriodsFromState(payload);
  const activeTab = metaReportsState.comparisonTab || 'table';
  const isLoading = metaReportsState.comparisonLoading;

  return `
    <section class="meta-report-comparison-view" id="meta-report-comparison-view">
      <div class="meta-report-comparison-controls">
        <div class="meta-report-comparison-presets" id="meta-report-comparison-presets">
          ${META_REPORT_COMPARISON_PRESETS.map(({ id, label }) => {
            const disabled = metaReportComparisonPresetDisabled(id, payload);
            const title = disabled && id === 'mom' ? 'No previous month available' : label;
            return `
              <button type="button" class="preset-btn${metaReportsState.comparisonMode === id ? ' active' : ''}${disabled ? ' is-disabled' : ''}" data-comparison-preset="${esc(id)}" aria-pressed="${metaReportsState.comparisonMode === id}"${disabled ? ' disabled' : ''}${title ? ` title="${esc(title)}"` : ''}>${esc(label)}</button>
            `;
          }).join('')}
        </div>
        <div class="meta-report-comparison-period-card">
          <div id="meta-report-comparison-range-wrap">
            ${renderMetaReportComparisonPeriodControls(periodA, periodB, payload, comparison)}
          </div>
        </div>
      </div>
      <div class="meta-report-comparison-table-layout">
        <div class="meta-report-comparison-view-card meta-report-comparison-table-card${isLoading ? ' is-loading' : ''}">
          <div class="meta-report-comparison-view-head">
            <div class="meta-report-comparison-tabs" role="tablist" aria-label="Comparison views">
              <button type="button" class="meta-report-chart-tab${activeTab === 'table' ? ' is-active' : ''}" data-comparison-tab="table" role="tab" aria-selected="${activeTab === 'table'}">Compare table</button>
              <button type="button" class="meta-report-chart-tab${activeTab === 'chart' ? ' is-active' : ''}" data-comparison-tab="chart" role="tab" aria-selected="${activeTab === 'chart'}">Show in chart</button>
            </div>
          </div>
          <div class="meta-report-comparison-tab-panel${activeTab === 'table' ? ' is-active' : ''}" data-comparison-panel="table" role="tabpanel"${activeTab === 'table' ? '' : ' hidden'}>
            <div id="meta-report-comparison-table-wrap">${renderMetaReportComparisonTables(comparison)}</div>
          </div>
          <div class="meta-report-comparison-tab-panel${activeTab === 'chart' ? ' is-active' : ''}" data-comparison-panel="chart" role="tabpanel"${activeTab === 'chart' ? '' : ' hidden'}>
            <div class="meta-report-comparison-chart-card">
              <div class="meta-report-comparison-chart-toolbar">
                <div class="meta-report-chart-toggle" id="meta-report-comparison-chart-mode" role="group" aria-label="Comparison chart display mode">
                  <button type="button" class="meta-report-chart-toggle-btn${metaReportsState.comparisonChartMode === 'kr' ? ' is-active' : ''}" data-mode="kr">Dkr</button>
                  <button type="button" class="meta-report-chart-toggle-btn${metaReportsState.comparisonChartMode === 'x' ? ' is-active' : ''}" data-mode="x">Multiplier</button>
                </div>
              </div>
              <div class="meta-report-comparison-chart-canvas-wrap">
                <canvas id="meta-report-comparison-chart" aria-label="Period comparison chart"></canvas>
                <p class="meta-report-chart-empty" id="meta-report-comparison-chart-empty" hidden>Not enough data to chart this comparison yet.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="meta-report-comparison-view-card meta-report-comparison-summary-card${isLoading ? ' is-loading' : ''}" id="meta-report-comparison-summary-card"${!isLoading && (!comparison || comparison.insufficientData || comparison.samePeriod) ? ' hidden' : ''}>
          <div id="meta-report-comparison-summary-wrap">${renderMetaReportComparisonSummaryBoxes(comparison)}</div>
        </div>
      </div>
    </section>
  `;
}

function destroyMetaReportComparisonChart() {
  if (metaReportsState.comparisonChartInstance) {
    metaReportsState.comparisonChartInstance.destroy();
    metaReportsState.comparisonChartInstance = null;
  }
}

function metaReportComparisonChartLabel(metricId, defs) {
  return defs.find((entry) => entry.id === metricId)?.label || metricId;
}

function buildMetaReportComparisonGroupedBarChart(canvas, comparison, chartMode = 'kr') {
  const metricDefs = metaReportComparisonMetricDefs(comparison.hasBottomline);
  const chartIds = metaReportComparisonChartIds(comparison.hasBottomline, chartMode);
  const labels = chartIds.map((id) => metaReportComparisonChartLabel(id, metricDefs));
  const valuesA = chartIds.map((id) => metaReportParseAmount(comparison.periodA.metrics[id]));
  const hasDataB = comparison.periodB.hasData !== false;
  const valuesB = chartIds.map((id) => (hasDataB ? metaReportParseAmount(comparison.periodB.metrics[id]) : null));

  return new Chart(canvas, {
    type: 'bar',
    data: {
      labels,
      datasets: [
        {
          label: comparison.periodA.label,
          data: valuesA,
          backgroundColor: 'rgba(255, 106, 0, 0.82)',
          borderColor: '#ff6a00',
          borderWidth: 1,
          borderRadius: 6,
          maxBarThickness: 42,
        },
        {
          label: comparison.periodB.label,
          data: valuesB,
          backgroundColor: 'rgba(148, 163, 184, 0.82)',
          borderColor: '#94a3b8',
          borderWidth: 1,
          borderRadius: 6,
          maxBarThickness: 42,
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      layout: { padding: { left: 8, right: 12, top: 0, bottom: 0 } },
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: {
          display: true,
          position: 'top',
          labels: { boxWidth: 12, font: { size: 11 } },
        },
        tooltip: {
          backgroundColor: '#ffffff',
          borderColor: '#e8e0d8',
          borderWidth: 1,
          titleColor: '#1a1208',
          bodyColor: '#1a1208',
          padding: 10,
          callbacks: {
            label(context) {
              const value = context.parsed.y;
              const metricId = chartIds[context.dataIndex];
              const def = metricDefs.find((entry) => entry.id === metricId);
              return `${context.dataset.label}: ${metaReportComparisonFmtValue(value, def?.format || 'num')}`;
            },
          },
        },
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { color: '#6b5348', font: { size: 11 }, maxRotation: 45, minRotation: 0 },
        },
        y: {
          grid: { color: 'rgba(26, 18, 8, 0.08)' },
          ticks: {
            color: '#6b5348',
            font: { size: 11 },
            callback: (value) => {
              const amount = Number(value) || 0;
              if (Math.abs(amount) >= 1000000) return `${(amount / 1000000).toFixed(1)}M`;
              if (Math.abs(amount) >= 1000) return `${Math.round(amount / 1000)}K`;
              return amount;
            },
          },
        },
      },
    },
  });
}

function metaReportComparisonYtdLineMetricId(hasBottomline, chartMode) {
  if (chartMode === 'x') {
    return hasBottomline ? 'poasX' : 'roasX';
  }
  return hasBottomline ? 'poasKr' : 'totalLeadValue';
}

function buildMetaReportComparisonYtdLineChart(canvas, comparison, chartMode = 'kr') {
  const rows = comparison.ytdByMonth || [];
  if (!rows.length) return null;

  const metricId = metaReportComparisonYtdLineMetricId(comparison.hasBottomline, chartMode);
  const metricDefs = metaReportComparisonMetricDefs(comparison.hasBottomline);
  const metricDef = metricDefs.find((entry) => entry.id === metricId);
  const labels = rows.map((row) => row.label);
  const valuesA = rows.map((row) => (
    row.hasDataA && row.periodA ? metaReportParseAmount(row.periodA[metricId]) : null
  ));
  const valuesB = rows.map((row) => (
    row.hasDataB && row.periodB ? metaReportParseAmount(row.periodB[metricId]) : null
  ));
  const hasAnyData = valuesA.some((value) => value != null) || valuesB.some((value) => value != null);
  if (!hasAnyData) return null;

  return new Chart(canvas, {
    type: 'line',
    data: {
      labels,
      datasets: [
        {
          label: comparison.periodA.label,
          data: valuesA,
          borderColor: '#ff6a00',
          backgroundColor: 'rgba(255, 106, 0, 0.08)',
          borderWidth: 2,
          pointBackgroundColor: '#ff6a00',
          pointRadius: 3,
          tension: 0.3,
          spanGaps: false,
        },
        {
          label: comparison.periodB.label,
          data: valuesB,
          borderColor: '#94a3b8',
          backgroundColor: 'rgba(148, 163, 184, 0.08)',
          borderWidth: 2,
          pointBackgroundColor: '#94a3b8',
          pointRadius: 3,
          tension: 0.3,
          spanGaps: false,
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      layout: { padding: { left: 8, right: 12, top: 0, bottom: 0 } },
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: {
          display: true,
          position: 'top',
          labels: { boxWidth: 12, font: { size: 11 } },
        },
        tooltip: {
          backgroundColor: '#ffffff',
          borderColor: '#e8e0d8',
          borderWidth: 1,
          titleColor: '#1a1208',
          bodyColor: '#1a1208',
          padding: 10,
          callbacks: {
            label(context) {
              const value = context.parsed.y;
              if (value == null) return `${context.dataset.label}: —`;
              return `${context.dataset.label}: ${metaReportComparisonFmtValue(value, metricDef?.format || 'num')}`;
            },
          },
        },
        title: {
          display: true,
          text: metricDef?.label || metricId,
          color: '#6b5348',
          font: { size: 12, weight: '600' },
          padding: { bottom: 8 },
        },
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { color: '#6b5348', font: { size: 11 } },
        },
        y: {
          grid: { color: 'rgba(26, 18, 8, 0.08)' },
          ticks: {
            color: '#6b5348',
            font: { size: 11 },
            callback: (value) => {
              const amount = Number(value) || 0;
              if (chartMode === 'x') return `${amount.toFixed(2)}x`;
              if (Math.abs(amount) >= 1000000) return `${(amount / 1000000).toFixed(1)}M`;
              if (Math.abs(amount) >= 1000) return `${Math.round(amount / 1000)}K`;
              return amount;
            },
          },
        },
      },
    },
  });
}

function buildMetaReportComparisonChart(canvas, comparison, chartMode = 'kr') {
  const emptyEl = document.getElementById('meta-report-comparison-chart-empty');
  if (!comparison || comparison.insufficientData || comparison.samePeriod) {
    if (emptyEl) emptyEl.hidden = false;
    return null;
  }

  let chartInstance = null;
  if (comparison.mode === 'ytd') {
    chartInstance = buildMetaReportComparisonYtdLineChart(canvas, comparison, chartMode);
  } else {
    chartInstance = buildMetaReportComparisonGroupedBarChart(canvas, comparison, chartMode);
  }

  if (emptyEl) emptyEl.hidden = !!chartInstance;
  return chartInstance;
}

function mountMetaReportComparisonChart(comparison) {
  destroyMetaReportComparisonChart();
  if ((metaReportsState.comparisonTab || 'table') !== 'chart') return;
  const canvas = document.getElementById('meta-report-comparison-chart');
  if (!canvas) return;
  metaReportsState.comparisonChartInstance = buildMetaReportComparisonChart(
    canvas,
    comparison,
    metaReportsState.comparisonChartMode,
  );
}

function setMetaReportComparisonTab(tab) {
  metaReportsState.comparisonTab = tab === 'chart' ? 'chart' : 'table';
  document.querySelectorAll('[data-comparison-tab]').forEach((button) => {
    const isActive = button.getAttribute('data-comparison-tab') === metaReportsState.comparisonTab;
    button.classList.toggle('is-active', isActive);
    button.setAttribute('aria-selected', isActive);
  });
  document.querySelectorAll('[data-comparison-panel]').forEach((panel) => {
    const isActive = panel.getAttribute('data-comparison-panel') === metaReportsState.comparisonTab;
    panel.classList.toggle('is-active', isActive);
    panel.hidden = !isActive;
  });
  if (metaReportsState.comparisonTab === 'chart') {
    const payload = metaReportsState.clientPayload || metaReportsState.publicPayload;
    mountMetaReportComparisonChart(metaReportsState.comparisonResult || computeMetaReportComparison(payload));
  } else {
    destroyMetaReportComparisonChart();
  }
}

function setMetaReportViewMode(mode, payload, { editable = false } = {}) {
  metaReportsState.reportViewMode = mode === 'comparison' ? 'comparison' : 'monthly';
  document.querySelectorAll('[data-report-view-mode]').forEach((button) => {
    const isActive = button.getAttribute('data-report-view-mode') === metaReportsState.reportViewMode;
    button.classList.toggle('is-active', isActive);
    button.setAttribute('aria-selected', isActive);
  });
  document.querySelectorAll('[data-report-view-panel]').forEach((panel) => {
    const isActive = panel.getAttribute('data-report-view-panel') === metaReportsState.reportViewMode;
    panel.classList.toggle('is-active', isActive);
    panel.hidden = !isActive;
  });
  if (metaReportsState.reportViewMode === 'monthly') {
    destroyMetaReportComparisonChart();
    mountMetaReportTrendCharts(payload, { editable, clientId: payload?.clientId || null });
    if (editable) syncMetaReportScenario(payload);
  } else {
    destroyMetaReportTrendCharts();
    if (payload) {
      const { series } = resolveMetaReportChartSeries(payload, { allowDemo: !editable });
      if (series.length) metaReportsState.chartSeries = series;
      bindMetaReportComparisonControls(payload, { editable });
      void refreshMetaReportComparison(payload, { editable });
      if (editable) {
        bindMetaReportScenarioControls(payload, { editable: true });
        syncMetaReportScenario(payload);
      }
    }
  }
}

function bindMetaReportViewModeTabs(payload, { editable = false } = {}) {
  document.querySelectorAll('[data-report-view-mode]').forEach((button) => {
    button.onclick = () => {
      const mode = button.getAttribute('data-report-view-mode');
      if (!mode || mode === metaReportsState.reportViewMode) return;
      setMetaReportViewMode(mode, payload, { editable });
    };
  });
}

function syncMetaReportComparisonPeriodControls(payload, comparison, { editable = false } = {}) {
  const rangeWrap = document.getElementById('meta-report-comparison-range-wrap');
  if (!rangeWrap) return;
  const { periodA, periodB } = metaReportComparisonPeriodsFromState(payload);
  rangeWrap.innerHTML = renderMetaReportComparisonPeriodControls(periodA, periodB, payload, comparison);
  const mode = metaReportsState.comparisonMode || 'mom';
  if (mode === 'custom') {
    bindMetaReportComparisonDateInputs(payload, { editable });
  } else if (mode === 'months') {
    bindMetaReportComparisonMonthInputs(payload, { editable });
  }
}

function syncMetaReportComparisonUi(payload, { editable = false } = {}) {
  const view = document.getElementById('meta-report-comparison-view');
  if (!view) return;

  const comparison = computeMetaReportComparison(payload);
  metaReportsState.comparisonResult = comparison;

  syncMetaReportComparisonPeriodControls(payload, comparison, { editable });

  const headlineWrap = document.getElementById('meta-report-comparison-headline-wrap');
  if (headlineWrap) headlineWrap.remove();

  const isLoading = Boolean(metaReportsState.comparisonLoading);
  const tableCard = view.querySelector('.meta-report-comparison-table-card');
  const summaryCard = document.getElementById('meta-report-comparison-summary-card');
  if (tableCard) tableCard.classList.toggle('is-loading', isLoading);
  if (summaryCard) summaryCard.classList.toggle('is-loading', isLoading);

  const tableWrap = document.getElementById('meta-report-comparison-table-wrap');
  if (tableWrap) tableWrap.innerHTML = renderMetaReportComparisonTables(comparison);

  const summaryHtml = renderMetaReportComparisonSummaryBoxes(comparison);
  const summaryWrap = document.getElementById('meta-report-comparison-summary-wrap');
  if (summaryWrap) summaryWrap.innerHTML = summaryHtml;
  if (summaryCard) summaryCard.hidden = !isLoading && !summaryHtml;

  const emptyEl = document.getElementById('meta-report-comparison-chart-empty');
  if (emptyEl) {
    emptyEl.hidden = !(comparison.insufficientData || comparison.samePeriod);
  }

  if ((metaReportsState.comparisonTab || 'table') === 'chart') {
    mountMetaReportComparisonChart(comparison);
  }
}

async function refreshMetaReportComparison(payload, { editable = false } = {}) {
  if (!payload || !document.getElementById('meta-report-comparison-view')) return;
  const started = Date.now();
  metaReportsState.comparisonLoading = true;
  syncMetaReportComparisonUi(payload, { editable });
  try {
    await ensureMetaReportComparisonYears(payload, { editable });
  } finally {
    const elapsed = Date.now() - started;
    if (elapsed < 180) {
      await new Promise((resolve) => setTimeout(resolve, 180 - elapsed));
    }
    metaReportsState.comparisonLoading = false;
    syncMetaReportComparisonUi(payload, { editable });
  }
}

function bindMetaReportComparisonControls(payload, { editable = false } = {}) {
  const bindPresetButtons = () => {
    document.querySelectorAll('[data-comparison-preset]').forEach((button) => {
      button.onclick = async () => {
        if (button.disabled) return;
        const mode = button.getAttribute('data-comparison-preset');
        if (!mode) return;
        metaReportsState.comparisonMode = mode;
        metaReportApplyComparisonPresetDefaults(payload, mode);
        metaReportsState.comparisonLoading = true;
        const view = document.getElementById('meta-report-comparison-view');
        if (view) {
          view.outerHTML = renderMetaReportComparisonView();
          bindMetaReportComparisonControls(payload, { editable });
        }
        await refreshMetaReportComparison(payload, { editable });
      };
    });
  };

  document.querySelectorAll('[data-comparison-tab]').forEach((button) => {
    button.onclick = () => {
      const tab = button.getAttribute('data-comparison-tab');
      if (!tab) return;
      setMetaReportComparisonTab(tab);
    };
  });

  document.querySelectorAll('#meta-report-comparison-chart-mode .meta-report-chart-toggle-btn').forEach((button) => {
    button.onclick = () => {
      metaReportsState.comparisonChartMode = button.getAttribute('data-mode') || 'kr';
      document.querySelectorAll('#meta-report-comparison-chart-mode .meta-report-chart-toggle-btn').forEach((entry) => {
        entry.classList.toggle('is-active', entry === button);
      });
      mountMetaReportComparisonChart(metaReportsState.comparisonResult || computeMetaReportComparison(payload));
    };
  });

  bindPresetButtons();
  bindMetaReportComparisonDateInputs(payload, { editable });
  bindMetaReportComparisonMonthInputs(payload, { editable });
  setMetaReportComparisonTab(metaReportsState.comparisonTab || 'table');
}

function mountMetaReportComparison(payload, { editable = false } = {}) {
  if (!document.getElementById('meta-report-comparison-view')) return;
  bindMetaReportComparisonControls(payload, { editable });
  void refreshMetaReportComparison(payload, { editable });
}

function renderMetaReportScenarioCard() {
  return `
    <section class="meta-report-scenario-card" id="meta-report-scenario-card">
      <div class="meta-report-scenario-head">
        <div>
          <h3 class="meta-report-scenario-title">Budget scenario</h3>
          <p class="meta-report-scenario-copy">Estimate based on recent ad performance and diminishing returns—not a guarantee.</p>
        </div>
      </div>
      <div class="meta-report-scenario-controls">
        <label class="meta-report-scenario-field">
          <span>Budget multiplier</span>
          <div class="meta-report-scenario-slider-row">
            <input type="range" id="meta-report-budget-multiplier" min="0.5" max="3" step="0.1" value="${esc(metaReportsState.budgetMultiplier)}" />
            <output id="meta-report-budget-multiplier-value">${esc(Number(metaReportsState.budgetMultiplier).toFixed(1))}×</output>
          </div>
        </label>
        <label class="meta-report-scenario-field">
          <span>Baseline spend</span>
          <select id="meta-report-budget-baseline" class="admin-select">
            ${renderMetaReportBaselineSelectOptions(
              resolveMetaReportScenarioBaselineHints(metaReportsState.chartSeries || [], metaReportsState.chartProjection),
              metaReportsState.budgetBaseline,
            )}
          </select>
        </label>
        <label class="meta-report-scenario-field">
          <span>History window</span>
          <select id="meta-report-scenario-month-window" class="admin-select">
            ${META_REPORT_SCENARIO_MONTH_WINDOW_OPTIONS.map(({ value, label }) => `
              <option value="${esc(value)}"${metaReportsState.scenarioMonthWindow === value ? ' selected' : ''}>${esc(label)}</option>
            `).join('')}
          </select>
        </label>
      </div>
      ${renderMetaReportScenarioModelPills()}
      <div id="meta-report-scenario-context-wrap">${renderMetaReportScenarioContextStrip(metaReportsState.chartProjection)}</div>
      <div class="meta-report-scenario-grid" id="meta-report-scenario-grid"></div>
      <div class="meta-report-scenario-charts" id="meta-report-scenario-charts">
        <div class="meta-report-scenario-chart-card">
          <div class="meta-report-chart-head">
            <h3 class="meta-report-chart-title">ROAS extrapolation</h3>
            <div class="meta-report-chart-toggle" id="meta-scenario-roas-mode" role="group" aria-label="Scenario ROAS display mode">
              <button type="button" class="meta-report-chart-toggle-btn" data-mode="kr">Dkr</button>
              <button type="button" class="meta-report-chart-toggle-btn is-active" data-mode="x">Multiplier</button>
            </div>
          </div>
          <div class="meta-report-scenario-chart-canvas-wrap">
            <canvas id="meta-report-scenario-chart-roas" aria-label="ROAS budget extrapolation chart"></canvas>
            <p class="meta-report-chart-empty" id="meta-report-scenario-chart-roas-empty" hidden>Not enough data for extrapolation yet.</p>
          </div>
        </div>
        <div class="meta-report-scenario-chart-card" id="meta-report-scenario-poas-wrap">
          <div class="meta-report-chart-head">
            <h3 class="meta-report-chart-title">POAS extrapolation</h3>
            <div class="meta-report-chart-toggle" id="meta-scenario-poas-mode" role="group" aria-label="Scenario POAS display mode">
              <button type="button" class="meta-report-chart-toggle-btn" data-mode="kr">Dkr</button>
              <button type="button" class="meta-report-chart-toggle-btn is-active" data-mode="x">Multiplier</button>
            </div>
          </div>
          <div class="meta-report-scenario-chart-canvas-wrap">
            <canvas id="meta-report-scenario-chart-poas" aria-label="POAS budget extrapolation chart"></canvas>
            <p class="meta-report-chart-empty" id="meta-report-scenario-chart-poas-empty" hidden>Not enough data for extrapolation yet.</p>
          </div>
        </div>
      </div>
      <p class="meta-report-scenario-disclaimer">Projections use ad-active months only, skip in-progress months without complete inputs, and apply diminishing returns when spend scales.</p>
    </section>
  `;
}

function metaReportFormatDeltaPct(value) {
  if (value == null || !Number.isFinite(value)) return '';
  const sign = value > 0 ? '+' : '';
  return `${sign}${value.toFixed(0)}%`;
}

function metaReportScenarioDeltaTone(delta = '') {
  if (String(delta).startsWith('+')) return 'positive';
  if (String(delta).startsWith('-')) return 'negative';
  return 'neutral';
}

function renderMetaReportScenarioOutcomeCard({
  label,
  projectedValue,
  projectedSub = '',
  baselineValue = '',
  delta = '',
} = {}) {
  const tone = metaReportScenarioDeltaTone(delta);
  const cardTone = tone === 'negative' ? 'is-negative' : 'is-positive';
  return `
    <div class="meta-report-scenario-outcome-card ${cardTone}">
      <div class="meta-report-scenario-outcome-label">${esc(label)}</div>
      <div class="meta-report-scenario-outcome-value">${esc(projectedValue)}</div>
      ${projectedSub ? `<div class="meta-report-scenario-outcome-sub">${esc(projectedSub)}</div>` : ''}
      ${delta ? `<div class="meta-report-scenario-outcome-delta is-${tone}">${esc(delta)}</div>` : ''}
      ${baselineValue ? `<div class="meta-report-scenario-outcome-baseline">Baseline ${esc(baselineValue)}</div>` : ''}
    </div>
  `;
}

function renderMetaReportScenarioDetailRow(label, baseline, projected, delta) {
  const tone = metaReportScenarioDeltaTone(delta);
  return `
    <div class="meta-report-scenario-details-row">
      <span class="meta-report-scenario-label">${esc(label)}</span>
      <span class="meta-report-scenario-value">${esc(baseline)}</span>
      <span class="meta-report-scenario-value is-projected">${esc(projected)}</span>
      <span class="meta-report-scenario-delta${tone === 'positive' ? ' is-positive' : tone === 'negative' ? ' is-negative' : ''}">${esc(delta || '—')}</span>
    </div>
  `;
}

function renderMetaReportScenarioMetrics(projection) {
  if (!projection || projection.insufficientData) {
    return `<p class="meta-report-scenario-empty">${esc(renderMetaReportScenarioInsufficientMessage(projection))}</p>`;
  }

  const revenueDelta = metaReportFormatDeltaPct(
    metaReportDeltaPct(projection.projected.totalLeadValue, projection.baseline.totalLeadValue),
  );
  const roasDelta = metaReportFormatDeltaPct(
    metaReportDeltaPct(projection.projected.roasKr, projection.baseline.roasKr),
  );
  const revenueBand = projection.projectedConservative && projection.projectedOptimistic
    && projection.projectedConservative.totalLeadValue !== projection.projectedOptimistic.totalLeadValue
    ? `${metaFmtKr(projection.projectedConservative.totalLeadValue)} – ${metaFmtKr(projection.projectedOptimistic.totalLeadValue)}`
    : '';

  const outcomeCards = [
    renderMetaReportScenarioOutcomeCard({
      label: 'Projected revenue',
      projectedValue: metaFmtKr(projection.projected.totalLeadValue),
      projectedSub: revenueBand,
      baselineValue: metaFmtKr(projection.baseline.totalLeadValue),
      delta: revenueDelta,
    }),
    renderMetaReportScenarioOutcomeCard({
      label: 'Projected ROAS',
      projectedValue: metaFmtKr(projection.projected.roasKr),
      projectedSub: metaFmtX(projection.projected.roasX),
      baselineValue: `${metaFmtKr(projection.baseline.roasKr)} · ${metaFmtX(projection.baseline.roasX)}`,
      delta: roasDelta,
    }),
  ];

  if (projection.hasBottomline) {
    const profitDelta = metaReportFormatDeltaPct(
      metaReportDeltaPct(projection.projected.poasKr, projection.baseline.poasKr),
    );
    outcomeCards.push(renderMetaReportScenarioOutcomeCard({
      label: 'Projected profit',
      projectedValue: metaFmtKr(projection.projected.poasKr),
      projectedSub: metaFmtX(projection.projected.poasX),
      baselineValue: `${metaFmtKr(projection.baseline.poasKr)} · ${metaFmtX(projection.baseline.poasX)}`,
      delta: profitDelta,
    }));
  } else {
    const wonDelta = metaReportFormatDeltaPct(
      metaReportDeltaPct(projection.projected.wonLeads, projection.baseline.wonLeads),
    );
    outcomeCards.push(renderMetaReportScenarioOutcomeCard({
      label: 'Projected won leads',
      projectedValue: metaFmtNum(projection.projected.wonLeads),
      baselineValue: metaFmtNum(projection.baseline.wonLeads),
      delta: wonDelta,
    }));
  }

  const detailRows = [
    renderMetaReportScenarioDetailRow(
      'Ad spend',
      metaFmtKr(projection.baseline.spend),
      metaFmtKr(projection.projected.spend),
      metaReportFormatDeltaPct(metaReportDeltaPct(projection.projected.spend, projection.baseline.spend)),
    ),
    renderMetaReportScenarioDetailRow(
      'Leads',
      metaFmtNum(projection.baseline.leads),
      metaFmtNum(projection.projected.leads),
      metaReportFormatDeltaPct(metaReportDeltaPct(projection.projected.leads, projection.baseline.leads)),
    ),
  ];

  if (projection.hasBottomline) {
    detailRows.push(renderMetaReportScenarioDetailRow(
      'Won leads',
      metaFmtNum(projection.baseline.wonLeads),
      metaFmtNum(projection.projected.wonLeads),
      metaReportFormatDeltaPct(metaReportDeltaPct(projection.projected.wonLeads, projection.baseline.wonLeads)),
    ));
  }

  return `
    <div class="meta-report-scenario-outcomes">
      ${outcomeCards.join('')}
    </div>
    <div class="meta-report-scenario-details">
      <div class="meta-report-scenario-details-head">Investment & funnel</div>
      ${detailRows.join('')}
    </div>
  `;
}

function destroyMetaReportTrendCharts() {
  ['roas', 'poas'].forEach((kind) => {
    if (metaReportsState.chartInstances[kind]) {
      metaReportsState.chartInstances[kind].destroy();
      metaReportsState.chartInstances[kind] = null;
    }
    if (metaReportsState.chartScatterInstances[kind]) {
      metaReportsState.chartScatterInstances[kind].destroy();
      metaReportsState.chartScatterInstances[kind] = null;
    }
  });
}

function destroyMetaReportCharts() {
  destroyMetaReportTrendCharts();
  destroyMetaReportScenarioCharts();
  destroyMetaReportComparisonChart();
}

function destroyMetaReportScenarioCharts() {
  ['roas', 'poas'].forEach((kind) => {
    if (metaReportsState.scenarioChartInstances[kind]) {
      metaReportsState.scenarioChartInstances[kind].destroy();
      metaReportsState.scenarioChartInstances[kind] = null;
    }
  });
}

function metaReportChartValue(point, mode, krKey, xKey) {
  if (point?.hasData === false) return null;
  const raw = mode === 'x' ? point[xKey] : point[krKey];
  if (raw == null) return null;
  const parsed = Number(raw);
  return Number.isFinite(parsed) ? parsed : null;
}

function metaReportChartTooltipLabel(value, mode) {
  return mode === 'x' ? metaFmtX(value) : metaFmtKr(value);
}

function metaReportChartAxisTick(value, mode) {
  if (mode === 'x') return `${Number(value).toFixed(1)}x`;
  const amount = Number(value) || 0;
  if (Math.abs(amount) >= 1000000) return `${(amount / 1000000).toFixed(1)}M`;
  if (Math.abs(amount) >= 1000) return `${Math.round(amount / 1000)}K`;
  return amount;
}

function buildMetaReportLineChart(canvas, series, mode, krKey, xKey) {
  const labels = series.map((point) => point.label);
  const values = series.map((point) => metaReportChartValue(point, mode, krKey, xKey));

  return new Chart(canvas, {
    type: 'line',
    data: {
      labels,
      datasets: [{
        label: mode === 'x' ? 'Multiplier' : 'Dkr',
        data: values,
        borderColor: '#ff6a00',
        backgroundColor: 'rgba(255, 106, 0, 0.12)',
        borderWidth: 2.5,
        pointBackgroundColor: '#ff6a00',
        pointBorderColor: '#ffffff',
        pointBorderWidth: 2,
        pointRadius: 4,
        pointHoverRadius: 5,
        fill: true,
        tension: 0.3,
        spanGaps: false,
      }],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#ffffff',
          borderColor: '#e8e0d8',
          borderWidth: 1,
          titleColor: '#1a1208',
          bodyColor: '#1a1208',
          padding: 10,
          callbacks: {
            label(context) {
              if (context.parsed.y == null) return 'No data';
              return metaReportChartTooltipLabel(context.parsed.y, mode);
            },
          },
        },
      },
      scales: {
        x: {
          grid: { color: 'rgba(26, 18, 8, 0.06)' },
          ticks: { color: '#6b5348', font: { size: 11 } },
        },
        y: {
          grid: { color: 'rgba(26, 18, 8, 0.08)' },
          ticks: {
            color: '#6b5348',
            font: { size: 11 },
            callback: (value) => metaReportChartAxisTick(value, mode),
          },
        },
      },
    },
  });
}

function buildMetaReportDualMetricChart(canvas, {
  series,
  mode,
  krKey,
  xKey,
  returnLabel,
  chartType = 'area',
  projection = null,
  projectionLabel = 'Projected',
  showProjection = false,
  baselineSpend = null,
} = {}) {
  const chartSeries = series.filter((point) => metaReportParseAmount(point.spend) > 0);
  const labels = chartSeries.map((point) => point.label);
  const spendBaseline = metaReportParseAmount(
    baselineSpend ?? (projection?.baselineSpend ?? 0),
  ) || resolveMetaReportSpendChartBaseline(chartSeries, projection);
  const useSpendMultiplier = mode === 'x' && spendBaseline > 0;
  const spendValues = chartSeries.map((point) => (
    useSpendMultiplier
      ? metaReportSpendMultiplierValue(point.spend, spendBaseline)
      : metaReportParseAmount(point.spend)
  ));
  const returnValues = chartSeries.map((point) => metaReportChartValue(point, mode, krKey, xKey));
  const normalizedType = normalizeMetaReportSpendChartType(chartType);
  const dualAxis = mode === 'x';
  const lastHistoricalIndex = chartSeries.length - 1;

  if (showProjection && projection && !projection.insufficientData) {
    labels.push(projectionLabel || `Projected (${Number(projection.multiplier).toFixed(1)}×)`);
    spendValues.push(
      useSpendMultiplier
        ? metaReportParseAmount(projection.multiplier)
        : metaReportParseAmount(projection.projected.spend),
    );
    returnValues.push(metaReportParseAmount(projection.projected[mode === 'x' ? xKey : krKey]));
  }

  const projectedIndex = labels.length - 1;
  const hasProjectedPoint = showProjection && projection && !projection.insufficientData && projectedIndex > lastHistoricalIndex;

  function pointStyleAt(index, color) {
    const isProjected = hasProjectedPoint && index === projectedIndex;
    return {
      pointBackgroundColor: color,
      pointBorderColor: '#ffffff',
      pointBorderWidth: 2,
      pointRadius: isProjected ? 7 : (normalizedType === 'scatter' ? 5 : 4),
      pointHoverRadius: isProjected ? 8 : (normalizedType === 'scatter' ? 6 : 5),
      pointStyle: isProjected ? 'rectRot' : 'circle',
    };
  }

  function buildMetricDataset(label, values, color, fillColor, yAxisID) {
    const pointStyles = values.map((_, index) => pointStyleAt(index, color));
    const common = {
      label,
      data: values,
      borderColor: color,
      yAxisID,
    };

    if (normalizedType === 'bar') {
      return {
        ...common,
        type: 'bar',
        backgroundColor: color === '#138b53' ? 'rgba(19, 139, 83, 0.72)' : 'rgba(255, 106, 0, 0.72)',
        borderRadius: 4,
        borderWidth: 0,
      };
    }

    if (normalizedType === 'scatter') {
      return {
        ...common,
        type: 'line',
        backgroundColor: 'transparent',
        borderWidth: 0,
        showLine: false,
        fill: false,
        pointBackgroundColor: pointStyles.map((entry) => entry.pointBackgroundColor),
        pointBorderColor: pointStyles.map((entry) => entry.pointBorderColor),
        pointBorderWidth: pointStyles.map((entry) => entry.pointBorderWidth),
        pointRadius: pointStyles.map((entry) => entry.pointRadius),
        pointHoverRadius: pointStyles.map((entry) => entry.pointHoverRadius),
        pointStyle: pointStyles.map((entry) => entry.pointStyle),
      };
    }

    return {
      ...common,
      type: 'line',
      backgroundColor: fillColor,
      borderWidth: 2.5,
      fill: normalizedType === 'area',
      tension: 0.3,
      pointBackgroundColor: pointStyles.map((entry) => entry.pointBackgroundColor),
      pointBorderColor: pointStyles.map((entry) => entry.pointBorderColor),
      pointBorderWidth: pointStyles.map((entry) => entry.pointBorderWidth),
      pointRadius: pointStyles.map((entry) => entry.pointRadius),
      pointHoverRadius: pointStyles.map((entry) => entry.pointHoverRadius),
      pointStyle: pointStyles.map((entry) => entry.pointStyle),
    };
  }

  const datasets = [
    buildMetricDataset(
      'Ad spend',
      spendValues,
      '#138b53',
      'rgba(19, 139, 83, 0.16)',
      'ySpend',
    ),
    buildMetricDataset(
      returnLabel,
      returnValues,
      '#ff6a00',
      'rgba(255, 106, 0, 0.12)',
      dualAxis ? 'yReturn' : 'ySpend',
    ),
  ];

  if (hasProjectedPoint && normalizedType !== 'bar') {
    const connectorBase = {
      type: 'line',
      borderWidth: 2,
      fill: false,
      tension: 0,
      pointRadius: 0,
      pointHoverRadius: 0,
      spanGaps: true,
    };
    datasets.push({
      ...connectorBase,
      label: '',
      data: labels.map((_, index) => (
        index === lastHistoricalIndex || index === projectedIndex ? spendValues[index] : null
      )),
      borderColor: 'rgba(19, 139, 83, 0.55)',
      borderDash: [5, 4],
      yAxisID: 'ySpend',
    });
    datasets.push({
      ...connectorBase,
      label: '',
      data: labels.map((_, index) => (
        index === lastHistoricalIndex || index === projectedIndex ? returnValues[index] : null
      )),
      borderColor: 'rgba(255, 106, 0, 0.55)',
      borderDash: [5, 4],
      yAxisID: dualAxis ? 'yReturn' : 'ySpend',
    });
  }

  const scales = {
    x: {
      grid: { color: 'rgba(26, 18, 8, 0.06)' },
      ticks: { color: '#6b5348', font: { size: 11 }, maxRotation: 45, minRotation: 0 },
    },
    ySpend: {
      type: 'linear',
      position: 'left',
      title: {
        display: true,
        text: useSpendMultiplier ? 'Ad spend (×)' : (dualAxis ? 'Ad spend (Dkr)' : 'Dkr'),
        color: dualAxis ? '#138b53' : '#6b5348',
        font: { size: 11, weight: '600' },
      },
      grid: { color: 'rgba(26, 18, 8, 0.08)' },
      ticks: {
        color: dualAxis ? '#138b53' : '#6b5348',
        font: { size: 11 },
        callback: (value) => (
          useSpendMultiplier ? metaReportChartAxisTick(value, 'x') : metaReportSpendAxisTick(value)
        ),
      },
    },
  };

  if (dualAxis) {
    scales.yReturn = {
      type: 'linear',
      position: 'right',
      title: {
        display: true,
        text: 'Multiplier',
        color: '#ff6a00',
        font: { size: 11, weight: '600' },
      },
      grid: { drawOnChartArea: false },
      ticks: {
        color: '#ff6a00',
        font: { size: 11 },
        callback: (value) => metaReportChartAxisTick(value, 'x'),
      },
    };
  }

  return new Chart(canvas, {
    type: normalizedType === 'bar' ? 'bar' : 'line',
    data: { labels, datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: {
          display: true,
          position: 'top',
          align: 'end',
          labels: {
            boxWidth: 10,
            boxHeight: 10,
            font: { size: 11, weight: '600' },
            color: '#6b5348',
            filter(item) {
              return Boolean(item.text);
            },
          },
        },
        tooltip: {
          backgroundColor: '#ffffff',
          borderColor: '#e8e0d8',
          borderWidth: 1,
          titleColor: '#1a1208',
          bodyColor: '#1a1208',
          padding: 10,
          filter(item) {
            return Boolean(item.dataset.label);
          },
          callbacks: {
            label(context) {
              const datasetLabel = context.dataset.label || '';
              if (context.dataset.yAxisID === 'yReturn') {
                return `${datasetLabel}: ${metaReportChartTooltipLabel(context.parsed.y, 'x')}`;
              }
              if (useSpendMultiplier && context.dataset.yAxisID === 'ySpend') {
                return `${datasetLabel}: ${metaReportChartTooltipLabel(context.parsed.y, 'x')}`;
              }
              if (context.datasetIndex === 1 && !dualAxis) {
                return `${datasetLabel}: ${metaReportChartTooltipLabel(context.parsed.y, mode)}`;
              }
              return `${datasetLabel}: ${metaFmtKr(context.parsed.y)}`;
            },
          },
        },
      },
      scales,
    },
  });
}

function buildMetaReportScenarioExtrapolationChart(canvas, {
  series,
  mode,
  kind,
  projection,
  chartType = 'area',
  hasBottomline = false,
} = {}) {
  const krKey = kind === 'roas' ? 'roasKr' : 'poasKr';
  const xKey = kind === 'roas' ? 'roasX' : 'poasX';
  const returnLabel = kind === 'roas' ? 'ROAS' : 'POAS';
  const timelineSeries = resolveMetaReportScenarioActiveTimeline(series);
  const adActiveSeries = resolveMetaReportScenarioAdActiveSeries(timelineSeries, kind);
  const chartSeries = resolveMetaReportScenarioChartSeries(adActiveSeries);
  const baselineSpend = resolveMetaReportSpendChartBaseline(chartSeries, projection);
  const useMultiplier = mode === 'x' && baselineSpend > 0;
  const projectionSteps = buildMetaReportScenarioProjectionSteps(projection, {
    hasBottomline,
    targetMultiplier: metaReportsState.budgetMultiplier,
  });
  const normalizedType = normalizeMetaReportSpendChartType(chartType);
  const labels = timelineSeries.map((point) => point.label);
  const spendValues = timelineSeries.map((point) => {
    if (metaReportParseAmount(point.spend) <= 0) return null;
    return useMultiplier
      ? metaReportSpendMultiplierValue(point.spend, baselineSpend)
      : metaReportParseAmount(point.spend);
  });
  const returnValues = timelineSeries.map((point) => {
    if (metaReportParseAmount(point.spend) <= 0) return null;
    return metaReportChartValue(point, mode, krKey, xKey);
  });
  const lastHistoricalIndex = resolveMetaReportScenarioLastAdActiveIndex(timelineSeries);
  const firstProjectedIndex = labels.length;

  for (const step of projectionSteps) {
    labels.push(step.label);
    spendValues.push(
      useMultiplier
        ? metaReportSpendMultiplierValue(step.spend, baselineSpend)
        : step.spend,
    );
    returnValues.push(metaReportParseAmount(step[mode === 'x' ? xKey : krKey]));
  }

  const projectedIndices = new Set(
    projectionSteps.map((_, index) => firstProjectedIndex + index),
  );
  const hasProjected = projectionSteps.length > 0;

  function pointStyleAt(index, color) {
    const isProjected = projectedIndices.has(index);
    return {
      pointBackgroundColor: color,
      pointBorderColor: '#ffffff',
      pointBorderWidth: 2,
      pointRadius: isProjected ? 7 : (normalizedType === 'scatter' ? 5 : 4),
      pointHoverRadius: isProjected ? 8 : (normalizedType === 'scatter' ? 6 : 5),
      pointStyle: isProjected ? 'rectRot' : 'circle',
    };
  }

  function buildMetricDataset(label, values, color, fillColor) {
    const pointStyles = values.map((_, index) => pointStyleAt(index, color));
    const common = {
      label,
      data: values,
      borderColor: color,
      yAxisID: 'y',
    };

    if (normalizedType === 'bar') {
      return {
        ...common,
        type: 'bar',
        backgroundColor: color === '#138b53' ? 'rgba(19, 139, 83, 0.72)' : 'rgba(255, 106, 0, 0.72)',
        borderRadius: 4,
        borderWidth: 0,
      };
    }

    if (normalizedType === 'scatter') {
      return {
        ...common,
        type: 'line',
        backgroundColor: 'transparent',
        borderWidth: 0,
        showLine: false,
        fill: false,
        pointBackgroundColor: pointStyles.map((entry) => entry.pointBackgroundColor),
        pointBorderColor: pointStyles.map((entry) => entry.pointBorderColor),
        pointBorderWidth: pointStyles.map((entry) => entry.pointBorderWidth),
        pointRadius: pointStyles.map((entry) => entry.pointRadius),
        pointHoverRadius: pointStyles.map((entry) => entry.pointHoverRadius),
        pointStyle: pointStyles.map((entry) => entry.pointStyle),
      };
    }

    return {
      ...common,
      type: 'line',
      backgroundColor: fillColor,
      borderWidth: 2.5,
      fill: normalizedType === 'area',
      tension: 0.3,
      pointBackgroundColor: pointStyles.map((entry) => entry.pointBackgroundColor),
      pointBorderColor: pointStyles.map((entry) => entry.pointBorderColor),
      pointBorderWidth: pointStyles.map((entry) => entry.pointBorderWidth),
      pointRadius: pointStyles.map((entry) => entry.pointRadius),
      pointHoverRadius: pointStyles.map((entry) => entry.pointHoverRadius),
      pointStyle: pointStyles.map((entry) => entry.pointStyle),
    };
  }

  const datasets = [
    buildMetricDataset('Ad spend', spendValues, '#138b53', 'rgba(19, 139, 83, 0.16)'),
    buildMetricDataset(returnLabel, returnValues, '#ff6a00', 'rgba(255, 106, 0, 0.12)'),
  ];

  if (hasProjected && normalizedType !== 'bar') {
    const connectorBase = {
      type: 'line',
      borderWidth: 2,
      fill: false,
      tension: 0,
      pointRadius: 0,
      pointHoverRadius: 0,
      spanGaps: true,
      yAxisID: 'y',
    };
    const connectorData = (values) => labels.map((_, index) => (
      index === lastHistoricalIndex || projectedIndices.has(index) ? values[index] : null
    ));
    datasets.push({
      ...connectorBase,
      label: '',
      data: connectorData(spendValues),
      borderColor: 'rgba(19, 139, 83, 0.55)',
      borderDash: [5, 4],
    });
    datasets.push({
      ...connectorBase,
      label: '',
      data: connectorData(returnValues),
      borderColor: 'rgba(255, 106, 0, 0.55)',
      borderDash: [5, 4],
    });
  }

  const yAxisTitle = useMultiplier ? 'Multiplier (×)' : 'Dkr';
  const yTick = (value) => (
    useMultiplier ? metaReportChartAxisTick(value, 'x') : metaReportChartAxisTick(value, 'kr')
  );

  return new Chart(canvas, {
    type: normalizedType === 'bar' ? 'bar' : 'line',
    data: { labels, datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: {
          display: true,
          position: 'top',
          align: 'end',
          labels: {
            boxWidth: 10,
            boxHeight: 10,
            font: { size: 11, weight: '600' },
            color: '#6b5348',
            filter(item) {
              return Boolean(item.text);
            },
          },
        },
        tooltip: {
          backgroundColor: '#ffffff',
          borderColor: '#e8e0d8',
          borderWidth: 1,
          titleColor: '#1a1208',
          bodyColor: '#1a1208',
          padding: 10,
          filter(item) {
            return Boolean(item.dataset.label);
          },
          callbacks: {
            label(context) {
              const datasetLabel = context.dataset.label || '';
              return `${datasetLabel}: ${metaReportChartTooltipLabel(context.parsed.y, mode)}`;
            },
          },
        },
      },
      scales: {
        x: {
          grid: { color: 'rgba(26, 18, 8, 0.06)' },
          ticks: { color: '#6b5348', font: { size: 11 }, maxRotation: 45, minRotation: 0 },
        },
        y: {
          type: 'linear',
          position: 'left',
          title: {
            display: true,
            text: yAxisTitle,
            color: '#6b5348',
            font: { size: 11, weight: '600' },
          },
          grid: { color: 'rgba(26, 18, 8, 0.08)' },
          ticks: {
            color: '#6b5348',
            font: { size: 11 },
            callback: yTick,
          },
        },
      },
    },
  });
}

function updateMetaReportChart(kind, series, mode) {
  const canvas = document.getElementById(`meta-report-chart-${kind}`);
  const emptyEl = document.getElementById(`meta-report-chart-${kind}-empty`);
  if (!canvas || !emptyEl) return;

  const krKey = kind === 'roas' ? 'roasKr' : 'poasKr';
  const xKey = kind === 'roas' ? 'roasX' : 'poasX';
  const chartSeries = series;
  const pointsWithValues = chartSeries.filter((point) => {
    const value = metaReportChartValue(point, mode, krKey, xKey);
    return value != null;
  });

  if (metaReportsState.chartInstances[kind]) {
    metaReportsState.chartInstances[kind].destroy();
    metaReportsState.chartInstances[kind] = null;
  }

  if (pointsWithValues.length < META_REPORT_CHART_MIN_POINTS || typeof Chart === 'undefined') {
    canvas.hidden = true;
    emptyEl.hidden = false;
    return;
  }

  canvas.hidden = false;
  emptyEl.hidden = true;
  metaReportsState.chartInstances[kind] = buildMetaReportLineChart(canvas, chartSeries, mode, krKey, xKey);
}

function updateMetaReportSpendReturnChart(kind, series, mode, {
  projection = null,
  showProjection = false,
  projectionLabel = 'Projected',
  chartType = metaReportsState.spendChartType,
  target = 'spend',
} = {}) {
  const canvasId = target === 'scenario'
    ? `meta-report-scenario-chart-${kind}`
    : `meta-report-chart-scatter-${kind}`;
  const emptyId = target === 'scenario'
    ? `meta-report-scenario-chart-${kind}-empty`
    : `meta-report-chart-scatter-${kind}-empty`;
  const canvas = document.getElementById(canvasId);
  const emptyEl = document.getElementById(emptyId);
  if (!canvas || !emptyEl) return;

  const krKey = kind === 'roas' ? 'roasKr' : 'poasKr';
  const xKey = kind === 'roas' ? 'roasX' : 'poasX';
  const chartSeries = kind === 'poas'
    ? series.filter((point) => point.poasKr != null && point.poasX != null)
    : series.filter((point) => metaReportParseAmount(point.spend) > 0);
  const instanceKey = target === 'scenario' ? 'scenarioChartInstances' : 'chartScatterInstances';

  if (metaReportsState[instanceKey][kind]) {
    metaReportsState[instanceKey][kind].destroy();
    metaReportsState[instanceKey][kind] = null;
  }

  if (chartSeries.length < META_REPORT_CHART_MIN_POINTS || typeof Chart === 'undefined') {
    canvas.hidden = true;
    emptyEl.hidden = false;
    return;
  }

  if (showProjection && projection?.insufficientData) {
    canvas.hidden = true;
    emptyEl.hidden = false;
    return;
  }

  canvas.hidden = false;
  emptyEl.hidden = true;
  const baselineSpend = mode === 'x'
    ? resolveMetaReportSpendChartBaseline(chartSeries, projection)
    : null;
  metaReportsState[instanceKey][kind] = buildMetaReportDualMetricChart(canvas, {
    series: chartSeries,
    mode,
    krKey,
    xKey,
    returnLabel: kind === 'roas' ? 'ROAS' : 'POAS',
    chartType,
    projection,
    projectionLabel,
    showProjection,
    baselineSpend,
  });
}

function updateMetaReportScatterChart(kind, series, mode) {
  updateMetaReportSpendReturnChart(kind, series, mode, {
    showProjection: false,
    chartType: metaReportsState.spendChartType,
    target: 'spend',
  });
}

function updateMetaReportScenarioChart(kind, series, projection, mode, payload = null) {
  const canvas = document.getElementById(`meta-report-scenario-chart-${kind}`);
  const emptyEl = document.getElementById(`meta-report-scenario-chart-${kind}-empty`);
  if (!canvas || !emptyEl) return;

  const activePayload = payload || metaReportsState.clientPayload || metaReportsState.publicPayload;
  const timeline = resolveMetaReportScenarioDisplayTimeline(activePayload, series);
  const adActiveSeries = resolveMetaReportScenarioAdActiveSeries(timeline, kind);
  const trimmedSeries = resolveMetaReportScenarioChartSeries(adActiveSeries);

  if (metaReportsState.scenarioChartInstances[kind]) {
    metaReportsState.scenarioChartInstances[kind].destroy();
    metaReportsState.scenarioChartInstances[kind] = null;
  }

  if (
    trimmedSeries.length < META_REPORT_CHART_MIN_POINTS
    || typeof Chart === 'undefined'
  ) {
    canvas.hidden = true;
    emptyEl.hidden = false;
    return;
  }

  canvas.hidden = false;
  emptyEl.hidden = true;
  const chartProjection = projection?.insufficientData ? null : projection;
  metaReportsState.scenarioChartInstances[kind] = buildMetaReportScenarioExtrapolationChart(canvas, {
    series: timeline,
    mode,
    kind,
    projection: chartProjection,
    chartType: metaReportsState.spendChartType,
    hasBottomline: kind === 'poas',
  });
}

function mountMetaReportScenarioCharts(payload) {
  const scenarioPayload = resolveMetaReportScenarioPayload(payload);
  const activePayload = payload || metaReportsState.clientPayload || metaReportsState.publicPayload;
  const series = resolveMetaReportScenarioDisplayTimeline(activePayload);
  const hasBottomline = payloadHasMetaReportBottomline(scenarioPayload);
  const poasWrap = document.getElementById('meta-report-scenario-poas-wrap');
  if (poasWrap) poasWrap.hidden = !hasBottomline;

  const projection = metaReportsState.chartProjection;
  updateMetaReportScenarioChart('roas', series, projection, metaReportsState.chartScenarioRoasMode, activePayload);
  if (hasBottomline) {
    updateMetaReportScenarioChart('poas', series, projection, metaReportsState.chartScenarioPoasMode, activePayload);
  } else if (metaReportsState.scenarioChartInstances.poas) {
    metaReportsState.scenarioChartInstances.poas.destroy();
    metaReportsState.scenarioChartInstances.poas = null;
  }
}

function syncMetaReportSpendChartTypeToolbar(tab = metaReportsState.chartTab || 'trend') {
  const wrap = document.getElementById('meta-report-spend-chart-type-wrap');
  if (wrap) wrap.hidden = tab !== 'spend';
}

function setMetaReportChartTab(tab) {
  metaReportsState.chartTab = tab;
  document.querySelectorAll('[data-meta-chart-tab]').forEach((button) => {
    const active = button.getAttribute('data-meta-chart-tab') === tab;
    button.classList.toggle('is-active', active);
    button.setAttribute('aria-selected', active ? 'true' : 'false');
  });
  document.querySelectorAll('[data-meta-chart-panel]').forEach((panel) => {
    const active = panel.getAttribute('data-meta-chart-panel') === tab;
    panel.classList.toggle('is-active', active);
    panel.hidden = !active;
  });
  syncMetaReportSpendChartTypeToolbar(tab);
  mountActiveMetaReportCharts();
}

function mountActiveMetaReportCharts() {
  const series = metaReportsState.chartSeries || [];
  if (metaReportsState.chartTab === 'spend') {
    updateMetaReportScatterChart('roas', series, metaReportsState.chartScatterRoasMode);
    updateMetaReportScatterChart('poas', series, metaReportsState.chartScatterPoasMode);
  } else {
    updateMetaReportChart('roas', series, metaReportsState.chartRoasMode);
    updateMetaReportChart('poas', series, metaReportsState.chartPoasMode);
  }
}

function refreshMetaReportSpendAndScenarioCharts(payload) {
  mountActiveMetaReportCharts();
  if (document.getElementById('meta-report-scenario-card') && payload) {
    syncMetaReportScenario(payload);
  } else {
    mountMetaReportScenarioCharts(payload);
  }
}

function setMetaReportSpendChartType(nextType, { persist = false, clientId = null, payload = null } = {}) {
  const normalized = normalizeMetaReportSpendChartType(nextType);
  metaReportsState.spendChartType = normalized;
  document.querySelectorAll('[data-spend-chart-type]').forEach((button) => {
    button.classList.toggle('is-active', button.getAttribute('data-spend-chart-type') === normalized);
  });
  const activePayload = payload || metaReportsState.clientPayload || metaReportsState.publicPayload;
  refreshMetaReportSpendAndScenarioCharts(activePayload);
  if (persist && clientId) {
    return patchMetaReportSettings(clientId, { metaReportSpendChartType: normalized });
  }
  return Promise.resolve(null);
}

function bindMetaReportChartTabs() {
  document.querySelectorAll('[data-meta-chart-tab]').forEach((button) => {
    button.onclick = () => {
      setMetaReportChartTab(button.getAttribute('data-meta-chart-tab'));
    };
  });
}

function bindMetaReportChartToggles() {
  const roasToggle = document.getElementById('meta-chart-roas-mode');
  if (roasToggle) {
    roasToggle.querySelectorAll('[data-mode]').forEach((button) => {
      button.onclick = () => {
        const mode = button.getAttribute('data-mode');
        metaReportsState.chartRoasMode = mode;
        roasToggle.querySelectorAll('[data-mode]').forEach((entry) => {
          entry.classList.toggle('is-active', entry.getAttribute('data-mode') === mode);
        });
        updateMetaReportChart('roas', metaReportsState.chartSeries || [], mode);
      };
    });
  }

  const poasToggle = document.getElementById('meta-chart-poas-mode');
  if (poasToggle) {
    poasToggle.querySelectorAll('[data-mode]').forEach((button) => {
      button.onclick = () => {
        const mode = button.getAttribute('data-mode');
        metaReportsState.chartPoasMode = mode;
        poasToggle.querySelectorAll('[data-mode]').forEach((entry) => {
          entry.classList.toggle('is-active', entry.getAttribute('data-mode') === mode);
        });
        updateMetaReportChart('poas', metaReportsState.chartSeries || [], mode);
      };
    });
  }

  const scatterRoasToggle = document.getElementById('meta-chart-scatter-roas-mode');
  if (scatterRoasToggle) {
    scatterRoasToggle.querySelectorAll('[data-mode]').forEach((button) => {
      button.onclick = () => {
        const mode = button.getAttribute('data-mode');
        metaReportsState.chartScatterRoasMode = mode;
        scatterRoasToggle.querySelectorAll('[data-mode]').forEach((entry) => {
          entry.classList.toggle('is-active', entry.getAttribute('data-mode') === mode);
        });
        updateMetaReportScatterChart('roas', metaReportsState.chartSeries || [], mode);
      };
    });
  }

  const scatterPoasToggle = document.getElementById('meta-chart-scatter-poas-mode');
  if (scatterPoasToggle) {
    scatterPoasToggle.querySelectorAll('[data-mode]').forEach((button) => {
      button.onclick = () => {
        const mode = button.getAttribute('data-mode');
        metaReportsState.chartScatterPoasMode = mode;
        scatterPoasToggle.querySelectorAll('[data-mode]').forEach((entry) => {
          entry.classList.toggle('is-active', entry.getAttribute('data-mode') === mode);
        });
        updateMetaReportScatterChart('poas', metaReportsState.chartSeries || [], mode);
      };
    });
  }

  const scenarioRoasToggle = document.getElementById('meta-scenario-roas-mode');
  if (scenarioRoasToggle) {
    scenarioRoasToggle.querySelectorAll('[data-mode]').forEach((button) => {
      button.onclick = () => {
        const mode = button.getAttribute('data-mode');
        metaReportsState.chartScenarioRoasMode = mode;
        scenarioRoasToggle.querySelectorAll('[data-mode]').forEach((entry) => {
          entry.classList.toggle('is-active', entry.getAttribute('data-mode') === mode);
        });
        updateMetaReportScenarioChart(
          'roas',
          resolveMetaReportScenarioDisplayTimeline(
            metaReportsState.clientPayload || metaReportsState.publicPayload,
            metaReportsState.chartSeries || [],
          ),
          metaReportsState.chartProjection,
          mode,
        );
      };
    });
  }

  const scenarioPoasToggle = document.getElementById('meta-scenario-poas-mode');
  if (scenarioPoasToggle) {
    scenarioPoasToggle.querySelectorAll('[data-mode]').forEach((button) => {
      button.onclick = () => {
        const mode = button.getAttribute('data-mode');
        metaReportsState.chartScenarioPoasMode = mode;
        scenarioPoasToggle.querySelectorAll('[data-mode]').forEach((entry) => {
          entry.classList.toggle('is-active', entry.getAttribute('data-mode') === mode);
        });
        updateMetaReportScenarioChart(
          'poas',
          resolveMetaReportScenarioDisplayTimeline(
            metaReportsState.clientPayload || metaReportsState.publicPayload,
            metaReportsState.chartSeries || [],
          ),
          metaReportsState.chartProjection,
          mode,
        );
      };
    });
  }
}

function bindMetaReportSpendChartTypePicker(clientId, payload) {
  document.querySelectorAll('#meta-report-spend-chart-type-wrap [data-spend-chart-type]').forEach((button) => {
    button.onclick = async () => {
      const nextType = button.getAttribute('data-spend-chart-type');
      if (!nextType || nextType === metaReportsState.spendChartType) return;

      setMetaReportSpendChartType(nextType, { payload });
      if (!clientId) return;

      try {
        const patch = {
          metaReportSpendChartType: normalizeMetaReportSpendChartType(nextType),
        };
        const result = payload?.reportKind === 'google-ads'
          ? await patchGoogleAdsReportSettings(clientId, patch)
          : await patchMetaReportSettings(clientId, patch);
        if (result?.settings && payload) {
          const savedSettings = payload.reportKind === 'google-ads'
            ? googleAdsSettingsToMetaUx(result.settings)
            : result.settings;
          payload.settings = { ...payload.settings, ...savedSettings };
          if (metaReportsState.clientPayload?.clientId === payload.clientId) {
            metaReportsState.clientPayload.settings = payload.settings;
          }
        }
      } catch (error) {
        showToast(error.message || 'Could not save chart type default', 'error');
      }
    };
  });
}

function syncMetaReportChartToggleUi() {
  [
    ['roas', metaReportsState.chartRoasMode, 'meta-chart-roas-mode'],
    ['poas', metaReportsState.chartPoasMode, 'meta-chart-poas-mode'],
    ['scatter-roas', metaReportsState.chartScatterRoasMode, 'meta-chart-scatter-roas-mode'],
    ['scatter-poas', metaReportsState.chartScatterPoasMode, 'meta-chart-scatter-poas-mode'],
    ['scenario-roas', metaReportsState.chartScenarioRoasMode, 'meta-scenario-roas-mode'],
    ['scenario-poas', metaReportsState.chartScenarioPoasMode, 'meta-scenario-poas-mode'],
  ].forEach(([, mode, id]) => {
    const toggle = document.getElementById(id);
    if (!toggle) return;
    toggle.querySelectorAll('[data-mode]').forEach((button) => {
      button.classList.toggle('is-active', button.getAttribute('data-mode') === mode);
    });
  });
}

function scheduleMetaReportScenarioSettingsPersist(clientId, reportKind = 'meta') {
  if (!clientId) return;
  clearTimeout(metaReportsState._scenarioSettingsTimer);
  metaReportsState._scenarioSettingsTimer = setTimeout(() => {
    const patch = {
      metaReportBudgetMultiplier: metaReportsState.budgetMultiplier,
      metaReportBudgetBaseline: metaReportsState.budgetBaseline,
      metaReportScenarioMonthWindow: metaReportsState.scenarioMonthWindow,
      metaReportScenarioSmoothUneven: metaReportsState.scenarioSmoothUneven,
      metaReportScenarioBlendHistory: metaReportsState.scenarioBlendHistory,
      metaReportScenarioIncludeTrend: metaReportsState.scenarioIncludeTrend,
    };
    const save = reportKind === 'google-ads'
      ? patchGoogleAdsReportSettings(clientId, patch, { fast: true })
      : patchMetaReportSettings(clientId, patch, { fast: true });
    save.catch(() => {});
  }, 350);
}

function syncMetaReportScenarioControlValues() {
  const slider = document.getElementById('meta-report-budget-multiplier');
  const output = document.getElementById('meta-report-budget-multiplier-value');
  if (slider) slider.value = String(metaReportsState.budgetMultiplier);
  if (output) output.textContent = `${metaReportsState.budgetMultiplier.toFixed(1)}×`;

  const baselineSelect = document.getElementById('meta-report-budget-baseline');
  if (baselineSelect) {
    baselineSelect.value = normalizeMetaReportBudgetBaseline(metaReportsState.budgetBaseline);
  }

  const windowSelect = document.getElementById('meta-report-scenario-month-window');
  if (windowSelect) {
    windowSelect.value = normalizeMetaReportScenarioMonthWindow(metaReportsState.scenarioMonthWindow);
  }
}

function bindMetaReportScenarioControls(payload, { editable = false } = {}) {
  if (!editable) return;
  const clientId = payload?.clientId || null;
  syncMetaReportScenarioControlValues();
  const slider = document.getElementById('meta-report-budget-multiplier');
  const output = document.getElementById('meta-report-budget-multiplier-value');
  const baselineSelect = document.getElementById('meta-report-budget-baseline');
  const windowSelect = document.getElementById('meta-report-scenario-month-window');
  const persist = () => scheduleMetaReportScenarioSettingsPersist(
    clientId,
    payload?.reportKind || 'meta',
  );
  const refresh = () => syncMetaReportScenario(payload);

  if (slider) {
    slider.oninput = () => {
      metaReportsState.budgetMultiplier = normalizeMetaReportBudgetMultiplier(slider.value);
      if (output) output.textContent = `${metaReportsState.budgetMultiplier.toFixed(1)}×`;
      refresh();
      persist();
    };
  }
  if (baselineSelect) {
    baselineSelect.onchange = () => {
      metaReportsState.budgetBaseline = normalizeMetaReportBudgetBaseline(baselineSelect.value);
      refresh();
      persist();
    };
  }
  if (windowSelect) {
    windowSelect.onchange = () => {
      metaReportsState.scenarioMonthWindow = normalizeMetaReportScenarioMonthWindow(windowSelect.value);
      refresh();
      persist();
    };
  }

  const bindScenarioPillButtons = () => {
    document.querySelectorAll('[data-scenario-pill]').forEach((button) => {
      button.onclick = () => {
        const key = button.getAttribute('data-scenario-pill');
        if (!key || button.disabled) return;
        metaReportsState[key] = !metaReportsState[key];
        applyMetaReportScenarioPillsToState(getMetaReportScenarioPillsFromState());
        const pillsWrap = document.getElementById('meta-report-scenario-pills-wrap');
        if (pillsWrap) {
          pillsWrap.outerHTML = renderMetaReportScenarioModelPills();
          bindScenarioPillButtons();
        }
        refresh();
        persist();
      };
    });
  };
  bindScenarioPillButtons();
}

function syncMetaReportScenario(payload) {
  const scenarioPayload = resolveMetaReportScenarioPayload(payload);
  const series = resolveMetaReportScenarioSeries(payload);
  const hasBottomline = payloadHasMetaReportBottomline(scenarioPayload);
  const scenarioSeries = filterMetaReportScenarioSeries(series, { hasBottomline });
  const projection = buildMetaReportScenarioProjection(series, payload);
  metaReportsState.chartProjection = projection;
  syncMetaReportBaselineUi(metaReportsState.chartSeries || series, projection, scenarioPayload);

  const scenarioCard = document.getElementById('meta-report-scenario-card');
  if (!scenarioCard) return;

  const contextWrap = document.getElementById('meta-report-scenario-context-wrap');
  if (contextWrap) contextWrap.innerHTML = renderMetaReportScenarioContextStrip(projection);

  const grid = document.getElementById('meta-report-scenario-grid');
  if (grid) grid.innerHTML = renderMetaReportScenarioMetrics(projection);

  mountMetaReportScenarioCharts(payload);
}

function mountMetaReportTrendCharts(payload, { editable = false, clientId = null } = {}) {
  const chartsPanel = document.getElementById('meta-report-charts-panel');
  if (!payload || !chartsPanel) return;

  hydrateMetaReportSpendChartType(payload);
  hydrateMetaReportScenarioSettings(payload);
  const { series, demo } = resolveMetaReportChartSeries(payload, { allowDemo: !editable });
  metaReportsState.chartSeries = series;
  metaReportsState.chartDemo = demo;
  updateMetaReportScenarioSource(payload);

  const demoBadge = document.getElementById('meta-report-chart-demo-badge');
  if (demoBadge) demoBadge.hidden = !(demo && editable);

  bindMetaReportChartTabs();
  bindMetaReportChartToggles();
  if (editable) {
    bindMetaReportScenarioControls(payload, { editable: true });
    bindMetaReportSpendChartTypePicker(clientId, payload);
  }
  syncMetaReportChartToggleUi();
  syncMetaReportSpendChartTypeToolbar(metaReportsState.chartTab || 'trend');
  document.querySelectorAll('[data-spend-chart-type]').forEach((button) => {
    button.classList.toggle('is-active', button.getAttribute('data-spend-chart-type') === metaReportsState.spendChartType);
  });
  setMetaReportChartTab(metaReportsState.chartTab || 'trend');
  syncMetaReportScenario(payload);
}

function mountMetaReportCharts(payload, { editable = false, clientId = null } = {}) {
  destroyMetaReportCharts();
  destroyMetaReportComparisonChart();
  if (!payload) return;

  if (!editable) {
    metaReportsState.reportViewMode = 'monthly';
  }

  const viewMode = metaReportsState.reportViewMode || 'monthly';
  if (editable) {
    bindMetaReportViewModeTabs(payload, { editable });
  }

  if (viewMode === 'monthly' || !editable) {
    mountMetaReportTrendCharts(payload, { editable, clientId });
    return;
  }

  mountMetaReportComparison(payload, { editable });
  if (editable) {
    const { series } = resolveMetaReportChartSeries(payload, { allowDemo: false });
    if (series.length) metaReportsState.chartSeries = series;
    bindMetaReportScenarioControls(payload, { editable: true });
    syncMetaReportScenario(payload);
  }
}

function syncMetaReportMonthPanelDom(monthPayload, options = {}, yearPayload = null) {
  const payload = yearPayload
    || metaReportsState.clientPayload
    || metaReportsState.publicPayload;
  const activeKey = metaReportsState.activeMonthKey;
  const resolvedMonthPayload = resolveMetaReportActiveMonthPayload(payload) || monthPayload;
  const panel = document.getElementById('meta-report-month-panel');
  if (!panel) return;
  if (payload) {
    hydrateMetaReportSpendChartType(payload);
    hydrateMetaReportScenarioSettings(payload);
  }
  panel.innerHTML = renderMetaReportMonthBody(resolvedMonthPayload, {
    ...options,
    yearPayload: options.yearPayload || payload,
    activeMonthKey: activeKey || resolvedMonthPayload?.monthKey || null,
  });
  requestAnimationFrame(() => {
    mountMetaReportCharts(payload, {
      editable: Boolean(options.editable),
      clientId: payload?.clientId || null,
    });
  });
}

function renderMetaReportEmptyMonthCard({ editable = false, synced = false } = {}) {
  if (synced) {
    return `
      <div class="meta-report-empty-month-wrap">
        <div class="meta-report-empty-month-card is-synced-empty" role="status">
          <div class="meta-report-empty-month-icon" aria-hidden="true">${ICON_CHART}</div>
          <h3 class="meta-report-empty-month-title">No ad spend recorded for this month</h3>
        </div>
      </div>
    `;
  }

  const hintsHtml = editable ? `
    <div class="meta-report-empty-month-hints">
      <div class="meta-report-empty-month-hint">
        <span class="meta-report-empty-month-hint-icon" aria-hidden="true">↓</span>
        <span>Click <strong>Refresh from Meta</strong> below to pull data for this month.</span>
      </div>
      <div class="meta-report-empty-month-hint">
        <span class="meta-report-empty-month-hint-icon" aria-hidden="true">↑</span>
        <span>Use <strong>Backfill from Meta</strong> above to import historical months.</span>
      </div>
    </div>
  ` : `
    <p class="meta-report-empty-month-text">Ad spend data has not been synced for this month yet.</p>
  `;

  return `
    <div class="meta-report-empty-month-wrap">
      <div class="meta-report-empty-month-card" role="status">
        <div class="meta-report-empty-month-icon" aria-hidden="true">${ICON_CHART}</div>
        <h3 class="meta-report-empty-month-title">No ad spend recorded for this month yet</h3>
        ${editable ? '<p class="meta-report-empty-month-text">Sync Meta ads data to populate this report.</p>' : ''}
        ${hintsHtml}
      </div>
    </div>
  `;
}

function renderMetaReportMonthTables(monthPayload, { editable = false, adGroupTitle = 'Meta ads' } = {}) {
  if (!monthPayload) {
    return '<div class="meta-report-empty">No data for this month yet.</div>';
  }
  if (monthPayload.meta?.emptyMonth) {
    return renderMetaReportEmptyMonthCard({
      editable,
      synced: Boolean(monthPayload.metaFetchedAt),
    });
  }

  const metaRows = [
    ['Total spend', metaFmtKr(monthPayload.meta?.spend), ''],
    ['Cost Pr Mile (CPM)', metaFmtKr(monthPayload.meta?.cpm), ''],
    ['Impressions', metaFmtNum(monthPayload.meta?.impressions), ''],
    ['Reach', metaFmtNum(monthPayload.meta?.reach), ''],
    ['Click', metaFmtNum(monthPayload.meta?.clicks), ''],
    ['CTR', metaFmtNum(monthPayload.meta?.conversionRatePercent, 2), '%'],
  ];
  const toplineRows = [
    ['Leads', metaFmtNum(monthPayload.topline?.leads), ''],
    ['Cost Per Lead (CPL)', metaFmtKr(monthPayload.topline?.cpl), ''],
    ['Won leads', metaFmtNum(monthPayload.topline?.wonLeads), ''],
    ['Total Lead Value', metaFmtKr(monthPayload.topline?.totalLeadValue), ''],
    ['Average Lead Value', metaFmtKr(monthPayload.topline?.avgLeadValue), ''],
    ['Client acquisition cost (CAC)', metaFmtKr(monthPayload.topline?.cac), ''],
    ['Return on Ads Spend (ROAS)', metaFmtKr(monthPayload.topline?.roasKr), ''],
    ['Return on Ads Spend % (ROAS)', metaFmtX(monthPayload.topline?.roasX), ''],
  ];

  let groupsHtml = '';
  groupsHtml += renderMetaReportMetricTable(adGroupTitle, metaRows, 'meta');
  groupsHtml += renderMetaReportMetricTable('Topline KPI\'er', toplineRows, 'topline', { highlightLastN: 2 });

  if (monthPayload.bottomline) {
    const bottomRows = [
      ['Leads', metaFmtNum(monthPayload.bottomline.leads), ''],
      ['Won leads', metaFmtNum(monthPayload.bottomline.wonLeads), ''],
      ['Total Lead Value', metaFmtKr(monthPayload.bottomline.totalLeadValue), ''],
      ['Average Lead Value', metaFmtKr(monthPayload.bottomline.avgLeadValue), ''],
      ['Client acquisition cost (CAC)', metaFmtKr(monthPayload.bottomline.cac), ''],
      ['Avg Total Profit', metaFmtKr(monthPayload.bottomline.totalProfit), ''],
      ['Avg Single Profit Order', metaFmtKr(monthPayload.bottomline.avgProfitPerWon), ''],
      ['Profit on Ads Spend (POAS)', metaFmtKr(monthPayload.bottomline.poasKr), ''],
      ['Profit on Ads Spend % (POAS)', metaFmtX(monthPayload.bottomline.poasX), ''],
    ];
    if (monthPayload.bottomline.feeMode) {
      const feeLabel = monthPayload.bottomline.feeLabel
        || (monthPayload.bottomline.feeMode === 'marketing'
          ? 'Censio marketing fee'
          : `Censio performance fee (${metaFmtNum(monthPayload.bottomline.feePercent, 0)}%)`);
      bottomRows.push([feeLabel, metaFmtKr(monthPayload.bottomline.censioFee), '']);
      bottomRows.push(['Profit on Investment (POI)', metaFmtKr(monthPayload.bottomline.poiKr), '']);
      bottomRows.push(['Profit on Investment % (POI)', metaFmtX(monthPayload.bottomline.poiX), '']);
    }
    groupsHtml += renderMetaReportMetricTable('Bottomline KPI\'er', bottomRows, 'bottomline', { highlightLastN: 2 });
  }

  if (!groupsHtml) return '';

  return `
    <div class="meta-report-tables-card">
      <div class="meta-report-tables-card-label">Details</div>
      <div class="meta-report-groups-stack">${groupsHtml}</div>
    </div>
  `;
}

function renderMetaReportMonthBody(monthPayload, { editable = false, yearPayload = null, activeMonthKey = null, settings = null } = {}) {
  const tabMonthKey = activeMonthKey || monthPayload?.monthKey || null;
  const tabBounds = tabMonthKey ? metaReportMonthBounds(tabMonthKey) : null;
  const resolvedSettings = settings || yearPayload?.settings || {};
  const isGhlListClient = isMetaReportGhlListClient(resolvedSettings);
  const globalMode = resolveClientToplineMode(resolvedSettings);
  const toplineSource = resolveMetaToplineSource(monthPayload, resolvedSettings);
  const isGhlReadOnly = isGhlListClient && globalMode === 'cenhub' && toplineSource === 'ghl';
  let editPanelHtml = '';
  if (editable && monthPayload && !monthPayload.meta?.emptyMonth && tabBounds) {
    const readOnlyAttr = isGhlReadOnly ? ' readonly' : '';
    const manualRowHtml = renderMetaReportMonthManualRow(monthPayload, resolvedSettings);
    editPanelHtml = `
      <div class="meta-report-edit-panel" id="meta-report-edit-panel">
        <div class="meta-report-edit-panel-head">
          <h3>Edit month inputs · ${esc(metaMonthLabel(tabMonthKey))}</h3>
          ${renderMetaMonthSourcePill(monthPayload, resolvedSettings)}
        </div>
        <p class="meta-report-edit-note">These fields drive Topline KPI'er. Ad spend comes from Meta.</p>
        <div class="meta-report-edit-grid">
          <label>Period start<input type="date" id="meta-report-period-start" value="${esc(tabBounds.start)}" /></label>
          <label>Period end<input type="date" id="meta-report-period-end" value="${esc(tabBounds.end)}" /></label>
          <label class="meta-cv-value-field${isGhlReadOnly ? ' is-locked' : ''}">Number of leads<input type="number" step="any" id="meta-report-leads" value="${esc(isGhlReadOnly ? (monthPayload.ghlTotals?.leads ?? monthPayload.topline?.leads ?? '') : (monthPayload.topline?.leads ?? ''))}"${readOnlyAttr}${isGhlReadOnly ? ' disabled tabindex="-1" aria-readonly="true"' : ''} /></label>
          <label class="meta-cv-value-field${isGhlReadOnly ? ' is-locked' : ''}">Won leads<input type="number" step="any" id="meta-report-won-leads" value="${esc(monthPayload.topline?.wonLeads ?? '')}"${readOnlyAttr}${isGhlReadOnly ? ' disabled tabindex="-1" aria-readonly="true"' : ''} /></label>
          <label>Avg lead value<input type="number" step="any" id="meta-report-avg-lead-value" value="${esc(monthPayload.topline?.avgLeadValue ?? '')}"${readOnlyAttr} /></label>
          <label>Avg profit per won<input type="number" step="any" id="meta-report-avg-profit" value="${esc(monthPayload.inputs?.avgProfitPerWon ?? '')}"${readOnlyAttr} /></label>
        </div>
        ${manualRowHtml}
        <div class="meta-report-edit-actions">
          <button type="button" class="admin-btn admin-btn--ghost" id="meta-report-refresh-meta">${ICON_SYNC} Refresh from Meta</button>
          ${isGhlReadOnly ? `<button type="button" class="admin-btn admin-btn--ghost" id="meta-report-refresh-snapshot">${ICON_SYNC} Refresh Cenhub snapshot</button>` : ''}
          <button type="button" class="admin-btn admin-btn--primary" id="meta-report-save-month"${isGhlReadOnly ? ' disabled' : ''}>Save month</button>
        </div>
      </div>
    `;
  }

  const previewMonthKey = activeMonthKey || monthPayload?.monthKey || null;
  const previewLabel = editable
    ? (previewMonthKey ? `Report preview · ${metaMonthLabel(previewMonthKey)}` : 'Report preview')
    : (previewMonthKey ? `Report · ${metaMonthLabel(previewMonthKey)}` : 'Report');
  const viewMode = metaReportsState.reportViewMode || 'monthly';
  const showYearVisuals = shouldShowMetaReportYearVisuals(monthPayload, yearPayload, { editable });
  const showComparison = editable && showYearVisuals;
  const previewHtml = monthPayload && !monthPayload.meta?.emptyMonth ? `
    <div class="meta-report-preview-card">
      <div class="meta-report-preview-card-label">${previewLabel}</div>
      ${renderMetaReportHighlightStrip(monthPayload)}
    </div>
  ` : '';

  const tablesHtml = renderMetaReportMonthTables(monthPayload, { editable });
  const chartsPanel = showYearVisuals ? renderMetaReportChartsPanel({ editable }) : '';
  const scenarioCard = editable && showYearVisuals ? renderMetaReportScenarioCard() : '';
  const viewTabsHtml = showComparison ? renderMetaReportViewModeTabs() : '';

  let bodyHtml;
  if (showYearVisuals) {
    bodyHtml = `
      <div class="meta-report-view-panel${!showComparison || viewMode === 'monthly' ? ' is-active' : ''}" data-report-view-panel="monthly" role="tabpanel"${!showComparison || viewMode === 'monthly' ? '' : ' hidden'}>
        <div class="meta-report-content-layout">
          <div class="meta-report-content-main">${tablesHtml}</div>
          ${chartsPanel}
        </div>
      </div>
      ${showComparison ? `
      <div class="meta-report-view-panel${viewMode === 'comparison' ? ' is-active' : ''}" data-report-view-panel="comparison" role="tabpanel"${viewMode === 'comparison' ? '' : ' hidden'}>
        ${renderMetaReportComparisonView()}
      </div>` : ''}
      ${scenarioCard}
    `;
  } else {
    bodyHtml = `<div class="meta-report-content-main">${tablesHtml}</div>`;
  }

  return `${editPanelHtml}${previewHtml}${viewTabsHtml}${bodyHtml}`;
}

function renderMetaReportsHubPage(viewData) {
  const clients = viewData.clients || [];
  const metaInfo = viewData.meta || {};

  return `
    ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
    ${wrapDashboardShell(`
    <div class="page-hero admin-hub-hero meta-premium-page-hero">
      <div class="meta-premium-page-hero-inner">
        <div class="admin-breadcrumb">
          <a href="/admin">Clients</a>
          <span aria-hidden="true"> / </span>
          <span>Meta reports</span>
        </div>
        <h1>Meta client reports</h1>
      </div>
    </div>
    <div class="admin-hub meta-reports-page">
      <div class="meta-hub-layout">
        <div id="meta-reports-banner">${renderMetaReportsBannerHtml(metaInfo)}</div>
        <div class="hub-toolbar-row">
          <div class="hub-search">
            ${ICON_SEARCH}
            <input type="search" id="meta-reports-search" placeholder="Search clients or ad account…" value="${esc(metaReportsState.searchQuery)}" autocomplete="off" />
          </div>
          <span class="hub-count" id="meta-reports-count">${clients.length} client${clients.length === 1 ? '' : 's'}</span>
          <div class="hub-toolbar-actions">
            <div class="meta-hub-filters" id="meta-reports-filters" role="tablist" aria-label="Filter clients">
              ${renderMetaHubFiltersHtml(metaReportsState.filter)}
            </div>
            <a class="admin-btn admin-btn--secondary" href="/admin/meta-reports/ghl-clients">Cenhub clients</a>
            <a class="admin-btn admin-btn--secondary" href="/admin/meta-reports/custom-values">Custom values</a>
            <button class="admin-btn admin-btn--secondary" type="button" id="meta-reports-refresh">${ICON_SYNC} Refresh</button>
          </div>
        </div>
        <div class="meta-hub-cards" id="meta-reports-cards">
          ${renderMetaReportsClientCards(clients, viewData.filter, viewData.searchQuery)}
        </div>
      </div>
    </div>
    `)}
  `;
}

function renderMetaReportsClientPage(payload) {
