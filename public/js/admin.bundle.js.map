  if (fallbackRightHtml !== undefined) {
    return renderBrandTopbar(fallbackRightHtml);
  }
  return renderBrandTopbar(IS_ADMIN ? '<a class="admin-topbar-link" href="/admin">Admin hub</a>' : '');
