          })()}
        </div>
        <div class="meta-report-toolbar-actions">
          ${payload.reportUrl ? `<button type="button" class="admin-btn admin-btn--secondary" id="meta-report-toolbar-copy-link" data-copy-report-url="${esc(payload.reportUrl)}"${settings.metaReportEnabled ? '' : ' disabled'}>Copy link</button>` : ''}
        </div>
      </div>
      ${renderMetaReportShareCard(payload)}
      <div class="meta-report-settings${metaReportsState.clientReportSettingsExpanded ? '' : ' is-collapsed'}">
        <div class="meta-report-settings-card-head">
          <span class="meta-report-settings-card-title">Report settings</span>
          <span class="meta-report-save-indicator" id="meta-report-save-indicator"><span class="meta-report-save-indicator-spinner"></span> Saving…</span>
        </div>
