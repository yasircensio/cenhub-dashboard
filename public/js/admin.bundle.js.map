async function fetchStaffMe() {
  const response = await fetch('/api/auth/me', { credentials: 'include' });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) return null;
  return data.user || null;
}

let staffPreviewSessionProbed = false;
async function probeStaffPreviewSession() {
  if (staffPreviewSessionProbed) return currentStaffUser;
  staffPreviewSessionProbed = true;
  try {
    currentStaffUser = await fetchStaffMe();
  } catch {
    currentStaffUser = null;
  }
  return currentStaffUser;
}

