function closeFbLeadRunPanel() {
  const mount = document.getElementById('fb-lead-run-panel-mount');
  if (mount) mount.innerHTML = '';
  fbLeadSyncState.activeRun = null;
}

function openFbLeadRunPanel(clientId, mode) {
  const client = fbLeadSyncState.clients.find((row) => row.clientId === clientId);
  if (!clientFbLeadFieldReady(client)) {
    showToast(getClientFbLeadFieldHint(client), 'error');
    return;
  }
  const mount = document.getElementById('fb-lead-run-panel-mount');
  if (!mount) return;
  fbLeadSyncState.activeRun = {
    clientId,
    mode,
    runId: null,
    previewOk: clientHasReadyPreview(fbLeadSyncState.clients.find((row) => row.clientId === clientId)),
  };
  mount.innerHTML = renderFbLeadRunPanel(clientId, mode);
  const previewBtn = document.getElementById('fb-lead-preview-btn');
  if (previewBtn) previewBtn.onclick = () => runFbLeadSyncBatch({ clientId, mode, dryRun: true });
  mount.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function renderFbLeadRunResults(summary) {
  const rows = summary.rows || [];
  if (!rows.length) {
    return `<div class="sync-history-empty" style="padding:12px">No rows in this batch.</div>`;
  }
  const body = rows.map((row) => `
    <tr>
      <td>${esc(row.email || row.phone || '—')}</td>
      <td><code>${esc(row.metaLeadId || '—')}</code></td>
      <td>${esc(row.contactId || '—')}</td>
      <td>${renderSyncStatusBadge(row.status)}</td>
    </tr>
  `).join('');
  const processed = summary.nextBatchOffset ?? ((summary.batchOffset || 0) + (summary.batchProcessed || 0));
  const total = summary.inWindow || processed;
  return `
    <div class="fb-lead-audit-scroll">
      <table class="sync-history-table">
        <thead><tr><th>Email / phone</th><th>Meta lead id</th><th>GHL contact</th><th>Status</th></tr></thead>
        <tbody>${body}</tbody>
      </table>
    </div>
    <p style="color:var(--text-soft);font-size:12px;margin-top:8px">
      ${processed} / ${total} leads scanned · ${summary.updated || 0} would update/updated · ${summary.errors || 0} errors
    </p>
  `;
}

function renderGlobalApplyProgress(clientId, mode, contactCount = 0) {
  const client = fbLeadSyncState.clients.find((row) => row.clientId === clientId);
  const modeLabel = mode === 'backfill' ? '90-day backfill' : 'recent sync';
  const countLabel = contactCount > 0 ? `${contactCount} contact(s)` : 'contacts';
  return `
    <div class="fb-lead-apply-progress-card" id="fb-lead-global-progress-card">
      <div class="fb-lead-apply-progress-header">
        <div>
          <strong>Writing to GHL — ${esc(modeLabel)}</strong>
          <div class="fb-lead-apply-progress-sub">${esc(client?.accountName || clientId)} · ${esc(countLabel)}</div>
        </div>
        <span class="fb-lead-badge is-ok" id="fb-lead-apply-status-badge">Running</span>
      </div>
      <div class="fb-lead-apply-progress-stats" id="fb-lead-global-progress-stats">Preparing…</div>
      <div class="fb-lead-progress is-visible is-indeterminate" id="fb-lead-global-progress">
        <div class="fb-lead-progress-bar" id="fb-lead-global-progress-bar"></div>
      </div>
      <div class="fb-lead-progress-label" id="fb-lead-global-progress-label">Starting apply — do not close this page</div>
    </div>
  `;
}

function startGlobalApplyProgress(clientId, mode, contactCount = 0) {
  const mount = document.getElementById('fb-lead-apply-progress-mount');
  if (!mount) return;
  fbLeadSyncState.isApplying = true;
  fbLeadSyncState.applyStartedAt = Date.now();
  fbLeadSyncState.applyProgress = null;
  mount.innerHTML = renderGlobalApplyProgress(clientId, mode, contactCount);
  mount.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  if (fbLeadSyncState.applyWaitTimer) clearInterval(fbLeadSyncState.applyWaitTimer);
  fbLeadSyncState.applyWaitTimer = window.setInterval(() => {
    if (!fbLeadSyncState.isApplying) return;
    const elapsed = Math.floor((Date.now() - fbLeadSyncState.applyStartedAt) / 1000);
    const saved = fbLeadSyncState.applyProgress;
    if (saved?.total > 0) {
      updateGlobalApplyProgress({ ...saved, waiting: true, elapsed });
    } else {
      updateGlobalApplyProgress({ waiting: true, elapsed });
    }
  }, 1000);
}

function updateGlobalApplyProgress({
  processed,
  total,
  written,
  waiting = false,
  elapsed = 0,
  complete = false,
  error = '',
} = {}) {
  const card = document.getElementById('fb-lead-global-progress-card');
  const progress = document.getElementById('fb-lead-global-progress');
  const bar = document.getElementById('fb-lead-global-progress-bar');
  const label = document.getElementById('fb-lead-global-progress-label');
  const stats = document.getElementById('fb-lead-global-progress-stats');
  const badge = document.getElementById('fb-lead-apply-status-badge');
  if (!card || !progress || !bar || !label) return;

  const prev = fbLeadSyncState.applyProgress || {};
  const nextProcessed = processed ?? prev.processed ?? 0;
  const nextTotal = total ?? prev.total ?? 0;
  const nextWritten = written ?? prev.written ?? 0;

  if (!complete && !error && (nextTotal > 0 || nextProcessed > 0)) {
    fbLeadSyncState.applyProgress = {
      processed: nextProcessed,
      total: nextTotal,
      written: nextWritten,
    };
  }

  const hasProgress = nextTotal > 0 || nextProcessed > 0;

  if (waiting && !hasProgress && !complete) {
    progress.classList.add('is-indeterminate');
    bar.style.width = '35%';
    if (stats) stats.textContent = 'Contacting Meta and GHL…';
    label.textContent = `Writing to GHL… (${elapsed}s — do not close this page)`;
    return;
  }

  progress.classList.remove('is-indeterminate');
  const pct = nextTotal > 0
    ? Math.min(100, Math.round((nextProcessed / nextTotal) * 100))
    : (complete ? 100 : 0);
  bar.style.width = `${pct}%`;
  if (stats) {
    stats.textContent = complete
      ? `${nextWritten} written to GHL · ${nextProcessed} / ${nextTotal} contacts processed`
      : `${nextWritten} written · ${nextProcessed} / ${nextTotal} contacts (${pct}%)`;
  }
  if (complete) {
    card.classList.add('is-complete');
    card.classList.remove('is-error');
    label.textContent = `Complete — ${nextWritten} contact(s) updated in GHL`;
    if (badge) {
      badge.textContent = 'Complete';
      badge.classList.add('is-ok');
      badge.classList.remove('is-missing');
    }
  } else if (error) {
    card.classList.add('is-error');
    card.classList.remove('is-complete');
    label.textContent = error;
    if (badge) {
      badge.textContent = 'Failed';
      badge.classList.remove('is-ok');
      badge.classList.add('is-missing');
    }
  } else if (waiting && hasProgress) {
    label.textContent = nextProcessed >= nextTotal
      ? `Finishing up… (${elapsed}s)`
      : `Batch in progress — ${nextProcessed} / ${nextTotal} leads (${pct}%) · ${elapsed}s`;
  } else {
    label.textContent = `Writing to GHL — ${nextProcessed} / ${nextTotal} leads (${pct}%)`;
  }
}

function stopGlobalApplyProgress({ success = true, keepVisibleMs = 6000 } = {}) {
  fbLeadSyncState.isApplying = false;
  fbLeadSyncState.applyProgress = null;
  if (fbLeadSyncState.applyWaitTimer) {
    clearInterval(fbLeadSyncState.applyWaitTimer);
    fbLeadSyncState.applyWaitTimer = null;
  }
  window.setTimeout(() => {
    const mount = document.getElementById('fb-lead-apply-progress-mount');
    if (mount && !fbLeadSyncState.isApplying) mount.innerHTML = '';
  }, keepVisibleMs);
}

function setFbLeadProgress({ processed = 0, total = 0, complete = false, label = '' } = {}) {
  const wrap = document.getElementById('fb-lead-progress-wrap');
  const progressBar = document.getElementById('fb-lead-progress-bar');
  const progressLabel = document.getElementById('fb-lead-progress-label');
  if (!wrap || !progressBar) return;
  wrap.hidden = false;
  wrap.classList.toggle('is-complete', complete);
  const pct = total > 0 ? Math.min(100, Math.round((processed / total) * 100)) : (complete ? 100 : 0);
  progressBar.style.width = `${pct}%`;
  if (progressLabel) {
    progressLabel.textContent = label
      || (complete
        ? `Complete — ${processed} / ${total} leads (${pct}%)`
        : `Processing — ${processed} / ${total} leads (${pct}%)`);
  }
}

function hideFbLeadProgress(reset = true) {
  const wrap = document.getElementById('fb-lead-progress-wrap');
  const progressBar = document.getElementById('fb-lead-progress-bar');
  if (!wrap) return;
  if (reset) {
    wrap.hidden = true;
    wrap.classList.remove('is-complete');
    if (progressBar) progressBar.style.width = '0%';
  }
}

function updateFbLeadHistoryClearButton() {
  const clearBtn = document.getElementById('fb-lead-history-clear-all');
  if (!clearBtn) return;
  const hasRuns = (fbLeadSyncState.historyRuns || []).length > 0;
  clearBtn.disabled = !hasRuns;
}

function updateFbLeadCronSummaryUi() {
  const mount = document.getElementById('fb-lead-cron-summary-24h');
  if (!mount || !fbLeadSyncState.cronSummary24h) return;
  mount.outerHTML = renderFbLeadCronSummary24h(fbLeadSyncState.cronSummary24h);
}

async function refreshFbLeadHistoryUi() {
  await loadFbLeadHistory();
  const historyMount = document.getElementById('fb-lead-history-mount');
  if (!historyMount) return;
  const locationByClient = Object.fromEntries(
    fbLeadSyncState.clients.map((row) => [row.clientId, row.locationId]),
  );
  historyMount.innerHTML = renderFbLeadHistoryRows(fbLeadSyncState.historyRuns, locationByClient);
  updateFbLeadHistoryClearButton();
}

function bindFbLeadHistoryClearButton() {
  const clearBtn = document.getElementById('fb-lead-history-clear-all');
  if (clearBtn) clearBtn.onclick = () => clearFbLeadSyncHistory();
  const routineToggle = document.getElementById('fb-lead-show-routine-cron');
  if (routineToggle) {
    routineToggle.checked = fbLeadSyncState.showRoutineCronRuns;
    routineToggle.onchange = () => {
      fbLeadSyncState.showRoutineCronRuns = routineToggle.checked;
      const historyMount = document.getElementById('fb-lead-history-mount');
      if (!historyMount) return;
      const locationByClient = Object.fromEntries(
        fbLeadSyncState.clients.map((row) => [row.clientId, row.locationId]),
      );
      historyMount.innerHTML = renderFbLeadHistoryRows(fbLeadSyncState.historyRuns, locationByClient);
    };
  }
  updateFbLeadHistoryClearButton();
}

async function clearFbLeadSyncHistory() {
  if (!isStaffAdmin()) return;
  const confirmed = window.confirm(
    'Delete all FB lead sync run history?\n\nThis only clears the log — it does not change GHL contacts or Meta data.',
  );
  if (!confirmed) return;
  try {
    const result = await adminFetch('/api/fb-lead-sync/history', { method: 'DELETE' });
    showToast(`Cleared ${result.deleted || 0} run(s).`, 'success');
    await refreshFbLeadHistoryUi();
    await loadFbLeadSyncPage({ silent: true });
  } catch (error) {
    showToast(error.message || 'Failed to clear FB lead sync log.', 'error');
  }
}

async function deleteFbLeadRun(runId) {
  if (!isStaffAdmin()) return;
  const confirmed = window.confirm(`Delete run #${runId} from history?`);
  if (!confirmed) return;
  try {
    await adminFetch(`/api/fb-lead-sync/history/${runId}`, { method: 'DELETE' });
    showToast('Run deleted.', 'success');
    await refreshFbLeadHistoryUi();
    await loadFbLeadSyncPage({ silent: true });
  } catch (error) {
    showToast(error.message || 'Failed to delete run.', 'error');
  }
}

async function runFbLeadSyncBatch({ clientId, mode, dryRun, resumeRunId = null }) {
  const previewBtn = document.getElementById('fb-lead-preview-btn');
  const resultsMount = document.getElementById('fb-lead-run-results');
  if (previewBtn) previewBtn.disabled = true;

  const batchLimit = dryRun ? 12 : 10;
  const resumeRun = resumeRunId != null
    ? fbLeadSyncState.historyRuns.find((row) => Number(row.id) === Number(resumeRunId))
    : null;
  let runId = resumeRun?.id || fbLeadSyncState.activeRun?.runId || null;
  let offset = resumeRun ? (Number(resumeRun.batchOffset) || 0) : 0;
  let lastSummary = null;
  let allRows = [];
  let completed = false;
  const applyRunId = resumeRunId ?? fbLeadSyncState.activeRun?.previewRunId ?? null;
  const previewRun = applyRunId != null
    ? fbLeadSyncState.historyRuns.find((row) => Number(row.id) === Number(applyRunId))
    : null;
  const expectedContacts = resumeRun
    ? partialSyncRemaining(resumeRun)
    : (previewRun?.updated
      ?? fbLeadSyncState.previewOkByClient[clientId]?.updated
      ?? 0);

  if (!dryRun) {
    fbLeadSyncState.applyingRunId = applyRunId;
    startGlobalApplyProgress(clientId, mode, expectedContacts);
    await refreshFbLeadHistoryUi();
  }

  try {
    if (!resumeRunId) {
      const partial = findPartialSyncRun(clientId, mode, dryRun);
      if (partial) {
        const remaining = partialSyncRemaining(partial);
        const label = dryRun ? 'preview' : 'apply';
        const confirmed = window.confirm(
          `A ${label} for ${clientId} was interrupted (${partial.updated || 0} processed, ${remaining} remaining).\n\n`
          + `Resume the interrupted ${label}?`,
        );
        if (confirmed) {
          runId = partial.id;
          offset = Number(partial.batchOffset) || 0;
        }
      }
    }

    if (dryRun) {
      setFbLeadProgress({ processed: offset, total: 0, label: offset > 0 ? 'Resuming preview…' : 'Fetching Meta leads…' });
    } else {
      updateGlobalApplyProgress({ waiting: true, elapsed: 0 });
    }

    if (dryRun && offset === 0) {
      const prepared = await adminFetchWithRetry('/api/fb-lead-sync/prepare', {
        method: 'POST',
        body: JSON.stringify({
          clientId,
          mode,
          dryRun,
          runId,
        }),
      });
      const prep = prepared.summary || prepared;
      runId = prep.runId;
      offset = 0;
      setFbLeadProgress({
        processed: 0,
        total: prep.inWindow || 0,
        label: `Matching ${prep.inWindow || 0} Meta leads to GHL…`,
      });
    } else if (!dryRun && offset === 0) {
      updateGlobalApplyProgress({
        waiting: false,
        processed: 0,
        total: expectedContacts || previewRun?.updated || 0,
      });
    }

    do {
      lastSummary = await adminFetchWithRetry('/api/fb-lead-sync/run', {
        method: 'POST',
        body: JSON.stringify({
          clientId,
          mode,
          dryRun,
          runId,
          previewRunId: dryRun ? null : applyRunId,
          batchOffset: offset,
          batchLimit,
        }),
      });
      const summary = lastSummary.summary || lastSummary;
      runId = summary.runId;
      offset = summary.nextBatchOffset ?? (summary.batchOffset + (summary.batchProcessed || 0));
      allRows = allRows.concat(summary.rows || []);
      if (fbLeadSyncState.activeRun) {
        fbLeadSyncState.activeRun.runId = runId;
      }
      const total = summary.inWindow || offset || expectedContacts;
      if (dryRun) {
        setFbLeadProgress({
          processed: offset,
          total,
          complete: !summary.hasMore,
        });
        if (resultsMount) {
          resultsMount.innerHTML = renderFbLeadRunResults({ ...summary, rows: allRows });
        }
      } else {
        updateGlobalApplyProgress({
          processed: offset,
          total,
          written: summary.updated || 0,
          complete: !summary.hasMore,
        });
      }
    } while ((lastSummary.summary || lastSummary).hasMore);

    completed = true;
    const finalSummary = lastSummary.summary || lastSummary;
    const finalTotal = finalSummary.inWindow || offset || expectedContacts;
    const finalProcessed = finalSummary.nextBatchOffset ?? offset;

    if (dryRun) {
      setFbLeadProgress({
        processed: finalProcessed,
        total: finalTotal,
        complete: true,
      });
      markFbLeadPreviewReady(clientId, mode, finalSummary.updated);
      if (fbLeadSyncState.activeRun) {
        fbLeadSyncState.activeRun.previewOk = (finalSummary.updated || 0) > 0;
      }
      showToast(
        (finalSummary.updated || 0) > 0
          ? 'Preview complete — use Apply in Run history below.'
          : 'Preview complete — all contacts already have Fb Lead id. Nothing to apply.',
        'success',
      );
      await refreshFbLeadHistoryUi();
      document.getElementById('fb-lead-history-mount')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      updateGlobalApplyProgress({
        processed: finalProcessed,
        total: finalTotal,
        written: finalSummary.updated || 0,
        complete: true,
      });
      delete fbLeadSyncState.previewOkByClient[clientId];
      try {
        const stored = JSON.parse(sessionStorage.getItem('fbLeadSyncPreviewOk') || '{}');
        delete stored[clientId];
        sessionStorage.setItem('fbLeadSyncPreviewOk', JSON.stringify(stored));
      } catch {
        // ignore
      }
      showToast('FB lead sync complete — Fb Lead id written to GHL', 'success');
      stopGlobalApplyProgress({ success: true });
    }
    await refreshFbLeadHistoryUi();
    const dash = await adminFetch('/api/fb-lead-sync');
    fbLeadSyncState.clients = dash.clients || [];
    hydrateFbLeadPreviewState(fbLeadSyncState.clients);
    await refreshFbLeadClientRowsUi();
  } catch (error) {
    if (dryRun) {
      hideFbLeadProgress(true);
    } else {
      updateGlobalApplyProgress({
        error: `Failed — ${error.message || 'Apply failed'}`,
      });
      stopGlobalApplyProgress({ success: false, keepVisibleMs: 12000 });
    }
    showToast(
      (error.message || (dryRun ? 'FB lead preview failed.' : 'FB lead apply failed.'))
      + (dryRun ? ' Partial progress is saved — use Resume in Run history or try Preview again.' : ' Partial progress is saved — use Resume in Run history.'),
      'error',
    );
    await refreshFbLeadHistoryUi();
  } finally {
    if (previewBtn) previewBtn.disabled = false;
    fbLeadSyncState.applyingRunId = null;
    if (!completed && dryRun) {
      hideFbLeadProgress(true);
    }
    if (!dryRun && !completed) {
      fbLeadSyncState.isApplying = false;
      await refreshFbLeadHistoryUi();
    }
  }
}

async function expandFbLeadRun(runId) {
  const row = document.getElementById(`fb-lead-run-audit-${runId}`);
  if (!row) return;
  if (!row.hidden) {
    row.hidden = true;
    return;
  }
  try {
    const data = await adminFetch(`/api/fb-lead-sync/history/${runId}`);
    const client = fbLeadSyncState.clients.find((item) => item.clientId === data.run.clientId);
    row.innerHTML = `<td colspan="7"><div class="fb-lead-audit-scroll" id="fb-lead-audit-scroll-${runId}">${renderFbLeadAuditTable(data.run.rows || [], data.run.locationId || client?.locationId)}</div></td>`;
    row.hidden = false;
    const scrollHost = document.getElementById(`fb-lead-audit-scroll-${runId}`);
    if (scrollHost) {
      scrollHost.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  } catch (error) {
    showToast(error.message || 'Failed to load run audit.', 'error');
  }
}

function viewFbLeadClientHistory(clientId) {
  const filtered = getFbLeadHistoryRunsForDisplay(
    fbLeadSyncState.historyRuns.filter((run) => run.clientId === clientId),
  );
  const historyMount = document.getElementById('fb-lead-history-mount');
  if (!historyMount) return;
  const locationByClient = Object.fromEntries(
    fbLeadSyncState.clients.map((row) => [row.clientId, row.locationId]),
  );
  historyMount.innerHTML = filtered.length
    ? renderFbLeadHistoryRows(filtered, locationByClient)
    : `<div class="sync-history-empty">No runs for ${esc(clientId)} yet.</div>`;
  historyMount.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

async function loadFbLeadSyncPage({ silent = false, fullPreflight = false } = {}) {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard) return;

  const user = await fetchStaffMe();
  if (!user) {
    if (!silent) {
      dashboard.innerHTML = `
        ${renderBrandTopbar('')}
        ${wrapDashboardShell(`
          <div class="page-hero admin-hub-hero"><h1>FB lead sync</h1><p>Sign in to manage FB lead ID sync.</p></div>
          <div class="sync-history-page">
            <div class="sync-history-empty" style="padding:24px;text-align:center">
              <a class="admin-btn admin-btn--primary" href="/login?next=${encodeURIComponent(`${window.location.pathname}${window.location.search}`)}">Sign in</a>
            </div>
          </div>
        `)}
      `;
    }
    return;
  }
  currentStaffUser = user;

  if (!silent) {
    dashboard.innerHTML = `
      ${renderBrandTopbar(renderStaffAdminChrome('fb-lead-sync'))}
      ${wrapDashboardShell('<div class="loading-state"><div class="spinner"></div><p>Loading FB lead sync...</p></div>')}
    `;
  }

  try {
    if (silent && fbLeadSyncState.isApplying) return;

    const [data] = await Promise.all([
      adminFetch('/api/fb-lead-sync'),
      loadFbLeadHistory(),
    ]);
    fbLeadSyncState.clients = data.clients || [];
    fbLeadSyncState.cronSummary24h = data.summary?.cronSummary24h || null;
    hydrateFbLeadPreviewState(fbLeadSyncState.clients);

    if (!silent) {
      dashboard.innerHTML = renderFbLeadSyncPage(data);
      bindFbLeadSyncToggles();
      const refreshBtn = document.getElementById('fb-lead-sync-refresh');
      if (refreshBtn) {
        refreshBtn.onclick = () => loadFbLeadSyncPage({ fullPreflight: true });
      }
      bindFbLeadHistoryClearButton();
      if (fbLeadSyncRefreshTimer) {
        clearInterval(fbLeadSyncRefreshTimer);
        fbLeadSyncRefreshTimer = null;
      }
      fbLeadSyncRefreshTimer = window.setInterval(() => {
        loadFbLeadSyncPage({ silent: true }).catch(() => {});
      }, 60_000);
    }

    if (!silent || fullPreflight) {
      await loadFbLeadPreflightForClients(fbLeadSyncState.clients, { quick: !fullPreflight });
    }
    if (silent) {
      updateFbLeadCronSummaryUi();
      await refreshFbLeadHistoryUi();
      await refreshFbLeadClientRowsUi();
    } else {
      await refreshFbLeadClientRowsUi();
    }

    if (fullPreflight) {
      await loadFbLeadPreflightForClients(fbLeadSyncState.clients, { quick: false });
      await refreshFbLeadClientRowsUi();
    } else if (!silent) {
      scheduleFbLeadFullPreflight(fbLeadSyncState.clients);
    }
  } catch (error) {
    if (!silent) {
      dashboard.innerHTML = `
        ${renderBrandTopbar(renderStaffAdminChrome('fb-lead-sync'))}
        ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
      `;
    }
  }
}

const metaReportsState = {
  filter: 'all',
  searchQuery: '',
  dashboardData: null,
  hubMounted: false,
  clientPayload: null,
  clientPageMounted: false,
  activeMonthKey: null,
  selectedYear: new Date().getFullYear(),
  publicPayload: null,
  publicPageMounted: false,
};

const META_HUB_FILTER_OPTIONS = [
  { value: 'all', label: 'All' },
  { value: 'enabled', label: 'Live reports' },
  { value: 'meta-only', label: 'Meta only' },
  { value: 'needs-setup', label: 'Needs setup' },
];

function metaHubClientInitial(name) {
  const trimmed = String(name || '?').trim();
  return esc(trimmed.charAt(0).toUpperCase());
}

function filterMetaReportsClients(clients, filter, searchQuery = '') {
  let list = clients || [];
  if (filter === 'enabled') list = list.filter((client) => client.metaReportEnabled);
  if (filter === 'meta-only') list = list.filter((client) => !client.hasGhl);
  if (filter === 'needs-setup') list = list.filter((client) => client.needsSetup);
  const query = String(searchQuery || '').trim().toLowerCase();
  if (query) {
    list = list.filter((client) => {
      const haystack = [
        client.accountName,
        client.metaAdAccountId,
        client.clientId,
        client.metaName,
      ].filter(Boolean).join(' ').toLowerCase();
      return haystack.includes(query);
    });
  }
  return list;
}

function getMetaReportsHubView(dashboardData, filter, searchQuery = metaReportsState.searchQuery) {
  const allClients = dashboardData?.clients || [];
  const clients = filterMetaReportsClients(allClients, filter, searchQuery);
  const summary = dashboardData?.summary || {};
  return {
    clients,
    allClients,
    summary: {
      ...summary,
      totalListed: allClients.length,
    },
    meta: dashboardData?.meta || {},
    filter,
    searchQuery,
  };
}

function renderMetaHubSwitch({ label, attr, value, checked, disabled = false }) {
  if (!value) return `<div class="meta-hub-switch is-disabled"><span class="meta-hub-switch-label">${esc(label)}</span><span class="meta-report-muted">—</span></div>`;
  return `
    <label class="meta-hub-switch${disabled ? ' is-disabled' : ''}">
      <span class="meta-hub-switch-label">${esc(label)}</span>
      <span class="meta-hub-switch-track">
        <input type="checkbox" class="meta-hub-switch-input" ${attr}="${esc(value)}" ${checked ? 'checked' : ''} ${disabled ? 'disabled' : ''} aria-label="${esc(label)}" />
        <span class="meta-hub-switch-thumb"></span>
      </span>
    </label>
  `;
}

function renderMetaReportHubCard(client) {
  const canEdit = Boolean(client.clientId);
  const rowKey = client.clientId || client.metaAdAccountId || '';
  const cardClass = client.needsSetup ? 'is-setup' : '';
  const statusBadge = client.needsSetup
    ? '<span class="meta-report-badge meta-report-badge--setup">Needs setup</span>'
    : (client.metaReportEnabled
      ? '<span class="meta-report-badge meta-report-badge--on">Report live</span>'
      : '<span class="meta-report-badge meta-report-badge--off">Report off</span>');
  const typeLabel = client.hasGhl ? 'GHL + Meta' : 'Meta only';
  const nameMarkup = canEdit
    ? `<a href="/admin/meta-reports/${encodeURIComponent(client.clientId)}" class="meta-hub-card-name">${esc(client.accountName)}</a>`
    : `<span class="meta-hub-card-name">${esc(client.accountName)}</span>`;

  const actionButtons = [];
  if (client.needsSetup) {
    actionButtons.push(`<button type="button" class="admin-btn admin-btn--primary" data-meta-provision="${esc(client.metaAdAccountId)}" data-meta-provision-name="${esc(client.accountName)}">Add client</button>`);
  } else if (canEdit) {
    actionButtons.push(`<a class="admin-btn" href="/admin/meta-reports/${encodeURIComponent(client.clientId)}">Edit report</a>`);
    actionButtons.push(client.reportUrl
      ? `<button type="button" class="admin-btn admin-btn--secondary" data-copy-report-url="${esc(client.reportUrl)}">Copy link</button>`
      : `<a class="admin-btn admin-btn--secondary" href="/admin/meta-reports/${encodeURIComponent(client.clientId)}">Enable report</a>`);
  }
  const actionsClass = actionButtons.length === 1 ? 'meta-hub-card-actions meta-hub-card-actions--single' : 'meta-hub-card-actions';

  return `
    <article class="meta-hub-card ${cardClass}" data-meta-hub-row="${esc(rowKey)}">
      <div class="meta-hub-card-head">
        <span class="meta-hub-avatar" aria-hidden="true">${metaHubClientInitial(client.accountName)}</span>
        <div class="meta-hub-card-title">
          ${nameMarkup}
          <div class="meta-hub-card-slug">act_${esc(client.metaAdAccountId || '—')}</div>
        </div>
      </div>
      <div class="meta-hub-card-meta">
        ${statusBadge}
        <span class="meta-hub-card-meta-dot" aria-hidden="true">·</span>
        <span>${esc(typeLabel)}</span>
      </div>
      <div class="meta-hub-card-toggles">
        ${renderMetaHubSwitch({
          label: 'Report',
          attr: 'data-meta-report-enabled',
          value: canEdit ? client.clientId : null,
          checked: client.metaReportEnabled,
        })}
        ${renderMetaHubSwitch({
          label: 'Bottomline',
          attr: 'data-meta-bottomline',
          value: canEdit ? client.clientId : null,
          checked: client.metaReportShowBottomline,
          disabled: !client.metaReportEnabled,
        })}
        ${renderMetaHubSwitch({
          label: 'Censio fee',
          attr: 'data-meta-fee',
          value: canEdit ? client.clientId : null,
          checked: client.metaReportFeeEnabled,
          disabled: !client.metaReportEnabled,
        })}
      </div>
      ${actionButtons.length ? `<div class="${actionsClass}">${actionButtons.join('')}</div>` : ''}
    </article>
  `;
}

function renderMetaReportsClientCards(clients, filter = 'all', searchQuery = '') {
  if (!clients.length) {
    const message = searchQuery
      ? `No clients match “${searchQuery}”.`
      : (filter === 'all'
        ? 'No Meta ad accounts found. Check META_SYSTEM_USER_TOKEN and META_BUSINESS_ID, or add clients manually.'
        : 'No clients match this filter.');
    return `
      <div class="meta-hub-empty">
        <h3>No clients to show</h3>
        <p>${esc(message)}</p>
      </div>
    `;
  }
  return clients.map((client) => renderMetaReportHubCard(client)).join('');
}

function renderMetaReportsBannerHtml(metaInfo) {
  if (!metaInfo?.partnerFetchError) return '';
  return `
    <div class="meta-hub-banner">
      <strong>Meta Business Manager listing unavailable</strong>
      ${esc(metaInfo.partnerFetchError)} Showing only clients already configured in the app.
    </div>
  `;
}

function renderMetaHubFiltersHtml(activeFilter) {
  return META_HUB_FILTER_OPTIONS.map((option) => `
    <button
      type="button"
      class="meta-hub-filter${activeFilter === option.value ? ' is-active' : ''}"
      data-meta-filter="${esc(option.value)}"
    >${esc(option.label)}</button>
  `).join('');
}

function recomputeMetaReportsSummaryCounts() {
  const all = metaReportsState.dashboardData?.clients || [];
  const summary = metaReportsState.dashboardData?.summary || {};
  metaReportsState.dashboardData.summary = {
    ...summary,
    inAppCount: all.filter((client) => client.inApp).length,
    enabledCount: all.filter((client) => client.metaReportEnabled).length,
    needsSetupCount: all.filter((client) => client.needsSetup).length,
    totalListed: all.length,
  };
}

function mergeHubClient(clientId, patch) {
  const all = metaReportsState.dashboardData?.clients;
  if (!all) return null;
  const index = all.findIndex((client) => client.clientId === clientId);
  if (index < 0) return null;
  all[index] = { ...all[index], ...patch };
  recomputeMetaReportsSummaryCounts();
  return all[index];
}

function updateMetaReportsHubDom(viewData) {
  const bannerEl = document.getElementById('meta-reports-banner');
  const cardsEl = document.getElementById('meta-reports-cards');
  const countEl = document.getElementById('meta-reports-count');
  if (bannerEl) bannerEl.innerHTML = renderMetaReportsBannerHtml(viewData.meta);
  if (countEl) countEl.textContent = `${viewData.clients.length} client${viewData.clients.length === 1 ? '' : 's'}`;
  if (cardsEl) {
    cardsEl.innerHTML = renderMetaReportsClientCards(viewData.clients, viewData.filter, viewData.searchQuery);
    bindMetaReportsHubRowEvents(cardsEl);
  }
}

function renderMetaReportsClientTabs(payload) {
  const monthKeys = payload.monthKeys || [];
  const activeKey = metaReportsState.activeMonthKey || monthKeys[monthKeys.length - 1] || '';
  return monthKeys.map((key) => `
    <button type="button" class="meta-report-tab${key === activeKey ? ' is-active' : ''}" data-meta-month-tab="${esc(key)}">${esc(metaMonthLabel(key))}</button>
  `).join('');
}

function refreshMetaReportMonthPanel(monthPayload) {
  const payload = metaReportsState.clientPayload;
  if (!payload || !metaReportsState.activeMonthKey) return;
  payload.months = payload.months || {};
  payload.months[metaReportsState.activeMonthKey] = monthPayload;
  const panel = document.getElementById('meta-report-month-panel');
  if (!panel) return;
  panel.innerHTML = renderMetaReportMonthBody(monthPayload, {
    editable: true,
    showOtherToClient: payload.settings?.metaReportShowOther !== false,
  });
  bindMetaReportsClientEditEvents(payload.clientId, payload);
  refreshMetaReportBackfillControl(payload);
}

function refreshMetaReportBackfillControl(payload) {
  const toolbarLeft = document.querySelector('.meta-report-client-page .meta-report-toolbar-left');
  const wrap = document.querySelector('.meta-report-backfill-wrap');
  const missing = metaReportMonthsNeedingBackfill(payload);
  if (!missing.length) {
    if (wrap) wrap.remove();
    return;
  }
  const label = `${ICON_SYNC} Backfill ${missing.length} month${missing.length === 1 ? '' : 's'} from Meta`;
  const btn = document.getElementById('meta-report-backfill');
  if (btn) {
    btn.innerHTML = label;
    btn.disabled = false;
  } else if (toolbarLeft) {
    const div = document.createElement('div');
    div.className = 'meta-report-backfill-wrap';
    div.innerHTML = `
      <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="meta-report-backfill">${label}</button>
      <span class="meta-report-backfill-progress" id="meta-report-backfill-progress"></span>
    `;
    toolbarLeft.appendChild(div);
    bindMetaReportBackfillButton(payload.clientId);
  }
}

function updateMetaReportsClientContent(payload) {
  metaReportsState.clientPayload = payload;
  const monthKeys = payload.monthKeys || [];
  if (!metaReportsState.activeMonthKey) {
    metaReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  } else if (!monthKeys.includes(metaReportsState.activeMonthKey)) {
    metaReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  }

  const yearSelect = document.getElementById('meta-report-year');
  if (yearSelect) {
    const years = [payload.year, payload.year - 1].filter((value, index, arr) => arr.indexOf(value) === index);
    yearSelect.innerHTML = years.map((year) => `
      <option value="${year}"${Number(metaReportsState.selectedYear) === Number(year) ? ' selected' : ''}>${year}</option>
    `).join('');
  }

  const copyBtn = document.getElementById('meta-report-copy-link');
  if (payload.reportUrl) {
    if (copyBtn) {
      copyBtn.setAttribute('data-copy-report-url', payload.reportUrl);
      copyBtn.hidden = false;
    }
  } else if (copyBtn) {
    copyBtn.hidden = true;
  }

  const settings = payload.settings || {};
  const bottomlineToggle = document.getElementById('meta-report-setting-bottomline');
  const feeToggle = document.getElementById('meta-report-setting-fee');
  const feePercent = document.getElementById('meta-report-setting-fee-percent');
  if (bottomlineToggle) bottomlineToggle.checked = Boolean(settings.metaReportShowBottomline);
  if (feeToggle) feeToggle.checked = Boolean(settings.metaReportFeeEnabled);
  if (feePercent) feePercent.value = settings.metaReportFeePercent ?? 20;
  syncMetaReportFeeFieldState(Boolean(settings.metaReportFeeEnabled));

  const tabsEl = document.querySelector('.meta-report-tabs');
  if (tabsEl) {
    tabsEl.innerHTML = renderMetaReportsClientTabs(payload);
    bindMetaReportsClientTabEvents(payload);
  }

  const panel = document.getElementById('meta-report-month-panel');
  if (panel) {
    panel.innerHTML = renderMetaReportMonthBody(
      payload.months?.[metaReportsState.activeMonthKey],
      { editable: true, showOtherToClient: settings.metaReportShowOther !== false },
    );
    bindMetaReportsClientEditEvents(payload.clientId, payload);
  }
  refreshMetaReportBackfillControl(payload);
}

function updatePublicMetaReportContent(payload) {
  metaReportsState.publicPayload = payload;
  const monthKeys = payload.monthKeys || [];
  if (!metaReportsState.activeMonthKey) {
    metaReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  } else if (!monthKeys.includes(metaReportsState.activeMonthKey)) {
    metaReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  }

  const yearSelect = document.getElementById('meta-report-year');
  if (yearSelect) {
    const years = [payload.year, payload.year - 1].filter((value, index, arr) => arr.indexOf(value) === index);
    yearSelect.innerHTML = years.map((year) => `
      <option value="${year}"${Number(metaReportsState.selectedYear) === Number(year) ? ' selected' : ''}>${year}</option>
    `).join('');
  }

  const tabsEl = document.querySelector('.meta-report-tabs');
  if (tabsEl) {
    tabsEl.innerHTML = monthKeys.map((key) => `
      <button type="button" class="meta-report-tab${key === metaReportsState.activeMonthKey ? ' is-active' : ''}" data-meta-month-tab="${esc(key)}">${esc(metaMonthLabel(key))}</button>
    `).join('');
    bindPublicMetaReportTabEvents(payload);
  }

  const panel = document.getElementById('meta-report-month-panel');
  if (panel) {
    panel.innerHTML = renderMetaReportMonthBody(payload.months?.[metaReportsState.activeMonthKey], {
      editable: false,
      showOtherToClient: payload.settings?.metaReportShowOther !== false,
    });
  }
}

const META_MONTH_LABELS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function metaFmtKr(value) {
  const amount = Number(value) || 0;
  return `Dkr ${amount.toLocaleString('da-DK', { minimumFractionDigits: 0, maximumFractionDigits: 2 })}`;
}

function metaFmtNum(value, digits = 0) {
  const amount = Number(value) || 0;
  return amount.toLocaleString('da-DK', { minimumFractionDigits: digits, maximumFractionDigits: digits });
}

function metaFmtX(value) {
  const amount = Number(value) || 0;
  return amount > 0 ? `${amount.toFixed(2)}x` : '—';
}

function metaMonthLabel(monthKey) {
  const month = Number(String(monthKey || '').slice(5, 7));
  return META_MONTH_LABELS[month - 1] || monthKey;
}

function metaReportMonthsNeedingBackfill(payload) {
  const monthKeys = payload?.monthKeys || [];
  return monthKeys.filter((key) => !payload.months?.[key]?.metaFetchedAt);
}

function renderMetaReportHighlightStrip(monthPayload) {
  if (!monthPayload || monthPayload.meta?.emptyMonth) return '';
  const items = [
    ['Ad spend', metaFmtKr(monthPayload.meta?.spend)],
    ['Leads', metaFmtNum(monthPayload.topline?.leads)],
    ['Return on ad spend', metaFmtX(monthPayload.topline?.roasX)],
  ];
  if (monthPayload.bottomline) {
    const useFee = monthPayload.bottomline.censioFee > 0;
    items.push([
      useFee ? 'Profit on investment' : 'Profit on ad spend',
      metaFmtKr(useFee ? monthPayload.bottomline.poiKr : monthPayload.bottomline.poasKr),
    ]);
  } else {
    items.push(['Won leads', metaFmtNum(monthPayload.topline?.wonLeads)]);
  }
  return `
    <div class="meta-report-highlight-strip">
      ${items.map(([label, value]) => `
        <div class="meta-report-highlight-item">
          <div class="meta-report-highlight-value">${esc(value)}</div>
          <div class="meta-report-highlight-label">${esc(label)}</div>
        </div>
      `).join('')}
    </div>
  `;
}

function renderMetaReportMetricTable(title, rows, accent = 'meta', { badge = '', highlightLastN = 0 } = {}) {
  const rowsHtml = rows.map(([label, value, unit], index) => {
    const isHighlight = highlightLastN > 0 && index >= rows.length - highlightLastN;
    return `
      <tr class="${isHighlight ? `is-highlight accent-${accent}` : ''}">
        <th scope="row">${esc(label)}</th>
        <td>${esc(String(value ?? '—'))}${unit ? `<span class="meta-report-row-unit">${esc(unit)}</span>` : ''}</td>
      </tr>
    `;
  }).join('');
  return `
    <section class="meta-report-group">
      <div class="meta-report-group-head">
        <span class="meta-report-group-bar meta-report-group-bar--${accent}" aria-hidden="true"></span>
        <h3 class="meta-report-group-title">${esc(title)}</h3>
        ${badge ? `<span class="meta-report-group-badge">${esc(badge)}</span>` : ''}
      </div>
      <div class="meta-report-group-table-wrap">
        <table class="meta-report-group-table">
          <tbody>${rowsHtml}</tbody>
        </table>
      </div>
    </section>
  `;
}

function renderMetaReportMonthBody(monthPayload, { editable = false, showOtherToClient = true } = {}) {
  if (!monthPayload) {
    return '<div class="meta-report-empty">No data for this month yet.</div>';
  }
  if (monthPayload.meta?.emptyMonth) {
    return `<div class="meta-report-empty">No ad spend recorded for this month yet.${editable ? ' Click "Refresh from Meta" below, or use "Backfill from Meta" above to pull historical months.' : ''}</div>`;
  }

  let editPanelHtml = '';
  if (editable) {
    editPanelHtml = `
      <div class="meta-report-edit-panel" id="meta-report-edit-panel">
        <h3>Edit month inputs</h3>
        <div class="meta-report-edit-grid">
          <label>Period start<input type="date" id="meta-report-period-start" value="${esc(monthPayload.periodStart || '')}" /></label>
          <label>Period end<input type="date" id="meta-report-period-end" value="${esc(monthPayload.periodEnd || '')}" /></label>
          <label>Won leads<input type="number" step="any" id="meta-report-won-leads" value="${esc(monthPayload.topline?.wonLeads ?? '')}" /></label>
          <label>Avg lead value<input type="number" step="any" id="meta-report-avg-lead-value" value="${esc(monthPayload.topline?.avgLeadValue ?? '')}" /></label>
          <label>Avg profit per won<input type="number" step="any" id="meta-report-avg-profit" value="${esc(monthPayload.inputs?.avgProfitPerWon ?? '')}" /></label>
        </div>
        <div class="meta-report-line-items-editor">
          <div class="meta-report-line-items-head">
            <h4>Other items</h4>
            <label class="meta-report-switch">
              <span class="meta-report-switch-track">
                <input type="checkbox" class="meta-report-switch-input" id="meta-report-setting-other" ${showOtherToClient ? 'checked' : ''} />
                <span class="meta-report-switch-thumb"></span>
              </span>
              <span class="meta-report-switch-label">Show "Other" section to client</span>
            </label>
          </div>
          <div id="meta-report-line-items-list">
            ${(monthPayload.customLineItems || []).map((row, index) => `
              <div class="meta-report-line-item-row" data-index="${index}">
                <input type="text" class="meta-line-label" value="${esc(row.label)}" placeholder="Label" />
                <input type="number" step="any" class="meta-line-amount" value="${esc(row.amount)}" placeholder="Amount" />
                <button type="button" class="admin-btn admin-btn--ghost admin-btn--small meta-line-remove">Remove</button>
              </div>
            `).join('')}
          </div>
          <button type="button" class="admin-btn admin-btn--secondary admin-btn--small meta-report-add-row" id="meta-report-add-line">+ Add row</button>
        </div>
        <div class="meta-report-edit-actions">
          <button type="button" class="admin-btn admin-btn--ghost" id="meta-report-refresh-meta">${ICON_SYNC} Refresh from Meta</button>
          <button type="button" class="admin-btn admin-btn--primary" id="meta-report-save-month">Save month</button>
        </div>
      </div>
    `;
  }

  let cardHtml = renderMetaReportHighlightStrip(monthPayload);

  const metaRows = [
    ['Total spend', metaFmtKr(monthPayload.meta?.spend), ''],
    ['Cost Pr Mile (CPM)', metaFmtKr(monthPayload.meta?.cpm), ''],
    ['Impressions', metaFmtNum(monthPayload.meta?.impressions), ''],
    ['Reach', metaFmtNum(monthPayload.meta?.reach), ''],
    ['Click', metaFmtNum(monthPayload.meta?.clicks), ''],
    ['CTR', metaFmtNum(monthPayload.meta?.conversionRatePercent, 2), '%'],
  ];
  const toplineRows = [
    ['Leads', metaFmtNum(monthPayload.topline?.leads), ''],
    ['Cost Per Lead (CPL)', metaFmtKr(monthPayload.topline?.cpl), ''],
    ['Won leads', metaFmtNum(monthPayload.topline?.wonLeads), ''],
    ['Total Lead Value', metaFmtKr(monthPayload.topline?.totalLeadValue), ''],
    ['Average Lead Value', metaFmtKr(monthPayload.topline?.avgLeadValue), ''],
    ['Client acquisition cost (CAC)', metaFmtKr(monthPayload.topline?.cac), ''],
    ['Return on Ads Spend (ROAS)', metaFmtKr(monthPayload.topline?.roasKr), ''],
    ['Return on Ads Spend % (ROAS)', metaFmtX(monthPayload.topline?.roasX), ''],
  ];

  cardHtml += renderMetaReportMetricTable('Meta ads', metaRows, 'meta');
  cardHtml += renderMetaReportMetricTable('Topline KPI\'er', toplineRows, 'topline', { highlightLastN: 2 });

  if (monthPayload.bottomline) {
    const bottomRows = [
      ['Leads', metaFmtNum(monthPayload.bottomline.leads), ''],
      ['Won leads', metaFmtNum(monthPayload.bottomline.wonLeads), ''],
      ['Total Lead Value', metaFmtKr(monthPayload.bottomline.totalLeadValue), ''],
      ['Average Lead Value', metaFmtKr(monthPayload.bottomline.avgLeadValue), ''],
      ['Client acquisition cost (CAC)', metaFmtKr(monthPayload.bottomline.cac), ''],
      ['Avg Total Profit', metaFmtKr(monthPayload.bottomline.totalProfit), ''],
      ['Avg Single Profit Order', metaFmtKr(monthPayload.bottomline.avgProfitPerWon), ''],
      ['Profit on Ads Spend (POAS)', metaFmtKr(monthPayload.bottomline.poasKr), ''],
      ['Profit on Ads Spend % (POAS)', metaFmtX(monthPayload.bottomline.poasX), ''],
    ];
    if (monthPayload.bottomline.censioFee > 0) {
      bottomRows.push([`Censio performance fee (${metaFmtNum(monthPayload.bottomline.feePercent, 0)}%)`, metaFmtKr(monthPayload.bottomline.censioFee), '']);
      bottomRows.push(['Profit on Investment (POI)', metaFmtKr(monthPayload.bottomline.poiKr), '']);
      bottomRows.push(['Profit on Investment % (POI)', metaFmtX(monthPayload.bottomline.poiX), '']);
    }
    cardHtml += renderMetaReportMetricTable('Bottomline KPI\'er', bottomRows, 'bottomline', { highlightLastN: 2 });
  }

  const hasCustomItems = Boolean(monthPayload.customLineItems?.length);
  if (hasCustomItems && (editable || showOtherToClient)) {
    const customRows = monthPayload.customLineItems.map((row) => [
      row.label,
      metaFmtKr(row.amount),
      '',
    ]);
    customRows.push(['Total', metaFmtKr(monthPayload.customLineItemsTotal), '']);
    cardHtml += renderMetaReportMetricTable('Other', customRows, 'other', {
      badge: editable && !showOtherToClient ? 'Hidden from client' : '',
      highlightLastN: 1,
    });
  }

  return `${editPanelHtml}<div class="meta-report-metrics-card"><div class="meta-report-metrics-card-label">${editable ? 'Report preview' : 'Report'}</div>${cardHtml}</div>`;
}

function renderMetaReportsHubPage(viewData) {
  const clients = viewData.clients || [];
  const metaInfo = viewData.meta || {};

  return `
    ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
    ${wrapDashboardShell(`
    <div class="page-hero admin-hub-hero meta-report-hub-hero">
      <div class="admin-breadcrumb">
        <a href="/admin">Clients</a>
        <span aria-hidden="true"> / </span>
        <span>Meta reports</span>
      </div>
      <h1>Meta client reports</h1>
      <p>Monthly Meta ads reports for partner clients. Toggle reporting, copy share links, and edit monthly inputs.</p>
    </div>
    <div class="admin-hub meta-reports-page">
      <div class="meta-hub-layout">
        <div id="meta-reports-banner">${renderMetaReportsBannerHtml(metaInfo)}</div>
        <div class="hub-toolbar-row">
          <div class="hub-search">
            ${ICON_SEARCH}
            <input type="search" id="meta-reports-search" placeholder="Search clients or ad account…" value="${esc(metaReportsState.searchQuery)}" autocomplete="off" />
          </div>
          <span class="hub-count" id="meta-reports-count">${clients.length} client${clients.length === 1 ? '' : 's'}</span>
          <div class="hub-toolbar-actions">
            <div class="meta-hub-filters" id="meta-reports-filters" role="tablist" aria-label="Filter clients">
              ${renderMetaHubFiltersHtml(metaReportsState.filter)}
            </div>
            <button class="admin-btn admin-btn--secondary" type="button" id="meta-reports-refresh">${ICON_SYNC} Refresh</button>
          </div>
        </div>
        <div class="meta-hub-cards" id="meta-reports-cards">
          ${renderMetaReportsClientCards(clients, viewData.filter, viewData.searchQuery)}
        </div>
      </div>
    </div>
    `)}
  `;
}

function renderMetaReportsClientPage(payload) {
  const monthKeys = payload.monthKeys || [];
  const activeKey = metaReportsState.activeMonthKey || monthKeys[monthKeys.length - 1] || '';
  const monthPayload = payload.months?.[activeKey] || null;
  const settings = payload.settings || {};
  const tabs = monthKeys.map((key) => `
    <button type="button" class="meta-report-tab${key === activeKey ? ' is-active' : ''}" data-meta-month-tab="${esc(key)}">${esc(metaMonthLabel(key))}</button>
  `).join('');

  return `
    ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
    ${wrapDashboardShell(`
    <div class="page-hero admin-hub-hero">
      <div class="admin-breadcrumb">
        <a href="/admin">Clients</a>
        <span aria-hidden="true"> / </span>
        <a href="/admin/meta-reports">Meta reports</a>
        <span aria-hidden="true"> / </span>
        <span>${esc(payload.accountName)}</span>
      </div>
      <h1>${esc(payload.accountName)}</h1>
      <p>Edit monthly Meta report inputs. Leads and ad metrics refresh from Meta; won leads and profit are manual.</p>
    </div>
    <div class="sync-history-page meta-reports-page meta-report-client-page">
      <div class="meta-report-toolbar">
        <div class="meta-report-toolbar-left">
          <label class="meta-report-year-field">Year
            <select id="meta-report-year" class="admin-select">
              ${[payload.year, payload.year - 1].filter((value, index, arr) => arr.indexOf(value) === index).map((year) => `
                <option value="${year}"${Number(metaReportsState.selectedYear) === Number(year) ? ' selected' : ''}>${year}</option>
              `).join('')}
            </select>
          </label>
          ${(() => {
            const missing = metaReportMonthsNeedingBackfill(payload);
            if (!missing.length) return '';
            return `
              <div class="meta-report-backfill-wrap">
                <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="meta-report-backfill">${ICON_SYNC} Backfill ${missing.length} month${missing.length === 1 ? '' : 's'} from Meta</button>
                <span class="meta-report-backfill-progress" id="meta-report-backfill-progress"></span>
              </div>
            `;
          })()}
        </div>
        <div class="meta-report-toolbar-actions">
          ${payload.reportUrl ? `<button type="button" class="admin-btn admin-btn--secondary" id="meta-report-copy-link" data-copy-report-url="${esc(payload.reportUrl)}">Copy client link</button>` : ''}
          <button type="button" class="admin-btn admin-btn--ghost" id="meta-report-rotate-token">Rotate link</button>
        </div>
      </div>
      <div class="meta-report-settings">
        <div class="meta-report-settings-group">
          <label class="meta-report-switch">
            <span class="meta-report-switch-track">
              <input type="checkbox" class="meta-report-switch-input" id="meta-report-setting-bottomline" ${settings.metaReportShowBottomline ? 'checked' : ''} />
              <span class="meta-report-switch-thumb"></span>
            </span>
            <span class="meta-report-switch-label">Show bottomline</span>
          </label>
          <label class="meta-report-switch">
            <span class="meta-report-switch-track">
              <input type="checkbox" class="meta-report-switch-input" id="meta-report-setting-fee" ${settings.metaReportFeeEnabled ? 'checked' : ''} />
              <span class="meta-report-switch-thumb"></span>
            </span>
            <span class="meta-report-switch-label">Censio performance fee</span>
          </label>
          <label class="meta-report-fee-field${settings.metaReportFeeEnabled ? '' : ' is-disabled'}" id="meta-report-fee-field">Fee %
            <input type="number" step="any" min="0" max="100" id="meta-report-setting-fee-percent" value="${esc(settings.metaReportFeePercent ?? 20)}" ${settings.metaReportFeeEnabled ? '' : 'disabled'} />
          </label>
        </div>
        <span class="meta-report-save-indicator" id="meta-report-save-indicator"><span class="meta-report-save-indicator-spinner"></span> Saving…</span>
      </div>
      <div class="meta-report-tabs" role="tablist">${tabs}</div>
      <div class="meta-report-month-panel" id="meta-report-month-panel">
        ${renderMetaReportMonthBody(monthPayload, { editable: true, showOtherToClient: settings.metaReportShowOther !== false })}
      </div>
    </div>
    `)}
  `;
}

function renderPublicMetaReportPage(payload) {
  const monthKeys = payload.monthKeys || [];
  const activeKey = metaReportsState.activeMonthKey || monthKeys[monthKeys.length - 1] || '';
  const monthPayload = payload.months?.[activeKey] || null;
  const tabs = monthKeys.map((key) => `
    <button type="button" class="meta-report-tab${key === activeKey ? ' is-active' : ''}" data-meta-month-tab="${esc(key)}">${esc(metaMonthLabel(key))}</button>
  `).join('');

  return `
    <header class="brand-topbar">
      <div class="brand-topbar-inner">
        <div class="brand-topbar-left">
          <img class="brand-logo" src="/cenhub-logo-white.png" alt="Cenhub" width="167" height="41" />
        </div>
      </div>
    </header>
    ${wrapDashboardShell(`
    <div class="page-hero meta-report-public-hero">
      <h1>${esc(payload.accountName)}</h1>
      <p>Meta ads performance report</p>
    </div>
    <div class="meta-reports-page meta-reports-page--public">
      <div class="meta-report-toolbar">
        <label class="meta-report-year-field">Year
          <select id="meta-report-year" class="admin-select">
            ${[payload.year, payload.year - 1].filter((value, index, arr) => arr.indexOf(value) === index).map((year) => `
              <option value="${year}"${Number(metaReportsState.selectedYear) === Number(year) ? ' selected' : ''}>${year}</option>
            `).join('')}
          </select>
        </label>
      </div>
      <div class="meta-report-tabs" role="tablist">${tabs}</div>
      <div class="meta-report-month-panel" id="meta-report-month-panel">
        ${renderMetaReportMonthBody(monthPayload, { editable: false, showOtherToClient: payload.settings?.metaReportShowOther !== false })}
      </div>
    </div>
    `)}
  `;
}

function bindMetaReportCopyButtons(root = document) {
  root.querySelectorAll('[data-copy-report-url]').forEach((button) => {
    button.onclick = async () => {
      const path = button.getAttribute('data-copy-report-url');
      const url = `${window.location.origin}${path}`;
      try {
        await navigator.clipboard.writeText(url);
        showToast('Share link copied', 'success');
      } catch {
        showToast(url, 'info');
      }
    };
  });
}

async function patchMetaReportSettings(clientId, patch) {
  return adminFetch(`/api/meta-reports/clients/${encodeURIComponent(clientId)}/settings`, {
    method: 'PATCH',
    body: JSON.stringify(patch),
  });
}

async function refreshMetaReportsHubData({ silent = true } = {}) {
  const refreshBtn = document.getElementById('meta-reports-refresh');
  if (refreshBtn) refreshBtn.disabled = true;
  try {
    const data = await adminFetch('/api/meta-reports?filter=all');
    metaReportsState.dashboardData = data;
    updateMetaReportsHubDom(getMetaReportsHubView(data, metaReportsState.filter, metaReportsState.searchQuery));
    if (!silent) showToast('Meta reports refreshed', 'success');
  } catch (error) {
    showToast(error.message || 'Refresh failed', 'error');
  } finally {
    if (refreshBtn) refreshBtn.disabled = false;
  }
}

function bindMetaReportsHubChromeEvents() {
  document.querySelectorAll('[data-meta-filter]').forEach((button) => {
    button.onclick = () => {
      metaReportsState.filter = button.getAttribute('data-meta-filter') || 'all';
      document.querySelectorAll('[data-meta-filter]').forEach((pill) => {
        pill.classList.toggle('is-active', pill.getAttribute('data-meta-filter') === metaReportsState.filter);
      });
      if (metaReportsState.dashboardData) {
        updateMetaReportsHubDom(getMetaReportsHubView(
          metaReportsState.dashboardData,
          metaReportsState.filter,
          metaReportsState.searchQuery,
        ));
      }
    };
  });

  const searchInput = document.getElementById('meta-reports-search');
  if (searchInput) {
    let searchTimer = null;
    searchInput.oninput = () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        metaReportsState.searchQuery = searchInput.value || '';
        if (metaReportsState.dashboardData) {
          updateMetaReportsHubDom(getMetaReportsHubView(
            metaReportsState.dashboardData,
            metaReportsState.filter,
            metaReportsState.searchQuery,
          ));
        }
      }, 180);
    };
  }

  const refreshBtn = document.getElementById('meta-reports-refresh');
  if (refreshBtn) refreshBtn.onclick = () => refreshMetaReportsHubData({ silent: false });
}

function bindMetaReportsHubRowEvents(root = document) {
  root.querySelectorAll('[data-meta-report-enabled]').forEach((input) => {
    input.onchange = async () => {
      const clientId = input.getAttribute('data-meta-report-enabled');
      input.disabled = true;
      try {
        const result = await patchMetaReportSettings(clientId, { metaReportEnabled: input.checked });
        const settings = result.settings || {};
        mergeHubClient(clientId, {
          metaReportEnabled: settings.metaReportEnabled,
          metaReportShowBottomline: settings.metaReportShowBottomline,
          metaReportFeeEnabled: settings.metaReportFeeEnabled,
          reportUrl: settings.reportUrl,
        });
        showToast(input.checked ? 'Report enabled' : 'Report disabled', 'success');
        updateMetaReportsHubDom(getMetaReportsHubView(
          metaReportsState.dashboardData,
          metaReportsState.filter,
          metaReportsState.searchQuery,
        ));
      } catch (error) {
        showToast(error.message || 'Update failed', 'error');
        input.checked = !input.checked;
      } finally {
        input.disabled = false;
      }
    };
  });

  root.querySelectorAll('[data-meta-bottomline]').forEach((input) => {
    input.onchange = async () => {
      const clientId = input.getAttribute('data-meta-bottomline');
      input.disabled = true;
      try {
        const result = await patchMetaReportSettings(clientId, { metaReportShowBottomline: input.checked });
        mergeHubClient(clientId, { metaReportShowBottomline: result.settings?.metaReportShowBottomline });
        showToast('Bottomline setting saved', 'success');
      } catch (error) {
        showToast(error.message || 'Update failed', 'error');
        input.checked = !input.checked;
      } finally {
        input.disabled = false;
      }
    };
  });

  root.querySelectorAll('[data-meta-fee]').forEach((input) => {
    input.onchange = async () => {
      const clientId = input.getAttribute('data-meta-fee');
      input.disabled = true;
      try {
        const result = await patchMetaReportSettings(clientId, { metaReportFeeEnabled: input.checked });
        mergeHubClient(clientId, { metaReportFeeEnabled: result.settings?.metaReportFeeEnabled });
        showToast('Fee setting saved', 'success');
      } catch (error) {
        showToast(error.message || 'Update failed', 'error');
        input.checked = !input.checked;
      } finally {
        input.disabled = false;
      }
    };
  });

  bindMetaReportCopyButtons(root);

  root.querySelectorAll('[data-meta-provision]').forEach((button) => {
    button.onclick = async () => {
      button.disabled = true;
      try {
        await adminFetch('/api/meta-reports/provision', {
          method: 'POST',
          body: JSON.stringify({
            accountName: button.getAttribute('data-meta-provision-name'),
            metaAdAccountId: button.getAttribute('data-meta-provision'),
            metaReportEnabled: true,
          }),
        });
        showToast('Client added', 'success');
        await refreshMetaReportsHubData({ silent: true });
      } catch (error) {
        showToast(error.message || 'Failed to add client', 'error');
        button.disabled = false;
      }
    };
  });
}

function bindMetaReportsHubEvents() {
  bindMetaReportsHubChromeEvents();
  bindMetaReportsHubRowEvents(document.getElementById('meta-reports-cards') || document);
}

function collectMetaReportLineItems() {
  return Array.from(document.querySelectorAll('.meta-report-line-item-row')).map((row, index) => ({
    label: row.querySelector('.meta-line-label')?.value || '',
    amount: Number(row.querySelector('.meta-line-amount')?.value) || 0,
    sortOrder: index,
  })).filter((item) => item.label.trim());
}

function bindMetaReportsClientTabEvents(payload) {
  const clientId = payload.clientId;
  document.querySelectorAll('[data-meta-month-tab]').forEach((button) => {
    button.onclick = () => {
      metaReportsState.activeMonthKey = button.getAttribute('data-meta-month-tab');
      const panel = document.getElementById('meta-report-month-panel');
      if (panel) {
        panel.innerHTML = renderMetaReportMonthBody(
          payload.months?.[metaReportsState.activeMonthKey],
          { editable: true, showOtherToClient: payload.settings?.metaReportShowOther !== false },
        );
        bindMetaReportsClientEditEvents(clientId, payload);
      }
      document.querySelectorAll('[data-meta-month-tab]').forEach((tab) => {
        tab.classList.toggle('is-active', tab.getAttribute('data-meta-month-tab') === metaReportsState.activeMonthKey);
      });
    };
  });
}

function setMetaReportSavingState(isSaving) {
  const panel = document.getElementById('meta-report-month-panel');
  const indicator = document.getElementById('meta-report-save-indicator');
  if (panel) panel.classList.toggle('is-loading', isSaving);
  if (indicator) indicator.classList.toggle('is-visible', isSaving);
}

function syncMetaReportFeeFieldState(enabled) {
  const feeField = document.getElementById('meta-report-fee-field');
  const feePercent = document.getElementById('meta-report-setting-fee-percent');
  if (feeField) feeField.classList.toggle('is-disabled', !enabled);
  if (feePercent) feePercent.disabled = !enabled;
}

function syncMetaReportSettingsControls(settings = {}) {
  const bottomlineToggle = document.getElementById('meta-report-setting-bottomline');
  const feeToggle = document.getElementById('meta-report-setting-fee');
  const feePercent = document.getElementById('meta-report-setting-fee-percent');
  if (bottomlineToggle) bottomlineToggle.checked = Boolean(settings.metaReportShowBottomline);
  if (feeToggle) feeToggle.checked = Boolean(settings.metaReportFeeEnabled);
  if (feePercent) {
    feePercent.value = settings.metaReportFeePercent ?? 20;
    feePercent.dataset.prevValue = String(feePercent.value);
  }
  syncMetaReportFeeFieldState(Boolean(settings.metaReportFeeEnabled));
}

function describeMetaReportSettingsChange(patch, settings) {
  if (Object.prototype.hasOwnProperty.call(patch, 'metaReportFeeEnabled')) {
    return settings.metaReportFeeEnabled ? 'Censio fee enabled' : 'Censio fee disabled';
  }
  if (Object.prototype.hasOwnProperty.call(patch, 'metaReportFeePercent')) {
    return `Fee set to ${settings.metaReportFeePercent ?? 20}% — report updated`;
  }
  if (Object.prototype.hasOwnProperty.call(patch, 'metaReportShowBottomline')) {
    return settings.metaReportShowBottomline ? 'Bottomline shown on report' : 'Bottomline hidden from report';
  }
  if (Object.prototype.hasOwnProperty.call(patch, 'metaReportShowOther')) {
    return settings.metaReportShowOther !== false ? '"Other" shown to client' : '"Other" hidden from client';
  }
  return 'Settings saved';
}

async function saveMetaReportClientSettings(clientId, patch, revert) {
  setMetaReportSavingState(true);
  try {
    const result = await patchMetaReportSettings(clientId, {
      ...patch,
      monthKey: metaReportsState.activeMonthKey,
    });
    const settings = result.settings || {};
    const payload = metaReportsState.clientPayload;
    if (payload) {
      payload.settings = settings;
      if (result.monthPayload && metaReportsState.activeMonthKey) {
        payload.months = payload.months || {};
        payload.months[metaReportsState.activeMonthKey] = result.monthPayload;
      }
    }

    syncMetaReportSettingsControls(settings);

    const panel = document.getElementById('meta-report-month-panel');
    if (panel && result.monthPayload) {
      panel.innerHTML = renderMetaReportMonthBody(result.monthPayload, {
        editable: true,
        showOtherToClient: settings.metaReportShowOther !== false,
      });
      bindMetaReportsClientEditEvents(clientId, payload);
    }
    showToast(describeMetaReportSettingsChange(patch, settings), 'success');
  } catch (error) {
    showToast(error.message || 'Update failed', 'error');
    if (revert) revert();
  } finally {
    setMetaReportSavingState(false);
  }
}

function bindMetaReportBackfillButton(clientId) {
  const backfillBtn = document.getElementById('meta-report-backfill');
  if (!backfillBtn) return;
  backfillBtn.onclick = async () => {
    const payload = metaReportsState.clientPayload;
    const missing = metaReportMonthsNeedingBackfill(payload);
    if (!missing.length) return;
    backfillBtn.disabled = true;
    const progressEl = document.getElementById('meta-report-backfill-progress');
    let done = 0;
    let failed = 0;
    for (const monthKey of missing) {
      done += 1;
      if (progressEl) progressEl.textContent = `Fetching ${metaMonthLabel(monthKey)} ${monthKey.slice(0, 4)}… (${done}/${missing.length})`;
      try {
        await adminFetch(`/api/meta-reports/clients/${encodeURIComponent(clientId)}/months/${encodeURIComponent(monthKey)}/refresh`, {
          method: 'POST',
        });
      } catch (error) {
        failed += 1;
      }
    }
    if (progressEl) progressEl.textContent = '';
    if (failed) {
      showToast(`Backfilled ${done - failed}/${missing.length} months. ${failed} failed (check Meta token access).`, 'error');
    } else {
      showToast(`Backfilled ${missing.length} month${missing.length === 1 ? '' : 's'} from Meta`, 'success');
    }
    await loadMetaReportsClientPage({ silent: true });
  };
}

function bindMetaReportsClientChromeEvents(payload) {
  const clientId = payload.clientId;

  const yearSelect = document.getElementById('meta-report-year');
  if (yearSelect) {
    yearSelect.onchange = async () => {
      metaReportsState.selectedYear = Number(yearSelect.value);
      metaReportsState.activeMonthKey = null;
      yearSelect.disabled = true;
      try {
        await loadMetaReportsClientPage({ silent: true });
      } finally {
        yearSelect.disabled = false;
      }
    };
  }

  bindMetaReportCopyButtons();
  bindMetaReportBackfillButton(clientId);

  const bottomlineToggle = document.getElementById('meta-report-setting-bottomline');
  const feeToggle = document.getElementById('meta-report-setting-fee');
  const feePercent = document.getElementById('meta-report-setting-fee-percent');
  syncMetaReportFeeFieldState(Boolean(feeToggle?.checked));

  if (bottomlineToggle) {
    bottomlineToggle.onchange = () => {
      const next = bottomlineToggle.checked;
      saveMetaReportClientSettings(
        clientId,
        { metaReportShowBottomline: next },
        () => { bottomlineToggle.checked = !next; },
      );
    };
  }
  if (feeToggle) {
    feeToggle.onchange = () => {
      const next = feeToggle.checked;
      syncMetaReportFeeFieldState(next);
      const patch = { metaReportFeeEnabled: next };
      // Fee only appears inside bottomline — turn it on together when enabling fee.
      if (next && bottomlineToggle && !bottomlineToggle.checked) {
        bottomlineToggle.checked = true;
        patch.metaReportShowBottomline = true;
      }
      saveMetaReportClientSettings(
        clientId,
        patch,
        () => {
          feeToggle.checked = !next;
          if (Object.prototype.hasOwnProperty.call(patch, 'metaReportShowBottomline') && bottomlineToggle) {
            bottomlineToggle.checked = false;
          }
          syncMetaReportFeeFieldState(feeToggle.checked);
        },
      );
    };
  }
  if (feePercent) {
    feePercent.dataset.prevValue = feePercent.value;
    const commitFeePercent = () => {
      if (feePercent.disabled) return;
      const prevValue = feePercent.dataset.prevValue;
      let nextValue = Number(feePercent.value);
      if (!Number.isFinite(nextValue)) nextValue = 20;
      nextValue = Math.min(100, Math.max(0, nextValue));
      feePercent.value = String(nextValue);
      if (String(nextValue) === String(prevValue)) return;
      feePercent.dataset.prevValue = String(nextValue);
      saveMetaReportClientSettings(
        clientId,
        { metaReportFeePercent: nextValue },
        () => { feePercent.value = prevValue; feePercent.dataset.prevValue = prevValue; },
      );
    };
    feePercent.onchange = commitFeePercent;
    feePercent.onkeydown = (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        feePercent.blur();
      }
    };
  }

  const rotateBtn = document.getElementById('meta-report-rotate-token');
  if (rotateBtn) {
    rotateBtn.onclick = async () => {
      if (!window.confirm('Rotate the client share link? The old link will stop working.')) return;
      rotateBtn.disabled = true;
      try {
        const result = await patchMetaReportSettings(clientId, { rotateAccessToken: true });
        const reportUrl = result.settings?.reportUrl;
        const currentPayload = metaReportsState.clientPayload;
        if (currentPayload) currentPayload.reportUrl = reportUrl;
        const copyBtn = document.getElementById('meta-report-copy-link');
        if (copyBtn && reportUrl) {
          copyBtn.setAttribute('data-copy-report-url', reportUrl);
          copyBtn.hidden = false;
        }
        showToast('Share link rotated', 'success');
      } catch (error) {
        showToast(error.message || 'Rotate failed', 'error');
      } finally {
        rotateBtn.disabled = false;
      }
    };
  }
}

function bindMetaReportsClientEvents(payload) {
  bindMetaReportsClientChromeEvents(payload);
  bindMetaReportsClientTabEvents(payload);
  bindMetaReportsClientEditEvents(payload.clientId, payload);
}

function bindMetaReportsClientEditEvents(clientId, payload) {
  const otherToggle = document.getElementById('meta-report-setting-other');
  if (otherToggle) {
    otherToggle.onchange = () => {
      const next = otherToggle.checked;
      saveMetaReportClientSettings(
        clientId,
        { metaReportShowOther: next },
        () => { otherToggle.checked = !next; },
      );
    };
  }

  const addLineBtn = document.getElementById('meta-report-add-line');
  if (addLineBtn) {
    addLineBtn.onclick = () => {
      const list = document.getElementById('meta-report-line-items-list');
      if (!list) return;
      const row = document.createElement('div');
      row.className = 'meta-report-line-item-row';
      row.innerHTML = `
        <input type="text" class="meta-line-label" placeholder="Label" />
        <input type="number" step="any" class="meta-line-amount" placeholder="Amount" />
        <button type="button" class="admin-btn admin-btn--ghost admin-btn--small meta-line-remove">Remove</button>
      `;
      list.appendChild(row);
      row.querySelector('.meta-line-remove')?.addEventListener('click', () => row.remove());
    };
  }
  document.querySelectorAll('.meta-line-remove').forEach((button) => {
    button.onclick = () => button.closest('.meta-report-line-item-row')?.remove();
  });

  const refreshBtn = document.getElementById('meta-report-refresh-meta');
  if (refreshBtn) {
    refreshBtn.onclick = async () => {
      refreshBtn.disabled = true;
      try {
        const monthKey = metaReportsState.activeMonthKey;
        const result = await adminFetch(`/api/meta-reports/clients/${encodeURIComponent(clientId)}/months/${encodeURIComponent(monthKey)}/refresh`, {
          method: 'POST',
        });
        refreshMetaReportMonthPanel(result.monthPayload);
        showToast('Meta data refreshed', 'success');
      } catch (error) {
        showToast(error.message || 'Meta refresh failed', 'error');
      } finally {
        refreshBtn.disabled = false;
      }
    };
  }

  const saveBtn = document.getElementById('meta-report-save-month');
  if (saveBtn) {
    saveBtn.onclick = async () => {
      saveBtn.disabled = true;
      try {
        const monthKey = metaReportsState.activeMonthKey;
        const body = {
          periodStart: document.getElementById('meta-report-period-start')?.value,
          periodEnd: document.getElementById('meta-report-period-end')?.value,
          wonLeads: Number(document.getElementById('meta-report-won-leads')?.value),
          avgLeadValue: Number(document.getElementById('meta-report-avg-lead-value')?.value),
          avgProfitPerWon: Number(document.getElementById('meta-report-avg-profit')?.value),
          lineItems: collectMetaReportLineItems(),
        };
        const result = await adminFetch(`/api/meta-reports/clients/${encodeURIComponent(clientId)}/months/${encodeURIComponent(monthKey)}`, {
          method: 'PUT',
          body: JSON.stringify(body),
        });
        refreshMetaReportMonthPanel(result.monthPayload);
        showToast('Month saved', 'success');
      } catch (error) {
        showToast(error.message || 'Save failed', 'error');
      } finally {
        saveBtn.disabled = false;
      }
    };
  }
}

function bindPublicMetaReportTabEvents(payload) {
  document.querySelectorAll('[data-meta-month-tab]').forEach((button) => {
    button.onclick = () => {
      metaReportsState.activeMonthKey = button.getAttribute('data-meta-month-tab');
      const panel = document.getElementById('meta-report-month-panel');
      if (panel) {
        panel.innerHTML = renderMetaReportMonthBody(payload.months?.[metaReportsState.activeMonthKey], {
          editable: false,
          showOtherToClient: payload.settings?.metaReportShowOther !== false,
        });
      }
      document.querySelectorAll('[data-meta-month-tab]').forEach((tab) => {
        tab.classList.toggle('is-active', tab.getAttribute('data-meta-month-tab') === metaReportsState.activeMonthKey);
      });
    };
  });
}

function bindPublicMetaReportEvents(payload) {
  bindPublicMetaReportTabEvents(payload);
  const yearSelect = document.getElementById('meta-report-year');
  if (yearSelect) {
    yearSelect.onchange = async () => {
      metaReportsState.selectedYear = Number(yearSelect.value);
      metaReportsState.activeMonthKey = null;
      yearSelect.disabled = true;
      try {
        await loadPublicMetaReportPage({ silent: true });
      } finally {
        yearSelect.disabled = false;
      }
    };
  }
}

async function loadMetaReportsHubPage() {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard) return;
  const user = await fetchStaffMe();
  if (!user) {
    dashboard.innerHTML = `
      ${renderBrandTopbar('')}
      ${wrapDashboardShell('<div class="sync-history-empty" style="padding:24px;text-align:center"><a class="admin-btn admin-btn--primary" href="/login?next=' + encodeURIComponent(window.location.pathname) + '">Sign in</a></div>')}
    `;
    return;
  }
  currentStaffUser = user;

  if (!metaReportsState.hubMounted) {
    dashboard.innerHTML = `
      ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
      ${wrapDashboardShell('<div class="loading-state"><div class="spinner"></div><p>Loading Meta reports...</p></div>')}
    `;
  }

  try {
    const data = await adminFetch('/api/meta-reports?filter=all');
    metaReportsState.dashboardData = data;
    const viewData = getMetaReportsHubView(data, metaReportsState.filter, metaReportsState.searchQuery);
    if (!metaReportsState.hubMounted) {
      dashboard.innerHTML = renderMetaReportsHubPage(viewData);
      metaReportsState.hubMounted = true;
      bindMetaReportsHubEvents();
    } else {
      updateMetaReportsHubDom(viewData);
    }
  } catch (error) {
    if (!metaReportsState.hubMounted) {
      dashboard.innerHTML = `
        ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
        ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
      `;
    } else {
      showToast(error.message || 'Load failed', 'error');
    }
  }
}

async function loadMetaReportsClientPage({ silent = false } = {}) {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard) return;
  const user = await fetchStaffMe();
  if (!user) {
    window.location.href = `/login?next=${encodeURIComponent(window.location.pathname)}`;
    return;
  }
  currentStaffUser = user;
  const clientId = CLIENT_SLUG;

  if (!metaReportsState.clientPageMounted) {
    dashboard.innerHTML = `
      ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
      ${wrapDashboardShell('<div class="loading-state"><div class="spinner"></div><p>Loading report editor...</p></div>')}
    `;
  } else if (!silent) {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.add('is-loading');
  }

  try {
    const payload = await adminFetch(`/api/meta-reports/clients/${encodeURIComponent(clientId)}?year=${encodeURIComponent(metaReportsState.selectedYear)}`);
    if (!metaReportsState.activeMonthKey) {
      metaReportsState.activeMonthKey = payload.monthKeys?.[payload.monthKeys.length - 1] || null;
    }
    if (!metaReportsState.clientPageMounted) {
      metaReportsState.clientPayload = payload;
      dashboard.innerHTML = renderMetaReportsClientPage(payload);
      metaReportsState.clientPageMounted = true;
      bindMetaReportsClientEvents(payload);
    } else {
      updateMetaReportsClientContent(payload);
    }
  } catch (error) {
    if (!metaReportsState.clientPageMounted) {
      dashboard.innerHTML = `
        ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
        ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
      `;
    } else {
      showToast(error.message || 'Load failed', 'error');
    }
  } finally {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.remove('is-loading');
  }
}

async function loadPublicMetaReportPage({ silent = false } = {}) {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard || !REPORT_TOKEN) return;

  if (!metaReportsState.publicPageMounted) {
    dashboard.innerHTML = wrapDashboardShell('<div class="loading-state"><div class="spinner"></div><p>Loading report...</p></div>');
  } else if (!silent) {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.add('is-loading');
  }

  try {
    const payload = await fetch(`/api/meta-reports/public/${encodeURIComponent(REPORT_TOKEN)}?year=${encodeURIComponent(metaReportsState.selectedYear)}`)
      .then(async (response) => {
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Report not found');
        return data;
      });
    if (!metaReportsState.activeMonthKey) {
      metaReportsState.activeMonthKey = payload.monthKeys?.[payload.monthKeys.length - 1] || null;
    }
    if (!metaReportsState.publicPageMounted) {
      metaReportsState.publicPayload = payload;
      dashboard.innerHTML = renderPublicMetaReportPage(payload);
      metaReportsState.publicPageMounted = true;
      bindPublicMetaReportEvents(payload);
    } else {
      updatePublicMetaReportContent(payload);
    }
  } catch (error) {
    if (!metaReportsState.publicPageMounted) {
      dashboard.innerHTML = wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message || 'Report not found')}</div>`);
    } else {
      showToast(error.message || 'Load failed', 'error');
    }
  } finally {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.remove('is-loading');
  }
}

function renderAdminHubPage(clients) {
  const count = clients.length;
  const syncLogActions = currentStaffUser ? `
          <a class="admin-btn admin-btn--secondary" href="/admin/sync-history/meta">Meta sync log</a>
  ` : '';
  const adminActions = isStaffAdmin() ? `
          ${syncLogActions}
          <button class="admin-btn" type="button" onclick="syncAllClients(this)">${ICON_SYNC} Sync all</button>
          <button class="admin-btn admin-btn--primary" type="button" onclick="focusAddClient()">${ICON_PLUS} Add client</button>
  ` : syncLogActions;
  return `
    ${renderBrandTopbar(renderStaffAdminChrome('clients'))}
    ${wrapDashboardShell(`
    <div class="page-hero admin-hub-hero">
      <h1>Client administration</h1>
      <p>Manage dashboard accounts, sync GHL data, and preview client views.</p>
    </div>
    <div class="admin-hub">
      <div class="hub-toolbar-row">
        <div class="hub-search">
          ${ICON_SEARCH}
          <input id="hub-search" type="search" placeholder="Search clients..." oninput="filterHubCards()" />
        </div>
        <span class="hub-count" id="hub-count">${count} client${count === 1 ? '' : 's'}</span>
        <div class="hub-toolbar-actions">
          ${adminActions}
        </div>
      </div>
      <div class="client-grid" id="client-grid">
        ${count ? clients.map((client) => renderClientCard(client)).join('') : `<div class="hub-empty">${isStaffAdmin() ? 'No clients yet. Create your first client below.' : 'No clients yet.'}</div>`}
        <div class="hub-empty" id="hub-no-results" style="display:none">No clients match your search.</div>
      </div>
      ${isStaffAdmin() ? renderAddClientPanel() : ''}
    </div>
    <div class="brand-footer">
      Dashboard by Cenhub · Holstebro
    </div>
    `)}
  `;
}

function focusAddClient() {
  const panel = document.getElementById('add-client-panel');
  if (panel) panel.open = true;
  const input = document.getElementById('new-account-name');
  if (!input) return;
  input.scrollIntoView({ behavior: 'smooth', block: 'center' });
  setTimeout(() => input.focus({ preventScroll: true }), 350);
}

function copyAdminUrl(clientId) {
  const url = `${window.location.origin}/admin/${clientId}`;
  navigator.clipboard.writeText(url).then(
    () => showToast('Admin URL copied', 'success'),
    () => showToast('Could not copy URL', 'error'),
  );
}

function closeCardMenus() {
  document.querySelectorAll('.card-menu.open').forEach((menu) => menu.classList.remove('open'));
}

function toggleCardMenu(clientId, event) {
  event.stopPropagation();
  const menu = document.getElementById(`card-menu-${clientId}`);
  if (!menu) return;
  const willOpen = !menu.classList.contains('open');
  closeCardMenus();
  if (willOpen) menu.classList.add('open');
}

function renderCardMenu(clientId, accountName) {
  const label = accountName || clientId;
  const deleteAction = isStaffAdmin()
    ? `<button type="button" role="menuitem" class="card-menu-item--danger" onclick="closeCardMenus(); deleteClient('${clientId}');">Delete client</button>`
    : '';
  return `
    <div class="card-menu" id="card-menu-${clientId}" data-client-id="${clientId}">
      <button
        type="button"
        class="icon-btn card-menu-trigger"
        aria-label="More actions for ${esc(label)}"
        title="More actions"
        aria-haspopup="menu"
        onclick="toggleCardMenu('${clientId}', event)"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <circle cx="12" cy="5" r="1.75"></circle>
          <circle cx="12" cy="12" r="1.75"></circle>
          <circle cx="12" cy="19" r="1.75"></circle>
        </svg>
      </button>
      <div class="card-menu-dropdown" role="menu">
        <button type="button" role="menuitem" onclick="copyAdminUrl('${clientId}'); closeCardMenus();">Copy admin URL</button>
        ${deleteAction}
      </div>
    </div>
  `;
}

function renderClientCard(client) {
  const kpis = client.previewKpis || {};
  const pipelineLabel = client.pipelineMode === '3-pipeline' ? '3 pipelines' : '2 pipelines';
  const needsAction = clientNeedsAction(client.status);
  return `
    <article class="client-card${needsAction ? ' client-card--needs-action' : ''}" data-client-id="${client.clientId}" data-search="${esc(`${client.accountName} ${client.clientId}`.toLowerCase())}">
      <div class="client-card-header">
        <span class="client-avatar" aria-hidden="true">${esc(clientInitials(client.accountName))}</span>
        <div class="client-card-title-block">
          <h3>${esc(client.accountName)}</h3>
          <div class="client-card-slug">/${client.clientId}</div>
        </div>
        ${renderCardMenu(client.clientId, client.accountName)}
      </div>
      <div class="client-card-meta">
        <span class="status-badge status-${client.status}">${statusLabel(client.status)}</span>
        <span class="client-card-meta-divider" aria-hidden="true">·</span>
        <span>${pipelineLabel}</span>
        <span class="client-card-meta-divider" aria-hidden="true">·</span>
        <span data-sync-meta>${formatRelativeSync(client.lastSyncAt, client.status)}</span>
      </div>
      ${needsAction ? `<p class="client-card-action-hint">${esc(clientActionHint(client.status))}</p>` : ''}
      ${kpis.totalLeads != null ? `
        <div class="client-card-stats">
          <div class="client-card-stat">
            <div class="client-card-stat-value">${fmtDkk(kpis.totalLeads)}</div>
            <div class="client-card-stat-label">Leads</div>
          </div>
          <div class="client-card-stat">
            <div class="client-card-stat-value">${fmtDkk(kpis.clientsWon)}</div>
            <div class="client-card-stat-label">Won</div>
          </div>
          <div class="client-card-stat">
            <div class="client-card-stat-value">${fmtRevenueDkk(kpis.wonRevenue)}</div>
            <div class="client-card-stat-label">Revenue</div>
          </div>
        </div>
      ` : ''}
      <div class="client-card-actions">
        <a class="admin-btn" href="/admin/${client.clientId}">Settings</a>
        <a class="admin-btn admin-btn--primary" href="/${encodeURIComponent(client.clientId)}" target="_blank" rel="noopener noreferrer" title="Open client dashboard">Dashboard</a>
        <button class="admin-btn admin-btn--secondary" type="button" onclick="syncClient('${client.clientId}', this)">${ICON_SYNC} Sync</button>
      </div>
    </article>
  `;
}

function filterHubCards() {
  const query = (document.getElementById('hub-search')?.value || '').trim().toLowerCase();
  let visible = 0;
  document.querySelectorAll('#client-grid .client-card').forEach((card) => {
    const match = !query || (card.dataset.search || '').includes(query);
    card.style.display = match ? '' : 'none';
    if (match) visible += 1;
  });
  const empty = document.getElementById('hub-no-results');
  if (empty) empty.style.display = query && !visible ? '' : 'none';
}

function renderAddClientPanel() {
  return `
    <details class="add-client-panel" id="add-client-panel">
      <summary class="add-client-summary">
        <h2>${ICON_PLUS} Add new client</h2>
        <span class="add-client-summary-hint">Click to expand</span>
      </summary>
      <p class="add-client-desc">Creates the account and opens the setup page where you pick the metrics model and connect GHL.</p>
      <div class="add-client-body">
        <div class="setup-grid setup-grid--3">
          <div class="field-group">
            <label for="new-account-name">Account name</label>
            <input id="new-account-name" type="text" placeholder="ScanTherm" oninput="suggestNewClientSlug()" />
          </div>
          <div class="field-group">
            <label for="new-client-slug">Admin slug</label>
            <input id="new-client-slug" type="text" placeholder="scantherm" oninput="checkNewClientSlug()" />
            <div id="slug-status" class="slug-status"></div>
          </div>
          <div class="field-group">
            <label for="new-location-id">GHL location ID</label>
            <input id="new-location-id" type="text" placeholder="Optional — can be added later" />
          </div>
        </div>
        <div class="setup-actions" style="border-top:0;padding-top:16px;margin-top:0">
          <div></div>
          <button class="admin-btn admin-btn--primary" type="button" onclick="createClient()">${ICON_PLUS} Create client</button>
        </div>
      </div>
    </details>
  `;
}

async function loadAdminHub() {
  const dashboard = document.getElementById('dashboard');
  const user = await requireStaffAuth();
  if (!user) return;

  dashboard.innerHTML = `
    ${renderBrandTopbar(renderStaffAdminChrome('clients'))}
    ${wrapDashboardShell(`
      <div class="loading-state">
        <div class="spinner"></div>
        Loading clients...
      </div>
    `)}`;

  try {
    const data = await adminFetch('/api/clients');
    dashboard.innerHTML = renderAdminHubPage(data.clients || []);
  } catch (error) {
    dashboard.innerHTML = `
      ${renderBrandTopbar(renderStaffAdminChrome('clients'))}
      ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
    `;
  }
}

let slugCheckTimer = null;

function suggestNewClientSlug() {
  const name = document.getElementById('new-account-name')?.value || '';
  const slugInput = document.getElementById('new-client-slug');
  if (!slugInput || slugInput.dataset.userEdited === 'true') return;
  slugInput.value = name.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  checkNewClientSlug();
}

function checkNewClientSlug() {
  const slugInput = document.getElementById('new-client-slug');
  if (slugInput) slugInput.dataset.userEdited = 'true';
  clearTimeout(slugCheckTimer);
  slugCheckTimer = setTimeout(async () => {
    const slug = document.getElementById('new-client-slug')?.value || '';
    const statusEl = document.getElementById('slug-status');
    if (!statusEl || !slug) {
      if (statusEl) statusEl.textContent = '';
      return;
    }
    try {
      const result = await adminFetch(`/api/clients/check-slug?slug=${encodeURIComponent(slug)}`);
      statusEl.className = `slug-status ${result.available ? 'ok' : 'bad'}`;
      statusEl.textContent = result.available
        ? `Available · ${result.adminUrl}`
        : `Unavailable (${result.reason || 'taken'})`;
    } catch (error) {
      statusEl.className = 'slug-status bad';
      statusEl.textContent = error.message;
    }
  }, 300);
}

async function createClient() {
  const accountName = document.getElementById('new-account-name')?.value?.trim();
  const clientId = document.getElementById('new-client-slug')?.value?.trim();
  const locationId = document.getElementById('new-location-id')?.value?.trim();
  if (!accountName || !clientId) {
    window.alert('Account name and slug are required.');
    return;
  }
  try {
    await adminFetch('/api/clients', {
      method: 'POST',
      body: JSON.stringify({ accountName, clientId, locationId: locationId || null }),
    });
    showToast('Client created', 'success');
    window.location.href = `/admin/${encodeURIComponent(clientId)}`;
  } catch (error) {
    showToast(error.message, 'error');
  }
}

let hubSyncPollTimer = null;
let hubSyncPendingIds = new Set();
let hubSyncPollStartedAt = 0;
let hubSyncBaselineAt = new Map();

function stopHubSyncPolling() {
  if (hubSyncPollTimer) {
    clearInterval(hubSyncPollTimer);
    hubSyncPollTimer = null;
  }
  hubSyncPendingIds = new Set();
  hubSyncPollStartedAt = 0;
  hubSyncBaselineAt = new Map();
}

function isClientSyncing(client) {
  return client.status === 'syncing' || client.lastSyncStatus === 'syncing';
}

function hubBatchStillPending(clients) {
  if (!hubSyncPendingIds.size) return false;
  const byId = new Map((clients || []).map((client) => [client.clientId, client]));
  for (const clientId of hubSyncPendingIds) {
    const client = byId.get(clientId);
    if (!client) continue;
    if (isClientSyncing(client)) return true;
    if (client.lastSyncStatus === 'error') continue;
    const baseline = hubSyncBaselineAt.get(clientId);
    if (baseline === client.lastSyncAt) return true;
  }
  return false;
}

async function pollHubSyncProgress() {
  if (!IS_ADMIN_HUB || !document.getElementById('client-grid')) {
    stopHubSyncPolling();
    return;
  }

  if (hubSyncPollStartedAt && Date.now() - hubSyncPollStartedAt > 15 * 60 * 1000) {
    stopHubSyncPolling();
    showToast('Some sync jobs are still running. Refresh the page in a minute.', 'error');
    return;
  }

  try {
    const data = await adminFetch('/api/clients');
    const clients = data.clients || [];
    updateHubCardsFromClients(clients);

    if (hubBatchStillPending(clients)) return;

    const pendingIds = new Set(hubSyncPendingIds);
    stopHubSyncPolling();
    const dashboard = document.getElementById('dashboard');
    if (dashboard) {
      dashboard.innerHTML = renderAdminHubPage(clients);
    }
    const failed = clients.filter((client) =>
      pendingIds.has(client.clientId) && client.lastSyncStatus === 'error',
    );
    if (failed.length) {
      showToast(`${failed.length} sync(s) failed`, 'error');
    } else {
      showToast('All clients synced', 'success');
    }
  } catch {
    // Keep polling while background jobs run.
  }
}

function startHubSyncPolling(clientIds = [], clients = []) {
  stopHubSyncPolling();
  hubSyncPendingIds = new Set(clientIds);
  hubSyncPollStartedAt = Date.now();
  hubSyncBaselineAt = new Map(
    (clients || [])
      .filter((client) => clientIds.includes(client.clientId))
      .map((client) => [client.clientId, client.lastSyncAt]),
  );
  markHubCardsSyncing(clientIds);
  pollHubSyncProgress();
  hubSyncPollTimer = setInterval(pollHubSyncProgress, 3000);
}
function markHubCardsSyncing(clientIds = []) {
  clientIds.forEach((clientId) => {
    const card = document.querySelector(`.client-card[data-client-id="${clientId}"]`);
    if (!card) return;
    const badge = card.querySelector('.status-badge');
    if (badge) {
      badge.className = 'status-badge status-syncing';
      badge.textContent = statusLabel('syncing');
    }
    const meta = card.querySelector('[data-sync-meta]');
    if (meta) meta.textContent = 'Syncing now...';
  });
}

function updateHubCardsFromClients(clients) {
  (clients || []).forEach((client) => {
    const card = document.querySelector(`.client-card[data-client-id="${client.clientId}"]`);
    if (!card) return;
    const badge = card.querySelector('.status-badge');
    if (badge) {
      badge.className = `status-badge status-${client.status}`;
      badge.textContent = statusLabel(client.status);
    }
    const meta = card.querySelector('[data-sync-meta]');
    if (meta) meta.textContent = formatRelativeSync(client.lastSyncAt, client.status);
  });
}

async function syncAllClients(button) {
  if (button) button.disabled = true;
  try {
    showToast('Syncing all clients...');
    const data = await adminFetch('/api/clients', {
      method: 'POST',
      body: JSON.stringify({ action: 'sync-all' }),
    });

    if (data.queued) {
      const count = data.count ?? (data.clientIds || []).length;
      showToast(`Syncing ${count} client${count === 1 ? '' : 's'} in background`, 'success');
      const hubData = await adminFetch('/api/clients');
      startHubSyncPolling(data.clientIds || [], hubData.clients || []);
      return;
    }

    const failed = (data.results || []).filter((row) => !row.success);
    if (failed.length) {
      showToast(`${failed.length} sync(s) failed`, 'error');
    } else {
      showToast('All clients synced', 'success');
    }
    await loadAdminHub();
  } catch (error) {
    showToast(error.message, 'error');
  } finally {
    if (button) button.disabled = false;
  }
}

async function deleteClient(clientId) {
  const label = clientId;
  const ok = window.confirm(
    `Delete "${label}" permanently?\n\nThis removes the account, GHL token, and all synced snapshot data. This cannot be undone.`,
  );
  if (!ok) return;

  const typed = window.prompt(`Type "${clientId}" to confirm deletion:`);
  if (typed !== clientId) {
    showToast('Deletion cancelled — slug did not match.', 'error');
    return;
  }

  try {
    await adminFetch(`/api/clients/${encodeURIComponent(clientId)}`, { method: 'DELETE' });
    showToast(`Deleted ${clientId}`, 'success');
    if (IS_ADMIN_HUB) {
      await loadAdminHub();
    } else {
      window.location.href = '/admin';
    }
  } catch (error) {
    showToast(error.message, 'error');
  }
}

async function syncClient(clientId, button) {
  if (button) {
    button.disabled = true;
    button.textContent = 'Syncing...';
  }
  try {
    await adminFetch(`/api/clients/${encodeURIComponent(clientId)}/sync`, { method: 'POST', body: '{}' });
    showToast('Sync completed', 'success');
    if (IS_ADMIN_HUB) await loadAdminHub();
    else if (IS_ADMIN_CLIENT) {
      await loadSetupAccount();
      if (accountCanPreviewDashboard(setupAccount)) loadDashboard(true, { background: true });
    }
    else loadDashboard(true, { background: true });
  } catch (error) {
    showToast(error.message, 'error');
  } finally {
    if (button) {
      button.disabled = false;
      const label = button.dataset.syncLabel || 'Sync';
      button.innerHTML = button.dataset.syncLabel ? `${ICON_SYNC} ${label}` : label;
    }
  }
}

function getMetricsModelLabels(account, pipelines = setupPipelines) {
  const pipelineMap = new Map((pipelines || []).map((pipeline) => [pipeline.id, pipeline.name]));
  if (account.dedupeEnabled) {
    const winName = pipelineMap.get(account.winPipelineId) || account.winPipelineId || '—';
    return {
      typeLabel: 'Funnel + deduplication',
      winLabel: `Win pipeline: ${winName}`,
    };
  }
  if (account.winPipelineId) {
    const winName = pipelineMap.get(account.winPipelineId) || account.winPipelineId;
    return {
      typeLabel: 'Simple (single win pipeline)',
      winLabel: `Win pipeline: ${winName}`,
    };
  }
  return {
    typeLabel: 'Simple (no deduplication)',
    winLabel: 'All won opportunities',
  };
}

const ICON_LAYER = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/></svg>';
