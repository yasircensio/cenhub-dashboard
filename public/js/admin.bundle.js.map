          <div class="sync-history-stat-label">Schedule</div>
          <div class="sync-history-stat-value" style="font-size:13px;font-family:monospace">${esc(summary.schedule || 'Webhook + 5m Vercel cron · daily reconcile (01:00 UTC)')}</div>
