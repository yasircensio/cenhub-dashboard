function renderStaffAdminChrome(activeTab) {
  if (!currentStaffUser) return '';
  const syncActive = activeTab === 'ghl-sync' || activeTab === 'meta-sync' || activeTab === 'fb-lead-sync';
  const metaReportsActive = activeTab === 'meta-reports' || activeTab === 'meta-reports-custom';
  const nav = `
    <nav class="staff-nav" aria-label="Admin navigation">
      <a href="/admin" class="staff-nav-link${activeTab === 'clients' ? ' is-active' : ''}">Cenhub clients</a>
      <div class="staff-nav-dropdown" data-staff-nav-dropdown="sync">
        <button type="button" class="staff-nav-link staff-nav-dropdown-trigger${syncActive ? ' is-active' : ''}" aria-expanded="false" aria-haspopup="true" onclick="toggleStaffNavDropdown(this, event)">Sync</button>
        <div class="staff-nav-dropdown-menu" role="menu">
          <a href="/admin/sync-history/ghl" class="staff-nav-dropdown-item${activeTab === 'ghl-sync' ? ' is-active' : ''}" role="menuitem">GHL sync</a>
          <a href="/admin/sync-history/meta" class="staff-nav-dropdown-item${activeTab === 'meta-sync' ? ' is-active' : ''}" role="menuitem">Meta sync</a>
          <a href="/admin/fb-lead-sync" class="staff-nav-dropdown-item${activeTab === 'fb-lead-sync' ? ' is-active' : ''}" role="menuitem">FB lead sync</a>
        </div>
      </div>
      <div class="staff-nav-dropdown" data-staff-nav-dropdown="meta-reports">
        <button type="button" class="staff-nav-link staff-nav-dropdown-trigger${metaReportsActive ? ' is-active' : ''}" aria-expanded="false" aria-haspopup="true" onclick="toggleStaffNavDropdown(this, event)">Meta reports</button>
        <div class="staff-nav-dropdown-menu" role="menu">
          <a href="/admin/meta-reports" class="staff-nav-dropdown-item${activeTab === 'meta-reports' ? ' is-active' : ''}" role="menuitem">All clients</a>
          <a href="/admin/meta-reports/custom-values" class="staff-nav-dropdown-item${activeTab === 'meta-reports-custom' ? ' is-active' : ''}" role="menuitem">Custom values</a>
        </div>
      </div>
