function setMetaReportYearLoadingBanner(toolbarSelector, year, loading) {
  const toolbar = document.querySelector(toolbarSelector);
  if (!toolbar) return;
  let banner = toolbar.querySelector('.meta-report-year-loading-banner');
  if (loading) {
    if (!banner) {
      banner = document.createElement('span');
      banner.className = 'meta-report-year-loading-banner';
      banner.setAttribute('aria-live', 'polite');
      toolbar.appendChild(banner);
    }
    banner.innerHTML = `<span class="meta-report-save-indicator-spinner"></span> Loading ${esc(year)}…`;
    banner.hidden = false;
  } else if (banner) {
    banner.hidden = true;
  }
}

function setMetaReportClientYearLoading(year, loading) {
  const page = document.querySelector('.meta-report-client-page');
  const yearSelect = document.getElementById('meta-report-year');
  if (loading) {
    if (yearSelect) yearSelect.disabled = true;
    if (page) page.classList.add('is-year-loading');
    setMetaReportYearLoadingBanner('.meta-report-client-page .meta-report-toolbar-left', year, true);
    const tabsEl = document.querySelector('.meta-report-tabs');
    if (tabsEl) {
      tabsEl.innerHTML = renderMetaReportTabsSkeleton();
      tabsEl.setAttribute('aria-busy', 'true');
    }
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) {
      panel.innerHTML = renderMetaReportMonthPanelSkeleton();
      panel.classList.add('is-loading');
    }
    destroyMetaReportCharts();
  } else {
    if (yearSelect) yearSelect.disabled = false;
    if (page) page.classList.remove('is-year-loading');
    setMetaReportYearLoadingBanner('.meta-report-client-page .meta-report-toolbar-left', year, false);
    const tabsEl = document.querySelector('.meta-report-tabs');
    if (tabsEl) tabsEl.removeAttribute('aria-busy');
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.remove('is-loading');
  }
}

function setMetaCvYearLoading(year, loading) {
  const page = document.querySelector('.sync-history-page.meta-reports-page');
  const yearSelect = document.getElementById('meta-cv-year');
  const search = document.getElementById('meta-cv-search');
  if (loading) {
    if (yearSelect) yearSelect.disabled = true;
    if (search) search.disabled = true;
    if (page) page.classList.add('is-year-loading');
    setMetaReportYearLoadingBanner('.meta-cv-toolbar-left', year, true);
    const summary = document.querySelector('.meta-cv-summary');
    if (summary) {
      summary.classList.add('is-skeleton');
      summary.innerHTML = renderMetaCvSummarySkeleton();
    }
    const legend = document.querySelector('.meta-cv-legend');
    if (legend) legend.setAttribute('aria-hidden', 'true');
    const list = document.getElementById('meta-cv-client-list');
    if (list) {
      list.innerHTML = renderMetaCvListSkeleton();
      list.setAttribute('aria-busy', 'true');
    }
    const editor = document.getElementById('meta-cv-editor');
    if (editor) {
      editor.innerHTML = renderMetaCvEditorYearSkeleton();
      editor.setAttribute('aria-busy', 'true');
    }
  } else {
    if (yearSelect) yearSelect.disabled = false;
    if (search) search.disabled = false;
    if (page) page.classList.remove('is-year-loading');
    setMetaReportYearLoadingBanner('.meta-cv-toolbar-left', year, false);
    const summary = document.querySelector('.meta-cv-summary');
    if (summary) summary.classList.remove('is-skeleton');
    const legend = document.querySelector('.meta-cv-legend');
    if (legend) legend.removeAttribute('aria-hidden');
    const list = document.getElementById('meta-cv-client-list');
    if (list) list.removeAttribute('aria-busy');
    const editor = document.getElementById('meta-cv-editor');
    if (editor) editor.removeAttribute('aria-busy');
  }
}

function setMetaReportPublicYearLoading(year, loading) {
  const page = document.querySelector('.meta-reports-page--public');
  const yearSelect = document.getElementById('meta-report-year');
  if (loading) {
    if (yearSelect) yearSelect.disabled = true;
    if (page) page.classList.add('is-year-loading');
    setMetaReportYearLoadingBanner('.meta-reports-page--public .meta-report-toolbar-left', year, true);
    const tabsEl = document.querySelector('.meta-reports-page--public .meta-report-tabs');
    if (tabsEl) {
      tabsEl.innerHTML = renderMetaReportTabsSkeleton();
      tabsEl.setAttribute('aria-busy', 'true');
    }
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) {
      panel.innerHTML = renderMetaReportMonthPanelSkeleton();
      panel.classList.add('is-loading');
    }
    destroyMetaReportCharts();
  } else {
    if (yearSelect) yearSelect.disabled = false;
    if (page) page.classList.remove('is-year-loading');
    setMetaReportYearLoadingBanner('.meta-reports-page--public .meta-report-toolbar-left', year, false);
    const tabsEl = document.querySelector('.meta-reports-page--public .meta-report-tabs');
    if (tabsEl) tabsEl.removeAttribute('aria-busy');
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.remove('is-loading');
  }
}

function bindMetaReportsClientChromeEvents(payload) {
  const clientId = payload.clientId;

  const yearSelect = document.getElementById('meta-report-year');
  if (yearSelect) {
    yearSelect.onchange = async () => {
      const option = yearSelect.selectedOptions?.[0];
      if (option?.disabled) {
        yearSelect.value = String(metaReportsState.selectedYear);
        return;
      }
      const previousYear = metaReportsState.selectedYear;
      const newYear = Number(yearSelect.value);
      if (newYear === previousYear) return;
      metaReportsState.selectedYear = newYear;
      metaReportsState.activeMonthKey = null;
      metaReportsState.comparisonYearCache = {};
      setMetaReportClientYearLoading(newYear, true);
      try {
        if (linkedReportsState.origin === 'google-ads' && linkedReportsState.metaPayload) {
          const clientId = linkedReportsState.metaPayload.clientId;
          const nextPayload = await adminFetch(`/api/meta-reports/clients/${encodeURIComponent(clientId)}?year=${encodeURIComponent(newYear)}`);
          linkedReportsState.metaPayload = nextPayload;
          syncMetaReportSelectedYear(nextPayload, { disableUnavailable: true });
          if (Number(metaReportsState.selectedYear) !== Number(nextPayload.year)) {
            metaReportsState.selectedYear = nextPayload.year;
          }
          applyLinkedAdminPlatformState('meta');
          const page = document.querySelector('.meta-report-client-page');
          if (page) page.innerHTML = renderLinkedAdminEditorInner();
          bindLinkedAdminEditorEvents();
          requestAnimationFrame(() => {
            mountMetaReportCharts(nextPayload, { editable: true, clientId });
          });
        } else {
          await loadMetaReportsClientPage({ silent: true });
        }
      } catch (error) {
        metaReportsState.selectedYear = previousYear;
        if (yearSelect) yearSelect.value = String(previousYear);
        if (linkedReportsState.origin === 'google-ads' && linkedReportsState.metaPayload) {
          applyLinkedAdminPlatformState('meta');
          const page = document.querySelector('.meta-report-client-page');
          if (page) page.innerHTML = renderLinkedAdminEditorInner();
          bindLinkedAdminEditorEvents();
        } else {
          await loadMetaReportsClientPage({ silent: true });
        }
        showToast(error.message || 'Load failed', 'error');
      } finally {
        setMetaReportClientYearLoading(newYear, false);
      }
    };
  }

  bindMetaReportCopyButtons();
  bindMetaReportBackfillButton(clientId);
  bindMetaReportBottomlineSummaryEvents(payload);
  bindMetaReportExcelSheetSummaryEvents(payload);
  bindMetaReportShareEvents(payload);
}

function bindMetaReportsClientEvents(payload) {
  bindMetaReportsClientChromeEvents(payload);
  bindMetaReportsClientTabEvents(payload);
  rebindMetaReportMonthPanelEvents(payload.clientId, payload);
  if (isMetaReportGhlListClient(payload.settings || {})) {
    bindMetaReportToplineSourceControl(payload.clientId, payload);
  }
  bindLinkedReportChrome();
}

function bindMetaReportsClientEditEvents(clientId, payload) {
  const refreshBtn = document.getElementById('meta-report-refresh-meta');
  if (refreshBtn) {
    refreshBtn.onclick = async () => {
      refreshBtn.disabled = true;
      try {
        const monthKey = metaReportsState.activeMonthKey;
        const result = await adminFetch(`/api/meta-reports/clients/${encodeURIComponent(clientId)}/months/${encodeURIComponent(monthKey)}/refresh`, {
          method: 'POST',
        });
        refreshMetaReportMonthPanel(result.monthPayload);
        showToast('Meta data refreshed', 'success');
      } catch (error) {
        showToast(error.message || 'Meta refresh failed', 'error');
      } finally {
        refreshBtn.disabled = false;
      }
    };
  }

  const saveBtn = document.getElementById('meta-report-save-month');
  if (saveBtn) {
    saveBtn.onclick = async () => {
      saveBtn.disabled = true;
      try {
        const monthKey = metaReportsState.activeMonthKey;
        const monthPayload = payload?.months?.[monthKey];
        const settings = payload?.settings || {};
        const globalMode = resolveClientToplineMode(settings);
        const toplineSource = resolveMetaToplineSource(monthPayload, settings);
        const manualMode = isMetaReportGhlListClient(settings)
          && globalMode === 'cenhub'
          && toplineSource === 'manual';
        const body = {
          periodStart: document.getElementById('meta-report-period-start')?.value,
          periodEnd: document.getElementById('meta-report-period-end')?.value,
          wonLeads: document.getElementById('meta-report-won-leads')?.value === ''
            ? null
            : Number(document.getElementById('meta-report-won-leads')?.value),
          avgLeadValue: document.getElementById('meta-report-avg-lead-value')?.value === ''
            ? null
            : Number(document.getElementById('meta-report-avg-lead-value')?.value),
          avgProfitPerWon: document.getElementById('meta-report-avg-profit')?.value === ''
            ? null
            : Number(document.getElementById('meta-report-avg-profit')?.value),
        };
        if (manualMode) {
          body.toplineSource = 'manual';
          body.manualOverride = true;
          body.manualLeads = document.getElementById('meta-report-leads')?.value === ''
            ? null
            : Number(document.getElementById('meta-report-leads')?.value);
        }
        const result = await adminFetch(`/api/meta-reports/clients/${encodeURIComponent(clientId)}/months/${encodeURIComponent(monthKey)}`, {
          method: 'PUT',
          body: JSON.stringify(body),
        });
        refreshMetaReportMonthPanel(result.monthPayload);
        showToast('Month saved', 'success');
      } catch (error) {
        showToast(error.message || 'Save failed', 'error');
      } finally {
        saveBtn.disabled = false;
      }
    };
  }
}

function bindPublicMetaReportTabEvents(payload) {
  document.querySelectorAll('[data-meta-month-tab]').forEach((button) => {
    button.onclick = () => {
      switchMetaReportMonthTab(button.getAttribute('data-meta-month-tab'), { editable: false });
    };
  });
}

function bindPublicMetaReportEvents(payload) {
  bindPublicMetaReportTabEvents(payload);
  bindLinkedReportChrome({ publicView: true });
  const yearSelect = document.getElementById('meta-report-year');
  if (yearSelect) {
    yearSelect.onchange = async () => {
      const option = yearSelect.selectedOptions?.[0];
      if (option?.disabled) {
        yearSelect.value = String(metaReportsState.selectedYear);
        return;
      }
      const previousYear = metaReportsState.selectedYear;
      const newYear = Number(yearSelect.value);
      if (newYear === previousYear) return;
      metaReportsState.selectedYear = newYear;
      metaReportsState.activeMonthKey = null;
      metaReportsState.comparisonYearCache = {};
      setMetaReportPublicYearLoading(newYear, true);
      try {
        await loadPublicMetaReportPage({ silent: true });
      } catch (error) {
        metaReportsState.selectedYear = previousYear;
        if (yearSelect) yearSelect.value = String(previousYear);
        await loadPublicMetaReportPage({ silent: true });
        showToast(error.message || 'Load failed', 'error');
      } finally {
        setMetaReportPublicYearLoading(newYear, false);
      }
    };
  }
}

async function loadMetaReportsHubPage() {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard) return;
  const user = await fetchStaffMe();
  if (!user) {
    dashboard.innerHTML = `
      ${renderBrandTopbar('')}
      ${wrapDashboardShell('<div class="sync-history-empty" style="padding:24px;text-align:center"><a class="admin-btn admin-btn--primary" href="/login?next=' + encodeURIComponent(window.location.pathname) + '">Sign in</a></div>')}
    `;
    return;
  }
  currentStaffUser = user;

  if (!metaReportsState.hubMounted) {
    dashboard.innerHTML = renderAdminHubSkeletonPage('meta-reports');
  }

  try {
    const data = await adminFetch('/api/meta-reports?filter=all');
    metaReportsState.dashboardData = data;
    const viewData = getMetaReportsHubView(data, metaReportsState.filter, metaReportsState.searchQuery);
    if (!metaReportsState.hubMounted) {
      dashboard.innerHTML = renderMetaReportsHubPage(viewData);
      metaReportsState.hubMounted = true;
      bindMetaReportsHubEvents();
    } else {
      updateMetaReportsHubDom(viewData);
    }
  } catch (error) {
    if (!metaReportsState.hubMounted) {
      dashboard.innerHTML = `
        ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
        ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
      `;
    } else {
      showToast(error.message || 'Load failed', 'error');
    }
  }
}

async function loadMetaReportsClientPage({ silent = false } = {}) {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard) return;
  const user = await fetchStaffMe();
  if (!user) {
    window.location.href = `/login?next=${encodeURIComponent(window.location.pathname)}`;
    return;
  }
  currentStaffUser = user;
  const clientId = CLIENT_SLUG;

  if (!metaReportsState.clientPageMounted) {
    dashboard.innerHTML = `
      ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
      ${wrapDashboardShell('<div class="loading-state"><div class="spinner"></div><p>Loading report editor...</p></div>')}
    `;
  } else if (!silent) {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.add('is-loading');
  }

  try {
    const payload = await adminFetch(`/api/meta-reports/clients/${encodeURIComponent(clientId)}?year=${encodeURIComponent(metaReportsState.selectedYear)}`);
    syncMetaReportSelectedYear(payload, { disableUnavailable: true });
    if (Number(metaReportsState.selectedYear) !== Number(payload.year)) {
      return loadMetaReportsClientPage({ silent: true });
    }
    if (!metaReportsState.activeMonthKey) {
      metaReportsState.activeMonthKey = payload.monthKeys?.[payload.monthKeys.length - 1] || null;
    }
    await ensureMetaReportScenarioSource(payload, { editable: true });
    const googlePayload = await fetchLinkedPartnerPayload(payload, 'meta');
    hydrateAdminLinkedReports({ origin: 'meta', metaPayload: payload, googlePayload });
    if (googlePayload) {
      googleAdsReportsState.clientPayload = googlePayload;
      googleAdsReportsState.selectedYear = Number(googlePayload.year) || googleAdsReportsState.selectedYear;
      if (!googleAdsReportsState.activeMonthKey || !(googlePayload.monthKeys || []).includes(googleAdsReportsState.activeMonthKey)) {
        googleAdsReportsState.activeMonthKey = googlePayload.monthKeys?.[googlePayload.monthKeys.length - 1] || null;
      }
    }
    const viewingGoogle = isGoogleAdsEditorActive() && googlePayload;
    const activePayload = viewingGoogle ? googleAdsPayloadToMetaUiShape(googlePayload) : payload;
    if (viewingGoogle) {
      metaReportsState.clientPayload = activePayload;
      metaReportsState.activeMonthKey = googleAdsReportsState.activeMonthKey;
      hydrateMetaReportSpendChartType(activePayload);
      hydrateMetaReportScenarioSettings(activePayload);
    }
    if (!metaReportsState.clientPageMounted) {
      metaReportsState.clientPayload = viewingGoogle ? activePayload : payload;
      metaReportsState.clientReportSettingsExpanded = false;
      metaReportsState.clientShareExpanded = false;
      if (!viewingGoogle) {
        hydrateMetaReportSpendChartType(payload);
        hydrateMetaReportScenarioSettings(payload);
      }
      dashboard.innerHTML = renderMetaReportsClientPage(payload);
      metaReportsState.clientPageMounted = true;
      bindLinkedAdminEditorEvents();
      mountMetaReportCharts(activePayload, {
        editable: true,
        clientId: viewingGoogle ? googlePayload.clientId : payload.clientId,
      });
    } else if (viewingGoogle) {
      const page = document.querySelector('.meta-report-client-page');
      if (page) page.innerHTML = renderLinkedAdminEditorInner();
      bindLinkedAdminEditorEvents();
    } else {
      metaReportsState.clientPayload = payload;
      updateMetaReportsClientContent(payload);
      bindLinkedReportChrome();
    }
  } catch (error) {
    if (!metaReportsState.clientPageMounted) {
      dashboard.innerHTML = `
        ${renderBrandTopbar(renderStaffAdminChrome('meta-reports'))}
        ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
      `;
    } else if (silent) {
      throw error;
    } else {
      showToast(error.message || 'Load failed', 'error');
    }
  } finally {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.remove('is-loading');
  }
}

const googleAdsReportsState = {
  filter: 'enabled',
  searchQuery: '',
  dashboardData: null,
  hubMounted: false,
  clientPageMounted: false,
  clientPayload: null,
  activeMonthKey: null,
  selectedYear: new Date().getFullYear(),
  reportViewMode: 'monthly',
};

function googleAdsSettingsToMetaUx(settings = {}) {
  return {
    metaReportEnabled: settings.googleAdsReportEnabled,
    metaReportShowBottomline: settings.googleAdsReportShowBottomline,
    metaReportFeeEnabled: settings.googleAdsReportFeeEnabled,
    metaReportFeeMode: settings.googleAdsReportFeeMode,
    metaReportFeePercent: settings.googleAdsReportFeePercent,
    metaReportMarketingFeeAmount: settings.googleAdsReportMarketingFeeAmount,
    metaReportSlug: settings.googleAdsReportSlug,
    metaReportAccessToken: settings.googleAdsReportAccessToken,
    metaReportExcelSheetUrl: settings.googleAdsReportExcelSheetUrl,
    metaReportSpendChartType: settings.googleAdsReportSpendChartType,
    metaReportScenarioMonthWindow: settings.googleAdsReportScenarioMonthWindow,
    metaReportScenarioSmoothUneven: settings.googleAdsReportScenarioSmoothUneven,
    metaReportScenarioBlendHistory: settings.googleAdsReportScenarioBlendHistory,
    metaReportScenarioIncludeTrend: settings.googleAdsReportScenarioIncludeTrend,
    metaReportBudgetMultiplier: settings.googleAdsReportBudgetMultiplier,
    metaReportBudgetBaseline: settings.googleAdsReportBudgetBaseline,
  };
}

function metaUxPatchToGoogleAds(patch = {}) {
  const out = {};
  if (patch.metaReportEnabled !== undefined) out.googleAdsReportEnabled = patch.metaReportEnabled;
  if (patch.metaReportShowBottomline !== undefined) out.googleAdsReportShowBottomline = patch.metaReportShowBottomline;
  if (patch.metaReportFeeEnabled !== undefined) out.googleAdsReportFeeEnabled = patch.metaReportFeeEnabled;
  if (patch.metaReportFeeMode !== undefined) out.googleAdsReportFeeMode = patch.metaReportFeeMode;
  if (patch.metaReportFeePercent !== undefined) out.googleAdsReportFeePercent = patch.metaReportFeePercent;
  if (patch.metaReportMarketingFeeAmount !== undefined) {
    out.googleAdsReportMarketingFeeAmount = patch.metaReportMarketingFeeAmount;
  }
  if (patch.metaReportSlug !== undefined) out.googleAdsReportSlug = patch.metaReportSlug;
  if (patch.metaReportExcelSheetUrl !== undefined) {
    out.googleAdsReportExcelSheetUrl = patch.metaReportExcelSheetUrl;
  }
  if (patch.metaReportSpendChartType !== undefined) {
    out.googleAdsReportSpendChartType = patch.metaReportSpendChartType;
  }
  if (patch.metaReportScenarioMonthWindow !== undefined) {
    out.googleAdsReportScenarioMonthWindow = patch.metaReportScenarioMonthWindow;
  }
  if (patch.metaReportScenarioSmoothUneven !== undefined) {
    out.googleAdsReportScenarioSmoothUneven = patch.metaReportScenarioSmoothUneven;
  }
  if (patch.metaReportScenarioBlendHistory !== undefined) {
    out.googleAdsReportScenarioBlendHistory = patch.metaReportScenarioBlendHistory;
  }
  if (patch.metaReportScenarioIncludeTrend !== undefined) {
    out.googleAdsReportScenarioIncludeTrend = patch.metaReportScenarioIncludeTrend;
  }
  if (patch.metaReportBudgetMultiplier !== undefined) {
    out.googleAdsReportBudgetMultiplier = patch.metaReportBudgetMultiplier;
  }
  if (patch.metaReportBudgetBaseline !== undefined) {
    out.googleAdsReportBudgetBaseline = patch.metaReportBudgetBaseline;
  }
  if (patch.rotateAccessToken) out.rotateAccessToken = true;
  if (Object.prototype.hasOwnProperty.call(patch, 'linkedMetaClientId')) {
    out.linkedMetaClientId = patch.linkedMetaClientId;
  }
  return out;
}

function googleAdsMonthToMetaUiShape(month) {
  if (!month) return null;
  const google = month.google || {};
  const spend = Number(google.spend) || 0;
  const impressions = Number(google.impressions) || 0;
  const emptyMonth = !month.googleFetchedAt && spend <= 0 && impressions <= 0;
  const cpm = google.cpm != null
    ? Number(google.cpm)
    : (impressions > 0 ? Math.round((spend / impressions) * 100000) / 100 : 0);
  return {
    ...month,
    meta: {
      spend,
      cpm,
      impressions,
      reach: 0,
      clicks: Number(google.clicks) || 0,
      conversionRatePercent: Number(google.ctr) || 0,
      emptyMonth,
    },
    metaFetchedAt: month.googleFetchedAt || null,
    inputs: month.inputs || {
      wonLeads: month.topline?.wonLeads,
      avgLeadValue: month.topline?.avgLeadValue,
      avgProfitPerWon: month.topline?.avgProfitPerWon,
    },
  };
}

function googleAdsPayloadToMetaUiShape(payload) {
  if (!payload) return payload;
  const settings = payload.settings || {};
  return {
    ...payload,
    reportUrl: payload.reportUrl || null,
    settings: googleAdsSettingsToMetaUx(settings),
    months: Object.fromEntries(
      Object.entries(payload.months || {}).map(([key, month]) => [key, googleAdsMonthToMetaUiShape(month)]),
    ),
  };
}

function googleAdsMonthsNeedingBackfill(payload) {
  const monthKeys = payload?.monthKeys || [];
  return monthKeys.filter((key) => !payload.months?.[key]?.googleFetchedAt);
}

async function patchGoogleAdsReportSettings(clientId, patch, { fast = false } = {}) {
  const path = `/api/google-ads-reports/clients/${encodeURIComponent(clientId)}/settings`;
  const body = metaUxPatchToGoogleAds(patch);
  const options = { method: 'PATCH', body: JSON.stringify(body) };
  if (fast) return adminFetch(path, options);
  return adminFetchWithRetry(path, options, { retries: 2, timeoutMs: 20000 });
}

function renderGoogleAdsReportYearSelectOptions(payload, { disableUnavailable = false } = {}) {
  const selectedYear = Number(googleAdsReportsState.selectedYear) || Number(payload?.year);
  return getMetaReportYearOptions(payload).map(({ year, available }) => {
    const disabled = disableUnavailable && !available;
    return `<option value="${year}"${Number(selectedYear) === year ? ' selected' : ''}${disabled ? ' disabled' : ''}>${year}${!available ? ' (no data)' : ''}</option>`;
  }).join('');
}

function renderGoogleAdsReportClientControlPanel(payload) {
  const uiPayload = googleAdsPayloadToMetaUiShape(payload);
  const settings = uiPayload.settings || {};
  const shareExpanded = metaReportsState.clientShareExpanded;
  const reportExpanded = metaReportsState.clientReportSettingsExpanded;
  const excelExpanded = metaReportsState.clientExcelSheetExpanded;
  const hasLink = Boolean(uiPayload.reportUrl);
  const statusHidden = shareExpanded || reportExpanded || excelExpanded;
  const missing = googleAdsMonthsNeedingBackfill(payload);
  const resyncLabel = missing.length
    ? `${ICON_SYNC} Backfill ${missing.length} month${missing.length === 1 ? '' : 's'} from Google Ads`
    : `${ICON_SYNC} Re-sync year from Google Ads`;

  return `
    <div class="meta-report-control-panel${shareExpanded ? ' is-editing-share' : ''}${reportExpanded ? ' is-editing-report' : ''}${settings.metaReportEnabled ? '' : ' is-share-disabled'}" id="meta-report-control-panel">
      <div class="meta-report-control-bar">
        <div class="meta-report-control-bar-left meta-report-toolbar-left">
          <label class="meta-report-year-field">Year
            <select id="meta-report-year" class="admin-select">
              ${renderGoogleAdsReportYearSelectOptions(payload, { disableUnavailable: true })}
            </select>
          </label>
          <div class="meta-report-backfill-wrap">
            <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="meta-report-backfill">${resyncLabel}</button>
            <span class="meta-report-backfill-progress" id="meta-report-backfill-progress"></span>
          </div>
        </div>
        <div class="meta-report-control-bar-actions meta-report-toolbar-actions">
          <span class="meta-report-save-indicator" id="meta-report-save-indicator"><span class="meta-report-save-indicator-spinner"></span> Saving…</span>
          ${hasLink ? `<button type="button" class="admin-btn admin-btn--secondary" id="meta-report-toolbar-copy-link" data-copy-report-url="${esc(uiPayload.reportUrl)}"${settings.metaReportEnabled ? '' : ' disabled'}>Copy link</button>` : ''}
          ${resolveMetaReportExcelSheetUrl(settings) ? `<a class="admin-btn admin-btn--secondary" id="meta-report-excel-sheet-toolbar-btn" href="${esc(resolveMetaReportExcelSheetUrl(settings))}" target="_blank" rel="noopener noreferrer">See Excel sheet</a>` : '<a class="admin-btn admin-btn--secondary" id="meta-report-excel-sheet-toolbar-btn" href="#" target="_blank" rel="noopener noreferrer" hidden>See Excel sheet</a>'}
          ${renderLinkedReportLinkControl()}
        </div>
      </div>
      ${hasLink ? `
        <div class="meta-report-control-status-rows"${statusHidden ? ' hidden' : ''} id="meta-report-control-status">
          <div class="meta-report-control-status-grid">
            ${renderMetaReportShareSummary(uiPayload)}
            ${renderMetaReportBottomlineFeeSummary(settings, 'meta-report')}
          </div>
          <div class="meta-report-control-status-grid">
            ${renderMetaReportExcelSheetSummary(settings)}
          </div>
        </div>
      ` : `
        <p class="meta-report-share-empty">Share link will appear once this client is enabled.</p>
      `}
    </div>
  `;
}

function refreshGoogleAdsReportClientShareUi(payload) {
  const uiPayload = googleAdsPayloadToMetaUiShape(payload);
  refreshMetaReportClientShareUi(uiPayload);
}

function bindGoogleAdsReportShareEvents(payload) {
  const uiPayload = googleAdsPayloadToMetaUiShape(payload);
  const clientId = payload.clientId;

  bindMetaReportCopyButtons();

  const rotateBtn = document.getElementById('meta-report-rotate-token');
  if (rotateBtn) {
    rotateBtn.onclick = async () => {
      if (!window.confirm('Rotate the share link? The old link will stop working.')) return;
      rotateBtn.disabled = true;
      try {
        const result = await patchGoogleAdsReportSettings(clientId, { rotateAccessToken: true });
        const settings = result.settings || {};
        const currentPayload = googleAdsReportsState.clientPayload || payload;
        currentPayload.reportUrl = settings.reportUrl || currentPayload.reportUrl;
        if (settings) currentPayload.settings = { ...currentPayload.settings, ...settings };
        googleAdsReportsState.clientPayload = currentPayload;
        refreshGoogleAdsReportClientShareUi(currentPayload);
        showToast('Share link rotated', 'success');
      } catch (error) {
        showToast(error.message || 'Rotate failed', 'error');
      } finally {
        const btn = document.getElementById('meta-report-rotate-token');
        if (btn) btn.disabled = false;
      }
    };
  }

  const editBtn = document.getElementById('meta-report-share-edit');
  if (editBtn) {
    editBtn.onclick = () => openGoogleAdsReportShareModal(payload);
  }

  const saveBtn = document.getElementById('meta-report-share-save');
  if (saveBtn) {
    saveBtn.onclick = async () => {
      const input = document.getElementById('meta-report-share-slug');
      const normalized = normalizeMetaReportSlugInput(input?.value);
      if (!normalized || normalized.length < 2) {
        showToast('Enter a valid slug (at least 2 characters).', 'error');
        return;
      }
      saveBtn.disabled = true;
      try {
        const result = await patchGoogleAdsReportSettings(clientId, { metaReportSlug: normalized });
        const settings = result.settings || {};
        const currentPayload = googleAdsReportsState.clientPayload || payload;
        currentPayload.settings = { ...currentPayload.settings, ...settings };
        currentPayload.reportUrl = settings.reportUrl || null;
        googleAdsReportsState.clientPayload = currentPayload;
        refreshGoogleAdsReportClientShareUi(currentPayload);
        closeMetaReportModal();
        showToast('Share link slug saved', 'success');
      } catch (error) {
        showToast(error.message || 'Save failed', 'error');
      } finally {
        const btn = document.getElementById('meta-report-share-save');
        if (btn) btn.disabled = false;
      }
    };
  }

  const slugInput = document.getElementById('meta-report-share-slug');
  if (slugInput) {
    slugInput.oninput = () => {
      slugInput.value = normalizeMetaReportSlugInput(slugInput.value);
    };
  }

  const previewToggle = document.querySelector('[data-meta-client-preview]');
  if (previewToggle) {
    let previewSaveSeq = 0;
    previewToggle.onchange = async () => {
      const seq = ++previewSaveSeq;
      const enabled = previewToggle.checked;
      const previous = !enabled;
      const currentPayload = googleAdsReportsState.clientPayload || payload;
      applyMetaReportEnabledUi(googleAdsPayloadToMetaUiShape(currentPayload), enabled);
      const switchEl = previewToggle.closest('.meta-hub-switch');
      switchEl?.classList.add('is-saving');
      try {
        const result = await patchGoogleAdsReportSettings(clientId, { metaReportEnabled: enabled }, { fast: true });
        if (seq !== previewSaveSeq) return;
        const settings = result.settings || {};
        currentPayload.settings = { ...currentPayload.settings, ...settings };
        currentPayload.reportUrl = settings.reportUrl ?? currentPayload.reportUrl;
        googleAdsReportsState.clientPayload = currentPayload;
        applyMetaReportEnabledUi(googleAdsPayloadToMetaUiShape(currentPayload), Boolean(settings.googleAdsReportEnabled));
        showToast(enabled ? 'Client preview enabled' : 'Client preview disabled', 'success');
      } catch (error) {
        if (seq !== previewSaveSeq) return;
        applyMetaReportEnabledUi(googleAdsPayloadToMetaUiShape(currentPayload), previous);
        previewToggle.checked = previous;
        showToast(error.message || 'Update failed', 'error');
      } finally {
        if (seq === previewSaveSeq) switchEl?.classList.remove('is-saving');
      }
    };
  }

  bindGoogleAdsReportBottomlineSummaryEvents(payload);
}

function openGoogleAdsReportShareModal(payload) {
  metaReportsState.clientShareExpanded = true;
  openMetaReportModal(renderMetaReportShareModalContent(googleAdsPayloadToMetaUiShape(payload)));
  bindGoogleAdsReportShareEvents(payload);
}

function openGoogleAdsReportBottomlineModal(payload) {
  metaReportsState.clientReportSettingsExpanded = true;
  syncMetaReportControlPanelUi();
  const uiPayload = googleAdsPayloadToMetaUiShape(payload);
  openMetaReportModal(renderMetaReportBottomlineModalContent(uiPayload));
  bindMetaReportBottomlineFeeEvents(payload.clientId, 'meta-report', async (patch, revert) => {
    try {
      const result = await patchGoogleAdsReportSettings(payload.clientId, patch);
      const settings = result.settings || {};
      const currentPayload = googleAdsReportsState.clientPayload || payload;
      currentPayload.settings = { ...currentPayload.settings, ...settings };
      googleAdsReportsState.clientPayload = currentPayload;
      const uiSettings = googleAdsSettingsToMetaUx(currentPayload.settings);
      metaReportsState.clientPayload = googleAdsPayloadToMetaUiShape(currentPayload);
      syncMetaReportBottomlineFeeDom(uiSettings, 'meta-report');
      updateMetaReportBottomlineFeeSummary(uiSettings, 'meta-report');
      bindGoogleAdsReportBottomlineSummaryEvents(currentPayload);
      showToast(
        Object.prototype.hasOwnProperty.call(patch, 'metaReportShowBottomline')
          ? (patch.metaReportShowBottomline ? 'Bottomline enabled' : 'Bottomline disabled')
          : 'Bottomline settings saved',
        'success',
      );
    } catch (error) {
      if (typeof revert === 'function') revert();
      showToast(error.message || 'Save failed', 'error');
    }
  });
}

function bindGoogleAdsReportBottomlineSummaryEvents(payload) {
  const editBtn = document.getElementById('meta-report-fee-edit');
  if (!editBtn || !payload) return;
  editBtn.onclick = () => openGoogleAdsReportBottomlineModal(payload);
}

function openGoogleAdsReportExcelSheetModal(payload) {
  metaReportsState.clientExcelSheetExpanded = true;
  syncMetaReportControlPanelUi();
  openMetaReportModal(
    renderMetaReportExcelSheetModalContent(googleAdsPayloadToMetaUiShape(payload)),
    { wide: true },
  );
  bindGoogleAdsReportExcelSheetModalEvents(payload);
}

function bindGoogleAdsReportExcelSheetSummaryEvents(payload) {
  const editBtn = document.getElementById('meta-report-excel-sheet-edit');
  if (!editBtn || !payload) return;
  editBtn.onclick = () => openGoogleAdsReportExcelSheetModal(payload);
}

function bindGoogleAdsReportExcelSheetModalEvents(payload) {
  const input = document.getElementById('meta-report-excel-sheet-url');
  const saveBtn = document.getElementById('meta-report-excel-sheet-save');
  if (!input || !saveBtn) return;

  const save = async () => {
    const previous = resolveMetaReportExcelSheetUrl(
      googleAdsSettingsToMetaUx(googleAdsReportsState.clientPayload?.settings || {}),
    );
    const nextValue = input.value.trim();
    saveBtn.disabled = true;
    try {
      const result = await patchGoogleAdsReportSettings(payload.clientId, {
        metaReportExcelSheetUrl: nextValue || null,
      });
      const settings = result.settings || {};
      const currentPayload = googleAdsReportsState.clientPayload || payload;
      currentPayload.settings = { ...currentPayload.settings, ...settings };
      googleAdsReportsState.clientPayload = currentPayload;
      metaReportsState.clientPayload = googleAdsPayloadToMetaUiShape(currentPayload);
      updateMetaReportExcelSheetSummary(metaReportsState.clientPayload.settings);
      syncMetaReportExcelSheetUi(metaReportsState.clientPayload.settings);
      bindGoogleAdsReportExcelSheetSummaryEvents(currentPayload);
      closeMetaReportModal();
      showToast(nextValue ? 'Excel sheet link saved' : 'Excel sheet link removed', 'success');
    } catch (error) {
      input.value = previous || '';
      showToast(error.message || 'Could not save Excel sheet link', 'error');
    } finally {
      saveBtn.disabled = false;
    }
  };

  saveBtn.onclick = save;
  input.onkeydown = (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      save();
    }
  };
}

function bindGoogleAdsReportBackfillButton(clientId) {
  const backfillBtn = document.getElementById('meta-report-backfill');
  if (!backfillBtn) return;
  backfillBtn.onclick = async () => {
    const payload = googleAdsReportsState.clientPayload;
    const missing = googleAdsMonthsNeedingBackfill(payload);
    const targets = missing.length ? missing : (payload?.monthKeys || []);
    if (!targets.length) return;
    backfillBtn.disabled = true;
    const progressEl = document.getElementById('meta-report-backfill-progress');
    let done = 0;
    let failed = 0;
    for (const monthKey of targets) {
      done += 1;
      if (progressEl) {
        progressEl.textContent = `Fetching ${metaMonthLabel(monthKey)} ${monthKey.slice(0, 4)}… (${done}/${targets.length})`;
      }
      try {
        await adminFetch(`/api/google-ads-reports/clients/${encodeURIComponent(clientId)}/months/${encodeURIComponent(monthKey)}/refresh`, {
          method: 'POST',
        });
      } catch (error) {
        failed += 1;
      }
    }
    if (progressEl) progressEl.textContent = '';
    if (failed) {
      showToast(`Synced ${done - failed}/${targets.length} months. ${failed} failed (check Google Ads access).`, 'error');
    } else {
      showToast(`Synced ${targets.length} month${targets.length === 1 ? '' : 's'} from Google Ads`, 'success');
    }
    await reloadCurrentLinkedEditor();
  };
}

function renderGoogleAdsReportMonthBody(monthPayload, { editable = false, yearPayload = null, activeMonthKey = null } = {}) {
  const tabMonthKey = activeMonthKey || monthPayload?.monthKey || null;
  const tabBounds = tabMonthKey ? metaReportMonthBounds(tabMonthKey) : null;
  let editPanelHtml = '';
  if (editable && monthPayload && !monthPayload.meta?.emptyMonth && tabBounds) {
    editPanelHtml = `
      <div class="meta-report-edit-panel" id="meta-report-edit-panel">
        <div class="meta-report-edit-panel-head">
          <h3>Edit month inputs · ${esc(metaMonthLabel(tabMonthKey))}</h3>
        </div>
        <p class="meta-report-edit-note">These fields drive Topline and Bottomline KPI'er. Ad spend comes from Google Ads.</p>
        <div class="meta-report-edit-grid">
          <label>Period start<input type="date" id="meta-report-period-start" value="${esc(tabBounds.start)}" /></label>
          <label>Period end<input type="date" id="meta-report-period-end" value="${esc(tabBounds.end)}" /></label>
          <label class="meta-cv-value-field is-locked">Number of leads<input type="number" step="any" id="meta-report-leads" value="${esc(monthPayload.topline?.leads ?? '')}" readonly disabled tabindex="-1" aria-readonly="true" /></label>
          <label>Won leads<input type="number" step="any" id="meta-report-won-leads" value="${esc(monthPayload.topline?.wonLeads ?? '')}" /></label>
          <label>Avg lead value<input type="number" step="any" id="meta-report-avg-lead-value" value="${esc(monthPayload.topline?.avgLeadValue ?? '')}" /></label>
          <label>Avg profit per won<input type="number" step="any" id="meta-report-avg-profit" value="${esc(monthPayload.inputs?.avgProfitPerWon ?? '')}" /></label>
        </div>
        <div class="meta-report-edit-actions">
          <button type="button" class="admin-btn admin-btn--ghost" id="meta-report-refresh-meta">${ICON_SYNC} Refresh from Google Ads</button>
          <button type="button" class="admin-btn admin-btn--primary" id="meta-report-save-month">Save month</button>
        </div>
      </div>
    `;
  }

  const previewMonthKey = activeMonthKey || monthPayload?.monthKey || null;
  const previewLabel = editable
    ? (previewMonthKey ? `Report preview · ${metaMonthLabel(previewMonthKey)}` : 'Report preview')
    : (previewMonthKey ? `Report · ${metaMonthLabel(previewMonthKey)}` : 'Report');
  const viewMode = metaReportsState.reportViewMode || 'monthly';
  const showYearVisuals = shouldShowMetaReportYearVisuals(monthPayload, yearPayload, { editable });
  const showComparison = editable && showYearVisuals;
  const previewHtml = monthPayload && !monthPayload.meta?.emptyMonth ? `
    <div class="meta-report-preview-card">
      <div class="meta-report-preview-card-label">${previewLabel}</div>
      ${renderMetaReportHighlightStrip(monthPayload)}
    </div>
  ` : '';

  const tablesHtml = renderMetaReportMonthTables(monthPayload, { editable, adGroupTitle: 'Google ads' });
  const chartsPanel = showYearVisuals ? renderMetaReportChartsPanel({ editable }) : '';
  const scenarioCard = editable && showYearVisuals ? renderMetaReportScenarioCard() : '';
  const viewTabsHtml = showComparison ? renderMetaReportViewModeTabs() : '';

  let bodyHtml;
  if (showYearVisuals) {
    bodyHtml = `
      <div class="meta-report-view-panel${!showComparison || viewMode === 'monthly' ? ' is-active' : ''}" data-report-view-panel="monthly" role="tabpanel"${!showComparison || viewMode === 'monthly' ? '' : ' hidden'}>
        <div class="meta-report-content-layout">
          <div class="meta-report-content-main">${tablesHtml}</div>
          ${chartsPanel}
        </div>
      </div>
      ${showComparison ? `
      <div class="meta-report-view-panel${viewMode === 'comparison' ? ' is-active' : ''}" data-report-view-panel="comparison" role="tabpanel"${viewMode === 'comparison' ? '' : ' hidden'}>
        ${renderMetaReportComparisonView()}
      </div>` : ''}
      ${scenarioCard}
    `;
  } else {
    bodyHtml = `<div class="meta-report-content-main">${tablesHtml}</div>`;
  }

  return `${editPanelHtml}${previewHtml}${viewTabsHtml}${bodyHtml}`;
}

function syncGoogleAdsReportMonthPanelDom(monthPayload, options = {}, yearPayload = null) {
  const payload = yearPayload || googleAdsReportsState.clientPayload;
  const uiMonth = googleAdsMonthToMetaUiShape(monthPayload);
  const uiPayload = payload ? googleAdsPayloadToMetaUiShape(payload) : null;
  const panel = document.getElementById('meta-report-month-panel');
  if (!panel) return;
  if (uiPayload) {
    metaReportsState.clientPayload = uiPayload;
    hydrateMetaReportSpendChartType(uiPayload);
    hydrateMetaReportScenarioSettings(uiPayload);
  }
  panel.innerHTML = renderGoogleAdsReportMonthBody(uiMonth, {
    ...options,
    yearPayload: uiPayload,
    activeMonthKey: googleAdsReportsState.activeMonthKey || uiMonth?.monthKey || null,
  });
  requestAnimationFrame(() => {
    mountMetaReportCharts(uiPayload, {
      editable: Boolean(options.editable),
      clientId: payload?.clientId || null,
    });
  });
}

function refreshGoogleAdsReportMonthPanel(monthPayload) {
  const payload = googleAdsReportsState.clientPayload;
  if (!payload || !googleAdsReportsState.activeMonthKey) return;
  payload.months = payload.months || {};
  payload.months[googleAdsReportsState.activeMonthKey] = monthPayload;
  syncGoogleAdsReportMonthPanelDom(
    monthPayload,
    { editable: true, yearPayload: googleAdsPayloadToMetaUiShape(payload) },
    payload,
  );
  bindGoogleAdsReportMonthEditEvents(payload.clientId, payload);
}

function bindGoogleAdsReportMonthEditEvents(clientId, payload) {
  const refreshBtn = document.getElementById('meta-report-refresh-meta');
  if (refreshBtn) {
    refreshBtn.onclick = async () => {
      refreshBtn.disabled = true;
      try {
        const monthKey = googleAdsReportsState.activeMonthKey;
        const result = await adminFetch(`/api/google-ads-reports/clients/${encodeURIComponent(clientId)}/months/${encodeURIComponent(monthKey)}/refresh`, {
          method: 'POST',
        });
        googleAdsReportsState.clientPayload = result;
        const monthPayload = result.months?.[monthKey];
        if (monthPayload) refreshGoogleAdsReportMonthPanel(monthPayload);
        showToast('Google Ads data refreshed', 'success');
      } catch (error) {
        showToast(error.message || 'Google Ads refresh failed', 'error');
      } finally {
        refreshBtn.disabled = false;
      }
    };
  }

  const saveBtn = document.getElementById('meta-report-save-month');
  if (saveBtn) {
    saveBtn.onclick = async () => {
      saveBtn.disabled = true;
      try {
        const monthKey = googleAdsReportsState.activeMonthKey;
        const body = {
          periodStart: document.getElementById('meta-report-period-start')?.value,
          periodEnd: document.getElementById('meta-report-period-end')?.value,
          wonLeads: document.getElementById('meta-report-won-leads')?.value === ''
            ? null
            : Number(document.getElementById('meta-report-won-leads')?.value),
          avgLeadValue: document.getElementById('meta-report-avg-lead-value')?.value === ''
            ? null
            : Number(document.getElementById('meta-report-avg-lead-value')?.value),
          avgProfitPerWon: document.getElementById('meta-report-avg-profit')?.value === ''
            ? null
            : Number(document.getElementById('meta-report-avg-profit')?.value),
        };
        const result = await adminFetch(`/api/google-ads-reports/clients/${encodeURIComponent(clientId)}/months/${encodeURIComponent(monthKey)}`, {
          method: 'PUT',
          body: JSON.stringify(body),
        });
        googleAdsReportsState.clientPayload = result;
        const monthPayload = result.months?.[monthKey];
        if (monthPayload) refreshGoogleAdsReportMonthPanel(monthPayload);
        showToast('Month saved', 'success');
      } catch (error) {
        showToast(error.message || 'Save failed', 'error');
      } finally {
        saveBtn.disabled = false;
      }
    };
  }
}

function switchGoogleAdsReportMonthTab(monthKey) {
  if (metaReportsState.reportViewMode === 'comparison') {
    metaReportsState.reportViewMode = 'monthly';
  }
  googleAdsReportsState.activeMonthKey = monthKey;
  metaReportsState.activeMonthKey = monthKey;
  const payload = googleAdsReportsState.clientPayload;
  if (!payload) return;
  document.querySelectorAll('[data-google-ads-month-tab]').forEach((button) => {
    button.classList.toggle('is-active', button.getAttribute('data-google-ads-month-tab') === monthKey);
  });
  syncGoogleAdsReportMonthPanelDom(
    payload.months?.[monthKey],
    { editable: true, yearPayload: googleAdsPayloadToMetaUiShape(payload) },
    payload,
  );
  bindGoogleAdsReportMonthEditEvents(payload.clientId, payload);
}

function updateGoogleAdsReportsClientContent(payload) {
  googleAdsReportsState.clientPayload = payload;
  metaReportsState.clientPayload = googleAdsPayloadToMetaUiShape(payload);
  metaReportsState.chartProjection = null;
  const monthKeys = payload.monthKeys || [];
  if (!googleAdsReportsState.activeMonthKey) {
    googleAdsReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  } else if (!monthKeys.includes(googleAdsReportsState.activeMonthKey)) {
    googleAdsReportsState.activeMonthKey = monthKeys[monthKeys.length - 1] || null;
  }
  metaReportsState.activeMonthKey = googleAdsReportsState.activeMonthKey;

  googleAdsReportsState.selectedYear = Number(payload.year) || googleAdsReportsState.selectedYear;
  metaReportsState.selectedYear = googleAdsReportsState.selectedYear;

  const yearSelect = document.getElementById('meta-report-year');
  if (yearSelect) {
    yearSelect.innerHTML = renderGoogleAdsReportYearSelectOptions(payload, { disableUnavailable: true });
  }

  refreshGoogleAdsReportClientShareUi(payload);

  const tabsEl = document.querySelector('.meta-report-tabs');
  if (tabsEl) {
    tabsEl.innerHTML = monthKeys.map((key) => `
      <button type="button" class="meta-report-tab${key === googleAdsReportsState.activeMonthKey ? ' is-active' : ''}" data-google-ads-month-tab="${esc(key)}">${esc(metaMonthLabel(key))}</button>
    `).join('');
    document.querySelectorAll('[data-google-ads-month-tab]').forEach((button) => {
      button.onclick = () => switchGoogleAdsReportMonthTab(button.getAttribute('data-google-ads-month-tab'));
    });
  }

  syncGoogleAdsReportMonthPanelDom(
    payload.months?.[googleAdsReportsState.activeMonthKey],
    { editable: true, yearPayload: googleAdsPayloadToMetaUiShape(payload) },
    payload,
  );
  bindGoogleAdsReportMonthEditEvents(payload.clientId, payload);
  bindGoogleAdsReportBackfillButton(payload.clientId);
  bindGoogleAdsReportShareEvents(payload);
  bindGoogleAdsReportBottomlineSummaryEvents(payload);
  bindGoogleAdsReportExcelSheetSummaryEvents(payload);
  void ensureMetaReportScenarioSource(metaReportsState.clientPayload, { editable: true });
}

function bindGoogleAdsReportsClientChromeEvents(payload) {
  const clientId = payload.clientId;
  const yearSelect = document.getElementById('meta-report-year');
  if (yearSelect) {
    yearSelect.onchange = async () => {
      const option = yearSelect.selectedOptions?.[0];
      if (option?.disabled) {
        yearSelect.value = String(googleAdsReportsState.selectedYear);
        return;
      }
      const previousYear = googleAdsReportsState.selectedYear;
      const newYear = Number(yearSelect.value);
      if (newYear === previousYear) return;
      googleAdsReportsState.selectedYear = newYear;
      if (linkedReportsState.origin !== 'meta') {
        metaReportsState.selectedYear = newYear;
      }
      googleAdsReportsState.activeMonthKey = null;
      metaReportsState.comparisonYearCache = {};
      setMetaReportClientYearLoading(newYear, true);
      try {
        if (linkedReportsState.origin === 'meta' && linkedReportsState.googlePayload) {
          const googleClientId = linkedReportsState.googlePayload.clientId;
          const nextPayload = await adminFetch(`/api/google-ads-reports/clients/${encodeURIComponent(googleClientId)}?year=${encodeURIComponent(newYear)}`);
          linkedReportsState.googlePayload = nextPayload;
          googleAdsReportsState.clientPayload = nextPayload;
          googleAdsReportsState.selectedYear = Number(nextPayload.year) || newYear;
          applyLinkedAdminPlatformState('google-ads');
          const page = document.querySelector('.meta-report-client-page');
          if (page) page.innerHTML = renderLinkedAdminEditorInner();
          bindLinkedAdminEditorEvents();
          const uiPayload = googleAdsPayloadToMetaUiShape(nextPayload);
          requestAnimationFrame(() => {
            mountMetaReportCharts(uiPayload, { editable: true, clientId: googleClientId });
          });
        } else {
          await loadGoogleAdsClientPage({ silent: true });
        }
      } catch (error) {
        googleAdsReportsState.selectedYear = previousYear;
        if (linkedReportsState.origin !== 'meta') {
          metaReportsState.selectedYear = previousYear;
        }
        if (yearSelect) yearSelect.value = String(previousYear);
        if (linkedReportsState.origin === 'meta' && linkedReportsState.googlePayload) {
          applyLinkedAdminPlatformState('google-ads');
          const page = document.querySelector('.meta-report-client-page');
          if (page) page.innerHTML = renderLinkedAdminEditorInner();
          bindLinkedAdminEditorEvents();
        } else {
          await loadGoogleAdsClientPage({ silent: true });
        }
        showToast(error.message || 'Load failed', 'error');
      } finally {
        setMetaReportClientYearLoading(newYear, false);
      }
    };
  }
  bindMetaReportCopyButtons();
  bindGoogleAdsReportBackfillButton(clientId);
  bindGoogleAdsReportBottomlineSummaryEvents(payload);
  bindGoogleAdsReportExcelSheetSummaryEvents(payload);
  bindGoogleAdsReportShareEvents(payload);
}

function bindGoogleAdsReportsClientEvents(payload) {
  bindGoogleAdsReportsClientChromeEvents(payload);
  document.querySelectorAll('[data-google-ads-month-tab]').forEach((button) => {
    button.onclick = () => switchGoogleAdsReportMonthTab(button.getAttribute('data-google-ads-month-tab'));
  });
  bindGoogleAdsReportMonthEditEvents(payload.clientId, payload);
  bindLinkedReportChrome();
}

const GOOGLE_ADS_HUB_FILTERS = [
  { value: 'enabled', label: 'Live' },
  { value: 'not-enabled', label: 'Not enabled' },
  { value: 'all', label: 'All' },
];

function filterGoogleAdsClients(clients, filter, searchQuery = '') {
  let list = clients || [];
  if (filter === 'enabled') list = list.filter((client) => client.googleAdsReportEnabled);
  if (filter === 'not-enabled' || filter === 'needs-setup') {
    list = list.filter((client) => !client.googleAdsReportEnabled);
  }
  const query = String(searchQuery || '').trim().toLowerCase();
  if (query) {
    list = list.filter((client) => {
      const haystack = [
        client.accountName,
        client.googleCustomerId,
        client.googleCustomerLabel,
        client.clientId,
      ].filter(Boolean).join(' ').toLowerCase();
      return haystack.includes(query);
    });
  }
  return list;
}

function getGoogleAdsHubView(dashboardData, filter, searchQuery = googleAdsReportsState.searchQuery) {
  const allClients = dashboardData?.clients || [];
  const clients = filterGoogleAdsClients(allClients, filter, searchQuery);
  return {
    clients,
    allClients,
    summary: dashboardData?.summary || {},
    google: dashboardData?.google || {},
    filter,
    searchQuery,
  };
}

function renderGoogleAdsHubFiltersHtml(activeFilter) {
  return GOOGLE_ADS_HUB_FILTERS.map((option) => `
    <button
      type="button"
      class="meta-hub-filter${activeFilter === option.value ? ' is-active' : ''}"
      data-google-ads-filter="${esc(option.value)}"
    >${esc(option.label)}</button>
  `).join('');
}

function renderGoogleAdsHubCard(client) {
  const canEdit = Boolean(client.clientId);
  const rowKey = client.clientId || client.googleCustomerId || '';
  const statusBadge = client.needsSetup
    ? '<span class="meta-report-badge meta-report-badge--setup">Needs setup</span>'
    : (client.googleAdsReportEnabled
      ? '<span class="meta-report-badge meta-report-badge--on">Report live</span>'
      : '<span class="meta-report-badge meta-report-badge--off">Report off</span>');
  const nameMarkup = canEdit
    ? `<a href="/admin/google-ads/${encodeURIComponent(client.clientId)}" class="meta-hub-card-name">${esc(client.accountName)}</a>`
    : `<span class="meta-hub-card-name">${esc(client.accountName)}</span>`;
  const actionButtons = [];
  if (client.needsSetup) {
    actionButtons.push(`<button type="button" class="admin-btn admin-btn--primary" data-google-ads-enable="${esc(client.googleCustomerId)}" data-google-ads-name="${esc(client.accountName)}">Enable</button>`);
  } else if (canEdit) {
    actionButtons.push(`<a class="admin-btn" href="/admin/google-ads/${encodeURIComponent(client.clientId)}">Edit report</a>`);
    if (client.reportUrl && client.googleAdsReportEnabled) {
      actionButtons.push(`<button type="button" class="admin-btn admin-btn--secondary" data-copy-report-url="${esc(client.reportUrl)}">Copy link</button>`);
    }
  }
  return `
    <article class="meta-hub-card ${client.needsSetup ? 'is-setup' : ''}" data-google-ads-row="${esc(rowKey)}">
      <div class="meta-hub-card-head">
        <span class="meta-hub-avatar" aria-hidden="true">${metaHubClientInitial(client.accountName)}</span>
        <div class="meta-hub-card-title">
          ${nameMarkup}
          <div class="meta-hub-card-slug">${esc(client.googleCustomerLabel || client.googleCustomerId || '—')}</div>
        </div>
      </div>
      <div class="meta-hub-card-meta">
        ${statusBadge}
        ${client.linkedMetaAccountName ? `<span class="meta-report-badge meta-report-badge--linked">Linked · ${esc(client.linkedMetaAccountName)}</span>` : ''}
        <span class="meta-hub-card-meta-dot" aria-hidden="true">·</span>
        <span>Google Ads</span>
      </div>
      <div class="meta-hub-card-actions${actionButtons.length === 1 ? ' meta-hub-card-actions--single' : ''}">
        ${actionButtons.join('')}
      </div>
    </article>
  `;
}

function renderGoogleAdsHubPage(viewData) {
  const clients = viewData.clients || [];
  const googleInfo = viewData.google || {};
  const banner = googleInfo.partnerFetchError
    ? `<div class="admin-banner admin-banner--warn">${esc(googleInfo.partnerFetchError)}</div>`
    : '';
  return `
    ${renderBrandTopbar(renderStaffAdminChrome('google-ads'))}
    ${wrapDashboardShell(`
    <div class="page-hero admin-hub-hero meta-premium-page-hero">
      <div class="meta-premium-page-hero-inner">
        <div class="admin-breadcrumb">
          <a href="/admin">Clients</a>
          <span aria-hidden="true"> / </span>
          <span>Google Ads</span>
        </div>
        <h1>Google Ads reports</h1>
      </div>
    </div>
    <div class="admin-hub meta-reports-page">
      <div class="meta-hub-layout">
        <div id="google-ads-banner">${banner}</div>
        <div class="hub-toolbar-row">
          <div class="hub-search">
            ${ICON_SEARCH}
            <input type="search" id="google-ads-search" placeholder="Search accounts…" value="${esc(viewData.searchQuery || '')}" autocomplete="off" />
          </div>
          <span class="hub-count" id="google-ads-count">${clients.length} account${clients.length === 1 ? '' : 's'}</span>
          <div class="hub-toolbar-actions">
            <div class="meta-hub-filters" id="google-ads-filters" role="tablist" aria-label="Filter accounts">
              ${renderGoogleAdsHubFiltersHtml(viewData.filter)}
            </div>
            <button class="admin-btn admin-btn--secondary" type="button" id="google-ads-refresh">${ICON_SYNC} Refresh</button>
          </div>
        </div>
        <div class="meta-hub-cards" id="google-ads-cards">
          ${clients.length ? clients.map(renderGoogleAdsHubCard).join('') : '<div class="sync-history-empty" style="padding:24px">No Google Ads accounts found.</div>'}
        </div>
      </div>
    </div>
    `)}
  `;
}

function updateGoogleAdsHubDom(viewData) {
  const banner = document.getElementById('google-ads-banner');
  const cards = document.getElementById('google-ads-cards');
  const count = document.getElementById('google-ads-count');
  const googleInfo = viewData.google || {};
  if (banner) {
    banner.innerHTML = googleInfo.partnerFetchError
      ? `<div class="admin-banner admin-banner--warn">${esc(googleInfo.partnerFetchError)}</div>`
      : '';
  }
  if (count) {
    const n = (viewData.clients || []).length;
    count.textContent = `${n} account${n === 1 ? '' : 's'}`;
  }
  if (cards) {
    cards.innerHTML = (viewData.clients || []).length
      ? viewData.clients.map(renderGoogleAdsHubCard).join('')
      : '<div class="sync-history-empty" style="padding:24px">No Google Ads accounts found.</div>';
  }
  bindGoogleAdsHubRowEvents();
  bindMetaReportCopyButtons(document.getElementById('google-ads-cards'));
}

function bindGoogleAdsHubRowEvents() {
  document.querySelectorAll('[data-google-ads-enable]').forEach((button) => {
    button.onclick = async () => {
      const googleCustomerId = button.getAttribute('data-google-ads-enable');
      const accountName = button.getAttribute('data-google-ads-name') || googleCustomerId;
      button.disabled = true;
      try {
        const result = await adminFetch('/api/google-ads-reports/provision', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ googleCustomerId, accountName }),
        });
        showToast(`Enabled ${accountName}`, 'success');
        if (result?.clientId) {
          window.location.href = `/admin/google-ads/${encodeURIComponent(result.clientId)}`;
          return;
        }
        await loadGoogleAdsHubPage();
      } catch (error) {
        showToast(error.message || 'Enable failed', 'error');
        button.disabled = false;
      }
    };
  });
}

function bindGoogleAdsHubEvents() {
  const search = document.getElementById('google-ads-search');
  if (search) {
    search.oninput = () => {
      googleAdsReportsState.searchQuery = search.value;
      updateGoogleAdsHubDom(getGoogleAdsHubView(
        googleAdsReportsState.dashboardData,
        googleAdsReportsState.filter,
        googleAdsReportsState.searchQuery,
      ));
    };
  }
  document.querySelectorAll('[data-google-ads-filter]').forEach((button) => {
    button.onclick = () => {
      googleAdsReportsState.filter = button.getAttribute('data-google-ads-filter') || 'enabled';
      document.querySelectorAll('[data-google-ads-filter]').forEach((el) => {
        el.classList.toggle('is-active', el === button);
      });
      updateGoogleAdsHubDom(getGoogleAdsHubView(
        googleAdsReportsState.dashboardData,
        googleAdsReportsState.filter,
        googleAdsReportsState.searchQuery,
      ));
    };
  });
  const refreshBtn = document.getElementById('google-ads-refresh');
  if (refreshBtn) refreshBtn.onclick = () => loadGoogleAdsHubPage();
  bindGoogleAdsHubRowEvents();
}

async function loadGoogleAdsHubPage() {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard) return;
  const user = await fetchStaffMe();
  if (!user) {
    dashboard.innerHTML = `
      ${renderBrandTopbar('')}
      ${wrapDashboardShell('<div class="sync-history-empty" style="padding:24px;text-align:center"><a class="admin-btn admin-btn--primary" href="/login?next=' + encodeURIComponent(window.location.pathname) + '">Sign in</a></div>')}
    `;
    return;
  }
  currentStaffUser = user;
  if (!googleAdsReportsState.hubMounted) {
    dashboard.innerHTML = renderAdminHubSkeletonPage('google-ads');
  }
  try {
    const data = await adminFetch('/api/google-ads-reports?filter=all');
    googleAdsReportsState.dashboardData = data;
    const viewData = getGoogleAdsHubView(data, googleAdsReportsState.filter, googleAdsReportsState.searchQuery);
    if (!googleAdsReportsState.hubMounted) {
      dashboard.innerHTML = renderGoogleAdsHubPage(viewData);
      googleAdsReportsState.hubMounted = true;
      bindGoogleAdsHubEvents();
    } else {
      updateGoogleAdsHubDom(viewData);
    }
  } catch (error) {
    dashboard.innerHTML = `
      ${renderBrandTopbar(renderStaffAdminChrome('google-ads'))}
      ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
    `;
  }
}

function renderGoogleAdsClientPage(payload) {
  return `
    ${renderBrandTopbar(renderStaffAdminChrome('google-ads'))}
    ${wrapDashboardShell(`
    <div class="page-hero admin-hub-hero meta-premium-page-hero">
      <div class="meta-premium-page-hero-inner">
        <div class="admin-breadcrumb">
          <a href="/admin">Clients</a>
          <span aria-hidden="true"> / </span>
          <a href="/admin/google-ads">Google Ads</a>
          <span aria-hidden="true"> / </span>
          <span>${esc(payload.accountName)}</span>
        </div>
        <h1>${esc(payload.accountName)}</h1>
        <p class="meta-report-public-subtitle">${esc(payload.settings?.googleCustomerLabel || payload.settings?.googleCustomerId || '')}</p>
      </div>
    </div>
    <div class="sync-history-page meta-reports-page meta-report-client-page">
      ${renderLinkedAdminEditorInner()}
    </div>
    `)}
  `;
}

async function loadGoogleAdsClientPage({ silent = false } = {}) {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard) return;
  const user = await fetchStaffMe();
  if (!user) {
    window.location.href = `/login?next=${encodeURIComponent(window.location.pathname)}`;
    return;
  }
  currentStaffUser = user;
  const clientId = CLIENT_SLUG;

  if (!googleAdsReportsState.clientPageMounted) {
    dashboard.innerHTML = `
      ${renderBrandTopbar(renderStaffAdminChrome('google-ads'))}
      ${wrapDashboardShell('<div class="loading-state"><div class="spinner"></div><p>Loading Google Ads report...</p></div>')}
    `;
  } else if (!silent) {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.add('is-loading');
  }

  try {
    const payload = await adminFetch(`/api/google-ads-reports/clients/${encodeURIComponent(clientId)}?year=${encodeURIComponent(googleAdsReportsState.selectedYear)}`);
    googleAdsReportsState.selectedYear = Number(payload.year) || googleAdsReportsState.selectedYear;
    metaReportsState.selectedYear = googleAdsReportsState.selectedYear;
    if (!googleAdsReportsState.activeMonthKey || !(payload.monthKeys || []).includes(googleAdsReportsState.activeMonthKey)) {
      googleAdsReportsState.activeMonthKey = payload.monthKeys?.[payload.monthKeys.length - 1] || null;
    }
    metaReportsState.activeMonthKey = googleAdsReportsState.activeMonthKey;
    const uiPayload = googleAdsPayloadToMetaUiShape(payload);
    await ensureMetaReportScenarioSource(uiPayload, { editable: true });
    const metaPayload = await fetchLinkedPartnerPayload(payload, 'google-ads');
    hydrateAdminLinkedReports({ origin: 'google-ads', metaPayload, googlePayload: payload });
    if (metaPayload) {
      if (!metaReportsState.activeMonthKey || !(metaPayload.monthKeys || []).includes(metaReportsState.activeMonthKey)) {
        metaReportsState.activeMonthKey = metaPayload.monthKeys?.[metaPayload.monthKeys.length - 1] || null;
      }
    }
    const viewingMeta = linkedReportsState.activePlatform === 'meta' && metaPayload;
    const activePayload = viewingMeta ? metaPayload : uiPayload;
    if (viewingMeta) {
      metaReportsState.clientPayload = metaPayload;
      metaReportsState.selectedYear = Number(metaPayload.year) || metaReportsState.selectedYear;
      hydrateMetaReportSpendChartType(metaPayload);
      hydrateMetaReportScenarioSettings(metaPayload);
    }
    if (!googleAdsReportsState.clientPageMounted) {
      googleAdsReportsState.clientPayload = payload;
      if (!viewingMeta) {
        metaReportsState.clientPayload = uiPayload;
        metaReportsState.clientShareExpanded = false;
        metaReportsState.clientReportSettingsExpanded = false;
        metaReportsState.clientExcelSheetExpanded = false;
        metaReportsState.reportViewMode = 'monthly';
        metaReportsState.comparisonYearCache = {};
      }
      dashboard.innerHTML = renderGoogleAdsClientPage(payload);
      googleAdsReportsState.clientPageMounted = true;
      bindLinkedAdminEditorEvents();
      requestAnimationFrame(() => {
        mountMetaReportCharts(activePayload, {
          editable: true,
          clientId: viewingMeta ? metaPayload.clientId : clientId,
        });
      });
    } else if (viewingMeta) {
      const page = document.querySelector('.meta-report-client-page');
      if (page) page.innerHTML = renderLinkedAdminEditorInner();
      bindLinkedAdminEditorEvents();
    } else {
      updateGoogleAdsReportsClientContent(payload);
      bindLinkedReportChrome();
    }
  } catch (error) {
    if (!googleAdsReportsState.clientPageMounted) {
      dashboard.innerHTML = `
        ${renderBrandTopbar(renderStaffAdminChrome('google-ads'))}
        ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message)}</div>`)}
      `;
    } else if (!silent) {
      showToast(error.message || 'Load failed', 'error');
    }
  } finally {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.remove('is-loading');
  }
}

async function loadPublicMetaReportPage({ silent = false } = {}) {
  const dashboard = document.getElementById('dashboard');
  if (!dashboard || !REPORT_TOKEN) return;

  metaReportsState.reportViewMode = 'monthly';

  if (!metaReportsState.publicPageMounted) {
    await probeStaffPreviewSession();
    dashboard.innerHTML = `
      ${renderAppTopbar()}
      ${wrapDashboardShell('<div class="loading-state"><div class="spinner"></div><p>Loading report...</p></div>')}
    `;
  } else if (!silent) {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.add('is-loading');
  }

  try {
    const raw = await fetch(`/api/meta-reports/public/${encodeURIComponent(REPORT_TOKEN)}?year=${encodeURIComponent(metaReportsState.selectedYear)}`)
      .then(async (response) => {
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Report not found');
        return data;
      });
    const payload = captureDualPublicPayload(raw);
    syncMetaReportSelectedYear(payload, { disableUnavailable: true });
    if (Number(metaReportsState.selectedYear) !== Number(payload.year)) {
      // Previous year has no data — reload the available year instead.
      return loadPublicMetaReportPage({ silent: true });
    }
    if (!metaReportsState.activeMonthKey || !(payload.monthKeys || []).includes(metaReportsState.activeMonthKey)) {
      metaReportsState.activeMonthKey = payload.monthKeys?.[payload.monthKeys.length - 1] || null;
    }
    const chartPayload = payload.reportKind === 'google-ads'
      ? googleAdsPayloadToMetaUiShape(payload)
      : payload;
    await ensureMetaReportScenarioSource(chartPayload, { editable: false });
    if (!metaReportsState.publicPageMounted) {
      metaReportsState.publicPayload = payload;
      hydrateMetaReportSpendChartType(chartPayload);
      hydrateMetaReportScenarioSettings(chartPayload);
      dashboard.innerHTML = renderPublicMetaReportPage(payload);
      metaReportsState.publicPageMounted = true;
      syncMetaReportPublicBranding(chartPayload);
      bindPublicMetaReportEvents(payload);
      mountMetaReportCharts(chartPayload, { editable: false });
    } else {
      updatePublicMetaReportContent(payload);
      bindLinkedReportChrome({ publicView: true });
    }
  } catch (error) {
    if (!metaReportsState.publicPageMounted) {
      dashboard.innerHTML = `
        ${renderAppTopbar()}
        ${wrapDashboardShell(`<div class="error-state" style="padding:24px">${esc(error.message || 'Report not found')}</div>`)}
      `;
    } else if (silent) {
      throw error;
    } else {
      showToast(error.message || 'Load failed', 'error');
    }
  } finally {
    const panel = document.getElementById('meta-report-month-panel');
    if (panel) panel.classList.remove('is-loading');
  }
}

function metaCvShortMonth(monthKey) {
  const month = Number(String(monthKey || '').slice(5, 7));
  return ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][month - 1] || monthKey;
}

function metaCvFormatUpdatedAt(value) {
  if (!value) return 'Not updated yet';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return 'Not updated yet';
  return date.toLocaleString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

function getMetaCvFilteredClients(overview = metaReportsState.customValues.overview) {
  const clients = overview?.clients || [];
  const query = String(metaReportsState.customValues.searchQuery || '').trim().toLowerCase();
  if (!query) return clients;
  return clients.filter((client) => (
    [client.accountName, client.clientId, client.metaAdAccountId]
      .filter(Boolean)
      .join(' ')
      .toLowerCase()
      .includes(query)
  ));
}

function renderMetaCvMonthPills(client, monthKeys = []) {
  const selectedClientId = metaReportsState.customValues.selectedClientId;
  const selectedMonthKey = metaReportsState.customValues.selectedMonthKey;
  return monthKeys.map((monthKey) => {
    const monthRow = client.months?.[monthKey] || {};
    const status = monthRow.status || 'empty';
    const isActive = selectedClientId === client.clientId && selectedMonthKey === monthKey;
    return `
      <button
        type="button"
        class="meta-cv-month-pill is-${esc(status)}${isActive ? ' is-active' : ''}"
        data-meta-cv-client="${esc(client.clientId)}"
        data-meta-cv-month="${esc(monthKey)}"
        title="${esc(metaCvShortMonth(monthKey))} · ${esc(status)}"
      >${esc(metaCvShortMonth(monthKey))}</button>
    `;
  }).join('');
}

function isMetaReportGhlListClient(settings = {}) {
  return Boolean(settings.metaReportGhlDataEnabled);
}

function resolveMetaToplineSource(monthPayload, settings = {}) {
  const raw = monthPayload?.dataSource || monthPayload?.toplineSource || 'meta';
  if (!isMetaReportGhlListClient(settings)) return raw;
  if (resolveClientToplineMode(settings) === 'meta' && (raw === 'manual' || raw === 'ghl')) {
    return 'meta';
  }
  return raw;
}

function resolveMetaCvMonthToplineSource(monthPayload, monthStatus, settings = {}) {
  return resolveMetaToplineSource(
    {
      ...(monthPayload || {}),
      dataSource: monthStatus?.toplineSource ?? monthPayload?.dataSource,
    },
    settings,
  );
}

function classifyMetaReportMonthInputStatus(monthPayload, requireProfit = false) {
  if (!monthPayload) return 'empty';
  const hasWon = monthPayload.topline?.wonLeads != null || monthPayload.inputs?.wonLeads != null;
  const hasAvgLead = monthPayload.topline?.avgLeadValue != null || monthPayload.inputs?.avgLeadValue != null;
  const hasProfit = monthPayload.inputs?.avgProfitPerWon != null;
  if (hasWon && hasAvgLead && (!requireProfit || hasProfit)) return 'complete';
  if (hasWon || hasAvgLead || hasProfit) return 'partial';
  return 'empty';
}

function resolveClientToplineMode(settings = {}) {
  return settings.metaReportToplineMode === 'cenhub' ? 'cenhub' : 'meta';
}

function resolveMetaReportHubTypeLabel(client = {}) {
  if (client.metaReportGhlDataEnabled && resolveClientToplineMode(client) === 'cenhub') {
    return 'Cenhub';
  }
  return 'Meta';
}

function clientUsesCenhubMetaReportTopline(client = {}) {
  return Boolean(client.metaReportGhlDataEnabled) && resolveClientToplineMode(client) === 'cenhub';
}

function metaMonthAllowsManualControls(monthPayload, settings = {}) {
  if (!isMetaReportGhlListClient(settings)) return false;
  if (resolveClientToplineMode(settings) !== 'cenhub') return false;
  const source = resolveMetaToplineSource(monthPayload, settings);
  return source === 'ghl' || source === 'manual';
}

function metaToplineSourceNote(mode) {
  return mode === 'cenhub' ? 'Using Cenhub for all months' : 'Using Meta for all months';
}

function metaToplineConfirmWord(mode) {
  return mode === 'cenhub' ? 'Cenhub' : 'Meta';
}

function renderMetaToplineSourcePillHtml(label, variant) {
  return `<span class="meta-topline-source-pill is-${variant}"><span class="meta-topline-source-pill-dot" aria-hidden="true"></span><span class="meta-topline-source-pill-text">${esc(label)}</span></span>`;
}

function renderMetaMonthSourcePill(monthPayload, settings = {}) {
  if (!isMetaReportGhlListClient(settings)) return '';
  const source = resolveMetaToplineSource(monthPayload, settings);
  const globalMode = resolveClientToplineMode(settings);
  if (globalMode === 'cenhub' && source === 'manual') {
    return renderMetaToplineSourcePillHtml('Manual this month', 'manual');
  }
  if (globalMode === 'meta' || source === 'meta') {
    return renderMetaToplineSourcePillHtml('Meta', 'meta');
  }
  if (source === 'ghl') {
    return renderMetaToplineSourcePillHtml('Cenhub', 'cenhub');
  }
  return renderMetaToplineSourcePillHtml('No Cenhub data', 'cenhub-empty');
}

function renderMetaReportToplineSourceControl(payload) {
  const settings = payload?.settings || {};
  if (!isMetaReportGhlListClient(settings)) return '';
  const mode = resolveClientToplineMode(settings);
  const saving = metaReportsState.clientToplineSaving;
  const disabledAttr = saving ? ' disabled' : '';
  const hasGhl = settings.hasGhl !== false;
  const sourceLabel = mode === 'cenhub' ? 'Cenhub' : 'Meta';
  const sourceValueClass = mode === 'cenhub' ? 'is-cenhub' : 'is-meta';

  return `
    <div class="meta-report-topline-source-wrap meta-topline-source-panel${saving ? ' is-loading' : ''}" id="meta-report-topline-source-panel">
      <div class="meta-report-topline-summary">
        <div class="meta-report-topline-summary-content">
          <div class="meta-report-topline-summary-row">
            <span class="meta-report-topline-summary-label">Data source</span>
            <span class="meta-report-topline-summary-value ${sourceValueClass}">${esc(sourceLabel)}</span>
          </div>
          <div class="meta-report-topline-summary-row">
            <span class="meta-report-topline-summary-label">Scope</span>
            <span class="meta-report-topline-summary-value">All months · ${esc(metaReportsState.selectedYear)}</span>
          </div>
        </div>
        <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="meta-report-topline-change"${disabledAttr}>Edit</button>
      </div>
      <div class="meta-topline-source-loading" id="meta-report-topline-loading"${saving ? '' : ' hidden'}>
        <span class="meta-report-save-indicator-spinner"></span> Switching source…
      </div>
    </div>
  `;
}

function renderMetaReportToplineChangeModal(payload, draftMode) {
  const settings = payload?.settings || {};
  const currentMode = resolveClientToplineMode(settings);
  const hasGhl = settings.hasGhl !== false;

  return `
    <div class="meta-report-modal-head">
      <h2 class="meta-report-modal-title">Change data source</h2>
      <button type="button" class="meta-report-modal-close" aria-label="Close">&times;</button>
    </div>
    <p class="metrics-model-copy">Choose where won leads, average lead value, and profit come from for every month in ${esc(metaReportsState.selectedYear)}.</p>
    <div class="metrics-option-cards">
      <label class="metrics-option-card">
        <input type="radio" name="meta-topline-draft-mode" value="meta"${draftMode === 'meta' ? ' checked' : ''} />
        <span class="metrics-option-card-top">
          <span class="metrics-option-card-icon">${ICON_TARGET}</span>
          <span class="metrics-option-card-title">Meta</span>
          <span class="metrics-option-card-radio">${ICON_CHECK}</span>
        </span>
        <span class="metrics-option-card-desc">Use Meta-derived topline KPIs. Ad spend always comes from Meta.</span>
      </label>
      <label class="metrics-option-card">
        <input type="radio" name="meta-topline-draft-mode" value="cenhub"${draftMode === 'cenhub' ? ' checked' : ''} />
        <span class="metrics-option-card-top">
          <span class="metrics-option-card-icon">${ICON_TAG}</span>
          <span class="metrics-option-card-title">Cenhub</span>
          <span class="metrics-option-card-radio">${ICON_CHECK}</span>
        </span>
        <span class="metrics-option-card-desc">Pull leads, won deals, revenue, and profit from Cenhub dashboard snapshots.</span>
      </label>
    </div>
    ${currentMode === 'cenhub' ? `
      <div class="meta-report-topline-sync-strip">
        <div class="meta-report-topline-sync-strip-copy">
          <span class="meta-report-topline-sync-strip-title">Sync from Cenhub</span>
          <span class="meta-report-topline-sync-strip-desc">Re-pull all months in ${esc(metaReportsState.selectedYear)} from Cenhub snapshots.</span>
        </div>
        <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="meta-report-topline-modal-sync-ghl-year"${!hasGhl ? ' disabled title="Cenhub not connected"' : ''}>Sync year from Cenhub</button>
      </div>
    ` : ''}
    <p class="meta-report-edit-note" id="meta-report-topline-no-change-hint"${draftMode !== currentMode ? ' hidden' : ''}>Select a different source above to switch.</p>
    <div class="metrics-confirm-strip" id="meta-report-topline-confirm-strip"${draftMode === currentMode ? ' hidden' : ''}>
      <div class="metrics-confirm-strip-title">${ICON_WARNING} Topline KPIs will change for all months in ${esc(metaReportsState.selectedYear)}</div>
      <div class="metrics-confirm-strip-row">
        <label class="metrics-confirm-check">
          <input id="meta-report-topline-ack" type="checkbox" />
          <span>I understand the numbers will change</span>
        </label>
        <input id="meta-report-topline-confirm" type="text" placeholder="Type ${esc(metaToplineConfirmWord(draftMode))} to confirm" autocomplete="off" />
      </div>
    </div>
    <div class="metrics-model-actions">
      <button type="button" class="admin-btn" data-meta-report-modal-close>Cancel</button>
      <button type="button" class="admin-btn admin-btn--danger-solid" id="meta-report-topline-apply" disabled>${ICON_CHECK} Apply change</button>
    </div>
    <div class="meta-topline-source-loading" id="meta-report-topline-modal-loading" hidden>
      <span class="meta-report-save-indicator-spinner"></span> Switching source…
    </div>
  `;
}

function openMetaReportToplineChangeModal(payload) {
  const currentMode = resolveClientToplineMode(payload?.settings || {});
  metaReportsState.clientToplineModalPayload = payload;
  openMetaReportModal(renderMetaReportToplineChangeModal(payload, currentMode), { wizard: true, wide: true });
  bindMetaReportToplineChangeModal(payload);
  updateMetaReportToplineApplyState();
}

function openMetaCvToplineChangeModal(client) {
  const payload = {
    clientId: client.clientId,
    settings: {
      metaReportToplineMode: client.metaReportToplineMode,
      hasGhl: client.hasGhl !== false,
    },
    reload: async () => {
      await refreshMetaCvOverviewSilently();
      refreshMetaCvListAndEditor();
    },
  };
  metaReportsState.clientToplineModalPayload = payload;
  openMetaReportModal(
    renderMetaReportToplineChangeModal(payload, resolveClientToplineMode(payload.settings)),
    { wizard: true, wide: true },
  );
  bindMetaReportToplineChangeModal(payload);
  updateMetaReportToplineApplyState();
}

function getMetaReportToplineDraftMode() {
  return document.querySelector('input[name="meta-topline-draft-mode"]:checked')?.value === 'cenhub'
    ? 'cenhub'
    : 'meta';
}

function updateMetaReportToplineApplyState() {
  const payload = metaReportsState.clientToplineModalPayload || metaReportsState.clientPayload;
  if (!payload) return;
  const currentMode = resolveClientToplineMode(payload.settings || {});
  const draftMode = getMetaReportToplineDraftMode();
  const isChanging = draftMode !== currentMode;
  const strip = document.getElementById('meta-report-topline-confirm-strip');
  const hint = document.getElementById('meta-report-topline-no-change-hint');
  if (strip) strip.hidden = !isChanging;
  if (hint) hint.hidden = isChanging;
  const confirmInput = document.getElementById('meta-report-topline-confirm');
  if (confirmInput) {
    confirmInput.placeholder = `Type ${metaToplineConfirmWord(draftMode)} to confirm`;
    if (!isChanging) confirmInput.value = '';
  }
  const ackInput = document.getElementById('meta-report-topline-ack');
  if (ackInput && !isChanging) ackInput.checked = false;
  const applyBtn = document.getElementById('meta-report-topline-apply');
  if (!applyBtn) return;
  if (!isChanging) {
    applyBtn.disabled = true;
    return;
  }
  const ack = Boolean(ackInput?.checked);
  const confirm = confirmInput?.value?.trim() || '';
  applyBtn.disabled = !(ack && confirm === metaToplineConfirmWord(draftMode));
}

async function applyMetaReportToplineSwitch(clientId, payload, nextMode) {
  let body = { mode: nextMode, year: metaReportsState.selectedYear };
  if (nextMode === 'cenhub') {
    const preview = await adminFetch(
      `/api/meta-reports/clients/${encodeURIComponent(clientId)}/sync-ghl-preview?year=${encodeURIComponent(metaReportsState.selectedYear)}`,
    );
    if ((preview.skipManual || []).length) {
      const choice = window.prompt(
        `${preview.skipManual.length} month(s) have manual values (${preview.skipManual.join(', ')}).\nType "skip" to skip manual months, or "overwrite" to replace all:`,
        'skip',
      );
      if (!choice) return false;
      if (choice.trim().toLowerCase() === 'overwrite') {
        body = { ...body, skipManual: false, overwriteManual: true };
      }
    }
  }
  await adminFetch(
    `/api/meta-reports/clients/${encodeURIComponent(clientId)}/switch-topline-source`,
    { method: 'POST', body: JSON.stringify(body) },
  );
  showToast(nextMode === 'cenhub' ? 'Switched all months to Cenhub' : 'Switched all months to Meta', 'success');
  if (typeof payload.reload === 'function') {
    await payload.reload();
  } else {
    await loadMetaReportsClientPage({ silent: true });
  }
  return true;
}

function bindMetaReportToplineChangeModal(payload) {
  const clientId = payload.clientId;
  document.querySelectorAll('input[name="meta-topline-draft-mode"]').forEach((input) => {
    input.addEventListener('change', updateMetaReportToplineApplyState);
  });
  document.getElementById('meta-report-topline-ack')?.addEventListener('change', updateMetaReportToplineApplyState);
  document.getElementById('meta-report-topline-confirm')?.addEventListener('input', updateMetaReportToplineApplyState);

  if (resolveClientToplineMode(payload.settings || {}) === 'cenhub') {
    const isCv = typeof payload.reload === 'function';
    bindMetaToplineCenhubActionEvents({
      clientId,
      prefix: 'meta-report-topline-modal',
      getMonthKey: () => metaReportsState.activeMonthKey,
      getYear: () => metaReportsState.selectedYear,
      setSaving: (isPending) => {
        const loading = document.getElementById('meta-report-topline-modal-loading');
        if (loading) loading.hidden = !isPending;
        const syncBtn = document.getElementById('meta-report-topline-modal-sync-ghl-year');
        if (syncBtn) syncBtn.disabled = isPending || payload.settings?.hasGhl === false;
      },
      onReload: async () => {
        if (isCv) {
          await payload.reload();
        } else {
          await loadMetaReportsClientPage({ silent: true });
        }
        closeMetaReportModal();
      },
    });
  }

  const applyBtn = document.getElementById('meta-report-topline-apply');
  if (applyBtn) {
    applyBtn.onclick = async () => {
      const nextMode = getMetaReportToplineDraftMode();
      const currentMode = resolveClientToplineMode(payload.settings || {});
      if (nextMode === currentMode) return;
      applyBtn.disabled = true;
      document.getElementById('meta-report-topline-modal-loading')?.removeAttribute('hidden');
      const isCv = typeof payload.reload === 'function';
      if (isCv) {
        setMetaCvSavePending(true);
      } else {
        metaReportsState.clientToplineSaving = true;
        syncMetaReportToplineSourceBar(metaReportsState.clientPayload || payload);
      }
      try {
        const ok = await applyMetaReportToplineSwitch(clientId, payload, nextMode);
        if (ok) closeMetaReportModal();
      } catch (error) {
        showToast(error.message || 'Could not switch data source', 'error');
      } finally {
        if (isCv) {
          setMetaCvSavePending(false);
        } else {
          metaReportsState.clientToplineSaving = false;
          syncMetaReportToplineSourceBar(metaReportsState.clientPayload);
        }
        document.getElementById('meta-report-topline-modal-loading')?.setAttribute('hidden', '');
      }
    };
  }
}

function renderMetaReportMonthManualRow(monthPayload, settings = {}, { prefix = 'meta-report' } = {}) {
  if (!metaMonthAllowsManualControls(monthPayload, settings)) return '';
  const source = resolveMetaToplineSource(monthPayload, settings);
  const isManual = source === 'manual';
  const restoreLabel = monthHasCenhubSnapshot(monthPayload, settings)
    ? 'Switch back to Cenhub'
    : 'Switch back to Meta';

  if (!isManual) {
    return `
      <div class="meta-report-month-manual-row">
        <div class="meta-report-month-manual-row-copy">
          <p class="meta-report-month-manual-row-title">Month data source</p>
          <p class="meta-report-month-manual-row-desc">This month uses Cenhub values (leads, won leads, average lead value, and profit). Switch to manual if you need to override them.</p>
        </div>
        <div class="meta-report-month-manual-row-actions">
          <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="${prefix}-use-manual-month">Use manual values</button>
        </div>
      </div>
    `;
  }

  return `
    <div class="meta-report-month-manual-row">
      <div class="meta-report-month-manual-row-copy">
        <p class="meta-report-month-manual-row-title">Manual override active</p>
        <p class="meta-report-month-manual-row-desc">You are editing custom values for this month instead of Cenhub data.</p>
      </div>
      <div class="meta-report-month-manual-row-actions">
        ${renderMetaToplineSourcePillHtml('Manual this month', 'manual')}
        <button type="button" class="admin-btn admin-btn--primary admin-btn--small" id="${prefix}-restore-month-source">${esc(restoreLabel)}</button>
      </div>
    </div>
  `;
}

function renderMetaCvToplineSourceControl(client, overview) {
  if (!client?.metaReportGhlDataEnabled) return '';
  const mode = client.metaReportToplineMode === 'cenhub' ? 'cenhub' : 'meta';
  const saving = metaReportsState.customValues.saving;
  const disabledAttr = saving ? ' disabled' : '';
  const hasGhl = client.hasGhl !== false;
  const sourceLabel = mode === 'cenhub' ? 'Cenhub' : 'Meta';
  const sourceValueClass = mode === 'cenhub' ? 'is-cenhub' : 'is-meta';

  return `
    <div class="meta-report-topline-source-wrap meta-topline-source-panel${saving ? ' is-loading' : ''}" id="meta-cv-topline-source-panel">
      <div class="meta-report-topline-summary">
        <div class="meta-report-topline-summary-content">
          <div class="meta-report-topline-summary-row">
            <span class="meta-report-topline-summary-label">Data source</span>
            <span class="meta-report-topline-summary-value ${sourceValueClass}">${esc(sourceLabel)}</span>
          </div>
          <div class="meta-report-topline-summary-row">
            <span class="meta-report-topline-summary-label">Scope</span>
            <span class="meta-report-topline-summary-value">All months · ${esc(metaReportsState.selectedYear)}</span>
          </div>
        </div>
        <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="meta-cv-topline-change"${disabledAttr}>Edit</button>
      </div>
      <div class="meta-topline-source-loading" id="meta-cv-topline-loading"${saving ? '' : ' hidden'}>
        <span class="meta-report-save-indicator-spinner"></span> Switching source…
      </div>
    </div>
  `;
}

function renderMetaCvMonthManualRow(monthPayload, client) {
  if (!client?.metaReportGhlDataEnabled) return '';
  const cvSettings = {
    metaReportGhlDataEnabled: client.metaReportGhlDataEnabled,
    metaReportToplineMode: client.metaReportToplineMode,
  };
  return renderMetaReportMonthManualRow(
    monthPayload || { dataSource: monthPayload?.toplineSource || 'meta' },
    cvSettings,
    { prefix: 'meta-cv' },
  );
}

function bindMetaToplineCenhubActionEvents({
  clientId,
  prefix,
  getMonthKey,
  getYear,
  setSaving,
  onReload,
  onMonthUpdated,
}) {
  if (!clientId || !prefix) return;

  const syncYearBtn = document.getElementById(`${prefix}-sync-ghl-year`);
  if (syncYearBtn) {
    syncYearBtn.onclick = async () => {
      if (setSaving) setSaving(true);
      try {
        const year = getYear?.() || metaReportsState.selectedYear;
        const preview = await adminFetch(
          `/api/meta-reports/clients/${encodeURIComponent(clientId)}/sync-ghl-preview?year=${encodeURIComponent(year)}`,
        );
        let skipManual = true;
        let overwriteManual = false;
        if ((preview.skipManual || []).length) {
          const choice = window.prompt(
            `${preview.skipManual.length} month(s) have manual values (${preview.skipManual.join(', ')}).\nType "skip" to skip manual months, or "overwrite" to replace all:`,
            'skip',
          );
          if (!choice) return;
          if (choice.trim().toLowerCase() === 'overwrite') {
            skipManual = false;
            overwriteManual = true;
          }
        }
        const result = await adminFetch(
          `/api/meta-reports/clients/${encodeURIComponent(clientId)}/sync-ghl-year?year=${encodeURIComponent(year)}`,
          { method: 'POST', body: JSON.stringify({ skipManual, overwriteManual }) },
        );
        if (onReload) await onReload();
        else if (onMonthUpdated) await onMonthUpdated(result, null, { yearSync: true });
        showToast(`Synced ${result.synced?.length || 0} month(s)${result.skipped?.length ? `, skipped ${result.skipped.length}` : ''}`, 'success');
      } catch (error) {
        showToast(error.message || 'Year sync failed', 'error');
      } finally {
        if (setSaving) setSaving(false);
      }
    };
  }

  const refreshSnapshotBtn = document.getElementById(`${prefix}-refresh-snapshot`);
  if (refreshSnapshotBtn) {
    refreshSnapshotBtn.onclick = async () => {
      const monthKey = getMonthKey?.();
      if (!monthKey) return;
      if (setSaving) setSaving(true);
      try {
        const result = await adminFetch(
          `/api/meta-reports/clients/${encodeURIComponent(clientId)}/months/${encodeURIComponent(monthKey)}/refresh-snapshot`,
          { method: 'POST', body: '{}' },
        );
        if (onMonthUpdated) await onMonthUpdated(result, monthKey);
        showToast('Cenhub data refreshed and synced', 'success');
      } catch (error) {
        showToast(error.message || 'Refresh failed', 'error');
      } finally {
        if (setSaving) setSaving(false);
      }
    };
  }
}

function monthHasCenhubSnapshot(monthPayload, settings = {}) {
  if (!monthPayload) return false;
  if (resolveMetaToplineSource(monthPayload, settings) === 'ghl') return true;
  return Boolean(monthPayload.ghlSyncedAt);
}

function renderMetaCvClientRows(overview) {
  const clients = getMetaCvFilteredClients(overview);
  const monthKeys = overview.monthKeys || [];
  if (!clients.length) {
    return '<div class="meta-report-empty" style="padding:32px 12px">No matching clients.</div>';
  }
  return clients.map((client) => {
    const selected = metaReportsState.customValues.selectedClientId === client.clientId;
    return `
      <article class="meta-cv-client${selected ? ' is-selected' : ''}" data-meta-cv-client-card="${esc(client.clientId)}">
        <div class="meta-cv-client-head">
          <div>
            <h3>${esc(client.accountName)}</h3>
            <div class="meta-cv-client-meta">
              ${client.metaReportEnabled ? 'Live report' : 'Report off'}
              · Last update ${esc(metaCvFormatUpdatedAt(client.lastUpdatedAt))}
            </div>
          </div>
          <div class="meta-cv-client-stats">
            ${client.completeCount}/${monthKeys.length} done
            ${client.emptyCount ? `<br>${client.emptyCount} remaining` : ''}
          </div>
        </div>
        <div class="meta-cv-month-pills">${renderMetaCvMonthPills(client, monthKeys)}</div>
      </article>
    `;
  }).join('');
}

function monthStatusIsEmpty(monthContext, settings = {}) {
  if (!monthContext) return true;
  const status = monthContext.status
    ?? classifyMetaCvMonthStatus({
      wonLeads: monthContext.inputs?.wonLeads ?? monthContext.topline?.wonLeads ?? monthContext.wonLeads,
      avgLeadValue: monthContext.inputs?.avgLeadValue ?? monthContext.topline?.avgLeadValue ?? monthContext.avgLeadValue,
      avgProfitPerWon: monthContext.inputs?.avgProfitPerWon ?? monthContext.avgProfitPerWon,
    }, Boolean(settings.metaReportShowBottomline));
  return status === 'empty';
}

function metaReportEffectiveFeeEnabled(clientOrSettings, monthContext = null) {
  if (!monthContext) return Boolean(clientOrSettings?.metaReportFeeEnabled);
  const requireProfit = Boolean(clientOrSettings?.metaReportShowBottomline);
  const status = monthContext.status
    ?? classifyMetaCvMonthStatus({
      wonLeads: monthContext.inputs?.wonLeads ?? monthContext.topline?.wonLeads ?? monthContext.wonLeads,
      avgLeadValue: monthContext.inputs?.avgLeadValue ?? monthContext.topline?.avgLeadValue ?? monthContext.avgLeadValue,
      avgProfitPerWon: monthContext.inputs?.avgProfitPerWon ?? monthContext.avgProfitPerWon,
    }, requireProfit);
  if (status === 'empty') return false;
  return Boolean(clientOrSettings?.metaReportFeeEnabled);
}

function resolveMetaReportFeeMode(settings = {}) {
  if (!settings.metaReportFeeEnabled) return '';
  return resolveMetaReportStoredFeeMode(settings);
}

const META_REPORT_FEE_MODE_META = [
  { value: '', icon: '–', title: 'None', desc: 'No Censio fee' },
  { value: 'performance', icon: '%', title: 'Performance fee', desc: '% of profit (POAS)' },
  { value: 'marketing', icon: 'Dkr', title: 'Marketing fee', desc: 'Fixed Dkr amount' },
];

function metaReportFeeValueBlockHtml(prefix, mode, feePercent, marketingFee, { inline = false } = {}) {
  if (inline && mode === 'performance') {
    return `
      <label class="meta-cv-fee-inline-field">
        <span class="meta-cv-fee-inline-label">Performance fee</span>
        <span class="meta-report-fee-value-input-wrap meta-cv-fee-inline-input">
          <input type="number" step="any" min="0" max="100" id="${prefix}-setting-fee-percent" value="${esc(feePercent)}" />
          <span class="meta-report-fee-value-input-suffix">%</span>
        </span>
      </label>`;
  }
  if (inline && mode === 'marketing') {
    return `
      <label class="meta-cv-fee-inline-field">
        <span class="meta-cv-fee-inline-label">Marketing fee</span>
        <span class="meta-report-fee-value-input-wrap meta-cv-fee-inline-input">
          <input type="number" step="any" min="0" id="${prefix}-setting-marketing-fee" value="${esc(marketingFee)}" />
          <span class="meta-report-fee-value-input-suffix">Dkr</span>
        </span>
      </label>`;
  }
  if (inline) {
    return '<span class="meta-cv-fee-inline-hint">No fee amount — save to apply.</span>';
  }
  if (mode === 'performance') {
    return `
      <label class="meta-report-fee-value-field">
        <span class="meta-report-fee-value-label">Performance fee percentage</span>
        <span class="meta-report-fee-value-input-wrap">
          <input type="number" step="any" min="0" max="100" id="${prefix}-setting-fee-percent" value="${esc(feePercent)}" />
          <span class="meta-report-fee-value-input-suffix">%</span>
        </span>
      </label>`;
  }
  if (mode === 'marketing') {
    return `
      <label class="meta-report-fee-value-field">
        <span class="meta-report-fee-value-label">Marketing fee amount</span>
        <span class="meta-report-fee-value-input-wrap">
          <input type="number" step="any" min="0" id="${prefix}-setting-marketing-fee" value="${esc(marketingFee)}" />
          <span class="meta-report-fee-value-input-suffix">Dkr</span>
        </span>
      </label>`;
  }
  return '<p class="meta-report-fee-value-empty">No amount needed — just save your selection.</p>';
}

function metaReportUsesInlineFeeValue(prefix) {
  return prefix === 'meta-cv';
}

function describeMetaReportFeeModeLabel(mode, feePercent, marketingFee, { feeEnabled = true } = {}) {
  if (!feeEnabled || mode === '' || mode == null) return 'No Censio fee';
  if (mode === 'performance') {
    const pct = Number(feePercent);
    return `Performance fee · ${Number.isFinite(pct) ? pct : 20}%`;
  }
  if (mode === 'marketing') {
    const amount = Number(marketingFee);
    return `Marketing fee · Dkr ${Number.isFinite(amount) ? amount : 0}`;
  }
  return 'No Censio fee';
}

function readMetaReportFeeDraftState(prefix) {
  const nested = document.getElementById(`${prefix}-fee-nested`);
  if (!nested) return null;
  const checkedRadio = nested.querySelector(`input[name="${prefix}-fee-mode"]:checked`);
  const selectedMode = checkedRadio ? (checkedRadio.value || '') : (nested.dataset.feeMode || '');
  let selectedPercent = Number(nested.dataset.feePercent);
  let selectedMarketing = Number(nested.dataset.marketingFee);
  if (selectedMode === 'performance') {
    const input = document.getElementById(`${prefix}-setting-fee-percent`);
    const parsed = Number(input?.value);
    if (Number.isFinite(parsed)) selectedPercent = parsed;
  } else if (selectedMode === 'marketing') {
    const input = document.getElementById(`${prefix}-setting-marketing-fee`);
    const parsed = Number(input?.value);
    if (Number.isFinite(parsed)) selectedMarketing = parsed;
  }
  const appliedMode = nested.dataset.feeEnabled === 'true'
    ? resolveMetaReportStoredFeeMode({
      metaReportFeeEnabled: true,
      metaReportFeeMode: nested.dataset.feeMode || null,
      metaReportMarketingFeeAmount: nested.dataset.marketingFee,
    })
    : '';
  const appliedPercent = Number(nested.dataset.feePercent);
  const appliedMarketing = Number(nested.dataset.marketingFee);
  const modeDirty = selectedMode !== appliedMode;
  const amountDirty = selectedMode === 'performance'
    ? selectedPercent !== appliedPercent
    : selectedMode === 'marketing'
      ? selectedMarketing !== appliedMarketing
      : false;
  return {
    appliedMode,
    appliedPercent,
    appliedMarketing,
    selectedMode,
    selectedPercent,
    selectedMarketing,
    isDirty: modeDirty || amountDirty,
    appliedLabel: describeMetaReportFeeModeLabel(appliedMode, appliedPercent, appliedMarketing),
    selectedLabel: describeMetaReportFeeModeLabel(selectedMode, selectedPercent, selectedMarketing),
  };
}

function metaReportFeeStatusHtml(draft) {
  if (draft.isDirty) {
    return `
        <span class="meta-report-fee-status-value is-active">${esc(draft.appliedLabel)}</span>
        <span class="meta-report-fee-status-arrow" aria-hidden="true">→</span>
        <span class="meta-report-fee-status-pending">${esc(draft.selectedLabel)}</span>`;
  }
  return `<span class="meta-report-fee-status-value is-active">${esc(draft.appliedLabel)}</span>`;
}

function syncMetaReportFeeSelectionState(prefix) {
  const nested = document.getElementById(`${prefix}-fee-nested`);
  const draft = readMetaReportFeeDraftState(prefix);
  if (!nested || !draft) return;

  const statusEl = document.getElementById(`${prefix}-fee-status`);
  if (statusEl) {
    statusEl.innerHTML = metaReportFeeStatusHtml(draft);
  }

  const saveBtn = document.getElementById(`${prefix}-fee-save`);
  if (saveBtn) {
    saveBtn.classList.toggle('is-dirty', draft.isDirty);
    if (prefix === 'meta-cv') {
      saveBtn.disabled = !draft.isDirty;
      saveBtn.textContent = draft.isDirty ? 'Save changes' : 'Saved';
    }
  }
}

function bindMetaReportFeeAmountInputs(prefix) {
  const percentInput = document.getElementById(`${prefix}-setting-fee-percent`);
  const marketingInput = document.getElementById(`${prefix}-setting-marketing-fee`);
  if (percentInput) {
    percentInput.oninput = () => syncMetaReportFeeSelectionState(prefix);
  }
  if (marketingInput) {
    marketingInput.oninput = () => syncMetaReportFeeSelectionState(prefix);
  }
}

function bindMetaReportFeeDraftTracking(prefix) {
  bindMetaReportFeeAmountInputs(prefix);
  syncMetaReportFeeSelectionState(prefix);
}

function renderMetaReportBottomlineFeeSummary(settings = {}, prefix = 'meta-report') {
  const showBottomline = Boolean(settings.metaReportShowBottomline);
  const feeMode = resolveMetaReportFeeMode(settings) || '';
  const feePercent = settings.metaReportFeePercent ?? 20;
  const marketingFee = settings.metaReportMarketingFeeAmount ?? 0;
  const feeLabel = describeMetaReportFeeModeLabel(feeMode, feePercent, marketingFee);
  return `
    <div class="meta-report-bottomline-summary" id="${prefix}-fee-summary">
      <div class="meta-report-bottomline-summary-content">
        <div class="meta-report-bottomline-summary-row">
          <span class="meta-report-bottomline-summary-label">Bottomline</span>
          <span class="meta-report-bottomline-summary-value${showBottomline ? ' is-on' : ' is-off'}">${showBottomline ? 'Enabled' : 'Disabled'}</span>
        </div>
        ${showBottomline ? `
        <div class="meta-report-bottomline-summary-row">
          <span class="meta-report-bottomline-summary-label">Censio fee</span>
          <span class="meta-report-bottomline-summary-value">${esc(feeLabel)}</span>
        </div>` : ''}
      </div>
      <button type="button" class="admin-btn admin-btn--secondary admin-btn--small" id="${prefix}-fee-edit">Edit</button>
    </div>
  `;
}

function renderMetaReportBottomlineFeeEditor(settings = {}, prefix = 'meta-report', { compact = false, modal = false } = {}) {
  const showBottomline = Boolean(settings.metaReportShowBottomline);
  const feeEnabled = Boolean(settings.metaReportFeeEnabled);
  const storedMode = settings.metaReportFeeMode || '';
  const displayMode = resolveMetaReportFeeMode(settings);
  const feePercent = settings.metaReportFeePercent ?? 20;
  const marketingFee = settings.metaReportMarketingFeeAmount ?? 0;
  const inlineFeeValue = metaReportUsesInlineFeeValue(prefix);
  const feeDataAttrs = `data-fee-mode="${esc(storedMode)}" data-fee-enabled="${feeEnabled ? 'true' : 'false'}" data-fee-percent="${esc(feePercent)}" data-marketing-fee="${esc(marketingFee)}"`;
  const appliedLabel = describeMetaReportFeeModeLabel(displayMode, feePercent, marketingFee);
  const cards = META_REPORT_FEE_MODE_META.map(({ value, icon, title, desc }) => `
        <label class="meta-report-fee-mode-card">
          <input type="radio" name="${prefix}-fee-mode" value="${esc(value)}"${displayMode === value ? ' checked' : ''} />
          <span class="meta-report-fee-mode-card-icon" aria-hidden="true">${esc(icon)}</span>
          <span class="meta-report-fee-mode-card-text">
            <span class="meta-report-fee-mode-card-title">${esc(title)}</span>
            <small>${esc(desc)}</small>
          </span>
          <span class="meta-report-fee-mode-card-radio" aria-hidden="true">${ICON_CHECK}</span>
        </label>`).join('');
  const editorActions = modal ? `
    <div class="meta-report-fee-editor-actions">
      <button type="button" class="admin-btn admin-btn--ghost admin-btn--small" data-meta-report-modal-close>Done</button>
      <button type="button" class="admin-btn admin-btn--primary admin-btn--small" id="${prefix}-fee-save">Save fee settings</button>
    </div>` : `
        <div class="meta-report-fee-save-row">
          <button type="button" class="admin-btn admin-btn--primary admin-btn--small" id="${prefix}-fee-save">Save fee settings</button>
        </div>`;

  if (modal) {
    return `
    <div class="meta-report-bottomline-editor meta-report-bottomline-editor--modal" id="${prefix}-fee-editor">
      <div class="meta-report-bottomline-panel">
        <div class="meta-report-bottomline-row">
          <div class="meta-report-bottomline-row-text">
            <span class="meta-report-bottomline-row-title">Show bottomline</span>
            <span class="meta-report-bottomline-row-desc">Adds profit, ROAS and Censio fee breakdown to this report</span>
          </div>
          ${renderMetaReportSwitch(`${prefix}-setting-bottomline`, showBottomline, 'Show bottomline', false, { hideLabel: true })}
        </div>
        <div class="meta-report-fee-nested${showBottomline ? '' : ' is-hidden'}" id="${prefix}-fee-nested" ${feeDataAttrs}>
          <div class="meta-report-fee-status" id="${prefix}-fee-status" aria-live="polite">
            <span class="meta-report-fee-status-value is-active">${esc(appliedLabel)}</span>
          </div>
          <div class="meta-report-fee-mode-grid meta-report-fee-mode-grid--list">${cards}
          </div>
          <div class="meta-report-fee-value" id="${prefix}-fee-value">${metaReportFeeValueBlockHtml(prefix, displayMode, feePercent, marketingFee, { inline: inlineFeeValue })}</div>
        </div>
      </div>
      ${editorActions}
    </div>`;
  }

  return `
    <div class="meta-report-bottomline-editor" id="${prefix}-fee-editor">
      <div class="meta-report-bottomline-row">
        <div class="meta-report-bottomline-row-text">
          <span class="meta-report-bottomline-row-title">Show bottomline</span>
          <span class="meta-report-bottomline-row-desc">Adds profit, ROAS and Censio fee breakdown to this report</span>
        </div>
        ${renderMetaReportSwitch(`${prefix}-setting-bottomline`, showBottomline, 'Show bottomline', false, { hideLabel: true })}
      </div>
      <div class="meta-report-fee-nested${showBottomline ? '' : ' is-hidden'}" id="${prefix}-fee-nested" ${feeDataAttrs}>
        <div class="meta-report-fee-status" id="${prefix}-fee-status" aria-live="polite">
          <span class="meta-report-fee-status-value is-active">${esc(appliedLabel)}</span>
        </div>
        <div class="meta-report-fee-mode-grid${compact ? ' meta-report-fee-mode-grid--rows' : ''}">${cards}
        </div>
        <div class="meta-report-fee-value" id="${prefix}-fee-value">${metaReportFeeValueBlockHtml(prefix, displayMode, feePercent, marketingFee, { inline: inlineFeeValue })}</div>
        ${editorActions}
      </div>
    </div>
  `;
}

function renderMetaReportBottomlineModalContent(payload) {
  const settings = payload.settings || {};
  return `
    <div class="meta-report-modal-head">
      <h2 class="meta-report-modal-title">Bottomline & Censio fee</h2>
      <button type="button" class="meta-report-modal-close" aria-label="Close">&times;</button>
    </div>
